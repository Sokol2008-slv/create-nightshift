	file.0000000000000001.title: "Create: Ночная смена"
	quest.003CF000D6B806AA.quest_desc: [
		"&3Что:&r финал «Кузница»: Незеритовое чудовище и Игнис разом плюс вся орда."
		"&3Награда:&r 3 Сердца ночи, 2 звезды Незера, сильный артефакт. Дальше — Бесконечность."
		"&7&oПресс-служба: «Смена закрыта. Орда уведомлена. Переработка — в Бесконечности».&r"
	]
	quest.003CF000D6B806AA.title: "Волна 100 · Финал смены"
	quest.005E934BAF69625A.quest_desc: [
		"Вопросы, которые смена задавала чаще всего. Нажми на вопрос — откроется ответ."
		"&eРецепты и машины&r"
		"{\"text\": \"▶ Верстак в JEI есть, а не работает\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2ED4F972C8004BDD\"}}"
		"{\"text\": \"▶ Миксер делает не то\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"436EF826D8B38892\"}}"
		"{\"text\": \"▶ Пила выдаёт не то или бревно обратно\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"234C5426FCAE3ECD\"}}"
		"{\"text\": \"▶ Диагональный рецепт не собирается\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"34C1EC83C942AAFD\"}}"
		"{\"text\": \"▶ Рецепт больше 3×3: сколько крафтеров\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"157DCCB30AA9320E\"}}"
		"{\"text\": \"▶ Как не держать цепочку в голове\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"575E2449004F7BBA\"}}"
		"{@pagebreak}"
		"&eОсобые рецепты&r"
		"{\"text\": \"▶ Отделка (узор) на броню\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1A6D438D9F2B62A4\"}}"
		"{\"text\": \"▶ Незеритовый рюкзак\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5091595E3D8BFEBF\"}}"
		"{\"text\": \"▶ Улучшение «Переполнение»\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"31F29F77CF74F6C3\"}}"
		"{\"text\": \"▶ Экструдер не делает обсидиан\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0B0207618EA078D0\"}}"
		"{\"text\": \"▶ Как получить горелку всполоха\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"4D1ACF24FA3CCAE6\"}}"
		"{\"text\": \"▶ Чертежи, чтобы строить модулями\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"736E1771B8D1AFBE\"}}"
		"{@pagebreak}"
		"&eВыживание&r"
		"{\"text\": \"▶ Рассудок быстро падает\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3ABA8B0AC43708FC\"}}"
		"{\"text\": \"▶ Стало меньше сердец\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1DE1569914F57358\"}}"
		"{\"text\": \"▶ Волна идёт, а монстров не видно\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"205D19F566F48380\"}}"
		"{\"text\": \"▶ Монстры у базы, хотя набег не начинали\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"135A722392CB4AA6\"}}"
		"&eМир и техника&r"
		"{\"text\": \"▶ Нет заряда молнии\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1244253591F26CD8\"}}"
		"{\"text\": \"▶ Форпост не найти\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3DB74392F6E9D921\"}}"
		"{\"text\": \"▶ Гевея не даёт латекс\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2B212A82A987C8EE\"}}"
		"{\"text\": \"▶ Где упал метеорит\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1D9CA855CB4EFF83\"}}"
		"{\"text\": \"▶ Дракон не зовётся или пропал\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6F8E8FF64145C30B\"}}"
		"{\"text\": \"▶ Где взять диски, шаблоны, яйцо дракона\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2BEF641D30F7ADE6\"}}"
		"{@pagebreak}"
		"&eКлиент и книга&r"
		"{\"text\": \"▶ Клавиши пака\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"042CEC92D46AE312\"}}"
		"{\"text\": \"▶ Квест не засчитывается\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1B6D166467CBC5C1\"}}"
		"{\"text\": \"▶ Ошибка «канал мода не подключён»\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"00D2DE459F4AEC0C\"}}"
	]
	quest.005E934BAF69625A.title: "Частые вопросы: оглавление"
	quest.00C1E5D9F1E192B0.quest_desc: [
		"Справка: готовые билды на 4 слота. Против стрел и магии — срез урона, против толпы вплотную — щит и отражение."
		"&eТанк:&r &bСердце Вахты&r + &cСердце орды&r + &6Кровь титана&r + &5Каменное сердце&r — 82 HP с 5 Сердцами ночи, лечение вне боя 2 HP/с."
		"&eБез божественного:&r &cСердце орды&r + &6Кровь титана&r + &5Каменное сердце&r + &aСтальная пряжка&r — 70 HP, реально к 60–70-й волне."
		"&eСтена:&r &6Щиток бригадира&r + &cОжерелье реликта&r + &5Чётки дозорного&r + &aНашивка ОТК&r — −34 % урона и длинная передышка после удара."
		"{@pagebreak}"
		"&eБессмертный:&r &cПесочные часы&r + &6Жетон второго дыхания&r + &5Чётки дозорного&r + &cОсколок пустоты&r — щит 1 с раз в 6 с, второе дыхание раз в 5 мин, уклонение 15 %. &bНимб бессменного&r заменяет часы и жетон разом."
		"&eВампир:&r &5Перчатка мясника&r + &cСердце орды&r + &6Жало скорпиоида&r + &bНимб бессменного&r — вампиризм 20 % (потолок), удары травят и замедляют."
		"&eПоджигатель:&r &cЯдро Игниса&r + &cКорона пекла&r + &6Пепельное сердце&r + &cРог диаболоса&r — аура жжёт, удары поджигают, убийства лечат, огонь не страшен."
		"&7&oИдеальный билд — тот, в котором ты дожил до раздачи добычи.&r"
	]
	quest.00C1E5D9F1E192B0.title: "Билды"
	quest.00D2DE459F4AEC0C.quest_desc: ["Клиент не обновился. Закрой игру и Prism, запусти снова и дождись окна обновления пака."]
	quest.00D2DE459F4AEC0C.title: "Ошибка «канал мода не подключён»"
	quest.00FFADF948AC3736.quest_desc: [
		"&3Сделай:&r вакуумный сборщик — забирает спелое вокруг себя."
		"&3Чем:&r миксер: жнец, вентилятор, латунный корпус, жёлоб. Вращение заряжает (&664&r об/мин — &630&r с), потом разом всасывает. Урожай — с любой стороны, кроме вала."
		"&7&o— ОТК: «Жнец не отличает капусту от ноги. Не стойте на грядке».&r"
	]
	quest.00FFADF948AC3736.title: "Уборка без рук"
	quest.01594BCF4B0FAA93.quest_desc: [
		"&3Сделай:&r пропеллерный подшипник — крутит лопасти из парусов перед ним (от 2 парусов); больше парусов — сильнее тяга."
		"&3Чем:&r крафтеры столбиком: деревянная плита, железный лист, латунный корпус."
		"&3Дальше:&r гироскоп."
	]
	quest.01594BCF4B0FAA93.title: "Пропеллер своими руками"
	quest.01617CC30A73058B.quest_desc: [
		"&3Сделай:&r превратить найденную жилу в товар: ПКМ сканером по земле в чанке с настоящей жилой — &eзонд&r этого типа навсегда появится в столе у всей команды. Первый скан типа на сервере дарит один зонд."
		"&3Чем:&r механические крафтеры: 3 латунных слитка, электронная лампа, детектор жил."
	]
	quest.01617CC30A73058B.title: "Сканер жил"
	quest.01B7C3894344A90F.quest_desc: [
		"&3Сделай:&r обсидиан без вёдер."
		"&3Чем:&r экструдер: вода и лава по бокам, не быстрее &64&r об/мин (маленькая шестерня → большая = ÷2)."
	]
	quest.01B7C3894344A90F.title: "Обсидиан"
	quest.0201C86BA400031C.quest_desc: [
		"Из-за алтаря выходит &4Пожиратель&r — неубиваемый и чуть быстрее бегущего человека. Вся команда должна добраться до &aточки эвакуации&r в ~400 блоках за 4 минуты."
		"Направление и расстояние — над хотбаром, над точкой столб света. Пешком не уйти: машина, самолёт, поезд, лошадь."
		"Отстал больше чем на 48 блоков — Пожиратель прыгает за спину. Повторы — 46 и 62."
		"Первое прохождение: &6Значок беглеца&r."
	]
	quest.0201C86BA400031C.title: "Волна 28: Побег"
	quest.021C59A76EC5D8D5.quest_desc: [
		"&3Сделай:&r бесплатное вращение с первого дня — &6256 SU&r (8 об/мин)."
		"&3Чем:&r миксер: 8 досок + вал. Два колеса есть в ящике."
		"&3Где:&r вода течёт по лопастям в одну сторону. Колёса на одном валу складываются: 4 колеса — &61 024 SU&r."
		"&3Дальше:&r котёл — шаг 2. Лестница главы: колёса → пар → генератор → провод → накопитель → мотор → энергофорпост."
		"&7&oРыба в реке была против. Её никто не спрашивал.&r"
	]
	quest.021C59A76EC5D8D5.title: "Шаг 1 · Водяное колесо"
	quest.029373F06668223C.quest_desc: [
		"&3Сделай:&r Пилот II — «Бамбуковый кукурузник», алый биплан, Форсаж II."
		"&3Чем:&r налёт 20 км, высота 200+, 10 посадок (3 — на ангар-док: центр самолёта в квадрате 7×7 над доком), 2 км ночью."
		"&7&o— Служба доставки: «Ночью летим по приборам. Приборов нет. Летим по звёздам».&r"
	]
	quest.029373F06668223C.title: "Пилот II"
	quest.02B25E310B8069D6.quest_desc: [
		"&3Сделай:&r осколочные гранаты — разобрать толпу за стеной."
		"&3Чем:&r миксер: медный самородок, латунная и железная пластины, шестерня, порох."
		"Взрыв &e20&r урона, радиус 4, бросок — ПКМ."
		"&3Дальше:&r ракетница."
	]
	quest.02B25E310B8069D6.title: "Осколочная граната"
	quest.03272886A0764215.quest_desc: [
		"&3Сделай:&r вдвое больше силы у той же реки — &6512 SU&r (4 об/мин)."
		"&3Чем:&r миксер: водяное колесо + 8 досок. Занимает 3×3, вал через центр."
		"Крутит медленно: большая шестерня → маленькая даёт ×2 к оборотам."
	]
	quest.03272886A0764215.title: "Большое водяное колесо"
	quest.036E90188F8EA76D.quest_desc: [
		"Зачем: падения — каждая третья смерть смены. Антиграв на ботинках превращает падение в мягкую посадку: выпал из самолёта — это парашют."
		"&6Механические крафтеры&r: сверху 2 &eбаллона гелия&r (Высотный конденсатор) и &eметеоритное железо&r между ними, в середине 2 конденсатора Crafts \\& Additions и механизм точности, снизу — модуль &eПружинные ботинки&r."
		"Ставят тоже крафтеры: модуль + любые ботинки + электрическая медь. Чары и прочность сохраняются, с пружинными ботинками на той же паре совместим."
		"{@pagebreak}"
		"&eКак работает:&r падаешь дольше 3,5 блока — модуль включается сам: медленное падение, голубое свечение под ногами, на посадке кольцо облаков. Зажми &eShift&r в воздухе — включится раньше."
		"&eЗаряд&r — свой, 100 000 FE: парение 500 FE/с (~200 с). Не успел затормозить — 1 000 FE за единицу урона. Пусто — берёт из энергощита на нагруднике. Совсем пусто — обычное падение."
		"&eЗарядка:&r под куполом генератора щита (полный за 5 с) или энергоячейка в инвентаре (1 000 FE/т). Заряд виден фиолетовой полоской на иконке ботинок."
		"&7&o— Отдел кадров: «Прыгать с крыши по-прежнему запрещено. Но теперь хотя бы не больно».&r"
	]
	quest.036E90188F8EA76D.title: "&dАнтиграв&r"
	quest.03D58C0D28130D2F.quest_desc: [
		"Кошмар (70–100): в каждой волне 18 подволн, мобов втрое больше, они крупнее и толще: все модовые мобы, подволны &cL_Ender's Cataclysm&r и Свита Кошмара (крабы, жнецы, моли). У каждой волны — «звезда вечера»."
		"Босс — каждую волну: сначала мини-боссы (Кобольдиатор, Аметистовый краб, Уаджет, Рыскун, Аптргангр, Голем Края, Клаудиан), с 80-й — настоящие."
		"{@pagebreak}"
		"Боссы Cataclysm базу не ломают, но у них &eпотолок урона&r за удар и в секунду — одной пушкой не задавить, нужны время и много стволов."
		"&6Веха каждому&r: &dЗвёздный осколок&r — из него собирают Звёздную кирку (копает руды наших планет). И &5Сердце ночи&r."
		"&7&o— Отдел по работе с ордой: «С 70-й волны орда не приходит. Она переезжает».&r"
	]
	quest.03D58C0D28130D2F.title: "Волна 70: звёздный осколок"
	quest.03D8DE952203E77C.quest_desc: [
		"&3Сделай:&r &616 384 SU&r с одного двигателя — в 64 раза больше колеса."
		"&3Чем:&r крафтеры столбиком: золотой лист, андезитовый сплав, медный блок. Ставь на стенку бака, перед ним — вал: 64 об/мин."
		"Не тянет — посмотри в очках на бак: видно, что держит уровень (нагрев, вода или размер)."
		"&3Дальше:&r шаг 3 — генератор (нужна 15-я волна). Тепло — ветка ниже."
	]
	quest.03D8DE952203E77C.title: "Паровой двигатель"
	quest.03DB751250233EB0.quest_desc: [
		"&3Сделай:&r закрой первый заказ фактории — первый &6жетон смены&r, валюта их лавки."
		"&3Где:&r у алтаря встают 3 фактории в &6900–1400&r бл.; где они и что просят — &e/factory&r."
		"&3Чем:&r 2–4 товара по силам волны: андезит и листы → латунь и механизмы → с 15-й электромедь и провода. Возить — дирижаблем или поездом."
		"Срок — 2–3 игровых дня (≈ &640–60&r мин), не успели — заказ сгорает со сданным. Новый — через ≈ &63&r мин. Без игроков сроки стоят."
		"&3Дальше:&r касса на премию."
		"&7&o— Служба доставки Axiomativ: «Мы бы сами привезли, но у нас лапки».&r"
	]
	quest.03DB751250233EB0.title: "Фактории: первый заказ"
	quest.042CEC92D46AE312.quest_desc: [
		"&6R&r / &6U&r — рецепты и применения (JEI); &6W&r — Ponder; &6J&r — планшет инженера; &6P&r — закрепить (в окнах), &6Shift+P&r — цель смены."
		"&6L&r — книга квестов, &6Alt+L&r — листать закреплённые квесты. &6Мышь 5&r (боковая) — метка команде, зажать — колесо меток («сюда», «опасно», «смотри»); метка сама встаёт на карту Xaero на 30 с."
		"С 3.4.0 редкое уехало на Alt: голосовой чат &6Alt+V&r, микрофон &6Alt+M&r, новая метка Xaero &6Alt+B&r, история смертей &6Alt+U&r, шейдеры &6Alt+K&r. &6V&r — дракон, &6M&r — карта, &6F5&r — только вид."
		"Свои переназначения у тебя остались. Взять раскладку пака целиком: «Управление» → «Сбросить всё»."
	]
	quest.042CEC92D46AE312.title: "Клавиши пака"
	quest.0445124ADFD41179.quest_desc: [
		"&3Что:&r Кошмар: 18 подволн, мобов втрое больше, босс Cataclysm каждую волну — у них потолок урона, нужны много стволов."
		"&3Построй к ней:&r оборону, которая работает без вас, лучшие артефакты, броню из межпланетного сплава."
		"&3Награда:&r звёздный осколок — Звёздная кирка (руды наших планет)."
		"{\"text\": \"▶ Подробно: волна 70\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"03D58C0D28130D2F\"}}"
	]
	quest.0445124ADFD41179.title: "Волна 70 · Звёздный осколок"
	quest.0503A513927D11DF.quest_desc: [
		"Мир открыт с первого дня: копай, строй, ставь заводы. Главное испытание — &5набеги на алтарь&r, волну выбираете сами."
		"План на первую ночь: свет → кровать → рассудок. Потом — база и алтарь."
		"{\"text\": \"▶ Этап 3: алтарь и первые волны\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2B5D5FE8FC36C5DE\"}}"
		"&7&oОтдел кадров: «Ночная смена оплачивается по двойному тарифу. Посмертно — по тройному».&r"
	]
	quest.0503A513927D11DF.title: "Справка: ночи здесь другие"
	quest.054A25D32F75CDFE.quest_desc: [
		"&3Сделай:&r латунный просеиватель — все блоки и подхват ресурсов одной линией."
		"&3Чем:&r просеиватель, 4 латуни, 3 латунных листа, блок редстоуна. С латунной сеткой гравий и песок дают дроблёную руду, кварц, опыт."
		"&7&o— Маркетинг Axiomativ: «Всегда есть решение». Обычно это ещё одна лента.&r"
	]
	quest.054A25D32F75CDFE.title: "Фабрика блоков"
	quest.05989202445BDA9F.quest_desc: [
		"Волны 27–34: богомолы (удар на 15), термиты, плоские пауки, шершни, ныряльщики. Босс 30-й — &4Артроплевра-мерзость&r."
		"Провал с 27-й стоит &c5 сердец&r. Готовьтесь: мясорубка в коридоре, автопушки, запас лечения, броня с «Защитой»."
		"&7&o— ОТК: «Ног в этой волне больше, чем в отделе кадров. Мы пересчитали».&r"
	]
	quest.05989202445BDA9F.title: "Волна 30: Артроплевра"
	quest.05BFAC295E23C671.quest_desc: [
		"Мобы набега &eгрызут стены&r на пути к алтарю: булыжник ~4 с, глубинный сланец ~6 с, железный блок ~10 с, обсидиан — минута."
		"Машины, сундуки, валы, всё с блок-сущностью, пушки и турели они &aне трогают&r."
		"Путь ищут на 64 блока — длинный коридор-ловушка работает. Великаны после 70-й грызут и третий блок прохода."
		"С 18-й волны — &cподрывники&r: не грызут, а взрывают (квест «Подрывники»)."
		"{@pagebreak}"
		"&eТочки спавна&r: встань, где должна выходить орда, — &e/nightshift spawn add&r (20–128 блоков от алтаря, вне зоны, до 8 точек). Орда пойдёт в твой коридор."
		"&e/nightshift spawn list&r, &eremove&r (ближняя), &eclear&r (снова кольцом)."
		"Зомби лезут друг на друга, пауки — по стенам. Фантомы и вексы кружат над алтарём: провалом они не считаются, но волна не кончится, пока живы."
		"{@pagebreak}"
		"&7&oСтена из булыжника держит орду четыре секунды. Хватит, чтобы помолиться. Коротко.&r"
	]
	quest.05BFAC295E23C671.title: "Стены и точки спавна"
	quest.063156D925C2481D.quest_desc: [
		"&3Что:&r особая стадия — духов ранит только магия: посохи, заклинания Iron's Spells, зелья вреда."
		"&3Построй к ней:&r книгу заклинаний с боевыми свитками, посохи, запас маны и зелий."
		"&3Ключ:&r эссенция духа — сильная магия. Повтор — 52."
		"{\"text\": \"▶ Магия на вахте\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"26D4945737F6CCB3\"}}"
	]
	quest.063156D925C2481D.title: "Волна 32 · Духи"
	quest.064C83DE0B941189.quest_desc: [
		"&3Сделай:&r картофельная пушка — дальнобойное оружие Create, стреляет едой."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Урон: картошка 5, печёная 5 и поджог, золотая морковь 12, дыня 8 и отброс."
		"&3Дальше:&r гранаты."
	]
	quest.064C83DE0B941189.title: "Картофельная пушка"
	quest.06A9EE3F9100586B.quest_desc: [
		"Сколько ставить и сколько везти."
		"&eЯчейка&r — 2 млн FE; станции — 8 000 FE/т, ячейка за 12,5 с"
		"&eГеотермальный&r — 2 000 FE/т с водой, 500 без; &eгидро&r — 500 на камень"
		"Для сравнения: двигатель + генератор — 432 FE/т; котёл 18 на тортах — 7 776."
		"Поле из 5 геотермальных (10 000 FE/т) — 2 зарядные станции; сундук ячеек наберётся за 4,5 мин."
	]
	quest.06A9EE3F9100586B.title: "Справка: энергофорпост в цифрах"
	quest.06AA8DFEA3F70CB5.quest_desc: [
		"&3Сделай:&r рельсы Create — по ним ездят поезда."
		"&3Чем:&r сборка по шагам: шпалы (плиты) → 2 самородка железа или цинка → пресс."
		"Кладутся от точки к точке: повороты и подъёмы строятся сами."
	]
	quest.06AA8DFEA3F70CB5.title: "Рельсы"
	quest.06B5CD629BA1C0AF.quest_desc: [
		"&3Сделай:&r слитки и железные листы."
		"&3Чем:&r пресс над чашей: 9 самородков → слиток. Пресс над депо: слиток → лист."
		"&3Дальше:&r горелка всполоха."
	]
	quest.06B5CD629BA1C0AF.title: "Слитки и листы: пресс"
	quest.07393EA56E1D767B.quest_desc: [
		"Подлодка — та же штуковина: сборщик и клей, вместо пропеллера вверх — балласт."
		"&eДавление&r — корпус схлопывается: прочное стекло и толстые стены."
		"&eПоплавок&r — 8 шерсти + мембрана (ламинария прессом): тянет к поверхности."
		"&eПодводная мина&r — миксер: 4 промышленных железных блока, магнетит, 4 динамита."
		"Тормозной гак и декомпрессионная камера — «в разработке», не ставить."
	]
	quest.07393EA56E1D767B.title: "Справка: подлодка"
	quest.074742062F9FA498.quest_desc: [
		"&3Что:&r особая стадия — орду берёт только ток: тесла-башня, молния. Пули, мечи и турели — мимо."
		"&3Построй к ней:&r 2–3 тесла-башни выше стен и сеть с запасом в аккумуляторе: выстрел — 2 000 FE."
		"&3Ключ:&r сердечник катушки — тесла-техника следующего уровня. Повторы — 44, 64."
		"{\"text\": \"▶ Тесла-башня\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5B0D0D05577E8BCF\"}}"
	]
	quest.074742062F9FA498.title: "Волна 22 · Механоиды"
	quest.07E1779D7F156A53.quest_desc: [
		"&3Сделай:&r «Сердце ночи» без набега: +1 сердце навсегда (до 5)."
		"&3Чем:&r миксер над &cперегревом&r (торт всполоха): 16 звёздных осколков + 2 небесных кристалла + настойка жизни."
		"Примерно один звездопад на троих."
	]
	quest.07E1779D7F156A53.title: "Сердце из звёзд"
	quest.0811D15A56819E96.quest_desc: [
		"&3Сделай:&r межпланетный навигатор — без него только Луна (строка Navigator: Required)."
		"&3Чем:&r крафтеры: 6 титановых пластин, 2 титановых слитка, 5 полированных лунных сапфиров, 4 схемы, навигационный компьютер. В корпус, приклеить."
		"Порядок: Марс (сталь) → Меркурий (вольфрам, жара днём) → Венера (жара всегда). Справки — в ряду ниже."
		"&3Дальше:&r марсианская сталь."
	]
	quest.0811D15A56819E96.title: "Межпланетный навигатор"
	quest.081BCC72EBCBE493.quest_desc: [
		"&3Сделай:&r приручи дракончика сырой рыбой (квест ждёт треску)."
		"Команды — «Меню команд дракону» (Управление → «Драконы»), инвентарь — Shift+ПКМ по нему."
		"&3Дальше:&r седло, броня, свисток."
	]
	quest.081BCC72EBCBE493.title: "Приручение"
	quest.0842BE7A53F7464B.quest_desc: [
		"&3Сделай:&r радар — пушка стреляет сама, только если кто-то видит цель."
		"&3Чем:&r вращатель антенны (электронная лампа, механический подшипник, 3 железных листа), на него приёмник (без него «No Receiver Found») и рефлекторы, вращение."
		"Дальность 20 + 10 за рефлектор, до 1 000. Обзор 90°, по высоте ±20 — держи на уровне алтаря."
		"&3Дальше:&r монитор."
	]
	quest.0842BE7A53F7464B.title: "Радар"
	quest.084D8406F225C967.quest_desc: [
		"Победа — добыча &aкаждому&r в этом мире, кто был в игре хотя бы на &eполовине подволн&r — расстояние до алтаря не важно (к боссу зайти в игру не выйдет)."
		"Бросков: по одному за подволну, два за каждого босса, с 70-й — ещё по одному за каждую волну после 69-й."
		"Таблица богатеет с волной: от дерева и железа до алмазов, незерита и тория. У броска 14% на &dредкое&r: рюкзаки, книги, тотемы, элитры, звезда Незера, зонды жил."
		"{@pagebreak}"
		"Раз за набег — шанс на &5артефакт&r: от 3% до 60%, после 69-й +1% за волну. С 70-й — ещё особые броски: череп визера, незерит с чарами, элитры, маяк."
		"&6Первое прохождение&r: зонд жилы на команду — за первую волну нового состава (1, 4, 8, 14, 20, 27, 35, 43, 50, 60); сильный артефакт каждому — каждая 5-я с 20-й."
		"{@pagebreak}"
		"Артефакты носят в слотах аксессуаров (кнопка в инвентаре): облако в бутылке, кроссовки, силовая перчатка, кристальное сердце… всего почти 50."
		"Ещё их роняет &5подражатель&r — моб-сундук волн с 35-й."
		"&7&o— Бухгалтерия EMC: «Добыча не облагается налогом. Облагается только тот, кто не дожил до раздачи».&r"
	]
	quest.084D8406F225C967.title: "Добыча"
	quest.085A792FBA7E3B63.quest_desc: [
		"&3Сделай:&r купи карту клада и забери сундук."
		"&3Где:&r 350–800 блоков от базы: координаты и метка Xaero приходят при покупке, на карте — крестик. Ближе 40 блоков сундук появится, над местом встанет столб света."
		"&eКлад&r зарыт на 2–3 блока. &eСхрон разбойников&r (с 5-й волны) — у костра под охраной, добыча богаче. Карта живёт 12 игровых дней."
	]
	quest.085A792FBA7E3B63.title: "Клад снабженца"
	quest.08F1549241E129A6.quest_desc: [
		"&3Сделай:&r долети до Луны — засчитается сам (в станции — The Moon)."
		"Первое дело — лунный сапфир (справка «Луна»): из него автопосадка и межпланетный навигатор."
		"Домой: открой станцию — выпадет Обратный билет. Билет — в слот вместо Атласа, «Previous takeoff»: сядешь, откуда взлетел. Билет сгорает при посадке; топливо — из тех же баков, норма теплозащиты Земли действует."
		"&7&oМаленький шаг для вахтовика, огромный счёт за топливо для бухгалтерии.&r"
	]
	quest.08F1549241E129A6.title: "&6Ступил на Луну&r"
	quest.092F3AC53112DA4F.quest_desc: [
		"После сотой шкала не кончается: &dБесконечность&r — волны ∞1, ∞2, ∞3… Почти одни боссы, мобов и силы всё больше, без потолка."
		"Боссы Cataclysm толстеют не больше чем вдвое, а вот свита растёт без предела."
		"Каждая 5-я новая волна — сильный артефакт и &5Сердце ночи&r каждому; обычный артефакт падает почти всегда."
		"&7&oБесконечность — это когда отпуск согласовали, но дату не поставили.&r"
	]
	quest.092F3AC53112DA4F.title: "Бесконечность"
	quest.095F889A350581BE.quest_desc: [
		"&3Сделай:&r нагрев котла: горелка на угле — &61&r уровень, на торте всполоха — &62&r."
		"&3Где:&r только прямо под дном бака — под 3×3 влезает 9. Горелку не крафтят: пустой горелкой ПКМ по живому всполоху (крепость Незера)."
		"&3Топливо&r (воронкой или деплоером): уголь — 80 с, угольный блок — 800 с, торт — 160 с перегрева. Торт: пресс над чашей жмёт основу (яйцо + сахар + незераковая мука), дозатор заливает &6250 мБ&r лавы."
		"Лава или огонь под баком — пассив: &62 048 SU&r на весь котёл."
	]
	quest.095F889A350581BE.title: "Горелка под котлом"
	quest.09AAC059978BF8D7.quest_desc: [
		"Выход одного экструдера: 4 удара на штуку сырья."
		"&e64 об/мин&r — &612&r шт/мин, &e128&r — &6~21&r, &e256&r — &6~43&r. Больше — несколько экструдеров на пятно."
		"{@pagebreak}"
		"Экструдер на 64 об/мин, в минуту:"
		"&eСера&r — &630&r серной пыли"
		"&eСоль&r — &66&r вёдер электролита"
		"&eМагнетит&r — &624&r порошка (&66&r блоков)"
		"&eКварц&r — &612&r стёкол или линз"
		"&eБоксит&r — &6~18&r алюминиевых слитков"
		"&eГелий&r — &612&r баллонов (&648&r оболочек)"
		"&eЛёд&r — &624&r радиатора"
		"&eТорф&r — &66&r фильтров воздуха"
		"&eСветогриб&r — &636&r спор (&6216&r таблеток)"
		"&eЗвёздная пыль&r — &612&r звёздных карт"
		"&eГевея&r — латекс раз в 3 с со ствола"
		"{@pagebreak}"
		"&eБуровая установка&r (высокая ступень) — как &610&r экструдеров на тех же оборотах: &e64 об/мин&r — &6120&r шт/мин, &e256&r — &6450&r. Без тока — вдвое меньше."
	]
	quest.09AAC059978BF8D7.title: "Справка: форпосты в цифрах"
	quest.09C9D211AE0F9C81.quest_desc: [
		"&3Что:&r фантомы в небе, невидимые тени-пауки, вихри; босс — Голиаф, быстрый паук на ~560 HP."
		"&3Построй к ней:&r алмазная броня и оружие с чарами, стрелки или турели, бьющие вверх; играть вдвоём-втроём."
		"&3Награда:&r заряд молнии каждому — ключ к току (этап 7)."
		"{\"text\": \"▶ Подробно: волна 15\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"798ACE3CE5DB69E8\"}}"
	]
	quest.09C9D211AE0F9C81.title: "Волна 15 · Кровавая луна"
	quest.09F356C146A17F96.quest_desc: [
		"&3Сделай:&r автопушку — очередь без перезарядки."
		"&3Чем:&r казённик (с экстрактором), ствол, возвратная пружина — отлить, просверлить, на крепление пушки. Длина с казёнником: чугун до 3, бронза 5, сталь 7."
		"Темп — сила сигнала: 10 выстрелов/мин (1) … 300 (15). Патроны: пулемётный 8 урона, бронебойный 14, зенитный 10 + 15 осколков."
		"&3Дальше:&r компактные лафеты."
	]
	quest.09F356C146A17F96.title: "Автопушка"
	quest.0A0C129FCF5B1753.quest_desc: [
		"&3Сделай:&r воздухонагреватель — горячий воздух для домны."
		"&3Чем:&r 2 чугунных бака, 2 чугунные трубы, 2 огнеупорных кирпича → 2."
		"&3Где:&r топливо (креозот, печной газ) — снизу, воздухозаборник — сбоку, выход сверху — трубой в люк домны. От CO₂ — дымовая труба рядом."
	]
	quest.0A0C129FCF5B1753.title: "Воздухонагреватель"
	quest.0A1DAFEE8419EA9C.quest_desc: [
		"&3Сделай:&r собери первый поезд — квест засчитается, когда готовы станция, контроллер и расписание."
		"&3Чем:&r меню станции → режим сборки. Тележки — ПКМ железнодорожным корпусом по рельсам, блоки к ним — суперклеем, контроллер лицом вперёд. Подтверди на станции."
		"&3Дальше:&r поезд к форпостам и факториям."
		"{\"text\": \"▶ Сеть форпостов\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1DC2DCB789843948\"}}"
	]
	quest.0A1DAFEE8419EA9C.title: "Первый поезд"
	quest.0A1E924D269679FA.quest_desc: [
		"Справка: &9сверхредкие&r артефакты волн — с 8-й волны."
		"&9Клык кровососа&r — +1 урона вплотную; вампиризм 5 % (до 2 HP за удар), стрелы твоего лука тоже считаются."
		"&9Наплечник из сплава&r — +4 брони, +2 прочности брони: режет крупные удары боссов."
		"&9Шипастый ошейник&r — +1 брони; отражает 25 % урона вплотную (стрелы и заклинания — нет)."
		"Шанс каждого за победу: ≈0,23 % на 8-й волне, ≈0,61 % на 15-й, ≈2,7 % на 50-й, ≈4 % на 100-й."
	]
	quest.0A1E924D269679FA.title: "&9Сверхредкие&r артефакты"
	quest.0A221ACB167F5182.quest_desc: [
		"&3Сделай:&r держатель — голем в одном предмете; ПКМ им по земле — голем выходит."
		"&3Чем:&r крафтеры: металлический — рука | тело | рука, ноги под телом; человекоподобный — тело, руки, ноги столбиком; пёс — тело над ногами."
		"Лечить — ПКМ слитком его металла."
		"&3Дальше:&r улучшения, жезл команды."
		"&7&o— Бухгалтерия: «Голем окупается за одну ночь. Если пережил её».&r"
	]
	quest.0A221ACB167F5182.title: "Голем в сборе"
	quest.0A3DAD1655477A4B.quest_desc: [
		"&3Сделай:&r погрузись: клапан трубами к цистернам, вращение, грань к морю — лодка тонет; реверс — всплывает."
		"Не тонет — клапан не соединён трубами или не крутится."
		"&3Дальше:&r водомёт и электролизёр."
		"&7&oПодлодка — единственный транспорт, где «утонул» значит «всё по плану».&r"
	]
	quest.0A3DAD1655477A4B.title: "Первое погружение"
	quest.0A550435312139BD.quest_desc: [
		"&3К концу этапа:&r паровой двигатель крутит генератор, ток идёт по проводу к машинам. Ток — это зарядка (магниты, моторы), тесла-башни и щит."
		"&e1. Заряд молнии&r — за первую 15-ю волну, у каждого. Деплоер держит заряд и бьёт по медным слиткам на депо → &eэлектромедь&r. Заряд не тратится. Посох молнии его съедает — не собирай из единственного."
		"&e2. Прокатный стан:&r слиток → 2 стержня, лист → 2 провода."
		"&e3. Генератор переменного тока:&r крафтеры ромбом 5×5 — &e13 штук&r: 4 электромеди, 6 железных листов, железный стержень, 2 сплава. На 256 об/мин — &6432 FE/т&r."
		"&e4. Провод:&r медная катушка (пустая + 4 медных провода, &aбез резины&r) и низковольтные соединители. Без лимита тока, пролёт 32."
		"{@pagebreak}"
		"&3Форпосты для тока&r (этап 8):"
		"• &eСолеварня&r (пляж) — конденсатор: тесла-башня, аккумулятор, электромотор, ячейки."
		"• &eМагнитная аномалия&r (горы от 120) — магниты, моторы, секции тесла-башни."
		"• &eСера + Каучуковая плантация&r — резина: высоковольтный соединитель, золотой провод, провода New Age. Первому току не нужна."
		"&3Волны:&r 16 — стаи пауков-шнырей; &e22 «Механоиды»&r — орду берёт только ток: к ней тесла-башни."
		"{@pagebreak}"
		"{\"text\": \"▶ Шаг 3: заряд молнии\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2ECBF16F87D4CAC1\"}}"
		"{\"text\": \"▶ Генератор переменного тока\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0B8DDB0E251F417E\"}}"
		"{\"text\": \"▶ Шаг 4: провод\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6B4A80C8D04DFF1C\"}}"
		"{\"text\": \"▶ Сеть форпостов\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1DC2DCB789843948\"}}"
		"&3Дальше:&r этап 8 — форпосты."
	]
	quest.0A550435312139BD.title: "Этап 7 · Ток"
	quest.0A56940FBB7439AE.quest_desc: [
		"&3Сделай:&r урожай томатов (для бургера — ещё капуста и лук)."
		"Томат спеет на 4-й стадии, капуста — на 7-й. Гнилой томат — не еда."
		"&3Дальше:&r уборка и кухня без рук."
	]
	quest.0A56940FBB7439AE.title: "Урожай"
	quest.0ACD559F06214A80.quest_desc: [
		"Убитый моб &cделится на двоих&r поменьше: 0,75 роста и 40 % здоровья. Половинки больше не делятся."
		"Летуны, подрывники и выводки не делятся; когда живых больше 100 — тоже нет."
		"Бей по площади: огнемёт, взрывы, размашистый меч. Повтор — 59 (половинки крепче)."
		"Первое прохождение: осколки орды и бутыльки опыта."
	]
	quest.0ACD559F06214A80.title: "Волна 33: Гидра"
	quest.0AFB1385552891D0.quest_desc: [
		"&3Сделай:&r запомни правило вахты: &6руками только собирать&r — ставить блоки и класть детали. Остальное делают машины Create."
		"&3Где:&r у бригадира — &6Ящик вахтовика&r (поставь — механизмы внутри), у каждого — ключ, очки и книга «Инструктаж вахтовика»: квест засчитает её сам."
		"&3Дальше:&r сборочный пост."
		"&7&o— Axiomativ: «Свобода от рутины». Рутину крафта у вас уже отобрали.&r"
	]
	quest.0AFB1385552891D0.title: "Прибытие"
	quest.0B0207618EA078D0.quest_desc: [
		"Обсидиан выходит только на медленной скорости — &6не выше 4 об/мин&r: вода и лава по бокам, в фильтре экструдера — обсидиан."
		"Замедлить: маленькая шестерня → большая (÷2) — водяное колесо 8 об/мин станет 4."
	]
	quest.0B0207618EA078D0.title: "Экструдер не делает обсидиан"
	quest.0B8DDB0E251F417E.quest_desc: [
		"&3Сделай:&r ток из вращения — один блок, КПД &690 %&r."
		"&3Чем:&r механические крафтеры &eромбом 5×5 — 13 штук&r (в ящике 9): 4 электромеди, 6 железных листов, железный стержень, 2 андезитовых сплава. P над генератором в JEI — закрепить рецепт на экране."
		"&3Сколько:&r берёт 64 SU на об/мин: на 64 об/мин — &6108 FE/т&r, на 256 — &6432 FE/т&r (ровно один паровой двигатель)."
		"&3Дальше:&r провод — шаг 4. Соседним блокам ток отдаёт сам."
	]
	quest.0B8DDB0E251F417E.title: "Генератор переменного тока"
	quest.0C5F009A7468C1F1.quest_desc: [
		"&3Сделай:&r самый сильный источник без топлива — до &68 192 SU&r."
		"&3Чем:&r подшипник (миксер: камень + деревянная плита + вал). На его лицо суперклеем — паруса или шерсть, от 8 штук; ПКМ по подшипнику — ветряк собран."
		"Каждые 8 парусов — &6+1 об/мин&r, потолок 16 (128 парусов). Сила — &6512 SU&r на об/мин: 8 парусов — 512, 64 — 4 096, 128 — 8 192."
		"&7&oВетер бесплатный. Шерсть — нет: овцы уже подали жалобу в профсоюз.&r"
	]
	quest.0C5F009A7468C1F1.title: "Ветряк: подшипник и паруса"
	quest.0C6D145FAD7B7DE5.quest_desc: [
		"&3Сделай:&r ячейки из поезда — снова в сеть базы."
		"&3Чем:&r крафтеры: депо, латунный корпус, 2 электронные лампы, 2 конденсатора, электромедь."
		"&3Как:&r снимает до &68 000 FE/т&r и отдаёт соседям: аккумулятору вплотную, соединителю, проводам New Age. Пустая ячейка выходит вперёд — обратно к поезду."
	]
	quest.0C6D145FAD7B7DE5.title: "Разрядная станция"
	quest.0CA383208BFFC4DA.quest_desc: [
		"&3Сделай:&r дроблёную руду: сырая руда даёт &61,5&r, блок руды (шёлковое касание) — &62,5&r."
		"&3Чем:&r промывка (самородки + побочка) или плавка — печь, вентилятор сквозь лаву."
		"Побочка: железо — 75 % редстоуна, медь — 50 % глины, цинк — 25 % пороха, золото — 50 % кварца."
		"&3Дальше:&r экструдер."
	]
	quest.0CA383208BFFC4DA.title: "Дроблёная руда"
	quest.0CB6A55DA838EA09.quest_desc: [
		"&3Сделай:&r левитит — блок сам тянет вверх (10 kpg), без шара и горелки."
		"&3Чем:&r миксер с нагревом: 4 порошка эндерняка, 2 цинковых самородка, 500 мБ гелия → 500 мБ смеси. Вылей блоком, рядом огонь — застынет."
		"&3Где:&r эндерняк — только из Энда; гелий — «Высотный конденсатор»."
	]
	quest.0CB6A55DA838EA09.title: "Левитит"
	quest.0CB839EC6B4FFE19.quest_desc: [
		"&3Сделай:&r котёл — главный источник силы: баки, горелки под дном, вода, двигатели на стенках."
		"&3Чем:&r жидкостный бак — крафтеры столбиком: медный лист, бочка, медный лист. Баки рядом сливаются в один (до 3×3 в ширину)."
		"&3Как считать:&r уровень котла (0–18) = меньшее из трёх: нагрев, вода, размер (4 блока бака на уровень). Уровень N тянет N двигателей по &616 384 SU&r."
		"&3Дальше:&r горелки и вода."
	]
	quest.0CB839EC6B4FFE19.title: "Шаг 2 · Пар: котёл из баков"
	quest.0D4CABC9D4E7AE3A.quest_desc: [
		"Цепочка с 40-й волны — готовит к космосу."
		"&eШаги&r: каркас (тяжёлые плиты, промышленное железо, сталь) → жизнеобеспечение (пластик, баки, трубы, схемы Northstar) → энергия и связь (конденсаторы, платы, электрумовый провод)."
		"&eПремия&r — &6+60 %&r за три шага и полный &eжелезный скафандр&r в посылке."
		"{\"text\": \"▶ Скафандр и космос\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"206F6135673F26E9\"}}"
	]
	quest.0D4CABC9D4E7AE3A.title: "Справка: станция на Луне"
	quest.0D7095A54027C586.quest_desc: [
		"&3Сделай:&r «Бессмертие» — погибший голем выпадает держателем и сам прыгает тебе в инвентарь."
		"&3Чем:&r крафтеры плюсом: тотем сверху, эндер-жемчуг по бокам, якорь возрождения снизу, пустое улучшение в центре."
		"Без него голем, погибший на арене, пропадает насовсем: арена откатывает только блоки. Держатель с нулём здоровья чинится на наковальне слитком его металла."
	]
	quest.0D7095A54027C586.title: "Бессмертный голем"
	quest.0DA29650B2A99689.quest_desc: [
		"&3Сделай:&r реактивный ранец — летать над базой и ордой."
		"&3Чем:&r крафтеры: элитры, медный баллон, 2 механизма точности, латунные листы, жёлобы, вал."
		"Прыжок — вверх, Shift — вниз, &eG&r — вкл/выкл, &eH&r — зависание. Ест воздух из баллона."
	]
	quest.0DA29650B2A99689.title: "Реактивный ранец"
	quest.0DBAB77BAE915A5D.quest_desc: [
		"С 18-й волны в орде &cподрывники&r — светящиеся муравьи на 6 HP: на 18-й — премьерой, дальше — в каждой второй подволне. Бегут к стене и взрываются: дыра ~2 блока; рядом с игроком — взрыв по игроку."
		"Не берут: машины и всё с блок-сущностью, пушки и турели, &eобсидиан&r и прочее взрывоустойчивое. Добежал до алтаря — взрывается там, но набег не проваливает."
		"{@pagebreak}"
		"Что делать: сбивать на подходе — луки, турели, ловушки; второй слой стены за первым; обсидиан там, где орда упирается."
		"С 59-й — &4подрывник-тяжеловес&r: крупнее, крепче, дыра втрое больше."
		"&7&o— Отдел кадров: «Подрывники работают без выходных. Ровно до первого взрыва».&r"
	]
	quest.0DBAB77BAE915A5D.title: "Подрывники"
	quest.0E9B75BD4A8ACA52.quest_desc: [
		"&3Сделай:&r стабилитовую кирку — лучшая кирка смены, из металлов наших планет."
		"&3Чем:&r крафтеры: стабилит — аксиомит — стабилит сверху, под ними 2 межпланетных сплава."
		"Копает руды наших планет: прочность 6 000, скорость 14, урон выше, не горит в лаве, чары лучше незерита."
	]
	quest.0E9B75BD4A8ACA52.title: "&dСтабилитовая кирка&r"
	quest.0EB8F93F165A1C11.quest_desc: [
		"Зачем: из рам собирают арку врат перехода — 15 штук на одни врата."
		"&6Сборка по шагам&r (конвейер, деплоеры, пресс): латунный корпус → &eмагнетитовая пыль&r (форпост «Магнитная аномалия») → &eэлектрическая медь&r (заряд молнии с 15-й волны) → латунный лист → пресс, один круг."
		"Арку и орда не берёт: взрывы подрывников ей нипочём, как тесла-башне."
		"&7&o— ОТК: «Рама без пульта — это не врата, а очень дорогая дверь, в которую никто не заходит».&r"
	]
	quest.0EB8F93F165A1C11.title: "Рама врат"
	quest.0F09FFA3A4ED3DAF.quest_desc: [
		"Какой провод сколько проводит."
		"&eНизковольтный&r + медная катушка — &6без лимита&r, 4 провода, пролёт 32"
		"&eВысоковольтный&r + золото или электрум — &6без лимита&r, 6 проводов, пролёт 32; медь между двумя большими не тянется"
		"Сеть C\\&A — общий пул: лимит только там, где ток входит и выходит."
		"{@pagebreak}"
		"&eNew Age&r — лимит у провода, пролёт до 16, тянут между электрическими коннекторами: медь — &61 024&r, заряж. железо — &62 048&r, заряж. золото — &64 096&r, заряж. алмаз — &68 192 FE/т&r. Провод — сборка по шагам: лист → деплоер с резиной → пила = 4."
		"&eTFMG&r — своя сеть; с C\\&A и New Age — только через FE-блок вплотную."
	]
	quest.0F09FFA3A4ED3DAF.title: "Справка: провода и соединители"
	quest.0F14A05DE96A2802.quest_desc: [
		"Сколько стоит 1 % прочности на стойке:"
		"&eКожа, дерево, камень, золото&r — 400 FE"
		"&eЖелезо, кольчуга&r — 1 000 FE"
		"&eАлмаз&r (и щит, элитры, трезубец) — 2 500 FE"
		"&eНезерит&r и редкие модовые вещи — 5 000 FE"
		"Чары: +8 % за каждый уровень (не больше ×2,5); модуль брони — +25 % за штуку."
		"Пример: незеритовый нагрудник с Защитой IV, Прочностью III и Починкой — &68 200 FE&r за 1 %, с нуля ~820 000 FE (40 % энергоячейки); с модулем брони — 10 250 FE за 1 %. После тяжёлой волны (−20 % на 6 вещах) комплект встаёт в ~1 млн FE."
		"Энергощит: Mk1 1 000 FE/т, Mk2 2 000 FE/т. Запас стойки — 400 000 FE."
		"Не чинит вещи из тега &7axiomativ:no_rack_repair&r."
	]
	quest.0F14A05DE96A2802.title: "Справка: ремонт в цифрах"
	quest.0FF3009B62FC3F73.quest_desc: [
		"&8Тёмное измерение&r (The Afterdark): темно, мобы сильнее, зато тайники."
		"Вход — алтари телепорта в Глубокой тьме: ПКМ &eкатализатором телепорта&r (только из сундуков) — 5 переходов. Обратно — ПКМ по алтарю там."
		"Бери свет и таблетки: переход бьёт по рассудку."
	]
	quest.0FF3009B62FC3F73.title: "Справка: тёмная сторона"
	quest.102D14365F5DC1B3.quest_desc: [
		"&3Сделай:&r лечить раны — каждая смерть отнимает сердце максимума, настойка возвращает одно."
		"&3Чем:&r миксер: медовая бутылка + светящиеся ягоды + сладкие ягоды + костная мука + 2 &eцелебные споры&r → 2."
		"&3Где:&r ягоды — пышные пещеры; мёд без ульев — нагретый миксер: 2 сахара + цветок + вода, дозатором в бутылки. Готовые настойки — лавка фактории."
	]
	quest.102D14365F5DC1B3.title: "Настойка жизни"
	quest.104662E6DA217044.quest_desc: [
		"&3Сделай:&r рюкзак — вторая половина инвентаря."
		"&3Чем:&r крафтеры: сундук в центре, кожа и нить вокруг (R). Кожа — миксер с нагревом: 3 гнилой плоти + вода."
		"B — открыть надетый. Незеритовый — крафтеры в ряд: шаблон | алмазный рюкзак | незерит, содержимое цело."
	]
	quest.104662E6DA217044.title: "Рюкзак"
	quest.10AB8BC67127FF0D.quest_desc: [
		"Аксиоматив — родная планета Axiomativ: заводы, литейные, мёрзлые равнины. Отсюда приходят приказы."
		"&3Долететь:&r наука 8 в Атласе, межпланетный навигатор на борту, звёздный — у каждого. Науку быстрее снимать с Луны и Марса."
		"Тяжесть 11 м/с² — ускорителей больше; теплозащита 80 + 0,3 за блок; 2,2 а.е. — топлива больше, чем до Марса. −120 °C, тонкий углекислый воздух: железный скафандр держит."
		"&7&o— Приёмная штаба: «Вы опоздали на планёрку на 70 волн».&r"
	]
	quest.10AB8BC67127FF0D.title: "&6Аксиоматив: штаб компании&r"
	quest.10B140C481EE1381.quest_desc: [
		"Команды и правила гонок по кольцам."
		"&e/race list&r — трассы, рекорды, кнопки [Старт] и [Показать]"
		"&e/race start · stop · top · show <трасса>&r — заезд, сойти, рекорды, подсветить кольца"
		"&e/race new · edit · remove <трасса>&r — автор трассы (и оператор)"
		"&eКольцо засчитано&r — пролёт сквозь плоскость кольца ближе радиуса к центру, с любой стороны"
		"&eСрыв заезда&r — телепорт, смерть, другое измерение, 5 мин до старта, 2 мин без нового кольца"
		"&eПравка трассы&r — сбрасывает её рекорды"
	]
	quest.10B140C481EE1381.title: "Справка: гонки"
	quest.10F9F025767F43F1.quest_desc: [
		"&3Сделай:&r гвоздемёт — 10 выстрелов в секунду, магазин 40, бесшумный."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Гвоздь 5 урона, стальной 8. Гвозди: 3 железных самородка в миксере → 9."
		"&3Дальше:&r гатлинг."
	]
	quest.10F9F025767F43F1.title: "Гвоздемёт"
	quest.11275B17FBDCC7ED.quest_desc: [
		"&3Сделай:&r заряженное железо, золото и алмаз — для магнитов, моторов, нагревателя и теплогенераторов."
		"&3Чем:&r обыкновенный электризатор New Age — миксер: андезитовый корпус + громоотвод. Стоит над депо или лентой, как пресс; ест вращение и ток."
		"&3Сколько:&r железо — 1 000 FE, золото — 2 000, алмаз — 10 000, бутылка → пузырёк опыта — 50 000."
		"{@pagebreak}"
		"&eЗарядная катушка Теслы&r (C\\&A) — тоже над депо: золотой слиток или лист → &eэлектрум&r за &636 000 FE&r, провод или стержень — за 18 000. Предметы с батареей — 5 000 FE/т."
		"Мощность электризатора на каждые 10 об/мин: обыкновенный — 4, продвинутый — 16, укреплённый — 64 FE/т."
	]
	quest.11275B17FBDCC7ED.title: "Электризатор: зарядка током"
	quest.1172882304DE25C3.quest_desc: [
		"&3Сделай:&r ведро биотоплива — самое простое топливо. Ускорители жгут его из баков Create на борту: заливай до сборки."
		"ГДж на 1 мБ: биотопливо (и биоэтанол C\\&A) &60,25&r; газообразный водород &60,5&r; жидкий водород, нафта &60,75&r; углеводороды, керосин &61&r; метан &62&r. Дизель и бензин не годятся."
		"{@pagebreak}"
		"Биотопливо — пресс над чашей с горелкой: 3 сушёные ламинарии + костная мука → 150 мБ. Углеводороды — миксер с перегревом: 3 натриевых катализатора + 500 мБ углерода + 500 мБ воды → 500 мБ. Керосин, нафта — башня TFMG."
		"Расход на 1 массы: взлёт 30 × тяжесть старта, посадка 10 × тяжесть цели, перелёт 10 × а.е. Ракета массой 50: до Луны ~1600 ГДж, обратно ~750 — ~2,3 ведра углеводородов или ~9,3 биотоплива."
		"Топливо на рейс списывается при старте — на обратный путь вези в тех же баках. К планетам — следи за строкой Travel."
		"{\"text\":\"▶ Вики Northstar: топливо (англ.)\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/Astronauts-of-Create/Northstar-Redux/wiki/Fuel\"}}"
	]
	quest.1172882304DE25C3.title: "Ракетное топливо"
	quest.11807A46F6FD8F33.quest_desc: [
		"Защита полного комплекта (потолок — 30):"
		"&eмедь / цинк / латунь&r — &614 / 15 / 16&r"
		"&eжелезо&r — &615&r"
		"&eалмаз, незерит, эхо&r — &620&r"
		"&eмежпланетный сплав&r — &624&r, с бронепластиной &628&r"
		"Броня Cataclysm (рептилия, цветущий камень, игнитовая, проклятая) — с трофеев 70+, улучшения — крафтеры в ряд: шаблон | незеритовая вещь | слиток."
	]
	quest.11807A46F6FD8F33.title: "Справка: броня"
	quest.11AE4E7F06713FBD.quest_desc: [
		"&3Сделай:&r просеиватель — подхват металла и мелочи из гравия и песка."
		"&3Чем:&r миксер: андезитовый корпус + шестерня + камень + 2 доски + 2 палки; сетку — ПКМ, сыпь сверху, вращение сбоку."
		"Андезитовая сетка по гравию: железо и цинк по 10 %, медь 7,5 %, золото 5 %. Это подхват, не завод: металлы в ситах урезаны вчетверо."
	]
	quest.11AE4E7F06713FBD.title: "Просеиватель и сетки"
	quest.11B7267B7F280CBD.quest_desc: [
		"&3Сделай:&r добудь семена — купить их негде."
		"&3Где:&r кусты в траве: дикие томаты и капуста → семена, дикий лук → луковица, дикий рис (у воды) → рис. Там же морковь, картофель, свёкла."
		"&3Дальше:&r посадка."
	]
	quest.11B7267B7F280CBD.title: "Дикие грядки"
	quest.1244253591F26CD8.quest_desc: [
		"Заряд дают за первое прохождение 15-й волны — каждому защитнику. Ещё один — лавка фактории (40 жетонов)."
		"Деплоер заряд не тратит. Тратит рецепт посоха молнии — не собирай его из единственного заряда."
	]
	quest.1244253591F26CD8.title: "Нет заряда молнии"
	quest.12BE751E2935630C.quest_desc: [
		"Ночной дозор (волны 1–3): зомби, малыши, бегуны, пауки. Каменного меча и стены вокруг алтаря хватит."
		"&6Награда&r: добыча каждому, кто держал алтарь, и &6зонд жилы&r на команду (уголь или медь)."
		"Засчитывается всей команде при первом прохождении."
		"&7&o— Инструктаж: «Первая волна — ознакомительная. Умирать на ней можно, но стыдно».&r"
	]
	quest.12BE751E2935630C.title: "Волна 1: первая победа"
	quest.135091C07022C9A1.quest_desc: [
		"&3Сделай:&r биплан — самый быстрый путь в небо, без физики и расчёта тяги."
		"&3Чем:&r крафтеры: 3 корпуса, кварцевое стекло, двигатель, пропеллер. Двигатель — миксер: котёл, доменная печь, 3 булыжника, 2 поршня. Пропеллер — алюминиевый лист, вал, лист в ряд."
		"&3Где:&r алюминий — «Бокситовый карьер», стекло — «Кварцевый карьер»."
		"&3Дальше:&r роторная пушка, аэроклуб (влево)."
		"{@pagebreak}"
		"&eРоторная пушка&r — оружие к «Воздушному бою»: раздатчик, промышленные шестерни, медный слиток. В слот оружия (E в кресле)."
		"Поставить — ПКМ самолётом по земле; топливо печи — в котёл самолёта. Клавиши — Управление → Immersive Aircraft."
		"{\"text\": \"▶ Волна 24: Воздушный бой\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6A13AEBFD75DFA61\"}}"
	]
	quest.135091C07022C9A1.title: "Биплан: готовый самолёт"
	quest.135A722392CB4AA6.quest_desc: [
		"Малые набеги выключены (3.3.1): набег начинается только по вашему выбору — у алтаря или на арене."
		"Обычные ночные монстры в мире остались. Внутри зоны базы (разметчик) они сами не появляются."
		"Набег видно по полосе волны вверху экрана и подсвеченным мобам."
	]
	quest.135A722392CB4AA6.title: "Монстры у базы, хотя набег не начинали"
	quest.13720189D8B60053.quest_desc: [
		"&3Сделай:&r незеритовая броня — защита &e20&r, вязкость &e12&r, не горит в лаве."
		"&3Чем:&r крафтеры в ряд: шаблон незеритового улучшения | алмазная вещь | незеритовый слиток. Чары сохраняются."
		"&3Дальше:&r броня эха или из сплава."
		"&7&o— Техника безопасности: незерит не горит в лаве. Вы — горите.&r"
	]
	quest.13720189D8B60053.title: "Незеритовая броня"
	quest.1409D189B5A4B25E.quest_desc: [
		"&3Сделай:&r железная броня — зомби и скелеты бьют в разы слабее."
		"&3Чем:&r крафтеры, раскладка как на верстаке; комплект — 24 слитка, защита &e15&r."
		"Чары «Защита» — стол зачарований или Create Enchantment Industry."
		"&3Дальше:&r алмазная броня, модули."
		"{\"text\": \"▶ Этап 3: алтарь и первые волны\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2B5D5FE8FC36C5DE\"}}"
	]
	quest.1409D189B5A4B25E.title: "Железная броня"
	quest.144751B87537B6D6.quest_desc: [
		"Справка: в команде книга общая — квест одного засчитан всем."
		"&e/ftbteams party create НочнаяСмена&r, потом &e/ftbteams party invite <ник>&r — друг примет в чате."
	]
	quest.144751B87537B6D6.title: "Справка: одна команда"
	quest.14DAD84588460E70.quest_desc: [
		"&3К концу этапа:&r сборочный пост вместо верстака, доски с пилы, каменная кирка и свет на первую ночь."
		"&3Правило вахты:&r руками только ставить и собирать — крафтят машины Create."
		"• &eПост:&r 9 крафтеров стеной 3×3, стрелки ключом к одному выходу; вращение — рукоятка или водяное колесо из ящика."
		"• &eДоски:&r пила зубьями вверх, бросить бревно — 6 досок. Фильтр пилы — то, что хочешь получить."
		"• &eКирка:&r деревянная, потом каменная — на крафтерах."
		"• &eСвет:&r факелы — миксер: палка + уголь. В темноте тает рассудок."
		"{@pagebreak}"
		"{\"text\": \"▶ Сборочный пост\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7AA1D2EC840C70E1\"}}"
		"{\"text\": \"▶ Пила: доски и палки\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7B5A4EFA0A80ED25\"}}"
		"{\"text\": \"▶ Ночи здесь другие\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0503A513927D11DF\"}}"
		"&3Дальше:&r этап 2 — первый металл."
	]
	quest.14DAD84588460E70.title: "Этап 1 · Прибытие"
	quest.1531C3C2A9EA07F1.quest_desc: [
		"&3Что:&r неубиваемый Пожиратель; вся команда — к точке эвакуации в ~400 блоках за 4 минуты. Пешком не уйти."
		"&3Построй к ней:&r транспорт на каждого: самолёт, машина, поезд, лошадь. Направление — над хотбаром."
		"&3Ключ:&r значок беглеца — для лицензий пилота и машин. Повторы — 46, 62."
	]
	quest.1531C3C2A9EA07F1.title: "Волна 28 · Побег"
	quest.154AE1290036F9E0.quest_desc: [
		"&3К концу этапа:&r металл из породы, андезитовый сплав на потоке и стол трансмутации — магазин за EMC."
		"• &eЖелезо:&r жернов мелет булыжник в гравий, вентилятор сквозь воду промывает его на депо — 25 % самородка. Пресс над чашей: 9 самородков → слиток; над депо: слиток → лист."
		"• &eСплав:&r миксер над чашей — андезит + железный самородок."
		"• &eКорпус:&r окорённое бревно блоком, ПКМ сплавом."
		"• &eСтол трансмутации:&r миксер — 4 сплава, корпус, 2 редстоуна, 2 камня. Сдал лишнее — купил цинк, медь, уголь."
		"&3Миксер делает не то&r (печь вместо сплава)? Положи сплав в фильтр чаши."
		"{@pagebreak}"
		"{\"text\": \"▶ Первый металл: промывка\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6A850784B9615901\"}}"
		"{\"text\": \"▶ Андезитовый сплав\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"54231138C74C436B\"}}"
		"{\"text\": \"▶ Стол трансмутации\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1B532706F4DD6F3A\"}}"
		"&3Дальше:&r этап 3 — алтарь и первые волны."
	]
	quest.154AE1290036F9E0.title: "Этап 2 · Первый металл"
	quest.157DCCB30AA9320E.quest_desc: [
		"Крафтеры ставь по раскладке рецепта (JEI, вкладка «Форменное создание»), а не квадратом."
		"&eГенератор переменного тока&r — ромб 5×5, &613&r крафтеров"
		"&eДробильное колесо&r — 5×5, &621&r"
		"&eЭлектромотор&r — 5×4, &612&r"
		"В ящике 9. Ещё — электронная лампа, латунный корпус и мёртвый верстак столбиком → 3 крафтера."
	]
	quest.157DCCB30AA9320E.title: "Рецепт больше 3×3: сколько крафтеров"
	quest.160E154A7BFCDF86.quest_desc: [
		"&3Сделай:&r голые части — тело, руки, ноги."
		"&3Чем:&r пила; в её фильтр — часть, которую хочешь &eполучить&r (без фильтра пила перебирает всё по кругу)."
		"Разобрать голема на части нельзя — собирай сразу как надо."
		"&3Дальше:&r часть из металла."
	]
	quest.160E154A7BFCDF86.title: "Голые части: пила"
	quest.16428C3D5C32A327.quest_desc: [
		"Алтарь надо &dзарядить&r: заряд идёт, пока кто-то стоит в круге у алтаря (4 блока) и рядом с алтарём (8 блоков) нет мобов. 0,5 % в секунду — не меньше 3,5 минуты."
		"Орда идёт по кругу, новая подволна — раз в 45 с, даже если прошлая жива. 100 % — победа, остатки орды уходят."
		"Один держит центр, остальные чистят подходы. Повтор — 51 (заряд медленнее)."
		"Первое прохождение: &6две Настойки жизни&r и осколки орды."
	]
	quest.16428C3D5C32A327.title: "Волна 21: Ритуал"
	quest.16915B107FB94D45.quest_desc: [
		"Ручное оружие броню &cне берёт&r. Работают турели, пушки Create Big Cannons, тесла, големы, деплоеры и взрывы."
		"Повторы — 48 и 68."
		"Первое прохождение: &6Бронеплита ОТК&r."
	]
	quest.16915B107FB94D45.title: "Волна 26: Бронеколонна"
	quest.16E0397B5D28DDB0.quest_desc: [
		"&3Сделай:&r &664&r жетона — это зонд дорогой жилы или «Сердце ночи»."
		"&3Где:&r три фактории работают разом: держи склад под их заказы, и касса наполнится сама."
	]
	quest.16E0397B5D28DDB0.title: "Полная касса"
	quest.173248E40D04FCA5.quest_desc: [
		"&3Сделай:&r жезл команды — следовать, бродить у точки, стоять, патруль."
		"&3Чем:&r крафтеры по диагонали: золото, шаблон, палки; пустые клетки — с &eзаглушкой слота&r."
		"ПКМ по голему — режим, по мобу — атака; Shift+ПКМ — инвентарь голема. Жезл возвращения (жемчуг вместо золота) убирает големов, жезл призыва — выпускает."
	]
	quest.173248E40D04FCA5.title: "Жезл команды"
	quest.175B80529FFB40F7.quest_desc: [
		"&3Сделай:&r алхимический котёл — чернила и эликсиры жидкостью."
		"&3Чем:&r крафтеры по раскладке JEI; пепельная эссенция — вентилятор через огонь душ по эссенции."
		"Котёл «кипит», когда в нём жидкость. Лишний свиток в воде — 50 % чернил его редкости."
	]
	quest.175B80529FFB40F7.title: "Алхимический котёл"
	quest.17A40DFC177EEC99.quest_desc: [
		"&3Сделай:&r небесный кристалл без острова."
		"&3Чем:&r пресс над бассейном: 4 звёздных осколка → кристалл."
	]
	quest.17A40DFC177EEC99.title: "Кристалл из осколков"
	quest.17C3D0CDD3773E4F.quest_desc: [
		"&3Сделай:&r шлем-излучатель — лазер из головы."
		"&3Чем:&r крафтеры, рецепт — R в JEI (конденсатор древнего стража — охота на стражей)."
		"Клавиша &eR&r — луч: 8 урона (+4 магией) на 15 блоков; тратит прочность шлема."
	]
	quest.17C3D0CDD3773E4F.title: "Шлем-излучатель"
	quest.1861EF00B945866F.quest_desc: [
		"&3Сделай:&r латунный загрузчик — больше чанков, и на ходу."
		"&3Чем:&r крафтеры 5×5 (рецепт — R), гаст — так же. Радиус 1×1 / 3×3 / 5×5 — выше обороты. На поезде держит 3×3 без вращения."
		"&7&oГаст в коробке держит чанк. Гаст не рад.&r"
	]
	quest.1861EF00B945866F.title: "Латунный загрузчик чанков"
	quest.187D3DAA1A99B484.quest_desc: [
		"&3К концу этапа:&r база держит особые стадии: тесла-башни на сети с запасом, прожекторы на подходах, турели."
		"• &eТесла-башня&r — к 22-й «Механоидам»: орду бьёт только ток. Ставь выше стен; секции сверху — дальше и больнее."
		"• &eАккумулятор&r — 2 млн FE на блок: башня в бою ест 125–225 FE/т."
		"• &eЛазерная турель&r и пушки — к 26-й «Бронеколонне»: ручное оружие её не берёт."
		"• &eПрожектор&r — к 34-й «Невидимкам»: орду видно только в луче."
		"• &eМагия&r — к 32-й «Духам»: посохи, заклинания, зелья вреда."
		"{@pagebreak}"
		"{\"text\": \"▶ Тесла-башня\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5B0D0D05577E8BCF\"}}"
		"{\"text\": \"▶ Лазерная турель\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"65EBFC16CC926C3D\"}}"
		"{\"text\": \"▶ Прожектор\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1FD83CEEED53B59F\"}}"
		"{\"text\": \"▶ Магия на вахте\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"26D4945737F6CCB3\"}}"
		"&3Дальше:&r этап 10 — небо."
	]
	quest.187D3DAA1A99B484.title: "Этап 9 · Оборона на токе"
	quest.18984F35EFC9F4EC.quest_desc: [
		"&3Сделай:&r запас электромеди — она нужна всем генераторам."
		"&3Сколько:&r генератор переменного тока — 4, катушка динамо — 8, генератор TFMG — 3; ещё тесла-башня, станции, котельная, ТЭН."
		"Не покупается за EMC — только деплоер с зарядом."
		"&3Дальше:&r прокатный стан и генератор."
	]
	quest.18984F35EFC9F4EC.title: "Электрическая медь"
	quest.190E507AE2C83EB5.quest_desc: [
		"&3Сделай:&r колёсное крепление: машина возит груз и людей без рельсов."
		"&3Чем:&r крафтеры столбиком: андезитовый корпус, пружина, железный лист. Пружина: лист, самородок, лист → 2."
		"Сигнал сверху — тормоз, сбоку — поворот. Подвеска — в панели параметров."
		"&3Дальше:&r шины."
	]
	quest.190E507AE2C83EB5.title: "Колёсное крепление"
	quest.192A9E87FB0BF09E.quest_desc: [
		"&3Сделай:&r большие шестерни — менять скорость без коробок."
		"Большая → маленькая по диагонали: ×2, обратно ÷2. Две большие под прямым углом уводят вращение на другую ось. Машина ест SU пропорционально скорости."
		"&3Чем:&r миксер: вал + 2 доски."
	]
	quest.192A9E87FB0BF09E.title: "Большая шестерня"
	quest.19D4BB73C55E6276.quest_desc: [
		"&3Сделай:&r открой атлас (ПКМ): ближайшее месторождение каждого вида — координаты, расстояние, сторона света, «✔ форпост», если сеть уже там."
		"&3Чем:&r клик по координатам — метка на карте Xaero. Встал на новое месторождение — атлас записал его сам и сказал всем."
		"&3Где взять:&r первый — подарок геологоразведки при входе; ещё — деплоер кладёт компас на книгу. Команда &e/atlas&r — без предмета."
	]
	quest.19D4BB73C55E6276.title: "Атлас месторождений"
	quest.1A33CB476C1A29D4.quest_desc: [
		"&3Сделай:&r Пилот III — открывает грузовой дирижабль, экономичный самолёт, Форсаж I, бронекорпус, экономайзер, аэрофотоаппарат."
		"&3Чем:&r налёт, крафт не нужен: 3 км в кресле пилота, высота 120+, 3 посадки (5+ с полёта и касание земли)."
		"Прогресс — &e/aeroclub&r. В рецептах удостоверение стоит в деплоере и не тратится."
		"&3Дальше:&r Форсаж I, Пилот II."
	]
	quest.1A33CB476C1A29D4.title: "Аэроклуб: Пилот III"
	quest.1A3B36E257B08F8E.quest_desc: [
		"&3Сделай:&r магнитную блокопушку — таскать блоки, с чарами «Гравитационная пушка» — и мобов."
		"&3Чем:&r крафтеры: медь, 2 шестерни, гидравлический двигатель, медный магнит (8 меди вокруг незеритового слитка). Ест воду."
	]
	quest.1A3B36E257B08F8E.title: "Магнитная блокопушка"
	quest.1A6D438D9F2B62A4.quest_desc: [
		"&3Почему не выходит:&r кузнечного стола на вахте нет."
		"&3Что делать:&r три механических крафтера в ряд: &eшаблон | броня | материал&r — слиток или камень задаёт цвет узора. Зеркальный ряд тоже работает."
	]
	quest.1A6D438D9F2B62A4.title: "Отделка (узор) на броню"
	quest.1A83B1A3BC0266B4.quest_desc: [
		"&3Сделай:&r побей рекорд любой трассы. Первый заезд на новой трассе — эталон, он не в счёт."
		"&3Награда:&r 1–6 жетонов смены по длине трассы — если рекорд лучше прежнего на 2 % и хотя бы на 0,5 с. Трасса от 3 колец и 300 блоков; до 10 жетонов в день, до 3 оплаченных рекордов на трассу."
		"Рекорды — на табло над стартом и в журнале смены (&e/journal&r)."
		"&7&o— ОТК: «Срезать мимо кольца — не рекорд, а экскурсия».&r"
	]
	quest.1A83B1A3BC0266B4.title: "Рекорд трассы"
	quest.1AD77E9FFCC09760.quest_desc: [
		"&3Сделай:&r землю и ил без лопаты."
		"&3Чем:&r миксер: песок + гравий + 900 мБ воды → земля; земля + 250 мБ воды → ил → прессованный ил (+ пшеница) → кирпичи."
	]
	quest.1AD77E9FFCC09760.title: "Земля и ил"
	quest.1B3BC032BE51D42E.quest_desc: [
		"&3Сделай:&r сфера улучшения — постоянный бонус к броне или книге."
		"&3Чем:&r пустая сфера — крафтеры: мифрил, 4 волшебных слитка, 4 пепельные эссенции. Сфера школы — пустая + 8 рун школы. Ставится на наковальне."
		"&7&oТри сферы на нагруднике — и ты уже не вахтовик, а архимаг на окладе.&r"
	]
	quest.1B3BC032BE51D42E.title: "Сфера улучшения"
	quest.1B532706F4DD6F3A.quest_desc: [
		"&3Сделай:&r стол трансмутации — EMC-магазин: сдал лишнее, купил нужное."
		"&3Чем:&r миксер: 4 сплава + андезитовый корпус + 2 редстоуна + 2 камня."
		"Цинк и медь — &6512&r EMC, железо — &61 024&r. &cНельзя:&r руду, технику Create, сплавы, латунь, дроблёную руду."
		"&3Дальше:&r медь и цинк."
		"{\"text\": \"▶ Лимиты стола и выкуп\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"62D949F92F5E380D\"}}"
	]
	quest.1B532706F4DD6F3A.title: "Стол трансмутации"
	quest.1B6D166467CBC5C1.quest_desc: [
		"Задача-предмет видит только &eинвентарь&r: поставленную машину сними ключом (Shift+ПКМ) и поставь обратно, предмет из сундука возьми в руки."
		"Квест ждёт свои зависимости (линии к нему): пока не готов предыдущий, этот не закроется, хотя задачи уже набраны."
		"Книга общая на команду (/ftbteams): что сделал один, засчитано всем."
	]
	quest.1B6D166467CBC5C1.title: "Квест не засчитывается"
	quest.1C0B7950C978D6EB.quest_desc: [
		"&3Сделай:&r целебные споры — без них нет успокоительного (рассудок) и настойки жизни (раны)."
		"&3Где:&r грибные поля на поверхности и пышные пещеры (на полу): светящаяся синяя грибница."
		"&3Чем:&r экструдер на грибницу, сбоку вода и блок мха → светогриб → жернов: 3 споры (+25 % светокаменной пыли)."
		"&3Дальше:&r успокоительное."
	]
	quest.1C0B7950C978D6EB.title: "Грибные пещеры"
	quest.1C38E72D15B444D8.quest_desc: [
		"&3Сделай:&r слиток метеоритного железа (~0,75 с куска сырья)."
		"&3Чем:&r миксер с нагревом: 2 дроблёного + 100 мБ лавы → 1. Лава — тот же миксер над горелкой из булыжника."
		"{\"text\": \"▶ Форсаж II\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5595A4942C76A170\"}}"
		"&7&o— ОТК: «Слиток из космоса проверен. Космос претензий не имеет».&r"
	]
	quest.1C38E72D15B444D8.title: "Слиток метеоритного железа"
	quest.1C53FB94F3D33399.quest_desc: [
		"&3Сделай:&r клетку — мясо без стада."
		"&3Чем:&r семплер ДНК — ПКМ по корове, затем по клетке блок травы и семплер. Корова раз в ~минуту: говядина 50 %, кожа 40 %. Пустые клетки рецептов — заглушки слота."
		"&3Дальше:&r бургер."
		"&7&o— Юротдел: корова в клетке виртуальная. Стейк настоящий.&r"
	]
	quest.1C53FB94F3D33399.title: "Мясо из клетки"
	quest.1CA73A2F9FA9AB14.quest_desc: [
		"&3Сделай:&r шаблон — один на каждую часть голема."
		"&3Чем:&r крафтеры 3×3: медь в центре, палки крестом, глина по углам."
		"Металлическому — 4 шаблона, человекоподобному — 3, псу — 2."
		"&3Дальше:&r части на пиле."
	]
	quest.1CA73A2F9FA9AB14.title: "Шаблон голема"
	quest.1CDF7057BD782920.quest_desc: [
		"Голем — охранник без сна и еды, бьёт всех врагов, кроме криперов."
		"&eМеталлический&r — танк, &eчеловекоподобный&r — с оружием и бронёй, &eпёс&r — быстрый, ездовой."
		"Путь: шаблон → пила → сборка по шагам → крафтеры."
		"&7&o— Отдел кадров: идеальный сотрудник. Жаль, в ведомости он числится как «инвентарь».&r"
	]
	quest.1CDF7057BD782920.title: "Цех големов"
	quest.1D77D26E368A22F5.quest_desc: [
		"Тепло — в секунду."
		"&eТеплообменник&r — уголь 200, торт 400; &eТЭН&r — до 600 (3 FE/т за единицу)"
		"&eНагреватель&r: 100 — нагрев, 400 — котлу 2 уровня, 500 — суперогонь (3 уровня)"
		"&eВентиль&r — обычный 200, суперогонь 550 на нагреватель"
		"&eТруба&r теряет 1/с и несёт ~&620 000 / длина&r: 10 блоков — 1 800, 20 — 1 000, 30 — 700. Больше — 2–3 трубы рядом."
		"Теплообменник и ТЭН греют сеть не выше 8 000 — до лавы (10 000) не дойдёт."
	]
	quest.1D77D26E368A22F5.title: "Справка: котельная в цифрах"
	quest.1D91A098B3B8E6DD.quest_desc: [
		"&3Сделай:&r поезд по расписанию — заказы едут сами, пока ты воюешь с ордой."
		"&3Где:&r у фактории уже лежит путь вдоль перрона: подведи свою линию и поставь станцию. Интерфейс хранения на вагоне и второй на кромке напротив; между кромкой и терминалом 2 блока — под воронку и ленту в терминал."
		"&3Чем:&r расписание «завод → фактория», на станциях ждать, пока груз не перестанет двигаться. Лишнее уедет обратно."
		"Чанки фактории без тебя спят — латунный загрузчик на поезде держит 3×3."
		"{\"text\": \"▶ Латунный загрузчик чанков\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1861EF00B945866F\"}}"
	]
	quest.1D91A098B3B8E6DD.title: "Поезд до фактории"
	quest.1D9CA855CB4EFF83.quest_desc: [
		"Падает днём раз в 2–3 игровых дня в 400–900 блоках от алтаря базы; после победы в набеге иногда ещё один утром."
		"Столб света виден издалека, метка для карты приходит в чат ([Add]), подсказка над хотбаром со стрелкой ведёт к кратеру."
	]
	quest.1D9CA855CB4EFF83.title: "Где упал метеорит"
	quest.1DB8105E4DA61380.quest_desc: [
		"&3Сделай:&r автоматический выстрел, как только пушка навелась."
		"&3Чем:&r Fire Controller (редстоун, 2 компаратора, механизм точности, латунный корпус) — сигналом в грань выстрела крепления, связь тем же передатчиком. Подачу патронов продумай заранее."
		"&3Дальше:&r крепость."
	]
	quest.1DB8105E4DA61380.title: "Разрешение на выстрел"
	quest.1DC2DCB789843948.quest_desc: [
		"&3Сделай:&r сеть форпостов: соль, магнетит, сера, кварц, алюминий, гелий, хладагент, фильтры, споры и звёздные карты есть только в своём биоме."
		"&3Чем:&r механический экструдер на месторождении, по бокам — два блока из рецепта (вода, лава, блок железа, жидкая сера, воздух). Дальше 1–2 машины."
		"&3Где:&r светящееся пятно 5–10 блоков, над ним дымок или искры, только в новых чанках. Ближайшие известные — &eатлас месторождений&r (ПКМ), сеть форпостов — &e/outposts&r."
		"{@pagebreak}"
		"Месторождение не ломается и не двигается. Продукт — в ящик у станции, поезд возит на базу. За EMC продукция форпостов не торгуется."
		"&3Дальше:&r Солеварня и Магнитная аномалия — для тока, Серный источник — для патронов."
		"{\"text\": \"▶ Карта замков: что без какого форпоста не собрать\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7029C1577D3B1501\"}}"
		"{\"text\": \"▶ Этап 8 · Форпосты\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"217DBD70A3581A76\"}}"
	]
	quest.1DC2DCB789843948.title: "Форпосты: как это работает"
	quest.1DC6DE2B5041E481.quest_desc: [
		"Режимы — кнопками в окне или Shift+ПКМ пультом:"
		"&eСбор добычи&r — предметы в &612&r блоках вокруг тебя; полный трюм — сам на склад"
		"&eСвет&r — висит над головой, свет &615&r"
		"&eРазведка&r — руда в &620&r блоках и месторождения форпостов в &664&r — сквозь стены на &615 с&r, находки — в атлас"
		"&eДоставка&r — трюм на склад, образцы «привезти» — со склада, кнопка «Рейс»"
		"&eДомой&r — в гнездо, на зарядку"
		"{@pagebreak}"
		"&eБатарея&r — &6200 000 FE&r, с улучшениями до &6800 000&r"
		"&eПолёт&r — &66–14 FE/т&r, разведка &61 500 FE&r за импульс"
		"&eРейс&r — &61 000 FE + 15 FE/блок&r в каждую сторону, &620 бл/с&r"
		"&eГнездо&r — &62 000 FE/т&r в дрона, запас &6200 000 FE&r"
		"Дронов на игрока — до &63&r. Мобы их не трогают, урон не проходит. Список и вызов — &e/axdrone&r."
	]
	quest.1DC6DE2B5041E481.title: "Справка: режимы дрона"
	quest.1DD412AA9B181472.quest_desc: [
		"Режимы и очки тира."
		"&eНа время&r — 60 с, три мишени, каждая живёт 5 с; &6золотая&r — очки ×3, живёт 2,5 с"
		"&eТарелки&r — 60 с, летят поперёк коридора, очки ×2; &cдинамит&r — −3"
		"&eСпринт&r — 10 мишеней по одной, на время (до 2 мин)"
		"&eОчки&r — 1 + 1 за каждые 25 блоков от рубежа"
		"&eКлассы&r — огнестрел, лук и арбалет, магия и посохи, прочее (вперемешку — прочее)"
		"&eОдна дорожка&r — пока стреляет один, попадания других не считаются"
	]
	quest.1DD412AA9B181472.title: "Справка: тир"
	quest.1DE1569914F57358.quest_desc: [
		"&eРана&r — минус 1 сердце за смерть (до −5); своя техника и союзники — без раны. Лечат &eнастойка жизни&r (миксер со спорами или лавка фактории) и каждая победа в набеге."
		"&eПроклятие&r — за провал набега, всей команде (1, 2 или 3 сердца по номеру волны; на арене 1). Алтарь не запирает: победа на волне не ниже «лучшая − 5» снимает сердце, стопка ресурса ПКМ по алтарю — сразу."
		"Вместе не опустят ниже 3 сердец. &eСердце ночи&r — +1 навсегда (до +5): из набегов или из звёздных осколков (глава «Небо»)."
	]
	quest.1DE1569914F57358.title: "Стало меньше сердец"
	quest.1DF089F6B46653BC.quest_desc: [
		"&3Сделай:&r сменный бур — наконечник буровой (не путать с механическим буром Create)."
		"&3Чем:&r 2 железных блока + 5 слитков. Буры: железный → алмазный → незеритовый; жилы незерита и закалённого алмаза берёт только незеритовый и с лавой."
		"&7&oОтдел закупок: «Бур — расходник. Как и оптимизм».&r"
	]
	quest.1DF089F6B46653BC.title: "Сменный бур"
	quest.1E12E32E31299787.quest_desc: [
		"&3Сделай:&r ранец Mk2: &61,6 млн FE&r, передача 120 + 1 FE за блок, база — 192 блока, связь из других измерений."
		"&3Чем:&r сборка по шагам на Mk1: метеоритное железо → линза → метеоритное железо → радиатор → энергоячейка → пресс."
		"&3Дальше:&r межпространственный ретранслятор — склад из Незера и с планет."
	]
	quest.1E12E32E31299787.title: "Ранец снабжения Mk2"
	quest.1E4435CC30E236DE.quest_desc: [
		"&3Сделай:&r засей полосу — урожай отдаёт семена."
		"&3Где:&r на пашню у воды; рис — в воду глубиной 1 блок. ПКМ по спелому — собрать и пересадить."
		"&3Дальше:&r богатая почва."
	]
	quest.1E4435CC30E236DE.title: "Посадка"
	quest.1E4BD02D9BF9BE76.quest_desc: [
		"&3Сделай:&r котёл 18 без угля: 1 стержень = &6600&r тепла/с = нагреватель на 3 уровня; 6 стержней — &6294 912 SU&r."
		"&3Чем:&r корпус — линия из кирпичей: электризатор 500 FE → деплоер с железным листом → пресс → 4. Стержень — крафтеры: 4 корпуса, 4 золотых листа, 2 радиатора (форпост «Ледник»), 4 реакторных стекла, 2 топлива → 2."
		"{@pagebreak}"
		"&3Сборка:&r стержни в ряд → загрузчик топлива вплотную (делит топливо, до 32 в сторону) → теплоотводы вплотную → трубы → нагреватели под котлом."
		"&cОпасно:&r стержень с теплом больше 16 000 взрывается, сломанный заряженный — тоже; рядом радиация. Отводи тепло с запасом."
		"&7&oПресс-служба: «Небольшой хлопок на объекте. Объекта нет — проблемы нет».&r"
	]
	quest.1E4BD02D9BF9BE76.title: "Ядерный реактор"
	quest.1E4D226185FC212A.quest_desc: [
		"&3Сделай:&r томатный соус — кухня на машинах."
		"&3Чем:&r миксер: 2 томата + миска → соус. Кастрюля на автомате (Central Kitchen): горелка снизу, механическая рука кладёт продукты, воронка забирает готовое."
		"&3Дальше:&r бургер."
	]
	quest.1E4D226185FC212A.title: "Кухня без рук"
	quest.1E68FEAD8DD9CB10.quest_desc: [
		"&3Сделай:&r заглушки слота — для диагональных рецептов: ножницы, удочка, жезлы."
		"&3Чем:&r пресс по железной решётке (или 3 латунных самородка)."
		"Пустую клетку рецепта займи крафтером с заглушкой (ПКМ): группа держится стенка к стенке, клетка считается пустой."
	]
	quest.1E68FEAD8DD9CB10.title: "Заглушка слота"
	quest.1EEFAB07D0D8A70B.quest_desc: [
		"&3Сделай:&r форму и отлей части пушки."
		"&3Чем:&r формы режет пила с фильтром из окорённой древесины. Песок для отливки (миксер: 2 песка, земля, глина) — ПКМ по форме, расплав — трубой."
		"Металла (90 мБ = слиток): дуло &6630 мБ&r, ствол &61 080&r, казённик и конец — по &6810&r. Застывает от 2 минут; формы столбиком — отливка цельная."
		"&3Дальше:&r сверление."
	]
	quest.1EEFAB07D0D8A70B.title: "Формы и отливка"
	quest.1F2A1A9AED2364A7.quest_desc: [
		"&3Сделай:&r вращение там, где нет вала: мотор ест ток и крутит вал без потерь — на 256 об/мин &616 384 SU&r за &6480 FE/т&r."
		"&3Чем:&r электромотор — механические крафтеры 5×4 (12 штук): блок магнетита, латунные листы, медные катушки, железный стержень, конденсатор (R)."
		"Проще — обыкновенный электромотор New Age (миксер: 6 железных самородков, андезитовый корпус, вал, блок магнетита): &6512 SU&r за &615 FE/т&r, до 128 об/мин."
		"{@pagebreak}"
		"Курс у всех один: &61 FE/т ≈ 34 SU&r. Усиленный New Age — 2 048 SU за 60 FE/т, укреплённый — 8 192 за 240 (до 256 об/мин). Обороты — прокруткой на моторе; мотор New Age выключается редстоуном."
		"&3Дальше:&r энергофорпост — шаг 7."
		"&7&oГенератор → мотор → генератор — не вечный двигатель, а обогреватель за счёт компании.&r"
	]
	quest.1F2A1A9AED2364A7.title: "Шаг 6 · Электромотор: ток во вращение"
	quest.1F3E4DFE744C723D.quest_desc: [
		"&3Сделай:&r найти &eрудную жилу&r — огромный запас под землёй, который буровая качает без шахты."
		"&3Чем:&r детектор (рецепт R): ПКМ по земле — подскажет, есть ли жила рядом."
		"&3Дальше:&r пробоотборник."
	]
	quest.1F3E4DFE744C723D.title: "Детектор рудных жил"
	quest.1F7106947E9DF5CB.quest_desc: [
		"&3Сделай:&r успей к метеориту, пока не остыл (20 минут; во время набега — пауза), и забери железо."
		"&3Где:&r раз в 2–3 игровых дня, днём, в 400–900 блоках от алтаря. В чате — направление, координаты и метка Xaero; столб дыма виден до 512 блоков."
		"Ближе 72 блоков встаёт стража (мобы ваших набегов и светящийся Страж). Пока она жива, руда под щитом."
		"Долю — 2–3 железа с блока — получает каждый в 32 блоках от кратера. Летите вместе."
	]
	quest.1F7106947E9DF5CB.title: "Метеорит"
	quest.1F93228FE232CC76.quest_desc: [
		"&3Сделай:&r вольфрам — межпланетное точило, маяк, обшивка +20."
		"&3Где:&r только Меркурий: руда или сырой (кирка, буровая установка)."
		"&3Чем:&r дробилка → дроблёный вольфрам → вентилятор над лавой или огнём → слиток (промывка — 9 самородков + 75 % кварца). Руда с шёлковым касанием выгоднее: 2 + 50 % против 1 + 50 %."
	]
	quest.1F93228FE232CC76.title: "Вольфрам с Меркурия"
	quest.1FD83CEEED53B59F.quest_desc: [
		"&3Сделай:&r прожектор — в луче невидимки видны и светятся ещё 5 с, фантомы отлетают, на земле светло."
		"&3Чем:&r луч 32 блока туда, куда смотришь при установке; ключ по боку — наклон, по верху — поворот. Ток &6150 FE/т&r; без тока или по редстоуну гаснет."
		"Крафтеры: стекло, лампа, латунные листы, электронные лампы, электрическая медь (после 15-й волны)."
		"{\"text\": \"▶ Волна 34 · Невидимки\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"48107DA2A3932792\"}}"
	]
	quest.1FD83CEEED53B59F.title: "Прожектор: видеть невидимок"
	quest.1FEE1D4A77C9DAFE.quest_desc: [
		"&3Сделай:&r посох молнии — молния до 48 блоков: 14 урона магией в радиусе 2,5, поджог. Своих не бьёт."
		"&3Чем:&r крафтеры: «электрическая медь | заряд молнии | электрическая медь», «эссенция | медный стержень | эссенция», медный стержень внизу."
		"&cЗаряд молнии съедается!&r Он нужен деплоеру для электрической меди — не трать последний. Второй — лавка фактории: 40 жетонов, с 15-й волны, 1 за сезон."
		"&3Дальше:&r посох сплава."
	]
	quest.1FEE1D4A77C9DAFE.title: "Посох молнии"
	quest.200EF6B4A3B73B4B.quest_desc: [
		"&3Сделай:&r ракетный ускоритель (Rocket Thruster) — в самый низ корпуса."
		"&3Чем:&r камера сгорания (миксер или крафтеры): 4 титановые пластины, пропеллер, закалённый механизм, отделитель кислорода. Ускоритель: 6 титановых пластин, пропеллер, камера. Отделитель: 3 железные пластины, лампа, 3 жидкостные трубы → 2."
		"Сколько: тяжесть × масса / 500 (бо́льшая тяжесть из двух планет); с Земли — 1 на ~50 массы. Блок = 1, железный блок и вольфрамовые листы и обшивка = 5, вольфрамовый и золотой блок = 10; топливо и груз не весят."
		"&7&oЕсли ракета не взлетела — это не провал, это очень короткий полёт.&r"
	]
	quest.200EF6B4A3B73B4B.title: "Ракетный ускоритель"
	quest.2022B22D15FA1B25.quest_desc: [
		"&3Сделай:&r теплозащиту: мало — старт запрещён (строка Heat Shielding красная)."
		"Норма — бо́льшая из старта и цели. Земля: 100 + 0,4 за каждый блок ракеты. Нормы планет — в справках."
		"Защита за блок: &6+3&r — промышленное железо, титановые обшивка, листы, колонна, железный блок (весит ×5); &6+8&r — то же из марсианской стали; &6+20&r — вольфрам (тяжёлый)."
		"Пример: 55 блоков, из них 48 промышленного железа — норма 122, защита 144, летит. Промышленное железо — пила: слиток → 2 блока. Всё — JEI, категория Heat Shielding."
	]
	quest.2022B22D15FA1B25.title: "Корпус и теплозащита"
	quest.205D19F566F48380.quest_desc: [
		"Мобы набега светятся; застрявших подсвечивает через 20 с, а через 45 с возвращает к выходу. Пауки бывают на крыше, летуны — в небе."
		"Фантомы и вексы кружат над алтарём: провалом не считаются, но волна не кончится, пока живы."
		"У метеорита стражи тоже светятся, застрявших поднимает на поверхность."
	]
	quest.205D19F566F48380.title: "Волна идёт, а монстров не видно"
	quest.206F6135673F26E9.quest_desc: [
		"&3Сделай:&r скафандр — все 4 части, иначе в вакууме минус сердце в секунду."
		"&3Чем:&r миксер или крафтеры: железные доспехи + железные пластины + прочная ткань (4 нитки + 2 шерсти); шлему — тонированное стекло, нагруднику — медный баллон. Шлем и нагрудник — с фильтром воздуха (форпост «Торфяник»), рецепты — R."
		"Баллон — 1800 мБ, 1 мБ/с: полчаса. Холод железный держит; жару выше 300 °C (Венера, день на Меркурии) — только скафандр из марсианской стали."
		"&7&o— Отдел кадров: скафандр — не дресс-код, а условие выживания. Хотя и дресс-код тоже.&r"
	]
	quest.206F6135673F26E9.title: "Скафандр: все 4 части"
	quest.20DE064F242F4E1A.quest_desc: [
		"&3Сделай:&r просверли ствол и дуло — отлитые, они сплошные."
		"&3Чем:&r пушечная дрель (миксер: железный слиток, андезитовый корпус, 2 трубы, шток поршня), в бак — вода. Заготовку крутит механический подшипник, дрель — не медленнее (8 SU на 1 об/мин). Конец пушки отливается готовым."
		"Сварной шов отнимает у чугуна 1 заряд — лей пушку цельной."
		"&3Дальше:&r казённик и затвор."
	]
	quest.20DE064F242F4E1A.title: "Сверление"
	quest.20E4E214449B4273.quest_desc: [
		"Нашествие (8–13): зомби в кольчуге с мечами, ведьмы, поборники, разбойники, утопленники с трезубцами. Вожак орды — 140 HP, алмазный меч."
		"Ведьм и поборников снимайте первыми. Провал с 8-й волны стоит &c3 сердца&r."
		"&7&oВедьма в орде — как бухгалтер на стройке: сама не бьёт, но всем от неё хуже.&r"
	]
	quest.20E4E214449B4273.title: "Волна 10: Нашествие"
	quest.21172F3016C5CB6F.quest_desc: [
		"&3Сделай:&r держи еду в запасе: при &64&r окорочках и меньше рассудок тает (&60,2/с&r), сытный обед лечит голову."
		"&3Чем:&r руками не крафтят, но печь, коптильня и костёр еду жарят."
		"&3Дальше:&r грядка (верх), кухня (середина), еда без рук (низ) → бургер."
		"&7&o— Столовая: «Обед строго по расписанию. Расписание — когда орда ушла».&r"
	]
	quest.21172F3016C5CB6F.title: "Столовая открыта"
	quest.217DBD70A3581A76.quest_desc: [
		"&3К концу этапа:&r на месторождениях работают экструдеры: соль, магнетит, сера, латекс. Без них нет конденсаторов, магнитов, патронов и резины."
		"&3Как:&r месторождение — светящееся пятно 5–10 блоков в своём биоме, только в новых, ещё не открытых землях. На него экструдер, по бокам два блока из рецепта (R по продукту). Рядом загрузчик чанков — иначе форпост спит без тебя. Сеть — &e/outposts&r."
		"• &eЗагрузчик чанков:&r пустой (крафтеры, якорь возрождения) → ПКМ по живому гасту в Незере."
		"• &eСолеварня&r (пляж) → электролит → &eконденсатор&r."
		"• &eМагнитная аномалия&r (горы от 120) → магнетит → &eредстоун-магнит&r."
		"• &eСерный источник&r (бесплодные земли, пещеры ниже −12) → &eоружейный порох&r: все патроны и заряды."
		"• &eКаучуковая плантация&r (джунгли, красная почва) → латекс + сера → &eрезина&r."
		"{@pagebreak}"
		"&3Волны:&r 38 «Осада форпоста» — орда идёт на форпост: укрепи их заранее."
		"{\"text\": \"▶ Зачем форпосты и как их связать\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1DC2DCB789843948\"}}"
		"{\"text\": \"▶ Форпосты в цифрах\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"09AAC059978BF8D7\"}}"
		"{\"text\": \"▶ Карта замков\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7029C1577D3B1501\"}}"
		"&3Дальше:&r этап 9 — оборона на токе."
	]
	quest.217DBD70A3581A76.title: "Этап 8 · Форпосты"
	quest.218DDF47E1508988.quest_desc: [
		"&3Сделай:&r станцию — здесь поезд собирают и разбирают."
		"&3Чем:&r миксер: железнодорожный корпус + компас → 2; компас — 4 железа + редстоун (миксер). Ставь вплотную к рельсам."
	]
	quest.218DDF47E1508988.title: "Железнодорожная станция"
	quest.21DC2FC0ABF8CFF7.quest_desc: [
		"&3Сделай:&r энергопушку — курсовое оружие самолёта на токе. Урон током: берёт «Механоидов», а ульи «Воздушного боя» его принимают."
		"&3Чем:&r сборка по шагам: роторная пушка → конденсатор → электромедь → медная катушка C\\&A → электромедь → электронная лампа → пресс → Пилот III (не тратится)."
		"В ячейку оружия; энергоячейки — в багажник самолёта. ПКМ пустой рукой в полёте — огонь."
		"{@pagebreak}"
		"&eЗаряд&r — &65&r урона, &65&r выстрелов/с на ствол; у биплана &62&r ствола на крыльях"
		"&eНагрев&r — &628&r выстрелов очередью, потом ~&63 с&r перегрева"
		"&eТок&r — &61 500 FE&r за выстрел; ячейка — ~&61 300&r выстрелов"
		"Мимо неуязвимости после удара: частый огонь бьёт и тех, кто режет сильные удары. Свой самолёт и дронов не задевает."
		"{\"text\": \"▶ Волна 24: Воздушный бой\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6A13AEBFD75DFA61\"}}"
		"&7&o— ОТК: «Ствол греется — это не брак, это характер».&r"
	]
	quest.21DC2FC0ABF8CFF7.title: "Энергопушка"
	quest.22689166CC61803D.quest_desc: [
		"&3Сделай:&r чугун — самый дешёвый металл для пушки (держит 2 заряда)."
		"&3Чем:&r пресс над нагретой чашей: железный слиток + уголь → чугун. Плавка: крышка для плавки (4 андезитовых сплава) на чашу с горелкой — слиток 90 мБ за 9 с."
		"&3Дальше:&r формы и отливка."
	]
	quest.22689166CC61803D.title: "Чугун и плавка"
	quest.2296AD0A128BC153.quest_desc: [
		"&3Что:&r подволны против щита и боссы ArPhEx — мечом уже не удержать."
		"&3Построй к ней:&r промышленную оборону: турели, пушки с радаром, големы, энергощит."
		"&3Награда:&r ядро навигации каждому — контроллер ракеты (этап 12) — и Сердце ночи."
		"{\"text\": \"▶ Подробно: волна 50\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5A4B58E3D3636EAA\"}}"
	]
	quest.2296AD0A128BC153.title: "Волна 50 · Ядро навигации"
	quest.2314D43D50466F2B.quest_desc: [
		"&3Сделай:&r одень часть в металл — он задаёт силу голема."
		"&3Чем:&r сборка по шагам: деплоер со слитком → пресс, круг за кругом. Кругов: металлический 9, человекоподобный 6, пёс 6 + 3. Точный круг — R по части."
		"&3Дальше:&r голем в сборе."
	]
	quest.2314D43D50466F2B.title: "Часть из металла"
	quest.2318D7EFDBE50618.quest_desc: [
		"&3Сделай:&r баллоны гелия — оболочки аэростатов, левитит, дирижабль Immersive Aircraft."
		"&3Где:&r горы от высоты 180: голубой лёд на вершине в облачках."
		"&3Чем:&r экструдер, по бокам пусто → иней → миксер с нагревом: 250 мБ гелия → дозатор в железный лист → баллон. Деплоер с баллоном над шерстью → 4 оболочки."
		"&7&o— Техника безопасности: гелий не вдыхать. Голос станет смешным, а приказы бригадира — нет.&r"
	]
	quest.2318D7EFDBE50618.title: "Высотный конденсатор"
	quest.23487472DFC8E464.quest_desc: [
		"&3Сделай:&r найди небесный остров и добудь первый кристалл."
		"&3Где:&r выше облаков (низ ~190–215), один на 600–1000 блоков — над равнинами, лесами, пустынями и морем, не над горами. Компас исследователя ищет «sky_island»."
		"Виды: руины станции (сундуки и турель-шалкер с левитацией), разбитый дирижабль (детали самолётов), гнездо стрекоз (больше кристаллов)."
		"Ближе ~56 блоков вылетает стая стрекоз, шершней и саранчи; новая — через 5 минут, если прежней нет."
		"&7&o— Техника безопасности: «Парашюта в комплекте нет. Земля — в комплекте всегда».&r"
	]
	quest.23487472DFC8E464.title: "Небесные острова"
	quest.234C5426FCAE3ECD.quest_desc: [
		"&3Почему:&r фильтр пилы — это &eрезультат&r. Без фильтра пила перебирает все варианты по кругу; бревно в фильтре — пилит бревно в бревно."
		"&3Что делать:&r ПКМ по пиле тем, что хочешь получить: доски, плиты, окорённое бревно, части голема."
		"&cОсторожно:&r пила режет и вахтовика — не стой на ней."
	]
	quest.234C5426FCAE3ECD.title: "Пила выдаёт не то или бревно обратно"
	quest.23790F79B2B609BB.quest_desc: [
		"Три задания на команду — вкладка &eКонтракты&r в пульте (или &e/nscontracts&r). Наведи — цель и награда."
		"Виды: убить N мобов вида X, пройти волну, &cбез единой смерти&r, &cс условием смены&r, завалить босса, победить на арене в теме, &eчистая оборона&r (орда ни разу не тронула алтарь), &eблиц&r (быстрее срока), &eоборона работает сама&r (турели убили больше бойцов), &eособая стадия&r, &eночной вызов&r."
		"{@pagebreak}"
		"Награда — &aкаждому в сети&r: артефакт смены наверняка (как с волны на 5–10 выше вашей лучшей), ресурсы, за трудные с 30-й — &5Сердце ночи&r, за условия с 70-й — звёздный осколок."
		"Выполненный меняется на новый с рассветом, висящий дольше 3 игровых дней — тоже. Цели растут вместе с вашей лучшей волной."
		"&7&o— Бригадир: «Работа не волк. Волк — это вон тот, с тремя головами. Иди работай».&r"
	]
	quest.23790F79B2B609BB.title: "Контракты бригадира"
	quest.23C6E8B8A1FF42FB.quest_desc: [
		"&3Сделай:&r пушку на креплении: поворот валами, выстрел по редстоуну."
		"&3Чем:&r крепление — крафтеры (железные листы, валы, андезитовый корпус, оружейный порох). Сигнал в грань с молотом — собрать, с огнём — выстрел."
		"Заряжать разобранную: пушечный заряжатель толкает порох и снаряд по оси. Застрял снаряд — банник."
		"&3Дальше:&r автопушка, стальные стволы."
		"&7&oЛучшее место для пушки — там, где её ствол смотрит не на вас.&r"
	]
	quest.23C6E8B8A1FF42FB.title: "Крепление и выстрел"
	quest.24B6DBCED47E2AC6.quest_desc: [
		"&3Сделай:&r железнодорожный корпус — для станций и контроллера."
		"&3Чем:&r прочный лист (обсидиан колёсами → порошок → сборка по шагам, R) ПКМ по латунному корпусу, руками или деплоером."
	]
	quest.24B6DBCED47E2AC6.title: "Железнодорожный корпус"
	quest.24EE72BE8BD6F220.quest_desc: [
		"Зачем: проверить, что сеть работает, пока не горит."
		"1. ПКМ по пульту — окно. Справа список врат: зелёная кнопка &e«Открыть»&r — хватает тока и всё готово; красным — почему нельзя."
		"2. Нажал — 7 огней загораются по очереди &eна обоих концах&r, вспышка, в арке встаёт плёнка на &e10 секунд&r."
		"3. Войди в арку — выйдешь перед вратами назначения. Можно всей сменой: проходит каждый, кто успел, платит каждый."
		"{@pagebreak}"
		"Пешком: верхом, в лодке, на поезде, в самолёте и с ящиком в руках (Carry On) врата отбросят назад. Предметы в инвентаре — можно."
		"Питомцы (не сидят, в 12 блоках от хозяина) идут следом за четверть цены — волки, кошки, драконы, лошадь на поводке. Между мирами питомцы не ходят: дракона зови свистком."
		"Выход — перед аркой, не в блок и не в лаву; завалено — выйдешь сзади или в самом проёме."
		"&7&o— Техника безопасности: «Перед прыжком убедись, что на той стороне не набег. Или убедись, что взял меч».&r"
	]
	quest.24EE72BE8BD6F220.title: "Первый прыжок"
	quest.2521B5D333C76592.quest_desc: [
		"Что лечит голову:"
		"&eЛюбая еда&r — &6+0,8&r за пол-окорочка, полный бонус раз в &65&r мин"
		"&eМёд&r &6+6&r, &eзолотая морковь&r &6+7&r, &eзолотое яблоко&r &6+8&r, &eзачарованное&r &6+13&r (откат ~&613&r мин)"
		"&eВредно&r: гнилая плоть, паучий глаз, ядовитый картофель, иглобрюх — &c−5&r; хорус — &c−3&r"
		"Золотая морковь — миксер: морковь + 8 золотых самородков."
		"&eТравяной чай&r &6+8&r — миксер над нагревом: 2 цветка + листва + сахар + 250 мБ воды → 4"
		"{\"text\": \"▶ Успокоительное: +25 %\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"43011314638F3A38\"}}"
	]
	quest.2521B5D333C76592.title: "Справка: еда и рассудок"
	quest.253E58BB36CEEECF.quest_desc: [
		"&3Сделай:&r фильтр — машина берёт или делает только нужное."
		"&3Чем:&r миксер: 2 железных самородка + шерсть. ПКМ фильтром или самим предметом по слоту шлюза, руки, пилы, чаши."
		"&eПила&r: в фильтре — что хочешь получить. &eЧаша&r: в фильтре — нужный результат, миксер и пресс над ней делают только его (печь вместо сплава, броня вместо латуни — лечится так)."
		"&7&o— Отдел кадров: фильтр — единственный в Axiomativ, кто умеет вежливо отказывать.&r"
	]
	quest.253E58BB36CEEECF.title: "Фильтр: пила, чаша, шлюз"
	quest.258C4CE4D34290E4.quest_desc: [
		"&3К концу этапа:&r котёл на горелках кормит паровые двигатели по &616 384 SU&r — хватит на весь завод и на будущий ток."
		"• &eКотёл:&r баки 2×2 в высоту 4–8, под дно — 4 горелки, вода — помпа из пруда 2×2."
		"• &eДвигатели&r на стенки бака, перед каждым вал. Уровень котла — сколько двигателей тянет; видно в очках."
		"• &eТорт всполоха&r — перегрев: 2 уровня с горелки. Котёл 2×2×8 на тортах — 8 двигателей."
		"&3Волны:&r готовься к 15-й «Кровавой луне»: фантомы, невидимые тени, босс Голиаф — стрелки и турели, бьющие вверх, алмазная броня."
		"{@pagebreak}"
		"{\"text\": \"▶ Энергия, шаг 2: котёл\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0CB839EC6B4FFE19\"}}"
		"{\"text\": \"▶ Справка: уровни котла\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6F174BDE59A5B3BF\"}}"
		"&3Дальше:&r этап 7 — ток, после 15-й волны."
	]
	quest.258C4CE4D34290E4.title: "Этап 6 · Пар"
	quest.25D36F30E4AC8C69.quest_desc: [
		"&3Сделай:&r реактивная тяга по редстоун-сигналу, когда пропеллеров мало."
		"&3Чем:&r твердотопливный — миксер: 3 железных листа, 2 медных, 2 сплава, желоб, труба; жжёт предметы из сундука сзади. Жидкостный — топливо трубами в тыл (скипидар: ель → дробилка → смола + вода, миксер)."
		"&3Дальше:&r пульт."
	]
	quest.25D36F30E4AC8C69.title: "Реактивный двигатель"
	quest.25D6A5CCAB623FD8.quest_desc: [
		"&3Сделай:&r дизельный двигатель — дёшево, без стали."
		"&3Чем:&r 2 поршня, огниво, блок латуни, 2 плиты полированного чернокамня, бак Create."
		"Топливо: дизель, бензин, биодизель, этанол, масло. Сильнее — модульный и огромный (нужен радиатор, «Ледник»); турбокомпрессор — ×2."
	]
	quest.25D6A5CCAB623FD8.title: "Дизельный двигатель"
	quest.25FE55697EDE4ECC.quest_desc: [
		"&3Сделай:&r магнетитовый порошок — магниты New Age, моторы, секции тесла-башни, подшипник радара."
		"&3Где:&r горы от высоты 120: фиолетовый камень в искрах портала."
		"&3Чем:&r экструдер, сбоку лава и блок железа (не тратится) → сырой магнетит → дробилка: 2 порошка. Пресс над чашей: 4 порошка → блок магнетита."
		"{\"text\": \"▶ Катушка динамо и магниты\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6098697A991695C9\"}}"
	]
	quest.25FE55697EDE4ECC.title: "Магнитная аномалия"
	quest.26583EE3D60C0310.quest_desc: [
		"&3Сделай:&r воду в котёл — каждый уровень пьёт &610 мБ/т&r."
		"&3Чем:&r механическая помпа: (об/мин ÷ 2) мБ/т. На 256 об/мин — &6128 мБ/т&r, это 12 уровней; котлу 18 — две помпы."
		"&3Где:&r труба открытым концом в пруд 2×2 — вода не кончится; другой конец — в стенку бака."
		"&7&oКотёл без воды — это не котёл, а очень дорогая печка.&r"
	]
	quest.26583EE3D60C0310.title: "Вода для котла"
	quest.265D285BE690A008.quest_desc: [
		"Здоровье самой толстой подволны на одного игрока (вдвоём — ×1,5):"
		"&eДо 49-й&r — до ~1 000 HP: мечи, луки, стены."
		"&e50-я&r ~2 100, &e69-я&r ~8 700: мобов в 1,5→2,5 раза больше, здоровье +50%→+300%."
		"&e70-я&r ~19 000, &e80-я&r ~38 000, &e100-я&r ~95 000: мобов ×3 и больше, здоровье +400% и растёт, сами крупнее (×1,2 → ×1,6)."
		"{@pagebreak}"
		"С 16-й — мобы модов (ArPhEx, Northstar, Cataclysm), с 70-й — ещё и отдельные подволны Cataclysm: драугры, пылающие берсерки, глубинники, коралловые големы."
		"Живых мобов набега одновременно не больше 120 — остальные ждут очереди."
		"Итог: с 50-й держат не руки, а завод — главы «Башенная оборона», «Пушки и оборона», «Големы»."
	]
	quest.265D285BE690A008.title: "Шкала угрозы"
	quest.26B7189575B37E49.quest_desc: [
		"&3Сделай:&r груду руды — порода идёт вдвое быстрее."
		"&3Чем:&r 9 дроблёных руд прессом над чашей; под экструдер вместо булыжника — 2 удара вместо 4."
		"&3Дальше:&r латунный экструдер."
		"&7&oКатализатор не тратится. Единственный сотрудник Axiomativ, которого не выжали.&r"
	]
	quest.26B7189575B37E49.title: "Катализатор: груда руды"
	quest.26D4945737F6CCB3.quest_desc: [
		"Магия Iron's Spells: бьёт и лечит издалека. Путь: эссенция → книга → свитки → начертательный стол → кузница свитков → наковальня."
		"Станции колдуют руками, а собирают их &6крафтеры&r и миксер. Свитки, чернила и эссенция падают в набегах с 1-й волны."
		"Волна 32 «Духи»: орду ранит только магия."
		"{\"text\": \"▶ Волна 32: Духи\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"063156D925C2481D\"}}"
		"&7&o— Служебная записка: «Магия на вахте разрешена. Руками — только колдовать».&r"
	]
	quest.26D4945737F6CCB3.title: "Магия на вахте"
	quest.26D5627881A1FE2F.quest_desc: [
		"Каждому защитнику — &6свой чемпион&r (Древний рыцарь Iron's Spells, ~735 HP). Ранить его может &cтолько ты&r: турели, друзья и тесла — мимо. Он идёт за тобой и догоняет."
		"Орда тем временем идёт &eвполсилы&r — база должна держаться сама. Победа — когда подволны кончились и все чемпионы пали."
		"Вышел из игры — через 30 с поединок засчитан. Повтор — 61 (Аптргангр)."
		"Первое прохождение: &6тотем бессмертия&r."
	]
	quest.26D5627881A1FE2F.title: "Волна 39: Поединок"
	quest.27494CDCCB4DCF99.quest_desc: [
		"Волны 50–100 рассчитаны на промышленную оборону:"
		"&e50–69&r — мобов ×1,5→×2,5, живучесть +50 %→+300 %"
		"&e70+&r — мобов ×3 (к 100-й ×6), живучесть +400 %; мобы крупнее, грызут третий блок стены"
		"Подволна 70-й — ~&619 тыс.&r HP, 100-й — ~&695 тыс.&r (20 продвинутых турелей: полминуты и пара минут)."
		"Боссы Cataclysm: до 20–25 урона за удар — держи их коридором, стенами, големами."
		"{\"text\": \"▶ Генератор щита — последний довод\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7FFAED499CB00CC3\"}}"
	]
	quest.27494CDCCB4DCF99.title: "Справка: волны 50–100"
	quest.275FE568C2DBF365.quest_desc: [
		"&3Сделай:&r линзы — для подзорной трубы, телескопа Northstar и бинокля радара."
		"&3Чем:&r деплоер с наждачной бумагой над депо или лентой шлифует кварцевое стекло."
		"&3Дальше:&r телескоп и путь в космос."
		"{\"text\": \"▶ Телескоп и записи\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"577D5A25C2A53FC5\"}}"
	]
	quest.275FE568C2DBF365.title: "Линза"
	quest.278E718C3770929D.quest_desc: [
		"&3Сделай:&r мифрил — сердцевина сфер улучшения."
		"&3Где:&r руда ниже Y −38, не под открытым небом; копает незеритовая кирка."
		"&3Чем:&r дробилка → мифриловый лом; 4 лома → слиток (пресс над чашей)."
		"&3Дальше:&r сфера улучшения."
	]
	quest.278E718C3770929D.title: "Мифрил"
	quest.27B3F98DBEED2A10.quest_desc: [
		"&3Сделай:&r коридор — вся орда пойдёт одной дорогой, там её и встречай."
		"Мобы идут по открытому пути (ищут на 64 блока) и грызут, только когда застряли. Оставь один длинный извилистый проход — стены вокруг не тронут."
		"&3Чем:&r решётки вместо стен коридора: видно и можно стрелять, пройти нельзя. Заметивший тебя моб идёт к тебе — не выходи."
		"&3Дальше:&r козырёк от пауков."
	]
	quest.27B3F98DBEED2A10.title: "Коридор-ловушка"
	quest.27F7FB8A91EB946D.quest_desc: [
		"&3Сделай:&r оборону, которая держит 50-ю волну: стены ведут в коридор, мясорубка перемалывает, турели и пушки добивают, небо прикрыто."
		"Засчитается само, когда команда пройдёт 50-ю волну."
		"&7&o— Пресс-служба Axiomativ: «Орда прибыла на объект. Объект прибыл на орду».&r"
	]
	quest.27F7FB8A91EB946D.title: "Крепость: волна 50"
	quest.27FDDAEDB93E2BEF.quest_desc: [
		"&3Сделай:&r экзоскелет — копать быстрее и бить сильнее, пока есть топливо."
		"&eАндезитовый&r — Спешка II + Слабость; &eлатунный&r — Спешка + Сила; &eмедный&r — Сила II + Утомление, только вода."
		"&7&o— Отдел кадров: экзоскелет не заменяет вахтовика. Пока.&r"
	]
	quest.27FDDAEDB93E2BEF.title: "Экзоскелеты"
	quest.282ECE65F61813C1.quest_desc: [
		"Зачем: база ↔ форпост ↔ фактория — за пару секунд, а не за полчаса полёта. Только людям и их питомцам: грузы по-прежнему возят поезда и самолёты."
		"&6Пульт&r — механические крафтеры: по углам 4 &eметеоритных железа&r (кратер, только самолётом), сверху &eзвёздная карта&r (Обсерватория), по бокам 2 &eлинзы&r (Кварцевый карьер), в середине &eэнергоячейка&r, снизу механизм точности."
		"&eКак строить:&r пульт — в середину нижнего ряда, рядом и над ним 15 рам: порог из 5 блоков (пульт — третий), две стойки по 4 блока, перекладина из 3 сверху. Углы над стойками пустые, проём &e3×4&r — тоже. Экран пульта смотри в ту сторону, куда будут выходить прибывшие."
		"{@pagebreak}"
		"Рама собрана — блоки сами станут стойками с огнями, шестернями и замковым камнем, в чате «Врата собраны». Не хватает блоков — ПКМ по пульту: рыжие точки покажут, где дыры."
		"&eТок&r — к пульту с любой стороны (провода Crafts \\& Additions и New Age, разрядная станция): до 50 000 FE/т, запас 6 000 000 FE."
		"Вторые врата — у форпоста или фактории. Сеть общая на смену: ПКМ по пульту — список всех врат с миром, расстоянием, стороной света и ценой."
		"&7&o— Служба доставки: «Посылки через врата не принимаем. Курьеров — пожалуйста».&r"
	]
	quest.282ECE65F61813C1.title: "&bВрата перехода&r"
	quest.2842951F59F2E86D.quest_desc: [
		"&3Сделай:&r рыболовную сеть — рыба без удочки."
		"&3Чем:&r крафтеры 2×2: защитная сеть, 2 палки, сплав → 2. Ловит, только когда едет в конструкции (тележка, поршень) по открытой воде."
		"&3Дальше:&r сладкий цех."
	]
	quest.2842951F59F2E86D.title: "Рыболовная сеть"
	quest.2888590EA4BC7883.quest_desc: [
		"Справка: &5эпические&r артефакты волн — с 15-й волны. С эпических начинается пробуждение."
		"&5Каменное сердце&r — +8 HP, +25 % стойкости к отбрасыванию, −5 % скорости."
		"&5Чётки дозорного&r — −5 % урона; передышка после удара дольше на 0,6 с (складывается с Оберегом сторожа и Крест-ожерельем)."
		"&5Перчатка мясника&r — +2 урона вплотную; вампиризм 10 % (до 3 HP за удар) — лучше с быстрым оружием."
		"Шанс каждого за победу: ≈0,15 % на 15-й волне, ≈1,7 % на 50-й, ≈4,8 % на 100-й."
	]
	quest.2888590EA4BC7883.title: "&5Эпические&r артефакты"
	quest.291F7DFD4AC666B2.quest_desc: [
		"&3Сделай:&r всполохомёт — жечь толпу в коридоре."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Огненные шары по 2 урона ~7 раз в секунду. Заправка — ПКМ по оружию: горючее (ведро лавы — полный бак) и вода. Визер-скелетам огонь нипочём."
		"{\"text\": \"▶ Волна 16: стаи пауков\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3D598A57FF05CC24\"}}"
	]
	quest.291F7DFD4AC666B2.title: "Всполохомёт"
	quest.2941F343D52B2027.quest_desc: [
		"&3Сделай:&r радиаторы — реактор New Age и тяжёлые двигатели (большие дизели, большой двигатель TFMG)."
		"&3Где:&r ледяные шипы, морозные пики: сине-белая мерзлота в снежинках."
		"&3Чем:&r экструдер, сбоку плотный лёд и вода → криокристалл → миксер с водой → хладагент → дозатор в медный лист (250 мБ) → радиатор."
		"{\"text\": \"▶ Ядерный реактор\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1E4BD02D9BF9BE76\"}}"
	]
	quest.2941F343D52B2027.title: "Ледник"
	quest.29FD0B60775645E1.quest_desc: [
		"&3Сделай:&r модуль брони — новое свойство, чары и прочность вещи остаются."
		"&3Чем:&r крафтеры: модуль + вещь своего слота рядом; один модуль каждого типа на вещь."
		"Первый — &eпружинные ботинки&r: урон от падения 0, а падения — главный убийца смены. Сборка по шагам: латунный лист → деплоер со слизью → деплоер с железным листом → пресс, 2 круга."
		"&3Дальше:&r справка «Модули», ночное видение."
	]
	quest.29FD0B60775645E1.title: "Модули брони"
	quest.29FF03022EEE798D.quest_desc: [
		"&3Сделай:&r свисток (квест ждёт красный) — зовёт дракона даже из другого мира."
		"&3Чем:&r крафтеры: железо по углам, доски по бокам, краситель в центре."
		"Привязать — Shift+ПКМ по дракону. Позвать — &eзажми ПКМ&r, выбери «Свистнуть», отпусти."
		"&3Дальше:&r «Дракон пропал?»."
	]
	quest.29FF03022EEE798D.title: "Свисток"
	quest.2A1A1E144D91C595.quest_desc: [
		"Сколько зарядов держит ствол (итог — меньшее из ствола и затвора, минус швы):"
		"&eБревно&r — &60&r"
		"&eКованое железо&r — &61&r"
		"&eЧугун&r — &62&r (шов −1)"
		"&eБронза&r — &64&r"
		"&eСталь&r — &68&r (шов −2)"
		"&eНезер-сталь&r — &610&r"
		"&7&o— Юротдел: «Превышение нормы пороха — не рационализаторство».&r"
	]
	quest.2A1A1E144D91C595.title: "Справка: материалы пушек"
	quest.2A48D211E264865E.quest_desc: [
		"&3Сделай:&r чернила — без них кузница свитков стоит."
		"&3Чем:&r миксер: чернильный мешок + эссенция + пузырёк. Выше — 4 пузырька + металл → 1 следующей редкости: медь, железо, золото, аметист."
		"&3Дальше:&r алхимический котёл."
	]
	quest.2A48D211E264865E.title: "Чернила"
	quest.2B212A82A987C8EE.quest_desc: [
		"Латекс даёт ствол гевеи, стоящий на &eлатеритной почве&r плантации, до 6 стволов в высоту. Ствол можно срубить и поставить на ту же почву."
		"Нож для подсочки (деплоер кладёт железный лист на палку) → ПКМ по стволу, раз в 3 с. Автомат — деплоер с ножом через клетку от ствола, латекс забирай воронкой с фильтром «латекс»."
	]
	quest.2B212A82A987C8EE.title: "Гевея не даёт латекс"
	quest.2B29212FBD9DC938.quest_desc: [
		"&3Сделай:&r навигационный компьютер — мозг ракетной станции (ещё — навигатор и маяк)."
		"&3Чем:&r сборка по шагам из железной пластины, 2 круга: полированный алмаз → закалённый механизм → гравирование → схема → звёздная карта → гравирование."
		"&3Где:&r звёздные карты — форпост «Обсерватория»; алмаз полирует деплоер с наждачкой."
		"Лишние компьютеры — в стойку на борту: −0,8 % топлива за штуку, до −40 % (48 шт.)."
		"&3Дальше:&r ракетная станция."
	]
	quest.2B29212FBD9DC938.title: "Навигационный компьютер"
	quest.2B3AF03BB3F2FDE0.quest_desc: [
		"&3Сделай:&r записную книжку шахты: где какая жила и сколько в ней (бесконечные — «∞»)."
		"&3Чем:&r сундук + аметист + карта + книга с пером. Работающую буровую тоже можно опросить атласом."
	]
	quest.2B3AF03BB3F2FDE0.title: "Атлас рудных жил"
	quest.2B3F74E1D633B85A.quest_desc: [
		"&3Сделай:&r механический рассадник — кожа, нить, порох, кости без охоты."
		"&3Чем:&r крафтеры 5×5: латунь, латунные листы, железные решётки, изумруд, вал. От &6100&r об/мин, сбоку жидкость призыва (&6100&r мБ на моба)."
		"Без сборщика добычи выходят живые мобы. Криперы тоже."
		"&7&o— Отдел по работе с ордой: наконец-то орда по расписанию.&r"
	]
	quest.2B3F74E1D633B85A.title: "Механический рассадник"
	quest.2B4C38883D6F37F5.quest_desc: [
		"&3Сделай:&r дрон-помощник — летает за тобой на токе: собирает добычу, светит, ищет руду, возит вещи на склад."
		"&3Чем:&r сборка по шагам: латунный корпус → механизм точности → конденсатор C\\&A → электромедь → 4 пропеллера → электронная лампа → пресс."
		"ПКМ по блоку — выпустить, ПКМ по дрону — окно, Shift+ПКМ пустой рукой — свернуть. Подзарядка — ПКМ энергоячейкой."
		"&3Дальше:&r гнездо, пульт, улучшения."
		"&7&o— Отдел кадров: «Новый сотрудник не ест, не спит и не просит отпуск. Просит только ток».&r"
	]
	quest.2B4C38883D6F37F5.title: "Дрон-помощник"
	quest.2B5D5FE8FC36C5DE.quest_desc: [
		"&3К концу этапа:&r база размечена, алтарь стоит, первые пять волн пройдены."
		"• &eРазметчик:&r миксер — палка, кремень, уголь. Внутри зоны базы монстры сами не появляются."
		"• &eБлок базы:&r миксер — костёр, резной каменный кирпич, 5 каменных кирпичей. Над ним вырастает алтарь; ПКМ по нему — пульт: волны, досье, старт."
		"• &eБроня и щит&r — железо с промывки; оружие — глава «Оружие и броня»."
		"&3Волны:&r выбираешь сам. 1–3 — зомби и пауки: стены и каменного меча хватит. 5 — первый босс. Моб у алтаря — провал и минус сердца; с 8-й — три."
		"{@pagebreak}"
		"{\"text\": \"▶ Разметчик базы\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"56635B3491872F7C\"}}"
		"{\"text\": \"▶ Пульт алтаря\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"515EB053AE51DC78\"}}"
		"{\"text\": \"▶ Оборона: как ходит орда\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5D0BB0FB363BCF9C\"}}"
		"&3Дальше:&r этап 4 — латунь."
	]
	quest.2B5D5FE8FC36C5DE.title: "Этап 3 · Алтарь и первые волны"
	quest.2B67A130566B547B.quest_desc: [
		"&3Сделай:&r дальше, больнее и длиннее цепь: до 4 секций в высоту."
		"&3Чем:&r сборка по шагам, 2 круга: медный корпус → деплоер с медной катушкой → деплоер с электромедью → деплоер с магнетитовым порошком (форпост «Магнитная аномалия») → пресс."
		"{@pagebreak}"
		"Секций — дальность / урон / перескоков / FE за выстрел с полной цепью:"
		"&e0&r — 8 / 6 / 1 / 2 500; &e1&r — 12 / 8 / 2 / 3 000; &e2&r — 16 / 10 / 3 / 3 500; &e3&r — 20 / 12 / 4 / 4 000; &e4&r — 24 / 14 / 5 / &64 500&r"
		"В бою без передышки башня с 4 секциями ест &6125–225 FE/т&r: генератора на 256 об/мин (432 FE/т) хватит на две такие или на три без секций. Полного запаса — на 11 залпов."
	]
	quest.2B67A130566B547B.title: "Секции: растим башню"
	quest.2B93C5ECE763DE47.quest_desc: [
		"&3Сделай:&r прочное стекло: на глубине обычное трескается первым."
		"&3Чем:&r миксер: 8 стёкол + промышленный железный блок (медное — медный блок)."
		"Барометр — давление и глубина: 5 прочных стёкол, ведро воды, 3 промышленных железных блока."
		"&3Дальше:&r подлодка на глубине."
	]
	quest.2B93C5ECE763DE47.title: "Прочное стекло"
	quest.2BB90C762D8DE0FB.quest_desc: [
		"&3Сделай:&r собери ракету снизу вверх, как в Ponder станции:"
		"1) ускорители — в самый низ; 2) над ними баки с топливом; 3) сундук под груз — по желанию;"
		"4) сиденье Create, контроллер, ракетная станция, к планетам — межпланетный навигатор; 5) обшивка — где угодно."
		"{@pagebreak}"
		"6) Склей всё суперклеем одной областью (иначе «No rocket controls attached»)."
		"7) Атлас — в слот станции: планета → «Поверхность», точка «Hold position», «Save destination»."
		"8) Fuel, Thrusters, Heat Shielding, Navigator — в норме. 9) «Собрать Ракету». Забыл что-то — «Disassemble Rocket»."
		"&3Дальше:&r чек-лист перед стартом."
		"&7&o— ОТК: «Ракета без суперклея — это салют».&r"
	]
	quest.2BB90C762D8DE0FB.title: "&6Сборка ракеты: по шагам&r"
	quest.2BC1B58A4F6EE6D5.quest_desc: [
		"&3Сделай:&r оружейный порох — только он идёт в патроны Gunsmithing, заряды и гильзы пушек. Обычный порох остался для TNT и фейерверков."
		"&3Чем:&r миксер: серная пыль + порох + древесный уголь → 3."
		"&3Дальше:&r пороховые заряды пушек."
		"{\"text\": \"▶ Пороховой заряд\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5E9B9A280ABBD6B0\"}}"
	]
	quest.2BC1B58A4F6EE6D5.title: "Оружейный порох"
	quest.2BEF641D30F7ADE6.quest_desc: [
		"То, чего не сделать машинами, привозит &eстранствующий снабженец&r: раз в 2–3 игровых дня утром у алтаря базы, стоит сутки. Валюта — жетоны смены (фактории)."
		"Где он и когда придёт — &e/trader&r. Каждый визит — новый товар."
		"{\"text\": \"▶ Справка: что привозит\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"694F131770861161\"}}"
	]
	quest.2BEF641D30F7ADE6.title: "Где взять диски, шаблоны, яйцо дракона"
	quest.2C06507CCB856B9D.quest_desc: [
		"&3Сделай:&r мантия странствующего мага — больше маны."
		"&3Чем:&r миксер: кожаная вещь + эссенция. Кожа — миксер с нагревом: 3 гнилой плоти + вода."
		"&3Дальше:&r роба волшебника."
	]
	quest.2C06507CCB856B9D.title: "Мантия странствующего мага"
	quest.2C866220A120C30C.quest_desc: [
		"&3Сделай:&r колонну CDG — перегонка без стали."
		"&3Чем:&r контроллер (2 андезитовых сплава, железная пластина, 2 трубы, часы → 4), колонна от 3 блоков, горелка снизу: 100 мБ нефти → 50 дизеля + 50 бензина (перегрев — по 75). Ponder — W."
	]
	quest.2C866220A120C30C.title: "Второй путь: колонна CDG"
	quest.2CC8CCC2EDA2288D.quest_desc: [
		"&3Сделай:&r балластную цистерну: набрала воды — вниз, откачала — вверх."
		"&3Чем:&r крафтеры 3×3 или миксер: сплав по углам, железные листы по бокам, жидкостный бак в центре."
		"Одна тянет около 75 блоков корпуса."
		"&3Дальше:&r клапан."
	]
	quest.2CC8CCC2EDA2288D.title: "Балластная цистерна"
	quest.2CE5CDB303BB7864.quest_desc: [
		"Веха: &4Древний реликт&r и два &6Уаджета&r. Реликт огромный — застревает в узких коридорах, песчаные бури мешают целиться."
		"Маледиктус и Предвестник &eлетают&r: наземные ловушки бесполезны, нужны купол и зенитки."
		"&6Первое прохождение&r: сильный артефакт и &5Сердце ночи&r."
		"&7&o— Пресс-служба: «До конца смены десять волн. Или десять некрологов — как пойдёт».&r"
	]
	quest.2CE5CDB303BB7864.title: "Волна 90: почти конец"
	quest.2D977C8542ABDF12.quest_desc: [
		"Справка: &aредкие&r артефакты волн — с 1-й волны."
		"&aСтальная пряжка&r — +6 HP, +10 % стойкости к отбрасыванию."
		"&aНашивка ОТК&r — −5 % входящего урона (до брони, складывается с «Защитой» и энергощитом)."
		"&aОберег сторожа&r — +1 брони; передышка после удара дольше на 0,3 с: толпа бьёт реже."
		"Шанс каждого за победу: ≈0,59 % на 1-й волне, ≈1,5 % на 15-й, ≈2,8 % на 50-й, ≈2,4 % на 100-й."
	]
	quest.2D977C8542ABDF12.title: "&aРедкие&r артефакты"
	quest.2DC6D6DFEA84D5FC.quest_desc: [
		"&3Сделай:&r экструдер — бесконечный камень без кирки."
		"&3Чем:&r миксер: 3 стекла + андезитовый корпус + вал. По бокам вода и лава, снизу — блок нужной породы (не тратится)."
		"Обсидиан — только на скорости ≤ 4 об/мин."
		"&3Дальше:&r рудная порода."
	]
	quest.2DC6D6DFEA84D5FC.title: "Экструдер: своя порода"
	quest.2DDBA2AB73BF01A6.quest_desc: [
		"Справка: JEI — из чего предмет и куда он идёт."
		"&6R&r — рецепты, &6U&r — где нужен, &6P&r — закрепить: цепочка до сырья справа на экране; &6J&r — планшет инженера."
		"«Мёртвый верстак» делают машины:"
		"&eфигурные&r — крафтеры по раскладке"
		"&eбесформенные&r — миксер над чашей"
		"&eквадрат из одного&r — пресс над чашей"
		"&eступеньки, плиты, двери&r — пила"
	]
	quest.2DDBA2AB73BF01A6.title: "Справка: JEI — R, U и P"
	quest.2DF0FDCB1FF00495.quest_desc: [
		"Что продаёт лавка (окно терминала → «Лавка»). Платишь кассой, недостающее — жетонами из инвентаря. Лимиты — на команду за сезон (10 игровых дней ≈ &63 ч 20 мин&r)."
		"&eПремия смены&r — &615&r: +50 % бросков добычи за следующую победу"
		"&eУдарная смена&r — &65&r: Спешка II на 15 мин всем в сети"
		"&eНаряд на артефакт&r — &630&r (с 5-й волны): как с волны на 5 выше лучшей"
		"&eСердце ночи&r — &6120&r (с 20-й, 2 за сезон)"
		"&eЗаряд молнии&r — &640&r (с 15-й): вторая линия электромеди"
		"&eТотем&r — &625&r; &eдвигатель Незера&r для самолёта — &635&r (с 25-й)"
		"&eНастойка жизни&r ×2 — &68&r, &eуспокоительное&r ×4 — &63&r (без спор и форпоста), &eопыт&r ×16 — &64&r"
		"{@pagebreak}"
		"&eЗонды жил&r (с волны): уголь, медь — &612&r; железо, цинк — &616&r (4); кварц, редстоун, сера — &620&r (8); золото, лазурит — &624&r (14); свинец, никель — &630&r (20); литий, светокамень — &636&r (27); платина — &644&r (35); торий — &652&r (43); алмазы — &664&r (50); титан, вольфрам, марсианское железо — &672&r (60, только на планетах). По 2 за сезон, с платины — по 1."
		"&eСемена&r: факельник ×4 — &64&r, кувшинка ×2 — &65&r, яйцо нюхача — &612&r."
	]
	quest.2DF0FDCB1FF00495.title: "Справка: лавка фактории"
	quest.2DF88FD3F54BC3BE.quest_desc: [
		"Другая ночь — &aсеверное сияние&r: зелёные и фиолетовые полотна в небе."
		"Под открытым небом рассудок не тает от темноты и понемногу растёт (+3 % в 10 с). Хорошая ночь, чтобы строить снаружи."
	]
	quest.2DF88FD3F54BC3BE.title: "Северное сияние"
	quest.2E084D0D4BD44A58.quest_desc: [
		"&3Сделай:&r огнеупорный кирпич — стены домны и воздухонагревателей."
		"&3Где:&r огнеупорная глина — жилами под землёй; шарики — в печь, 4 кирпича → блок."
	]
	quest.2E084D0D4BD44A58.title: "Огнеупорный кирпич"
	quest.2E0A18A49AA1C801.quest_desc: [
		"&3Сделай:&r руль: подшипник поворачивает часть, штурвал крутит его — зажми ПКМ и веди мышью."
		"&3Чем:&r крафтеры столбиком. Подшипник: плита, промышленный железный блок, шестерня. Штурвал: большая шестерня, андезитовый корпус, вал."
		"&3Дальше:&r газ."
	]
	quest.2E0A18A49AA1C801.title: "Руль: штурвал и подшипник"
	quest.2E2B96F9D175D3DE.quest_desc: [
		"&3Сделай:&r вентилятор, который жжёт и сдувает толпу."
		"&3Чем:&r лава или огонь перед вентилятором: сквозь лаву — &64&r урона и огонь на 10 с, сквозь огонь — &62&r и 2 с. Поток до 20 блоков на 256 об/мин толкает — сдувай орду на пилы. Визер-скелетам и магмовым кубам огонь нипочём."
		"&3Дальше:&r деплоер с мечом."
	]
	quest.2E2B96F9D175D3DE.title: "Вентилятор с лавой"
	quest.2E4CBB3E62737A6D.quest_desc: [
		"&3Сделай:&r казённик с затвором — без затвора пушку не зарядить."
		"&3Чем:&r казённик отливается и сверлится, затвор (3 чугунных слитка + 2 шестерни) — рукой или деплоером."
		"Предел заряда затвора: чугунный — 2, бронзовый и стальной — 4, винтовой стальной — 8. Скорострельный механизм — перезарядка механической рукой."
		"&3Дальше:&r крепление и выстрел."
	]
	quest.2E4CBB3E62737A6D.title: "Казённик и затвор"
	quest.2EA5301A0872E5B3.quest_desc: [
		"Одна катушка и 12 одинаковых магнитов: сила — FE/т на 64 / 256 об/мин — КПД."
		"&eМагнетитовый железняк&r (1) — &622 / 90&r — 33 %"
		"&eРедстоун-магнит&r (2) — &645 / 180&r — 50 %"
		"&eВысоко-активный&r (4) — &690 / 360&r — 67 % (и якорь возрождения)"
		"&eОбогащённый железняк&r (8) — &6180 / 720&r — 80 %"
		"&eНезеритовый&r (24) — &6540 / 2 160&r — 92 %"
		"{@pagebreak}"
		"&eРецепты:&r железняк — пресс: 4 магнетитовых порошка; редстоун-магнит — крафтеры: блок редстоуна, 4 железных самородка, 4 порошка → 2; высоко-активный — 3 заряж. золота, 4 заряж. железа, 2 порошка → 4; обогащённый — миксер: 4 железняка, заряж. алмаз, 4 заряж. золота → 2; незеритовый — 4 заряж. алмаза, блок магнетита, 4 незеритовых обломка → 2."
		"&eПуть:&r редстоун-магниты → первый ток → электризатор → высоко-активные → обогащённые."
	]
	quest.2EA5301A0872E5B3.title: "Справка: магниты"
	quest.2ECBF16F87D4CAC1.quest_desc: [
		"&3Сделай:&r ключ ко всему току — без него нет электрической меди и ни одного генератора."
		"&3Где:&r первое прохождение &e15-й волны&r — каждому защитнику. Ещё один — лавка фактории (40 жетонов) или стол трансмутации (8 192 EMC), если стол его уже знает."
		"&cНе трать заряд на посох молнии:&r рецепт посоха его съедает, а деплоеру он нужен навсегда."
		"&3Дальше:&r отдай заряд деплоеру."
	]
	quest.2ECBF16F87D4CAC1.title: "Шаг 3 · Генератор: заряд молнии"
	quest.2ED4F972C8004BDD.quest_desc: [
		"&3Почему:&r на вахте верстак мёртв, сетка 2×2 в инвентаре тоже — крафтят машины Create."
		"&3Что делать:&r вкладка «Создание» в JEI — работа для машин: &eфигурный&r рецепт — механические крафтеры по раскладке; &eбесформенный&r — миксер над чашей; &eквадрат&r 2×2 или 3×3 из одного — пресс над чашей; ступеньки, плиты, двери — пила."
		"Какой машиной делать — подсказка JEI на рецепте и вкладка над ним."
	]
	quest.2ED4F972C8004BDD.title: "Верстак в JEI есть, а не работает"
	quest.2F27FD3FABF74065.quest_desc: ["Справка: держи &6W&r над блоком Create (в инвентаре или JEI) — сценка покажет, куда его ставить и что ему нужно."]
	quest.2F27FD3FABF74065.title: "Справка: Ponder (W)"
	quest.2FBF34DA191F4F4E.quest_desc: [
		"Волны 16–26: пауки, сколопендры и скорпионы ArPhEx, &cподрывники&r, стрекозы, муравьи, мёрзлые зомби. 16–19 — переходные: часть подволн ещё обычные. Босс 20-й — &4Паучиха-матриарх&r (~1 100 HP, плодит паучат), 25-й — &4Термитный король&r."
		"Пауки лезут по стенам, прыгуны — через стены: крыша над алтарём окупится."
		"С этой волны за первое прохождение каждой 5-й — &5сильный артефакт&r каждому. На повторах боссы меняются: Магистры цитадели, Мёртвый король, Эхо Тироса (Iron's Spells)."
	]
	quest.2FBF34DA191F4F4E.title: "Волна 20: Паучиха-матриарх"
	quest.2FC167169892DA63.quest_desc: [
		"Малых набегов больше нет — вместо них &6Ночной вызов&r. В сумерки алтарь сам &eпредлагает&r короткую волну из уже пройденных: 3 подволны и одно случайное условие смены."
		"Принять — кнопкой в чате, командой &e/nightshift call&r или «Старт» на этой волне в пульте (в пульте вверху написано, какая). Кто далеко — получит кнопку телепорта."
		"{@pagebreak}"
		"&6Премия&r каждому, кто получил добычу: &dартефакт смены наверняка&r (как с волны на 5 выше вашей лучшей), осколки орды и обычная добыча волны."
		"&aОтказ и провал — без штрафа&r: ни проклятия, ни ран от провала. Один вызов за ночь, до рассвета. Вы на арене — вызов пройдёт на арене."
		"&7&o— Служба доставки Axiomativ: «Гости теперь только по записи. Запись — у алтаря».&r"
	]
	quest.2FC167169892DA63.title: "Ночной вызов"
	quest.2FCFABA930668036.quest_desc: [
		"Над базой зависают &bульи-матки&r (3 шт., ~550 HP) в 45–70 блоках от алтаря и на 50–65 выше. Каждые 12 с из них вылетают стрекозы, шершни и саранча."
		"Ульи ранит только тот, кто &bв воздухе&r: самолёт (роторная пушка Immersive Aircraft), элитры, дракон. Тесла-башня тоже достаёт."
		"Сбить все ульи за 12 минут. Повторы — 42 и 58."
		"Первое прохождение: &6Чертёж форсажа&r."
	]
	quest.2FCFABA930668036.title: "Волна 24: Воздушный бой"
	quest.30DE9EDE66363F31.quest_desc: [
		"&3Сделай:&r сырьё ядерного топлива — путь к котлу 18 без угля и тортов."
		"&3Где:&r ториевая руда в обычном камне, высота 20…120, 2 жилы на чанк."
		"&3Чем:&r миксер: торий + камень + глина + 1 000 мБ воды → 2 тория. Дробильные колёса: торий → радиоактивный торий (10 %)."
		"&3Дальше:&r ядерное топливо."
	]
	quest.30DE9EDE66363F31.title: "Атом: торий"
	quest.312E6921C891CC59.quest_desc: [
		"Двое взрослых прирученных драконов после рыбы отложат яйцо; разные породы — гибрид."
		"Детёныш берёт породу по месту: у лавы — огненный, в холоде — ледяной, в Незере — незерский, во тьме — скалковый, высоко в горах — небесный."
	]
	quest.312E6921C891CC59.title: "Гибриды"
	quest.3143F5CDAE9CD77D.quest_desc: [
		"Справка: &bбожественные&r артефакты волн — с 90-й волны, в основном в Бесконечности."
		"&bСердце Вахты&r — +18 HP, +4 брони, −10 % урона; вне боя +1 HP/с."
		"&bНимб бессменного&r — вампиризм 10 % (до 4 HP); после удара 1 с неуязвимости, перезарядка 4 с; второе дыхание раз в 2 мин (1 HP и 3 с неуязвимости). С Песочными часами не складывается — работает Нимб."
		"Шанс каждого за победу: ≈0,27 % на 90-й волне, ≈0,9 % на 100-й, ≈2,5 % на ∞20."
	]
	quest.3143F5CDAE9CD77D.title: "&bБожественные&r артефакты"
	quest.31884BC4276B531D.quest_desc: [
		"&3Сделай:&r андезитовый загрузчик чанков — завод и форпост работают без тебя."
		"&3Чем:&r крафтеры 3×3: 5 стёкол, якорь возрождения, 2 андезитовых корпуса, вал. Пустым загрузчиком ПКМ по &eживому гасту&r (Незер). Вращение снизу держит чанк."
		"{\"text\": \"▶ Этап 8 · Форпосты\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"217DBD70A3581A76\"}}"
	]
	quest.31884BC4276B531D.title: "Андезитовый загрузчик чанков"
	quest.31F29F77CF74F6C3.quest_desc: ["Механические крафтеры 3×3 по раскладке из JEI (медь вокруг основы) или миксер — с 3.3.1 работают оба."]
	quest.31F29F77CF74F6C3.title: "Улучшение «Переполнение»"
	quest.3245368928B123AE.quest_desc: [
		"&3Сделай:&r фугасный снаряд — взрыв достаёт соседей цели."
		"&3Чем:&r крафтеры: 5 железных слитков, 2 спрессованной нитроцеллюлозы, плита. Взрыватель — в головную часть (Ponder, W)."
		"Взрыватели: ударный — 2 из 3, инерционный — 9 из 10, таймер и бесконтактный — подрыв над толпой, проводной — по редстоуну."
	]
	quest.3245368928B123AE.title: "Фугасы и взрыватели"
	quest.32494E2D2F556718.quest_desc: [
		"&3Сделай:&r шоколад — сладкое через жидкости."
		"&3Чем:&r миксер с нагревом: сахар, какао, молоко. Дозатор: ягоды + шоколад → в глазури, яблоко + мёд → медовое. Чай строителя (Спешка): листва, вода, молоко с нагревом."
		"&3Дальше:&r мясо из клетки."
	]
	quest.32494E2D2F556718.title: "Сладкий цех"
	quest.32A403330C10E18C.quest_desc: [
		"&3Сделай:&r насест — яйца без погони за курами."
		"&3Чем:&r миксер: 3 холста, 4 бамбука, пшеница (холст — 4 соломы прессом над чашей). ПКМ пустым насестом по взрослой курице."
		"&3Дальше:&r рыболовная сеть."
	]
	quest.32A403330C10E18C.title: "Насест"
	quest.32B7B81DD798CAD8.quest_desc: [
		"Сила каждого шага в цифрах (всё видно и в инженерных очках)."
		"&eКолёса&r — &6256–8 192 SU&r, даром."
		"&eПар&r — &616 384 SU&r на двигатель; котёл до &618&r двигателей — &6294 912 SU&r. Главный источник."
		"&eТок&r — переделка вращения: генератор берёт &616 384 SU&r, отдаёт &6432 FE/т&r (КПД &690 %&r)."
		"&eТепло&r — Стирлинг &6512–1 024 SU&r без топлива; нагреватель греет котёл без угля."
		"&eАтом&r — &66&r стержней = котёл 18 без угля."
		"&eЭнергофорпост&r — геотермальный генератор &62 000 FE/т&r, гидро &6500&r на камень порога."
		"{@pagebreak}"
		"&eЗачем ток, если вал и так крутится:&r зарядка (электризатор — магниты, моторы; зарядная катушка Теслы — электрум), тесла-башни и щит, а ещё сила по кабелю к моторам на &6256 об/мин&r. Вдаль вращение несёт и цепной конвейер — пролёт до 32 блоков."
	]
	quest.32B7B81DD798CAD8.title: "Справка: что сколько даёт"
	quest.33444D6CF34F28A8.quest_desc: [
		"&3Сделай:&r схему — она почти во всём: компьютер, станция, контроллер, кислород."
		"&3Чем:&r гравировальный станок (крафтеры: 4 титановые пластины, механизм точности, 3 полированного розового кварца, аметистовый кристалл Northstar, вал) — работает как пресс над лентой или депо."
		"Схема — сборка по шагам из железной пластины, 5 кругов: полированный аметист → медная пластина → золотая пластина → гравирование. Выход 70 %."
		"&3Дальше:&r навигационный компьютер."
	]
	quest.33444D6CF34F28A8.title: "Схема и гравировальный станок"
	quest.336E7B754D05AD3C.quest_desc: [
		"Сколько держит энергощит (удар — до брони):"
		"&eпаук, удар 15&r — Mk1 ~&626&r ударов, Mk2 ~&666&r"
		"&eбосс, удар 110&r — Mk1 &63–4&r, Mk2 ~&69&r"
		"Под куполом Mk1 полный за 10 с, Mk2 — за 12,5 с."
		"Не гасит: яд и магию (и тьму рассудка), иссушение, голод, утопление, пустоту. Поднятый щит в руке принимает удар раньше."
		"Зарядная катушка Теслы, электризатор и батареи его не заряжают."
	]
	quest.336E7B754D05AD3C.title: "Справка: энергощит"
	quest.33949459D93D20CF.quest_desc: [
		"Нагрузка турелей на вал (SU на 1 об/мин):"
		"&eОбычная&r — &64&r (на 256 об/мин — &61 024 SU&r)"
		"&eПродвинутая&r — &68&r (на 256 — &62 048 SU&r)"
		"20 продвинутых на 256 об/мин ≈ &641 000 SU&r — паровые двигатели или электромоторы (глава «Энергия»). Ниже 30 об/мин турель молчит."
	]
	quest.33949459D93D20CF.title: "Справка: питание турелей"
	quest.33E96C5EAAAD3D74.quest_desc: [
		"&3Сделай:&r продвинутую турель — главный калибр с 50-й волны."
		"&3Чем:&r как обычная, но тёмный призмарин и конденсатор древнего стража."
		"10 целей разом: на 256 об/мин ≈ &640&r урона/с, 20 турелей ≈ &6800&r/с. Круги по 17 блоков — на коридор и мясорубку."
		"&7&o— ОТК: «Турель не промахивается. Промахивается тот, кто её поставил не туда».&r"
	]
	quest.33E96C5EAAAD3D74.title: "Продвинутая турель"
	quest.33EA20BC35D99D61.quest_desc: [
		"&3Сделай:&r снаряды под цель:"
		"&eМешок с картечью&r — &625 × 15&r: против толпы"
		"&eШрапнельный&r — &650 × 8&r, с взрывателем рвётся над ордой"
		"&eТяжёлый&r — &630&r, пробивает стены; &eбронебойный&r — &650&r"
		"&eФугасный&r — &630&r и взрыв"
		"Тяжёлый — миксер: 4 железных слитка, 2 самородка, плита; шарики картечи — R в JEI."
	]
	quest.33EA20BC35D99D61.title: "Снаряды"
	quest.33EB747527C6AAA4.quest_desc: [
		"Артефакты делают &aтебя плотнее&r: мобов не ослабляем — поздние волны держит твой билд."
		"&eСлоты:&r 4 «Реликвия» — инвентарь → кнопка Curios у куклы. Одинаковые не надеваются, разные суммируются; щит после удара и второе дыхание — работает лучший из надетых."
		"&eОткуда:&r артефакты волн (19) — за любую победу; арены (13) — за победу на арене в её теме; трофеи боссов (14) — за волну с боссом."
		"&e/nsart&r — что даёт твой билд. Ни купить, ни продать: EMC у них нет."
		"{@pagebreak}"
		"&eПотолки суммы:&r срез урона &635 %&r, вампиризм &620 %&r (до 5 HP за удар), лечение вне боя &62 HP/с&r, отражение &650 %&r, уклонение &625 %&r, здоровье от артефактов &6+60&r."
		"Пример: 20 HP + 5 Сердец ночи (+10) + 4 артефакта на здоровье (+56) = &a86 HP&r."
		"Артефакты мода Artifacts носятся в своих слотах и складываются с этими."
		"{\"text\": \"▶ Добыча набега и первое прохождение\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"084D8406F225C967\"}}"
		"&7&o— Отдел кадров: «Четыре слота — корпоративная культура. Пятый выдают посмертно».&r"
	]
	quest.33EB747527C6AAA4.title: "Как это работает: слоты и потолки"
	quest.34C1EC83C942AAFD.quest_desc: [
		"&3Почему:&r крафтеры держатся группой только стенка к стенке; дырявая раскладка (палочки, ножницы, удочка) рвёт группу."
		"&3Что делать:&r пустые клетки рецепта — крафтеры с &eзаглушкой слота&r (ПКМ заглушкой по крафтеру): группа цела, клетка пустая. Заглушка — прессом из железной решётки."
	]
	quest.34C1EC83C942AAFD.title: "Диагональный рецепт не собирается"
	quest.350402D904DEB977.quest_desc: [
		"Орда идёт &cне на базу, а на форпост&r — механический экструдер на месторождении (глава «Сеть форпостов»). Моб у экструдера — &cпровал&r."
		"Форпост выбирается из сети команды: каждый экструдер на месторождении входит в неё сам, список — &e/outposts&r. Без форпостов стадию не начать."
		"Кто далеко — кнопка телепорта к форпосту придёт со стартом. Стены, турели и прожекторы ставьте и там."
		"Повтор — 57: форпост случайный, укрепляйте все."
		"Первое прохождение: &6Ядро бастиона&r."
	]
	quest.350402D904DEB977.title: "Волна 38: Осада форпоста"
	quest.35392A512115E122.quest_desc: [
		"&3Сделай:&r горелку всполоха — латунь мешается только с подогревом."
		"&3Чем:&r пустая горелка — 5 крафтеров крестом: 4 железных листа, незерак в центре. С ней ПКМ по живому всполоху в крепости Незера."
		"&3Где:&r портал — обсидиан (вода на источник лавы) и огниво (миксер). Кормить углём."
		"&3Дальше:&r латунь."
	]
	quest.35392A512115E122.title: "Горелка всполоха"
	quest.359D349B31911454.quest_desc: [
		"Шкала &dрассудка&r у хотбара. Низко — видения, у нуля тьма начинает убивать."
		"&cТает:&r темнота, монстры рядом (злые — вдвое быстрее), урон, дождь и вода, голод, переход в другое измерение, удар молнии; гнилая плоть и паучий глаз."
		"&aЛечат:&r горящий костёр в 5 блоках, свет, сон, питомец, друзья в здравом уме, ковёр и тропинка под ногами, мёд, золотая морковь и яблоки, таблетки."
		"У алтаря во время набега рассудок держится на уровне начала набега."
	]
	quest.359D349B31911454.title: "Справка: рассудок"
	quest.36276A9BB7F78AA3.quest_desc: [
		"&3Сделай:&r складской контроллер — один вход на весь склад."
		"&3Чем:&r 2 компаратора, камень, доски, деревянное хранилище (R). Хранилища Sophisticated вплотную + контроллер = один склад; шлюзы Create с ним работают."
	]
	quest.36276A9BB7F78AA3.title: "Складской контроллер"
	quest.363F2895D397D822.quest_desc: [
		"Духов ранит &dтолько магия&r: посохи, заклинания Iron's Spells, зелья вреда."
		"Повтор — 52."
		"Первое прохождение: &6Эссенция духа&r."
	]
	quest.363F2895D397D822.title: "Волна 32: Духи"
	quest.3657C1A4FAB03885.quest_desc: [
		"&e/arena&r — отдельное измерение: коридор 21 × 128 блоков под стеклянной крышей, вокруг — каньон. Алтарь у входа, орда выходит из ворот в дальнем конце. Назад — &e/arena&r ещё раз."
		"Стены, пол, крыша и фонари &aне ломаются&r: ни грызением, ни подрывниками. Пол ровный — турели ставь куда угодно. Фантомы и летуны из-под крыши не улетят."
		"{@pagebreak}"
		"Строй турели, щит, ловушки — постройки сохраняются между набегами. После набега арена &aоткатывается&r к снимку в момент выхода орды: взрывы и боссы следов не оставят."
		"Откатываются &eблоки&r. Сундуки, заряд батарей и патроны — как в конце набега (без дюпа), сломанное хранилище вернётся пустым. Големы и драконы — мобы, их откат не спасает."
		"Ток с базы — передатчиком энергии Ender Transmission. Волны общие с базой, а провал на арене стоит &aодно сердце&r проклятия — это полигон."
		"&7&o— Отдел по работе с ордой: «На арене ядерка разрешена. Всё равно потом откатим».&r"
	]
	quest.3657C1A4FAB03885.title: "Арена"
	quest.36689E871BD9E1C6.quest_desc: [
		"&3Сделай:&r сетевой контроллер — решает, в кого стрелять."
		"&3Чем:&r рецепт съедает три фильтра. Передатчиком ПКМ по контроллеру, затем линки к монитору, радару и контроллеру оружия."
		"Свой фильтр целей: Auto Target и Mob — вкл, Animal — выкл, иначе пушка палит по коровам."
		"&7&o— Столовая благодарит оборону за 40 кг говядины. Просит больше так не делать.&r"
	]
	quest.36689E871BD9E1C6.title: "Сетевой контроллер"
	quest.3674C97A553636B1.quest_desc: [
		"Справка: вентилятор обрабатывает то, что на депо, на ленте или в потоке. Режим — блок перед ним:"
		"&eВода&r — промывка (руда, гравий, песок)"
		"&eОгонь, костёр&r — копчение (еда)"
		"&eЛава&r — плавка (дроблёная руда, песок)"
		"&eОгонь душ&r — призрачная обработка"
		"Скорость прибавляет дальность, не быстроту. Сырую руду поток не плавит."
	]
	quest.3674C97A553636B1.title: "Справка: вентилятор — четыре режима"
	quest.3683F15199866889.quest_desc: [
		"&3Сделай:&r диффузор — разносит кислород по герметичному корпусу; тратит по размеру лодки, включается сигналом."
		"&3Чем:&r механические крафтеры: 2 фильтра воздуха, пропеллер, форсунка, осушитель, 2 электронные лампы, 2 редстоун-связи."
		"&3Где:&r фильтр воздуха — форпост «Торфяник»."
		"Дыра в обшивке — удушье догонит: сначала герметичность."
	]
	quest.3683F15199866889.title: "Кислородный диффузор"
	quest.369117D4B69EA320.quest_desc: [
		"&3Сделай:&r пройди список — потом Пробел. Задача — светокаменные факелы: обычные без воздуха гаснут (миксер: светокаменная пыль + железный слиток → 4)."
		"• Все 4 части скафандра на тебе, нагрудник заправлен."
		"• В станции Атлас, «Поверхность» (не Orbit), «Save destination»; Fuel, Thrusters, Heat Shielding — в норме."
		"• Топлива и на обратный путь; с собой кирка, еда, бумага, запас кислорода."
		"• К планетам — межпланетный навигатор на борту, к нашим — звёздный у каждого. Все пассажиры — внутри ракеты."
		"{@pagebreak}"
		"Посадка без автопосадки: держи Пробел, пока скорость внизу зелёная (до 5 м/с), иначе взрыв. «Use Rocket Controls to slow down!» — ПКМ по контроллеру и Пробел."
		"Садишься в те же X и Z, на верхний блок — или на маяк."
		"&7&o— Техника безопасности: вакуум прощает ровно одну ошибку. Последнюю.&r"
	]
	quest.369117D4B69EA320.title: "&eЧек-лист перед стартом&r"
	quest.36DE1D2FAB859594.quest_desc: [
		"&3Сделай:&r прибор ночного видения — видеть в темноте без факела."
		"&3Чем:&r крафтеры, рецепт — R в JEI; затем модуль + шлем."
		"&cРассудок считает свет вокруг&r, а не то, что ты видишь: от «тьма убивает» прибор не спасает."
		"&7&o— Отдел кадров: «За то, что вы увидели в темноте, отдел кадров не отвечает».&r"
	]
	quest.36DE1D2FAB859594.title: "Прибор ночного видения"
	quest.36EC191493CF8DB8.quest_desc: [
		"Как называются вещи в книге и как их искать в JEI."
		"&eкрафтер&r — Механический сборщик; &eзаглушка&r — Заглушка слота сборщика"
		"&eмиксер&r — Механический смешиватель (над &eчашей&r)"
		"&eдеплоер&r — Автономный активатор; &eдозатор&r — Дозатор"
		"&eгорелка&r — Горелка всполоха; &eэкструдер&r — Механический экструдер"
		"&eгенератор&r — Генератор переменного тока; &eмедная катушка&r — провод C\\&A"
		"&eмалый / большой соединитель&r — Низковольтный / Высоковольтный соединитель"
		"&eэлектризатор&r — Обыкновенный электризатор (зарядка, New Age)"
		"{@pagebreak}"
		"&eВолна&r — номер набега (1–100), выбираешь у алтаря. &eПодволна&r — часть волны."
		"&eОсобая стадия&r — волна с условием (22, 24, 26…): орду берёт только ток, только машины или только магия; или задача на время."
		"&eЭтап&r — ступень этой главы (1–12). &eШаг&r — ступень главы «Энергия»."
		"&eФорпост&r — экструдер на месторождении в своём биоме. &eEMC&r — валюта стола трансмутации."
	]
	quest.36EC191493CF8DB8.title: "Словарь смены"
	quest.37465D86CBD5D438.quest_desc: [
		"&3К концу этапа:&r колёса дробят руду (×1,5 к выходу), экструдер выдавливает рудную породу без кирки."
		"• &eДробильные колёса:&r сборка 5×5 — &e21 крафтер&r (в ящике 9; крафтер — лампа, латунный корпус, мёртвый верстак столбиком). Пара колёс крутится навстречу."
		"• &eДроблёная руда&r → промывка (самородки + побочка) или вентилятор сквозь лаву."
		"• &eЭкструдер:&r миксер — 3 стекла, андезитовый корпус, вал. По бокам вода и лава, снизу блок нужной породы."
		"• &eРудная порода:&r сбоку блок железа и лава → кримзит; колёсами — железо. Груда руды снизу — вдвое быстрее."
		"{@pagebreak}"
		"{\"text\": \"▶ Дробильные колёса\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7171E67739DF54DC\"}}"
		"{\"text\": \"▶ Экструдер\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2DC6D6DFEA84D5FC\"}}"
		"{\"text\": \"▶ Рудная порода\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"381CF6B331367254\"}}"
		"&3Дальше:&r этап 6 — пар."
	]
	quest.37465D86CBD5D438.title: "Этап 5 · Завод: руда без шахты"
	quest.381CF6B331367254.quest_desc: [
		"&3Сделай:&r рудную породу — металл без шахты."
		"&3Чем:&r экструдер: сбоку блок металла (не тратится) и лава, снизу булыжник. Железо → кримзит, медь → веридий, цинк → азурин, золото → охрум."
		"&3Дальше:&r катализатор."
	]
	quest.381CF6B331367254.title: "Рудная порода"
	quest.38B96CB993ED1D01.quest_desc: [
		"&3Сделай:&r медь и цинк для латуни."
		"&3Где:&r медь — промывка красного песка или стол (512 EMC); цинк — стол (512 EMC), азурин в жернове (6 %), сито по гравию (10 %)."
		"&3Дальше:&r латунь."
	]
	quest.38B96CB993ED1D01.title: "Медь и цинк"
	quest.38BFD00AD522076F.quest_desc: [
		"&3Сделай:&r линию электрической меди — сколько угодно."
		"&3Чем:&r деплоер держит заряд (ПКМ зарядом или воронкой), под ним депо или лента с медными слитками — молния бьёт по каждому. Заряд &aне тратится&r."
		"&3Дальше:&r копи электромедь."
		"&7&oМолния бьёт в одно место и дважды, и десять тысяч раз. Мы проверили.&r"
	]
	quest.38BFD00AD522076F.title: "Молния в деплоере"
	quest.3947E4DD03FEF6DA.quest_desc: [
		"&3Сделай:&r ракетница — тяжёлым мобам тяжёлый ответ."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Ракета: 5 + взрыв &e20&r, радиус 4, &cломает блоки&r. Малая — взрыв 8, 5 за сборку. Магазин на 4. Насадка «баллистазука» стреляет копьями по 20."
		"&3Дальше:&r всполохомёт."
		"&7&oСамая частая причина смерти ракетчика — стена в двух шагах. Своя.&r"
	]
	quest.3947E4DD03FEF6DA.title: "Ракетница"
	quest.394B0D9B5D293247.quest_desc: [
		"&3Сделай:&r серную пыль — для оружейного пороха и резины. Других источников серы нет."
		"&3Где:&r бесплодные земли или пещеры ниже −12: жёлтое озеро жидкой серы, над ним дым."
		"&3Чем:&r экструдер на берег-источник, сбоку жидкая сера (ведро из озера) и вода → серная корка → дробилка: 2 пыли (+50 % третья)."
		"&3Дальше:&r оружейный порох, резина."
	]
	quest.394B0D9B5D293247.title: "Серный источник"
	quest.39ADAE75A36F405C.quest_desc: [
		"&3Сделай:&r магазин — большая пушка стреляет трижды подряд без ручной зарядки."
		"&3Чем:&r к собранному креплению; в каждую из трёх колонок — снаряд и заряженная гильза. Цикл стартует, когда готовы все три; гильзы выходят под воронку. Рецепт — R в JEI."
	]
	quest.39ADAE75A36F405C.title: "Магазин на 3 выстрела"
	quest.39D69EF54E4A1273.quest_desc: [
		"&e/arena endless&r (на арене, с 5-й пройденной волны) — подволны вашей лучшей обычной волны идут &eпо кругу без конца&r. Каждый круг орда на 15 % толще, на 8 % злее и на 10 % многочисленнее."
		"Забег кончается, когда прочность алтаря кончилась (или &e/arena endless stop&r). &aПроклятия нет&r."
		"{@pagebreak}"
		"Добыча — бросок за каждую пройденную подволну (до 40) и &dартефакт смены&r за каждые 5. Лучший забег — &6рекорд арены&r, всем в чат."
		"&7&o— Отдел по работе с ордой: «Рекорд — это когда орда устала раньше вас».&r"
	]
	quest.39D69EF54E4A1273.title: "Арена: выживание"
	quest.39E1B145A85F9274.quest_desc: [
		"&3Сделай:&r посох сплава — ударная волна радиусом 10: 30 урона, отброс, замедление."
		"&3Чем:&r крафтеры: «сплав | волшебный слиток | сплав», под ним 2 латунных стержня. Волшебный слиток — 8 эссенций вокруг слитка."
		"&3Дальше:&r посох равновесия."
	]
	quest.39E1B145A85F9274.title: "Посох сплава"
	quest.3A41ED9C7325801D.quest_desc: [
		"Справка: шанс артефакта волн за победу и уровни выпавшего, обычное прохождение."
		"Цвет — уровень: &fобычный&r, &aредкий&r, &9сверхредкий&r, &5эпический&r, &6легендарный&r, &cмифический&r, &bбожественный&r."
		"&eВолна 1&r — 8 %: &f78&r · &a22&r"
		"&eВолна 15&r — 15,4 %: &f55&r · &a30&r · &912&r · &53&r"
		"&eВолна 30&r — 23,2 %: &f38&r · &a30&r · &920&r · &510&r · &63&r"
		"&eВолна 50&r — 33,7 %: &f24&r · &a25&r · &924&r · &515&r · &69&r · &c4&r"
		"&eВолна 70&r — 44,2 %: &f14&r · &a19&r · &924&r · &520&r · &614&r · &c9&r"
		"{@pagebreak}"
		"&eВолна 100&r — 60 %: &f6&r · &a12&r · &920&r · &524&r · &619&r · &c16&r · &b3&r"
		"&e∞10&r — 72,5 %: &f5&r · &a11&r · &919&r · &524&r · &620&r · &c16&r · &b4&r"
		"&e∞20&r — 85 %: &f4&r · &a10&r · &918&r · &524&r · &621&r · &c17&r · &b6&r"
		"Первое прохождение — шанс ×1,5 (до 95 %), каждая 10-я волна — наверняка. Арена и трофеи боссов — отдельные броски."
	]
	quest.3A41ED9C7325801D.title: "Шансы по волнам"
	quest.3A7FEC2616BCC8B5.quest_desc: [
		"&3Сделай:&r найди яйцо дракона."
		"&3Где:&r только сундуки построек — порода по постройке (справка «Породы»); нетронутые старые постройки годятся."
		"Позже: клетка Caged Mobs с Эндер-драконом роняет чешую, 9 чешуек — пресс над чашей → яйцо."
		"&3Дальше:&r вылупление."
	]
	quest.3A7FEC2616BCC8B5.title: "Яйцо дракона"
	quest.3ABA8B0AC43708FC.quest_desc: [
		"&cЕст:&r темнота (ночью под небом тоже), монстры рядом, урон, дождь и вода, голод, переход в другое измерение."
		"&aЛечат:&r костёр в 5 блоках, свет, сон, питомец и друзья рядом, сытная еда, мёд, золотая морковь, таблетка «Успокоительное» (+25 %)."
		"У алтаря во время набега рассудок не падает."
		"Таблетки — миксер со спорой (форпост «Грибные пещеры») или лавка фактории. До спор — травяной чай (+8 %): миксер над нагревом, 2 цветка + листва + сахар + вода."
	]
	quest.3ABA8B0AC43708FC.title: "Рассудок быстро падает"
	quest.3ACD1946BC62D931.quest_desc: [
		"&3Сделай:&r туф, кальцит, капельник."
		"&3Чем:&r туф — миксер: андезит + диорит → 2. Кальцит — пресс над чашей: гравий + 3 костной муки. Капельник — миксер: кальцит + 200 мБ воды."
	]
	quest.3ACD1946BC62D931.title: "Туф, кальцит, капельник"
	quest.3AFD165303DC1F36.quest_desc: [
		"&3Сделай:&r эссенция волшебства — сырьё всей магии."
		"&3Чем:&r миксер с нагревом: лазурит + осколок аметиста + светопыль + самородок опыта."
		"&3Где:&r самородки опыта — побочка дробления руд; аметист — миксер с нагревом (кальцит + кварц + вода)."
		"&3Дальше:&r книга заклинаний, мантия."
	]
	quest.3AFD165303DC1F36.title: "Эссенция волшебства"
	quest.3B3BC2D592599387.quest_desc: [
		"&3Сделай:&r пневмомолот — бьёт полукругом до 6 мобов, достаёт на 5 блоков."
		"&3Чем:&r крафтеры (R в JEI); головка — миксер из камня, железа или алмазов."
		"Головка молота: камень 5, железо 7, алмаз 9, незерит 11, копает 3×3. Головка топора — 1 цель, 9–15. ПКМ — пневмоудар: +6 урона, 20 воздуха из медного баллона (в молоте 900)."
		"&3Дальше:&r незеритовая головка."
		"{\"text\": \"▶ Волна 16: стаи пауков — бей по площади\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3D598A57FF05CC24\"}}"
		"&7&oКогда в руках молот, всё вокруг похоже на зомби. Особенно зомби.&r"
	]
	quest.3B3BC2D592599387.title: "Пневмомолот"
	quest.3B7D9C7933E1D1BB.quest_desc: [
		"&3Сделай:&r улучшение — свойство голему: огнестойкость, защита от молний, размер…"
		"&3Чем:&r пустое улучшение — крафтеры: аметист в центре, железо крестом, глина по углам; остальные — U в JEI по пустому."
		"Ставит &eдеплоер&r: держатель на депо, улучшение в руке."
		"&3Дальше:&r бессмертный голем."
	]
	quest.3B7D9C7933E1D1BB.title: "Улучшения"
	quest.3B9FFE578028950D.quest_desc: [
		"&3Сделай:&r тихий ток — &6500 FE/т&r на каждый камень речного порога (порог из 5 — 2 500)."
		"&3Где:&r порог — гряда из 3–5 замшелых камней поперёк реки, на блок ниже глади, над ней пена. Генератор ставь на камень — в воде, сверху воздух для соединителя."
		"&3Чем:&r крафтеры: генератор переменного тока, андезитовый корпус, водяное колесо, 2 винта, 2 электромеди."
	]
	quest.3B9FFE578028950D.title: "Гидрогенератор"
	quest.3BCE829443992885.quest_desc: [
		"&3Сделай:&r бумажные патроны для самопала."
		"&3Чем:&r сборка по шагам: бумага → деплоер с оружейным порохом → деплоер со свинцовым самородком → 4 (миксером — 3)."
		"&3Где:&r оружейный порох — миксер: серная пыль + порох + древесный уголь → 3; в патроны идёт только он."
		"{\"text\": \"▶ Серный источник\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"394B0D9B5D293247\"}}"
		"&3Дальше:&r сталь для ружей."
		"&7&o— Бухгалтерия: «Патроны списываются по факту выстрела. Промахи — тоже».&r"
	]
	quest.3BCE829443992885.title: "Бумажные патроны"
	quest.3BDAFF239C4D72AE.quest_desc: [
		"&3Что:&r орда идёт на один из ваших форпостов; моб у экструдера — провал. Без форпостов стадию не начать."
		"&3Построй к ней:&r стены, турели и прожектор у каждого форпоста (список — /outposts). Со стартом придёт телепорт к форпосту."
		"&3Ключ:&r ядро бастиона — оборона форпостов. Повтор — 57: форпост случайный."
	]
	quest.3BDAFF239C4D72AE.title: "Волна 38 · Осада форпоста"
	quest.3C2F126B4119545E.quest_desc: [
		"Цифры метеорита — чтобы планировать вылет."
		"&eКак часто&r — раз в 2–3 игровых дня с 10-й пройденной волны; после победы в набеге — &640 %&r на внеочередной утром."
		"&eГде&r — 400–900 блоков от алтаря, не ближе 200 к любому алтарю и 64 к зоне базы. На постройки не падает."
		"&eРуда&r — &66&r блоков, +1 за каждые 15 пройденных волн (до 10)."
		"{@pagebreak}"
		"&eСтража&r — 3 моба, +1 за каждые 12 пройденных волн (до 7), +1 за игрока сверх первого (до +2). Летунов 1, с 30-й волны 2. Здоровье +3 % за пройденную волну, Страж вдвое крепче."
		"Все дальше 160 блоков минуту — стража уходит; убитые не воскресают. Руда выбрана — метеорит закрыт."
	]
	quest.3C2F126B4119545E.title: "Справка: метеорит"
	quest.3C83F989C78C435A.quest_desc: [
		"&3Сделай:&r деплоер — руки вахтовика в машине: ставит, кликает, бьёт."
		"&3Чем:&r миксер: андезитовый корпус + латунная рука + электронная лампа. Дай предмет (ПКМ) — работает им по клетке в 2 блоках впереди."
		"Механическая рука: ПКМ ею по источникам (синие), потом по приёмникам (жёлтые), потом поставь. Деплоеры над лентой — сборка по шагам."
	]
	quest.3C83F989C78C435A.title: "Деплоер и механическая рука"
	quest.3CC38EECAC712063.quest_desc: [
		"&3Сделай:&r бесконечные гравий, песок и пыль."
		"&3Чем:&r булыжник экструдера → жернов → гравий → колёса → песок → жернов → пыль. Песок в печь — стекло."
	]
	quest.3CC38EECAC712063.title: "Гравий, песок и пыль"
	quest.3D598A57FF05CC24.quest_desc: [
		"&3Что:&r первая волна только из мобов модов: стаи пауков-шнырей и паучий выводок — быстрые, хлипкие, лезут по стенам; мёрзлые зомби."
		"&3Построй к ней:&r козырёк или крышу над алтарём, урон по площади — пневмомолот (до 6 мобов за удар), всполохомёт, гранаты; пилу в полу коридора."
		"Не давай выводку копиться у алтаря. Застрявших мобов набега подсвечивает через 20 с."
		"{\"text\": \"▶ Козырёк от пауков\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3E607BBDA9DA7D25\"}}"
	]
	quest.3D598A57FF05CC24.title: "Волна 16 · Ночь шнырей"
	quest.3D93F7DA49468431.quest_desc: [
		"Мана и клавиши."
		"Мана — полоска у хотбара, +1 % от максимума за полсекунды. Больше маны — мантии, робы, кольцо, сферы маны."
		"&eR&r — колесо заклинаний, &eV&r — применить, &eAlt + колёсико&r — листать. Заняты другими модами — переназначь: Управление → «Iron's Spells 'n Spellbooks - Основное»."
	]
	quest.3D93F7DA49468431.title: "Справка: мана и клавиши"
	quest.3DB74392F6E9D921.quest_desc: [
		"Месторождения появляются только в &eновых, ещё не открытых&r землях, каждое в своём биоме: светящееся пятно 5–10 блоков, над ним дым или искры. Биом ищет природный компас, приметы — в главе «Сеть форпостов»."
		"Экструдеры на месторождениях с координатами — &e/outposts&r."
		"Без загрузчика чанков форпост спит, пока тебя нет рядом."
	]
	quest.3DB74392F6E9D921.title: "Форпост не найти"
	quest.3DCA31B7087B87A2.quest_desc: [
		"Арена меняет облик по номеру волны: на старте набега, если тема другая, за отсчёт перестраиваются стены, крыша, ворота, ландшафт и даже погода. Пол и ваши постройки не трогаются."
		"У каждой темы свой &eприкол&r — эффекты на время набега на арене (дома их нет)."
		"{@pagebreak}"
		"&7Шахта&r (1–15) — без сюрпризов."
		"&6Каньон пауков&r (16–29) — вам «Спешка II», орде «Скорость I»."
		"&bВечная мерзлота&r (30–44) — снег; вам «Скорость I», орда медленнее, но с «Сопротивлением II»."
		"&cПекло&r (45–59) — пепел, орда горит и злее («Сила I»), вам огнестойкость."
		"{@pagebreak}"
		"&dКрай&r (60–69) — низкая гравитация: вы прыгаете выше и падаете медленно, но и орда скачет через стены в два блока."
		"&3Кошмар&r (70–99) — тьма накатывает каждые 30 с, зато орда светится."
		"&5Звёздная бездна&r (100+) — вам «Регенерация I», орде «Сопротивление II»."
		"&7&o— Отдел по работе с ордой: «Обстановку меняем, чтобы вам не было скучно умирать в одном и том же интерьере».&r"
	]
	quest.3DCA31B7087B87A2.title: "Темы арены"
	quest.3DF6876E559D757D.quest_desc: [
		"&3Что:&r особая стадия — ручное оружие броню не берёт."
		"&3Построй к ней:&r турели, пушки Create Big Cannons, тесла-башни, големы, деплоеры с мечами, взрывы."
		"&3Ключ:&r бронеплита ОТК — тяжёлая оборона. Повторы — 48, 68."
		"{\"text\": \"▶ Лазерная турель\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"65EBFC16CC926C3D\"}}"
	]
	quest.3DF6876E559D757D.title: "Волна 26 · Бронеколонна"
	quest.3E4C124CD10EBD6D.quest_desc: [
		"&3Сделай:&r пульт — режимы, склад и вызов дронов издалека."
		"&3Чем:&r механические крафтеры: электронная лампа; латунный лист, механизм точности, латунный лист; электромедь."
		"ПКМ — окно ближайшего дрона, рядом никого — позвать всех (прилетят хоть из другого измерения). Shift+ПКМ в воздух — следующий режим."
		"Shift+ПКМ по сундуку или хранилищу — &eсклад&r: туда дрон сам сдаёт полный трюм, оттуда привозит заказанное."
	]
	quest.3E4C124CD10EBD6D.title: "Пульт дрона"
	quest.3E4DC2FF5F9E9A11.quest_desc: [
		"&3Сделай:&r оболочки аэростата: дирижабль держит воздух в шаре, тяга вверх не нужна."
		"&3Чем:&r деплоер с баллоном гелия над шерстью → 4 оболочки."
		"&3Где:&r гелий — «Высотный конденсатор»; он только в рецепте, шар поднимает горячий воздух горелки."
		"Воздух держат пустые клетки внутри, сверху вниз. Вал сквозь оболочку — «вал в оболочке» того же цвета."
		"&3Дальше:&r горелка."
	]
	quest.3E4DC2FF5F9E9A11.title: "Оболочка аэростата"
	quest.3E5CB0645B9A0F13.quest_desc: [
		"Звук объёмный: слышно, откуда шорох и за какой стеной шаги. Играйте в наушниках."
		"Не всё, что слышишь и видишь, — правда: даже «свой» может оказаться не своим. Договоритесь о кодовом слове."
	]
	quest.3E5CB0645B9A0F13.title: "Справка: прислушивайся"
	quest.3E607BBDA9DA7D25.quest_desc: [
		"&3Сделай:&r козырёк — плиты, нависающие наружу поверх стены, или крышу над коридором и алтарём."
		"Пауки лезут по стенам, зомби встают друг другу на головы — козырёк обрывает обоих. С 16-й волны пауков ArPhEx много: крыша окупится."
		"{\"text\": \"▶ Волна 16 · Ночь шнырей\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3D598A57FF05CC24\"}}"
		"&7&o— Техника безопасности: паук на потолке — это не баг, это паук.&r"
	]
	quest.3E607BBDA9DA7D25.title: "Козырёк от пауков"
	quest.3E8C22C1E7E253B1.quest_desc: [
		"&3Сделай:&r объёмный ферментер (бочка + 2 сплава) — этанол без нефти."
		"&3Чем:&r сахар, тростник, яблоки, картофель, лук или томаты + костная мука → 400 мБ."
		"&7&o— Столовая: «Картошку со склада не брать. Она ушла на топливо».&r"
	]
	quest.3E8C22C1E7E253B1.title: "Топливо без нефти"
	quest.3EB3DCC9CCA7B9A5.quest_desc: [
		"&3Сделай:&r тепло без топлива — когда тока много."
		"&3Чем:&r крафтеры: 4 медных листа, медная катушка, конденсатор, 2 тепловые трубы, электромедь. Ток и трубы — с любой стороны."
		"&3Сколько:&r &63 FE/т&r за 1 тепло/с, до 600/с. Нагреватель на обычном — 600 FE/т, на суперогне — 1 650. Сеть горячая — ТЭН ждёт и ток не тратит."
	]
	quest.3EB3DCC9CCA7B9A5.title: "ТЭН: тепло из тока"
	quest.3EC55E8A9E16874C.quest_desc: [
		"&3Сделай:&r каменный меч — отбиться в первую ночь."
		"&3Чем:&r крафтеры, раскладка как на верстаке."
		"Урон: &eкамень&r 5, &eжелезо&r 6, &eалмаз&r 7, &eнезерит&r 8 — с полного замаха (раз в 0,6 с). Мечи модов: латунный 5, стальной TFMG 6, марсианский 9."
		"&3Дальше:&r пневмомолот, лук, щит."
		"{\"text\": \"▶ Этап 3: алтарь и первые волны\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2B5D5FE8FC36C5DE\"}}"
	]
	quest.3EC55E8A9E16874C.title: "Первый клинок"
	quest.3EF185CC86F74D92.quest_desc: [
		"&3Сделай:&r накопи &615&r жетонов — «Премия смены» в лавке: +50 % добычи за следующую победу."
		"&3Где:&r плата падает в кассу терминала: объём × дальность. На 15-й волне обычный заказ ≈ &620&r жетонов, дальняя фактория платит на пятую часть больше."
		"За EMC жетоны не продаются и не покупаются."
		"&3Дальше:&r лавка (справка), полная касса."
		"&7&o— Бухгалтерия: «Жетон нельзя переплавить. Мы проверяли. Дважды».&r"
	]
	quest.3EF185CC86F74D92.title: "Касса на премию"
	quest.3F32929BF605AE5F.quest_desc: [
		"Волны 35–49: крабы-душители, &cПещерный житель&r, пауки-похитители, голиафы, паучья моль, осы, жнецы. Боссы: 35 — &4Скорпиоид-кровопийца&r (летает), 40 — &4Пустотный драконохвост&r (летает), 45 — &4Арахноид-трисектор&r."
		"Готовьтесь: зенитные турели, обсидиан на опасных участках стены, энергощит и артефакты. Это последняя эпоха ручного оружия — дальше нижний ряд."
	]
	quest.3F32929BF605AE5F.title: "Волна 40: Драконохвост"
	quest.3F54E637A97857D1.quest_desc: [
		"Справка: трофеи боссов ArPhEx — каждая 5-я волна с 15-й по 65-ю."
		"Падают за победу на волне с боссом: легендарный 15 %, мифический 10 % каждому; первое прохождение — наверняка одному из вас."
		"{@pagebreak}"
		"&6Хитин матриарх&r — +4 брони, +2 прочности брони, нет яда и некроза. &7Голиаф (15), матриарх (20, 55).&r"
		"&6Панцирь подземного короля&r — +10 HP, +2 брони, +30 % к отбрасыванию, +25 % к копанию. &7Термитный король (25), Артроплевра (30, 55).&r"
		"&6Жало скорпиоида&r — вампиризм 8 % (до 3 HP), удары: Яд II и Замедление I на 3 с. &7Скорпиоид (35, 60).&r"
		"&6Хвост драконохвоста&r — +15 % скорости, нет сверхтяжести и хаоса, ударившему вплотную Слабость II на 4 с. &7Драконохвост (40, 65).&r"
		"&cКлинок трисектора&r — +4 урона, +15 % скорости атаки. &7Трисектор (45, 60).&r"
		"&cРог диаболоса&r — +6 HP, +3 урона, убийство лечит 4 HP. &7Диаболос (50, 65).&r"
	]
	quest.3F54E637A97857D1.title: "&6Трофеи боссов ArPhEx&r"
	quest.3F888219989CE6F3.quest_desc: [
		"&3Сделай:&r пройди любую трассу — от золотого кольца до красного."
		"&3Чем:&r самолёт, дракон или элитры с ракетами. &e/race list&r — трассы и кнопка «Старт»: таймер пойдёт сам, когда пролетишь стартовое кольцо."
		"&3Где:&r над хотбаром — кольцо N из M, время и стрелка; следующее кольцо горит зелёным, на каждом — разница с рекордом."
		"&3Дальше:&r рекорд трассы."
	]
	quest.3F888219989CE6F3.title: "Заезд по кольцам"
	quest.40348BF0E706ABFC.quest_desc: [
		"&3Сделай:&r купи что-нибудь у снабженца. Валюта — жетоны смены: их платят фактории за заказы."
		"&3Где:&r раз в 2–3 игровых дня утром приходит к алтарю базы с двумя ламами и стоит сутки. Над хотбаром — объявление, в журнале смены — запись, в первый раз — метка Xaero. Где он сейчас — &e/trader&r."
		"&3Дальше:&r Ящик снабжения и карта клада."
		"{\"text\": \"▶ Справка: что привозит\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"694F131770861161\"}}"
	]
	quest.40348BF0E706ABFC.title: "Странствующий снабженец"
	quest.404F6AAA2C0EB4E3.quest_desc: [
		"&3Сделай:&r андезитового голема — помощник с прессом, не боец."
		"&3Чем:&r пресс по промышленному железному блоку → шляпа; шляпу — на блок андезитового сплава."
	]
	quest.404F6AAA2C0EB4E3.title: "Андезитовый голем"
	quest.40A90820DDCB08CC.quest_desc: [
		"Рассудок 3 % и ниже в кромешной тьме — &c1 сердце каждые 2 секунды&r, броня не спасает."
		"Спасает: выйти к свету, взять в руку факел или фонарь, съесть таблетку. После такой смерти рассудка чуть больше, чтобы не умирать по кругу."
		"&7&oТьма не кусается. Она просто ждёт, пока ты кончишься сам.&r"
	]
	quest.40A90820DDCB08CC.title: "Справка: тьма убивает"
	quest.40A93CAB5BCB6AF7.quest_desc: [
		"&3Сделай:&r лук или арбалет — бить из-за стены, пока нет пороха."
		"&3Чем:&r крафтеры, раскладка как на верстаке; стрелы — тоже."
		"Лук: натяг 6, крит до 10, Сила V — +150 %. Арбалет держит заряд, с Пронзанием прошивает строй."
		"&3Дальше:&r свинец и самопал."
	]
	quest.40A93CAB5BCB6AF7.title: "Лук и арбалет"
	quest.40BC59080DC10129.quest_desc: [
		"&3Сделай:&r на одной штуковине — пропеллер, двигатель, штурвал с подшипником, тяговый рычаг. Встань на борт, дай газ."
		"Не летит — очки покажут, сколько тяги не хватает: ещё винт или рама полегче."
		"&3Дальше:&r крылья, реактивный двигатель."
		"&7&oЕсли самолёт не взлетел — это не провал, а очень короткий полёт.&r"
	]
	quest.40BC59080DC10129.title: "Взлёт!"
	quest.40C50273936EC3A2.quest_desc: [
		"&3Сделай:&r залей бензин (задача — ведро) и запусти двигатель: трубы к корпусу тянут топливо из баков."
		"Мощность — в очках: топливо, цилиндры, газ."
		"&7&oДвигатель внутреннего сгорания: внутри горит топливо, снаружи — дедлайны.&r"
	]
	quest.40C50273936EC3A2.title: "Мотор на ходу"
	quest.413A163084692EA3.quest_desc: [
		"&3Сделай:&r двигатель TFMG (до 5 блоков в ряд): 2 стальных слитка, корпус тяжёлой машины, 3 тяжёлые пластины → 2."
		"Детали — по очереди, подскажут очки: ПКМ валом — выход, коленвал, цилиндры."
		"Пустая схема меняет цилиндры: обычные — бензин, керосин, нафта; дизельные; газовые; простые — креозот, печной газ."
		"Управление — контроллер двигателя: ПКМ по передатчику, потом по двигателю."
	]
	quest.413A163084692EA3.title: "Двигатель TFMG"
	quest.4150BFBBBA5AE66E.quest_desc: [
		"&3Сделай:&r вертолёт: гироскопический подшипник держит пропеллер вверх при крене."
		"&3Чем:&r крафтеры столбиком: плита, механизм гироскопа, алюминиевый лист, латунный корпус. Механизм — сборка по шагам из железного листа (шестерня, вал, латунный самородок, 5 кругов)."
		"Умный пропеллер — винт, сам встающий вверх: пропеллер, механизм, лист, корпус → 2."
	]
	quest.4150BFBBBA5AE66E.title: "Гироскоп: вертолёт"
	quest.4258DA3E82C76B90.quest_desc: [
		"Справка: &fобычные&r артефакты волн — с 1-й волны."
		"&fЗаплатка вахтовика&r — +4 HP."
		"&fЖетон смены&r — +1 брони, +5 % скорости."
		"&fТермос бригадира&r — вне боя +0,5 HP/с (через 5 с без урона)."
		"Шанс каждого за победу: ≈2,1 % на 1-й волне, ≈2,8 % на 15-й, ≈2,7 % на 50-й, ≈1,2 % на 100-й."
	]
	quest.4258DA3E82C76B90.title: "&fОбычные&r артефакты"
	quest.42B84590A81466C4.quest_desc: [
		"&3Сделай:&r точку возрождения: умер — проснёшься здесь, а не у спавна мира."
		"&3Чем:&r миксер: 3 доски + 3 шерсти одного цвета (квест ждёт красную)."
		"Сон возвращает часть рассудка. В ночь набега не поспать: алтарь держит ночь до конца волн."
		"&3Дальше:&r пережить первую ночь."
	]
	quest.42B84590A81466C4.title: "Точка возрождения"
	quest.43011314638F3A38.quest_desc: [
		"&3Сделай:&r таблетки рассудка — &e+25 %&r сразу, есть можно и сытым."
		"&3Чем:&r миксер: сахар + сладкие ягоды + любой маленький цветок + &eцелебная спора&r → 6."
		"&3Где:&r споры — форпост «Грибные пещеры» (пышные пещеры, грибные поля); готовые таблетки — лавка фактории."
		"&3До спор:&r &eтравяной чай&r — миксер над нагревом: 2 маленьких цветка + листва + сахар + 250 мБ воды → 4 чашки по &e+8 %&r."
		"Держи стопку перед шахтой и перед набегом."
	]
	quest.43011314638F3A38.title: "Успокоительное"
	quest.431F293EFF616CE7.quest_desc: [
		"&3Сделай:&r сталь — механизмы TFMG, качалка, двигатели, стволы."
		"&3Быстро:&r миксер с нагревом: 2 железных слитка + уголь → 2 стали Big Cannons. Любая сталь → 9 самородков → пресс → слиток TFMG (R в JEI)."
		"&3Домна&r — поток и стальной механизм: в люк горячий воздух, сверху сырое железо (2 слитка; дроблёная руда — 1) + флюс + пыль. Сталь — в литейную чашу."
		"{\"text\": \"▶ Этап 11 «Пути смены»\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5BBEB820DBEDDA72\"}}"
	]
	quest.431F293EFF616CE7.title: "Первая сталь"
	quest.436EF826D8B38892.quest_desc: [
		"&3Пример:&r андезит и самородки стаками — выходит печь или молот вместо сплава; медь и цинк над горелкой — кираса вместо латуни; булыжник над горелкой — печь вместо лавы."
		"&3Почему:&r из того, что лежит в чаше, она берёт рецепт с бо́льшим числом ингредиентов."
		"&3Что делать:&r положи нужный результат в &eфильтр чаши&r — ячейку на её боку, ПКМ предметом: миксер будет делать только его. Или подавай точные порции."
	]
	quest.436EF826D8B38892.title: "Миксер делает не то"
	quest.4373409747AF32C9.quest_desc: [
		"&3Что:&r в ~280 блоках вырастает гнездо с маткой (~1 400 HP) и стражей. Долететь и убить матку за 8 минут."
		"&3Построй к ней:&r самолёт или дракон на каждого, оружие на матку, лечение."
		"&3Ключ:&r сердце матки — живая броня и трофеи. Повторы — 54, 66."
	]
	quest.4373409747AF32C9.title: "Волна 36 · Штурм гнезда"
	quest.43AB898E82F67601.quest_desc: [
		"&3Сделай:&r самопал — первое ружьё: 10 урона патроном, перезарядка 3,5 с."
		"&3Чем:&r миксер: андезитовый сплав, железная пластина, огниво, окорённое бревно."
		"С картечью — 20 урона вблизи. Штык — колоть, когда кончились патроны. Насадки — клавиша «Изменить обвесы» (справка «Огнестрел»)."
		"&3Дальше:&r револьвер."
		"&7&oПоследний патрон — для зомби. Штык — для следующего.&r"
	]
	quest.43AB898E82F67601.title: "Самопал"
	quest.43B32A69C5B37F32.quest_desc: [
		"&3Сделай:&r энергощит — снимает &e50 %&r урона ДО брони."
		"&3Чем:&r модуль Mk1 — крафтеры (R в JEI); на нагрудник: модуль + нагрудник + электрическая медь."
		"Mk1 — 200 000 FE = 200 единиц урона. Заряжается &cтолько под куполом генератора щита&r."
		"{\"text\": \"▶ Генератор щита\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7FFAED499CB00CC3\"}}"
		"&3Дальше:&r энергощит Mk2."
	]
	quest.43B32A69C5B37F32.title: "&bЭнергощит&r"
	quest.43FE6A7416401283.quest_desc: [
		"&3Сделай:&r нагрев котла теплом вместо горелок и тортов."
		"&3Чем:&r бойлер-нагреватель — миксер: пустая горелка + 2 тепловые трубы + заряженное железо + 4 железных самородка. Ставится под дно бака, тепло — трубами."
		"&3Сколько:&r 100 тепла/с — 1 уровень (как уголь), 400 — 2 (как торт), 500 — &63&r (лучше торта). 500/с солнцем не набрать: это котельная или реактор."
		"&3Дальше:&r котельная или атом."
	]
	quest.43FE6A7416401283.title: "Нагреватель под котлом"
	quest.4423BC3944555606.quest_desc: [
		"Финал «Кузница»: &4Незеритовое чудовище&r и &4Игнис&r разом плюс вся орда: 18 подволн, мобов в 6 раз больше, сами в 1,6 раза крупнее."
		"&6Награда каждому&r: &53 Сердца ночи&r, &e2 звезды Незера&r и сильный артефакт."
		"&7&o— Пресс-служба Axiomativ: «Смена закрыта. Орда уведомлена. Переработка — в Бесконечности».&r"
	]
	quest.4423BC3944555606.title: "Волна 100: финал смены"
	quest.443ADCBE0E31176B.quest_desc: [
		"&3Сделай:&r звёздные карты — контроллер ракеты (3), звёздный и межпланетный навигаторы (по 2), навигационный компьютер."
		"&3Где:&r пики от высоты 200: тёмно-синий камень со звёздами."
		"&3Чем:&r экструдер, по бокам пусто → звёздная пыль. Сборка по шагам: бумага → деплоер с пылью → деплоер со светящимся чернильным мешком → пресс."
		"{\"text\": \"▶ Контроллер ракеты\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5419BEC0D04A20F0\"}}"
	]
	quest.443ADCBE0E31176B.title: "Обсерватория"
	quest.448B006147B5FDA1.quest_desc: [
		"&3Сделай:&r запас тока — &62 млн FE&r на блок; блоки сливаются до 3×3×5 — &690 млн FE&r. Приём и отдача без лимита."
		"&3Чем:&r миксер: латунный корпус + медный стержень + электрумовый провод + 2 конденсатора."
		"&3Где:&r конденсатор — миксер: медный и цинковый листы, факел из редстоуна, 100 мБ электролита (форпост «Солеварня»). Электрум — катушка Теслы (квест «Электризатор»)."
		"&3Дальше:&r мотор — шаг 6. Подключение — соединитель на аккумулятор и провод к сети."
	]
	quest.448B006147B5FDA1.title: "Шаг 5 · Накопитель: аккумулятор"
	quest.44FB9161122A88F5.quest_desc: [
		"&3Сделай:&r газ: тяговый рычаг даёт аналоговый сигнал — зажми ПКМ и потяни. Ключом — инверсия."
		"&3Чем:&r крафтеры: палка над латунным корпусом."
		"Сигнал веди на реверс, сцепление, горелку, двигатели."
		"&3Дальше:&r взлёт."
	]
	quest.44FB9161122A88F5.title: "Газ"
	quest.450C429BEABD7896.quest_desc: [
		"Смена — это не только волны и заводы. Три забавы, за рекорды — жетоны смены:"
		"• &eСнабженец&r — раз в 2–3 дня у алтаря базы: редкости за жетоны (вверх)."
		"• &eГонки по кольцам&r — свои трассы в небе: самолёт, дракон, элитры (вправо)."
		"• &eТир&r — на арене, когда нет набега: мишени, тарелки, спринт (вниз)."
		"&7&o— Отдел кадров: «Отдых — часть смены». Бухгалтерия: «Но жетоны считаем».&r"
	]
	quest.450C429BEABD7896.title: "Развлечения смены"
	quest.46097C31CBD877FE.quest_desc: [
		"&3Сделай:&r электролизёр — кислород из воды (трубами) и тока."
		"&3Чем:&r крафтеры: стекло, пружина, стекло; медный блок, электронная лампа, медный блок; 3 медных блока."
		"&3Дальше:&r диффузор."
		"{\"text\": \"▶ Ток: генератор переменного тока\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0B8DDB0E251F417E\"}}"
	]
	quest.46097C31CBD877FE.title: "Электролизёр"
	quest.461C80366979523A.quest_desc: [
		"&3Сделай:&r двигатель на борт: в воздухе валов с земли нет."
		"&3Чем:&r крафтеры столбиком: железный лист, узел двигателя, доменная печь. Узел — сборка по шагам из железного листа: пила → пресс, 8 кругов, выход ~50 %."
		"Жжёт топливо печи; на торте всполоха — вдвое сильнее."
		"&3Дальше:&r руль."
	]
	quest.461C80366979523A.title: "Портативный двигатель"
	quest.4647E91516588EFE.quest_desc: [
		"Блок базы — фундамент алтаря. Ставится только &eвнутри зоны базы&r; над ним должно быть пусто — там вырастает &5Алтарь смены&r."
		"Рецепт: костёр, резной каменный кирпич и 5 каменных кирпичей (миксер или крафтеры)."
		"Алтарь не ломается. Переезд — сломай блок базы, алтарь уйдёт с ним (идущий набег отменится)."
		"Shift + ПКМ по блоку базы с блоком в руке — просто строить рядом."
		"{@pagebreak}"
		"&7&o— Техника безопасности: алтарь не тушить. Он не для этого горит.&r"
	]
	quest.4647E91516588EFE.title: "Блок базы и алтарь"
	quest.4653E9EEEA38CD03.quest_desc: [
		"&3Сделай:&r стабилитовый слиток — для стабилитовой кирки."
		"&3Чем:&r только межпланетное точило: светлый + тёмный стабилит → 1."
		"&7&o— Отдел по работе с ордой: «Свет и тьма договорились. Орде бы так».&r"
	]
	quest.4653E9EEEA38CD03.title: "Стабилитовый слиток"
	quest.4691150B74DC7B9B.quest_desc: [
		"&3Сделай:&r любое улучшение — в окне дрона три ячейки."
		"&3Чем:&r сборка по шагам из латунного листа, в конце пресс:"
		"&eСкорость&r — пропеллер, механизм точности, электромедь: +25 % в полёте, рейсы на 50 % быстрее."
		"&eТрюм&r — сундук, сундук, латунный лист: +9 ячеек (до 27)."
		"&eБатарея&r — конденсатор, конденсатор, электромедь: +200 000 FE."
	]
	quest.4691150B74DC7B9B.title: "Улучшения дрона"
	quest.4758E9E111669784.quest_desc: [
		"&3Сделай:&r каменную кирку — без камня нет ни андезита, ни металла."
		"&3Чем:&r крафтеры: деревянная кирка (доски сверху, палки столбиком), потом каменная."
		"&3Где:&r в шахте — булыжник, андезит, гранит, уголь. Сырую руду копи впрок: колёса после латуни дадут ×1,5."
		"&3Дальше:&r промывка."
		"&7&o— Техника безопасности: без факела в шахту спускаются один раз.&r"
	]
	quest.4758E9E111669784.title: "Кирка и спуск в шахту"
	quest.475FB140DE9CB6C6.quest_desc: [
		"&3Сделай:&r дробовик — два залпа почти подряд по толпе у стены."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Залп вблизи: дробь 20, флешетты 25, стальные флешетты 30 и пробивают, зажигательный 20 + огонь. Гильзы — как у револьвера, но с бумагой, 4 шт.; деплоер кладёт картечь, гвоздь или огненный порошок."
		"&3Дальше:&r гвоздемёт."
		"&7&o— Техника безопасности: дробовиком не открывают двери. Особенно свои.&r"
	]
	quest.475FB140DE9CB6C6.title: "Дробовик"
	quest.479F0A6AA26C07A3.quest_desc: [
		"&3Сделай:&r алюминий — корпус и пропеллер самолётов, парус-крыло и гироскоп Aeronautics, большой двигатель TFMG."
		"&3Где:&r саванны и плато: рыжий бокситовый пласт."
		"&3Чем:&r экструдер, сбоку вода и блок глины → боксит → дробилка (+50 %) → вентилятор через лаву или печь → слиток."
		"{\"text\": \"▶ Корпус самолёта\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"58CDE5A8D0227B98\"}}"
	]
	quest.479F0A6AA26C07A3.title: "Бокситовый карьер"
	quest.47BFC78988118E45.quest_desc: [
		"&3Что:&r обоз из трёх лам в ~350 блоках идёт к базе, только пока рядом охрана; засада каждые 15 с. Довести хоть одну за 6 минут."
		"&3Построй к ней:&r транспорт до обоза, оружие по площади, лечение."
		"&3Ключ:&r пломба конвоя — грузовая логистика. Повтор — 63."
	]
	quest.47BFC78988118E45.title: "Волна 43 · Конвой"
	quest.47F332A4CE098BA9.quest_desc: [
		"&3Сделай:&r плиту — огонь под кастрюлей и сковородой."
		"&3Чем:&r миксер: 3 железа, 4 кирпича, костёр. Годятся и костёр или горелка всполоха (варит быстрее). Сковорода — миксер: 4 железа + кирпич."
		"&3Дальше:&r суп дня."
	]
	quest.47F332A4CE098BA9.title: "Огонь: плита и сковорода"
	quest.48107DA2A3932792.quest_desc: [
		"&3Что:&r вся орда невидима; видно только в луче прожектора (и ещё 5 с после)."
		"&3Построй к ней:&r прожекторы на подходах к стене, на токе. Турели и тесла бьют только видимых."
		"&3Ключ:&r призменная линза. Повтор — 56 «Блэкаут»: у защитников ещё и «Тьма»."
		"{\"text\": \"▶ Прожектор\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1FD83CEEED53B59F\"}}"
	]
	quest.48107DA2A3932792.title: "Волна 34 · Невидимки"
	quest.48443F5795D4DD05.quest_desc: [
		"&3Сделай:&r одну котельную вместо горелки под каждой чашей и котлом: жар идёт по трубам к нагревателям."
		"&3Чем:&r теплообменник (крафтеры: медный корпус, тепловая труба, 2 медных листа, электромедь) ставится на горелку; трубы — сверху и с боков."
		"&3Сколько:&r горелка на угле — &6200&r тепла/с (один нагреватель на обычный нагрев), на торте — &6400&r. Схема: 4–8 горелок в ряд → общая труба → вентили → нагреватели."
		"&7&oВсполох в котельной греет лучше, чем всполох на свободе. Проверено на всполохах.&r"
	]
	quest.48443F5795D4DD05.title: "Котельная: теплообменник"
	quest.48E420D53A0BA874.quest_desc: [
		"&3Сделай:&r эндерняк без Энда."
		"&3Чем:&r латунный экструдер: синий лёд и лава по бокам, снизу блок эндерняка — один раз принести из Энда."
	]
	quest.48E420D53A0BA874.title: "Эндерняк"
	quest.48E881DFD6B3194F.quest_desc: [
		"&3Сделай:&r наполнитель кислорода — нагрудник после крафта пустой."
		"&3Чем:&r крафтеры: 4 титановые пластины, 2 железные, схема, отделитель кислорода, фильтр воздуха (форпост «Торфяник»)."
		"Газ даёт атмосферный концентратор (крафтеры, R в JEI): крутится валом и копит то, что в воздухе — на Земле кислород, на Марсе и Венере углерод, на Луне и Меркурии ничего. Помпа и трубы — в наполнитель."
		"ПКМ нагрудником по наполнителю — вставить, пустой рукой — забрать: полный баллон за 15 с. На борту с баком кислорода тоже работает."
	]
	quest.48E881DFD6B3194F.title: "Кислород: заправка"
	quest.48F9B65B2F5D7203.quest_desc: [
		"Что лежит в сундуках и бочках. Сундук один на всех — делите честно."
		"&eСтанция&r — кристалл 3–5, металлы и детали Create, опыт; ~&616 %&r зонд жилы, ~&612 %&r артефакт."
		"&eДирижабль&r — кристалл 1–3, 1–2 улучшения самолётов (бывает оружие), провизия; ~&69 %&r артефакт."
		"&eГнездо&r — кристалл 2–4, кости, нити, мембраны фантома, жемчуг Края; ~&615 %&r артефакт (бывает эпический)."
	]
	quest.48F9B65B2F5D7203.title: "Справка: добыча островов"
	quest.491272F16FC2DDA7.quest_desc: [
		"&3Сделай:&r загрузчик чанков на каждый форпост — без него экструдеры спят, пока тебя нет рядом."
		"&3Чем:&r миксер: пустой андезитовый загрузчик + 2 жемчуга Края + светопыль (с 3.4.0, гаст не нужен). Старый путь — ПКМ пустым загрузчиком по живому гасту — тоже работает. Ставь у экструдеров, вращение снизу."
		"{\"text\": \"▶ Загрузчики чанков подробно\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"31884BC4276B531D\"}}"
		"&7&oРаньше в коробке сидел гаст. Гаст подал заявление об уходе — заявление подписали.&r"
	]
	quest.491272F16FC2DDA7.title: "Загрузчик чанков"
	quest.495D204B1F3208FC.quest_desc: [
		"&3Сделай:&r гатлинг — 8 урона × 4 в секунду, лента на 100; бронебойный — 12, пробивает 2 цели."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Патроны — как у револьвера, плюс медный самородок. Насадки: барабанный магазин, паровой двигатель."
		"&3Дальше:&r оборона, которая стреляет без тебя."
		"{\"text\": \"▶ Этап 9: оборона на токе\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"187D3DAA1A99B484\"}}"
		"&7&oГатлинг не решает проблему орды. Он решает орду.&r"
	]
	quest.495D204B1F3208FC.title: "Гатлинг"
	quest.4A02A98E37913188.quest_desc: [
		"&3Сделай:&r наводчики — крутят пушку к цели."
		"&3Чем:&r горизонтальный контроллер — под крепление, вертикальный — рядом, обоим вращение. Передатчик: ПКМ по креплению, линк на каждый."
		"Только крепления Big Cannons; лазерные турели радар не наводит."
		"&3Дальше:&r разрешение на выстрел."
	]
	quest.4A02A98E37913188.title: "Наводчики"
	quest.4AAC4C0B6EC1E5CE.quest_desc: [
		"&3Сделай:&r пыль орды — сырьё эссенции."
		"&3Чем:&r дробильные колёса: осколок → пыль (+10 % ещё одна). Жернов — 1 к 1 и медленнее."
		"&3Дальше:&r эссенция пробуждения."
	]
	quest.4AAC4C0B6EC1E5CE.title: "Пыль орды"
	quest.4AE3A069B2294E37.quest_desc: [
		"Ещё кухни — все на машинах Create (R и U в JEI):"
		"&eCreate Food&r — пицца, мороженое, супы; &eConfectionery&r — шоколад, конфеты; &eGarnished&r — орехи, соусы; &eWinery&r — вино; &eSome Assembly Required&r — сэндвичи."
	]
	quest.4AE3A069B2294E37.title: "Справка: ещё кухни"
	quest.4AF40550EC00F64C.quest_desc: [
		"&3Сделай:&r дроблёное железо: колёса — 1 → 1 и 50 % на второе. Жернов — без бонуса."
		"&3Дальше:&r слиток."
	]
	quest.4AF40550EC00F64C.title: "Дроблёное метеоритное железо"
	quest.4B15D3F36F382850.quest_desc: [
		"&3Сделай:&r автоподачу — турель стреляет, пока на складе есть патроны."
		"&3Чем:&r вплотную к собранному лафету автопушки; ПКМ — 64 основных + 64 трассера. Кормят воронка, желоб, механическая рука. Ещё есть ящик патронов, умный стеллаж и карусель."
		"&7&o— Служба доставки: «Посылка для орды. Оплата при получении».&r"
	]
	quest.4B15D3F36F382850.title: "Автоподача патронов"
	quest.4B1FB1644E359A75.quest_desc: [
		"&3Сделай:&r собери звёздный осколок. Иногда ночью начинается &bзвездопад&r: у каждого падает до 5 звёзд в 40–140 блоках."
		"&3Где:&r звезда светится, над ней столб искр, над хотбаром — расстояние и стрелка. Бей рукой."
		"&3Что даёт:&r 1–2 осколка, 2–3 звёздной пыли, иногда небесный кристалл; +5 % рассудка и «желание» — случайный эффект."
		"До рассвета: утром несобранные звёзды гаснут. Во время набега звёзды не падают."
		"&7&o— Загадывать желание разрешено. Исполнение — по графику смены.&r"
	]
	quest.4B1FB1644E359A75.title: "Звездопад"
	quest.4BDCC99B7C9A545A.quest_desc: [
		"&3Сделай:&r богатую почву — растёт быстрее."
		"&3Чем:&r миксер: земля, 2 гнилой плоти (или 4 коры), 2 соломы, 4 костной муки → компост; сам со временем станет почвой. Быстро: компост + 250 мБ воды → удобрение, дозатор 500 мБ на компост."
		"&3Дальше:&r урожай."
	]
	quest.4BDCC99B7C9A545A.title: "Богатая почва"
	quest.4BE51863FE0E8FAE.quest_desc: [
		"&3Сделай:&r свиток — заклинание с уровнем, его вписывают в книгу."
		"&3Где:&r добыча набегов, магические постройки, свои — кузница свитков. ПКМ свитком — колдует один раз, свиток сгорает."
		"&3Дальше:&r начертательный стол."
	]
	quest.4BE51863FE0E8FAE.title: "Свитки"
	quest.4C3550A20ABDE71C.quest_desc: [
		"&3Сделай:&r надень инженерные очки: видно скорость, запас сети, баки и стрелки крафтеров."
		"&3Где:&r выдают при высадке; потерял — R в JEI."
	]
	quest.4C3550A20ABDE71C.title: "Инженерные очки"
	quest.4C8775EB335DCF89.quest_desc: [
		"&3Сделай:&r бур-вездеход — сам копает тоннель и складывает добычу в сундук на борту."
		"&3Чем:&r буровое колесо — крафтеры столбиком: дробильное колесо, промышленный железный блок, железный лист. Буровой подшипник: плита, коробка передач, промышленный железный блок."
		"Крутится вчетверо медленнее источника; полный сундук — встаёт."
	]
	quest.4C8775EB335DCF89.title: "Бур-вездеход"
	quest.4CB4973DAB869AD0.quest_desc: [
		"&3Сделай:&r «Кормление» — рюкзак сам кормит в вылазках."
		"&3Чем:&r основа улучшения + золотое яблоко, золотая морковь, сверкающий ломтик арбуза, жемчуг Эндера (R)."
		"&7&o— Столовая: «Обед по расписанию». Рюкзак: «Обед по голоду». Рюкзак победил.&r"
	]
	quest.4CB4973DAB869AD0.title: "Улучшение «Кормление»"
	quest.4D03C9F63A7D2222.quest_desc: [
		"&3Сделай:&r алмазная броня — с 20-й волны без неё рискованно."
		"&3Чем:&r крафтеры. Защита &e20&r, вязкость &e8&r (режет сильные удары)."
		"&3Дальше:&r незеритовая броня."
	]
	quest.4D03C9F63A7D2222.title: "Алмазная броня"
	quest.4D1ACF24FA3CCAE6.quest_desc: ["Горелку не крафтят — ловят всполоха. &eПустая горелка&r (4 железных листа + незерак, крафтеры крестом) → ПКМ по живому всполоху или его спавнеру в крепости Незера. Бить стержнем не нужно."]
	quest.4D1ACF24FA3CCAE6.title: "Как получить горелку всполоха"
	quest.4D8732FCCCBD523B.quest_desc: [
		"&3Сделай:&r слиток чёрной стали — первый трофей Cataclysm."
		"&3Где:&r драугры (в набегах с 45-й волны); добыча боссов падает, даже если их добили турели."
		"&3Чем:&r крафтеры, рецепты — R в JEI. Трофейное оружие:"
		"&eчёрная сталь&r — меч, топор, щит; &eдревнее копьё&r 9,5; &eиспепелитель&r 14 (Игнис); &eрасплата душ&r 15 (Маледиктус); &eвизеритовый гранатомёт&r 16; &eкеравн&r 16 (Сцилла)."
		"Только с боссов: перчатка защиты (Страж Края), незеритовый горн (Незеритовое чудовище)."
	]
	quest.4D8732FCCCBD523B.title: "Трофеи Cataclysm"
	quest.4D8D8F451184D8CF.quest_desc: [
		"&3Сделай:&r кастрюлю — супы сытнее сырья в разы."
		"&3Чем:&r крафтеры 3×3: кирпич, деревянная лопата, кирпич / железо, ведро воды, железо / 3 железа."
		"&3Где:&r огонь снизу; продукты — ПКМ, миски — в слот посуды (миксер: 3 доски → 4 миски)."
		"&3Дальше:&r плита."
	]
	quest.4D8D8F451184D8CF.title: "Кастрюля"
	quest.4DADC2F0709A2873.quest_desc: [
		"Вдали, в ~280 блоках, вырастает &2гнездо&r с маткой (~1 400 HP) и стражей, которая подтягивается каждые 30 с."
		"Долететь, пробиться и убить матку за 8 минут. Куда лететь — над хотбаром."
		"Повторы — 54 и 66."
		"Первое прохождение: &6Сердце матки&r."
	]
	quest.4DADC2F0709A2873.title: "Волна 36: Штурм гнезда"
	quest.4DB3DC69131F3EBB.quest_desc: [
		"&3Сделай:&r пройди 10-ю волну — с неё падают метеориты. Небо даёт то, чего нет на земле: метеоритное железо и небесный кристалл."
		"&3Чем:&r только полётом: самолёт, дирижабль, дракон, элитры."
		"&3Дальше:&r метеорит (вправо) и небесные острова (вниз)."
		"{\"text\": \"▶ Биплан\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"135091C07022C9A1\"}}"
	]
	quest.4DB3DC69131F3EBB.title: "Смотрите в небо"
	quest.4DF24D91C9AC78F4.quest_desc: [
		"&3Сделай:&r грузовой дирижабль — везёт заказ по прямой, пока нет рельсов."
		"&3Чем:&r сборка по шагам на дирижабле: деплоеры кладут 4 сундука и корпус, последний — с удостоверением &eПилот III&r (не тратится). Рецепт — R."
		"&3Где:&r у фактории площадка с буквой «H»: сел, выгрузил в инвентарь — «Сдать из инвентаря» в окне терминала."
		"{\"text\": \"▶ Аэроклуб: Пилот III\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1A33CB476C1A29D4\"}}"
	]
	quest.4DF24D91C9AC78F4.title: "Грузовой дирижабль"
	quest.4E5B7F2646C73C7C.quest_desc: [
		"&3Сделай:&r костный бульон — суп без грядки."
		"&3Чем:&r кастрюля: кость + светящиеся ягоды, гриб или висячие корни. Кости — со скелетов. Остальное меню — U по кастрюле."
		"&3Дальше:&r кухня без рук."
		"&7&o— Бухгалтерия: «Бульон из скелета — безотходное производство».&r"
	]
	quest.4E5B7F2646C73C7C.title: "Суп дня"
	quest.4E80ABFD6CFAE6FF.quest_desc: [
		"В ~350 блоках от базы ждёт &6обоз&r — три вьючные ламы (~630 HP каждая). Идёт к алтарю, только пока рядом охрана (ближе 48 блоков); куда лететь — над хотбаром."
		"Каждые 15 с — &cзасада&r впереди обоза: пауки, сольпуги, стрекозы бьют лам. Довести до базы хоть одну за 6 минут. Своих лам вы не раните."
		"Застрявшую ламу обоз подталкивает сам. Повтор — 63: путь длиннее, засады злее."
		"Первое прохождение: &6Пломба конвоя&r."
	]
	quest.4E80ABFD6CFAE6FF.title: "Волна 43: Конвой"
	quest.4EEA6A53FCBBE2D0.quest_desc: [
		"Бродяги (4–7): скелеты, трясинные скелеты, пауки, слизни, кадавры и первые &cгромилы&r (60 HP)."
		"Каждая 5-я волна — с боссом. Здесь впервые &4Вожак орды&r: зомби в железе, 90 HP. Босс — два броска добычи."
		"Готовьтесь: железная броня, щит, лук, ловушка на подходе."
	]
	quest.4EEA6A53FCBBE2D0.title: "Волна 5: Вожак орды"
	quest.4F2010ED01E72F75.quest_desc: [
		"&3Сделай:&r гаечный ключ в хотбар: &6ПКМ&r — повернуть блок или стрелку, &6Shift+ПКМ&r — снять блок."
		"Квест видит предмет только в инвентаре: поставленную машину сними ключом — засчитается."
	]
	quest.4F2010ED01E72F75.title: "Гаечный ключ"
	quest.4F818187E549D44C.quest_desc: [
		"&3Сделай:&r пробуди артефакт эпического уровня или выше: &a+50 % к числам&r, перезарядки щита и второго дыхания на треть короче."
		"&3Чем:&r сборка по шагам — деплоер (эссенция) → пресс → дозатор (250 мБ лавы). Кругов: эпический 2, легендарный 3, мифический 4, божественный 5."
		"Пробуждаются артефакты волн, арены и трофеи — 37 видов, имя со ✦. Потолки суммы те же; обычный и ✦ одного вида вместе не надеть."
		"Галочку отметь, когда пробудишь первый."
		"&7&o— ОТК: «Пробуждённый артефакт проверен прессом. Трижды. Претензии — к прессу».&r"
	]
	quest.4F818187E549D44C.title: "&6Пробуждение ✦&r"
	quest.4F84F2F6E6210ECF.quest_desc: [
		"&3Сделай:&r стрелочный перевод — развилки сети."
		"&3Чем:&r миксер: рычаг + андезитовый корпус + шестерня. Переводит вручную или редстоуном."
	]
	quest.4F84F2F6E6210ECF.title: "Стрелочный перевод"
	quest.502442B12090F06D.quest_desc: [
		"&3Сделай:&r узел на 6 проводов — когда малому не хватает четырёх."
		"&3Чем:&r миксер: золотой или электрумовый стержень + 2 андезитовых сплава + &eрезина&r → 2. Резина — форпост «Каучуковая плантация»."
		"Между двумя большими — только золотая или электрумовая катушка (тоже с резиной). Shift+ПКМ большим по малому — замена на месте, провода остаются."
	]
	quest.502442B12090F06D.title: "Высоковольтный соединитель"
	quest.5050456F7CF14F06.quest_desc: [
		"&3Сделай:&r полноценное погружение: балласт держит глубину, водомёт двигает, прочное стекло держит давление, диффузор даёт дышать."
		"Задача — барометр: следи по нему за давлением."
		"Советы — справка рядом."
	]
	quest.5050456F7CF14F06.title: "Подлодка на глубине!"
	quest.507306DCDCF2C239.quest_desc: [
		"&3Сделай:&r контроллер — без него станция не соберёт поезд."
		"&3Чем:&r миксер: рычаг + железнодорожный корпус + механизм точности. Второй контроллер назад — езда в обе стороны."
	]
	quest.507306DCDCF2C239.title: "Контроллер поезда"
	quest.5091595E3D8BFEBF.quest_desc: ["Механические крафтеры в ряд: &eшаблон улучшения незерита | алмазный рюкзак | незеритовый слиток&r. Содержимое рюкзака сохраняется."]
	quest.5091595E3D8BFEBF.title: "Незеритовый рюкзак"
	quest.5097DA3954C254B0.quest_desc: [
		"&3Сделай:&r перегонную башню: стальные баки, рядом контроллер (в него — нефть), сверху до 6 выходов, снизу тепло."
		"&3Чем:&r контроллер — 2 свинцовые пластины, 2 лампы, компас, корпус тяжёлой машины, промышленная труба, 2 стальных механизма."
	]
	quest.5097DA3954C254B0.title: "Перегонная башня TFMG"
	quest.50B0F735AA99D36F.quest_desc: [
		"&3Сделай:&r начертательный стол — вписать свиток в книгу."
		"&3Чем:&r крафтеры по раскладке JEI (пустые клетки — заглушки)."
		"ПКМ по столу: книга — влево, свиток — в ячейку, «Начертать»."
		"&3Дальше:&r кузница свитков."
		"&7&o— Юротдел: всё, что вписано в книгу, может быть использовано против орды.&r"
	]
	quest.50B0F735AA99D36F.title: "Начертательный стол"
	quest.50FADB6F1F2FFCC9.quest_desc: [
		"&3Сделай:&r шестерни — передать вращение вбок и под 90°."
		"Соседние шестерни крутятся в разные стороны, лента — в одну. Перепутал — пила кинет доски назад, колёса не дробят."
		"&3Чем:&r миксер или деплоер: вал + доска."
	]
	quest.50FADB6F1F2FFCC9.title: "Шестерня"
	quest.50FDC1FFF6CE7CA4.quest_desc: [
		"&3Сделай:&r ранец снабжения — склад базы в кармане: взять и сдать в 128 блоках от узла."
		"&3Чем:&r сборка по шагам на рюкзаке: передатчик → конденсатор → электромедь → пресс. ПКМ ранцем по узлу — привязать."
		"&3Как:&r ПКМ — окно склада (ЛКМ — 1 шт., Shift — стак), Shift + ПКМ — сдать добычу. Каждая передача — &6200 FE + 2 за блок&r; заряд — зарядная станция или ячейки в инвентаре."
		"&3Дальше:&r ретранслятор на форпост."
	]
	quest.50FDC1FFF6CE7CA4.title: "Ранец снабжения"
	quest.5132CCC7A875B401.quest_desc: [
		"С 16-й волны в орды приходят &cмобы модов&r: пауки, сколопендры, скорпионы и летуны ArPhEx, глубинники и драугры Cataclysm, гости с планет, Пещерный житель."
		"Приходят &eпостепенно&r: на 16-й модовые — 2 подволны из 6 (первая и последняя), на 17-й — 3, на 18-й — 4, на 19-й — 5, с 20-й — все. Паучий выводок (лопается на паучат) — только с 23-й."
		"{@pagebreak}"
		"У каждой волны свой &6праздник&r и &eпремьера&r — моб, которого ещё не было. На старте — титр, совет в чате и строка «Готовьтесь». Премьера, которую съел сценарий (Воздушный бой, Побег…), выходит на следующей волне."
		"&dГастроли&r — одна подволна целиком из мобов других модов: 27 — «Шабаш» (маги Iron's Spells), 31 — «Ледяной поход», 37 — «Термитник», 41 — «Древняя стража», 49 — «Глубоководная ночь». Колдунов — первыми."
		"{@pagebreak}"
		"Примеры: 16 — Паук-шнырь, 18 — Подрывник, 22 — Стрекоза-дредноут (летает), 30 — Богомол-потрошитель (бьёт на 15), 37 — Пещерный житель, 50 — Краб-душитель. С 58-й — особые варианты, с 70-й — «звезда вечера»."
		"Удар у модовых мобов сильнее ванильного — держат &eброня с «Защитой»&r, &bэнергощит&r и &dартефакты смены&r."
		"&7&o— Пресс-служба: «Каждую ночь — премьера. Билеты бесплатные, выход — нет».&r"
	]
	quest.5132CCC7A875B401.title: "Премьеры: новая тварь каждую волну"
	quest.515EB053AE51DC78.quest_desc: [
		"&eПКМ по алтарю&r (или по блоку базы под ним) — окно &eПульт алтаря&r: всё про набеги в одном месте. Вкладки — мышью или клавишами &e1–6&r."
		"&eВолны&r — сетка по 20: &aзелёные ✔&r пройдены (фармите сколько угодно), &eжёлтая ▶&r — следующая, серые закрыты. В клетке — праздник волны и значки угроз. Листать — стрелками или колесом."
		"&eДосье&r — нажми на волну: каждая подволна, мобы с числом на всю команду и здоровьем с усилениями волны, значки угроз и «чем бить», босс, условия смены, тема арены, добыча и шансы артефактов. Кнопки &a[▶ Старт]&r и &b[→ Арена]&r."
		"{@pagebreak}"
		"Значки угроз: летают, невидимые, подрывники, лезут по стенам, плодят детёнышей, бронированные, быстрые, идут сквозь щит, ломают щит, выжигают щит, босс. Наведи на значок или моба — совет."
		"&eБестиарий&r — моб открывается после первой встречи в набеге: модель, здоровье, удар, особенности, совет, с какой волны. В досье закрытых волн ещё не встреченные — «???»."
		"&eУсловия&r, &eКонтракты&r и &eАртефакты&r (переплавка 3 → 1) — там же."
		"На старте каждой подволны в чате — строка досье: «Подволна 3: невидимые — нужен прожектор; летуны — ПВО». Наведи — состав."
		"{@pagebreak}"
		"Меню в чате осталось запасным: &e/nightshift menu&r в 64 блоках от алтаря. Досье любой волны текстом — &e/nightshift dossier N&r."
		"Волн &e100&r, сила растёт плавно; после сотой — &dБесконечность&r."
		"Волна — это несколько &eподволн&r подряд (3 в начале, 18 после 70-й), в конце босс: каждая &e5-я&r волна, с 70-й — каждая."
		"После старта — 15 секунд на подготовку (у малого набега — минута), ночь стоит до конца набега. Орда выходит кольцом в 30–45 блоках (за зоной) и идёт к алтарю. Моб у алтаря — &cпровал&r."
		"{@pagebreak}"
		"Обычные монстры у алтаря на время набега исчезают, мобы орды друг друга не трогают."
		"Никого ближе 160 блоков к алтарю — набег на паузе, орда ждёт. Кто далеко — получит кнопку &a[Телепорт к алтарю]&r; после набега вернёт, откуда забрала."
		"Мобов считают на всю команду онлайн: вдвоём — ×1,5, втроём — ×2. Начать может любой."
		"&7&o— Отдел по работе с ордой: «Досье выдаётся до боя. После боя оно называется некрологом».&r"
	]
	quest.515EB053AE51DC78.title: "Пульт алтаря"
	quest.51BC26FDB7EE8214.quest_desc: [
		"&3Сделай:&r седло — без него не полетать."
		"&3Где:&r сундуки подземелий и храмов, рыбалка, кожевник или стол трансмутации (192 EMC)."
		"&3Дальше:&r в небо."
	]
	quest.51BC26FDB7EE8214.title: "Седло"
	quest.51F5B4A18F78FE96.quest_desc: [
		"&3Сделай:&r ток форпоста — на базу, без проводов через полкарты."
		"&3Как:&r вагон — сундук (27 ячеек = 54 млн FE) + портативный складской интерфейс; на перроне второй интерфейс напротив. Форпост: зарядные станции люком в интерфейс. База: интерфейс → буфер-хранилище → разрядные станции."
		"Расписание: на форпост → «Неизменение груза» 20 с → на базу → то же."
		"&7&oВозим ток вагонами. Лет через сто придумают провода — посмеёмся.&r"
	]
	quest.51F5B4A18F78FE96.title: "Поезд с ячейками"
	quest.521CD648E130FD9F.quest_desc: [
		"&3Сделай:&r трезубец — удар 9, бросок 8; с &aВерностью&r возвращается."
		"&3Где:&r не собирается: редкая добыча набегов 35–42 и утопленники в диком мире (утопленники набега не роняют)."
		"&3Дальше:&r трофеи Cataclysm."
	]
	quest.521CD648E130FD9F.title: "Трезубец"
	quest.5257CFCF4554E0AE.quest_desc: [
		"Где яйцо (шанс на сундук) и чем порода хороша:"
		"&cОгненный&r — пустынный храм 6,5 %; не горит"
		"&4Незерский&r — бастион 35 %, крепость 10 %; не горит, броня"
		"&9Водный&r — клад 17,5 %; плавает"
		"&bЛедяной&r — иглу 15 %; не тонет"
		"&fНебесный&r — данж со спавнером 15 %; быстрый"
		"&7Призрачный&r — шахта 15 %; иссушение не берёт"
		"{@pagebreak}"
		"&2Лесной&r — храм джунглей 20 %; маскировка"
		"&aПышный&r — особняк 20 %, клад 10 %"
		"&dАметистовый&r — библиотека крепости 10 %"
		"&5Эндер&r — коридор крепости 10 %; здоровье 75"
		"&3Скалковый&r — древний город 10 %; эхо-чутьё"
	]
	quest.5257CFCF4554E0AE.title: "Справка: породы"
	quest.526F0A929AFCF674.quest_desc: [
		"&3Сделай:&r револьвер — 8 урона, 2 выстрела в секунду, барабан на 6; бронебойный — 12, пробивает 2 цели."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"&eПатроны&r — сборка по шагам: латунная пластина → деплоер с пресс-формой → деплоер с оружейным порохом → 8 гильз; гильза + свинцовый самородок → патрон (+ стальной — бронебойный). Пресс-форма — железный слиток на пиле."
		"&3Дальше:&r дробовик."
	]
	quest.526F0A929AFCF674.title: "Револьвер"
	quest.529610133ACB2780.quest_desc: [
		"Вещи после смерти остаются при тебе, но каждая смерть — &cрана&r: −1 сердце максимума (до −5). Лечит настойка жизни."
		"Рассудок при возрождении не восстанавливается, но не ниже 40 %."
		"Раны и проклятие алтаря вместе не опустят здоровье ниже 3 сердец."
		"&7&oЮротдел: «Смерть на смене не освобождает от выхода на смену».&r"
	]
	quest.529610133ACB2780.title: "Справка: цена смерти"
	quest.52B663403D95C5AC.quest_desc: [
		"Зонд = &eбесконечная жила&r своего типа в чанке: ПКМ по земле — и ставь буровую."
		"Цены, EMC: уголь, медь, цинк, сера — 128 000; железо, кварц — 256 000; свинец — 512 000; золото, литий — ~2 млн; платина — ~4 млн; торий — ~6 млн; алмаз — ~8 млн; титан, вольфрам, марсианское железо — ~10 млн."
		"Титан — на любой планете, вольфрам — только на Меркурии, марсианское железо — на Марсе. Первые зонды дают и набеги — за первую волну нового состава."
	]
	quest.52B663403D95C5AC.title: "Справка: зонды жил"
	quest.535A1AD00EFCD245.quest_desc: [
		"&3Сделай:&r большой двигатель — на дизеле, керосине, нафте или печном газе."
		"&3Чем:&r механические крафтеры (R в JEI); радиатор с хладагентом — форпост «Ледник»."
		"Без притока воздуха и выхлопа CO₂ глохнет."
	]
	quest.535A1AD00EFCD245.title: "Большой двигатель"
	quest.53705BB5018506EE.quest_desc: [
		"У алтаря &bтри рубежа&r (А, Б, В — подписаны, видны частицами). Орда идёт на них, а не на алтарь."
		"Моб на рубеже без защитника рядом — рубеж падает (~10–25 с). Встань на павший без мобов — отобьёшь. Пали все три разом — &cпровал&r; продержаться 6 минут — победа."
		"Новая подволна — раз в 40 с. Повтор — 67 (7 минут)."
		"Первое прохождение: осколки орды и &6зонд золотой жилы&r."
	]
	quest.53705BB5018506EE.title: "Волна 47: Удержание рубежей"
	quest.5374E61F4F20603E.quest_desc: [
		"&3Сделай:&r закалённый механизм — камера сгорания, ракетная станция, компьютер."
		"&3Чем:&r сборка по шагам из механизма точности, 5 кругов: титановый самородок → железная шестерня Northstar → большая железная шестерня. Выход 85 %."
		"Железная шестерня — миксер: вал + блок промышленного железа."
	]
	quest.5374E61F4F20603E.title: "Закалённый механизм"
	quest.539485CE657AFD69.quest_desc: [
		"&3Сделай:&r межпланетный сплав — звёздный навигатор, звёздная и стабилитовая кирки, генератор щита."
		"&3Чем:&r точило: 2 титановых слитка + вольфрамовый слиток + полированный лунный сапфир → 1."
		"&7&o— Бухгалтерия: «Слиток, ради которого облетели три мира, списывать запрещено».&r"
	]
	quest.539485CE657AFD69.title: "&dМежпланетный сплав&r"
	quest.539B7C6618ED6FA2.quest_desc: [
		"&3Сделай:&r запас небесного кристалла — для Форсажа III, двигателей и пропеллеров, тесла-техники (U в JEI)."
		"&3Чем:&r железная кирка или лучше по друзам: 1–3 кристалла. Друзы растут сверху острова и под брюхом — облетай кругом."
		"{\"text\": \"▶ Форсаж III\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"76E6188D5A1B5F5E\"}}"
	]
	quest.539B7C6618ED6FA2.title: "Небесный кристалл"
	quest.539FB1F056F8E82A.quest_desc: [
		"Огнестрел в цифрах и обвесы."
		"&eОбвесы&r (прицел, приклад-«ложа», стволы, магазины): оружие в руку → клавиша «Изменить обвесы». По умолчанию &6Z&r — она же зум и карта: переназначь (Управление → «NTGL Оружие»)."
		"{@pagebreak}"
		"Урон · выстрелов в секунду (в скобках — бронебойные):"
		"&eСамопал&r — &610&r · раз в 3,5 с"
		"&eРевольвер&r — &68 (12)&r · 2"
		"&eДробовик&r — &620–30&r за залп · 2"
		"&eГвоздемёт&r — &65 (8)&r · 10"
		"&eГатлинг&r — &68 (12)&r · 4"
		"&eРакета&r — &65&r + взрыв &620&r"
		"&eВсполохомёт&r — &62&r + огонь · ~7"
		"В голову ×1,25. Выстрел без глушителя злит мобов в 20 блоках — они бросают коридор и идут на стрелка."
	]
	quest.539FB1F056F8E82A.title: "Справка: огнестрел"
	quest.53DF778E5B05A4F3.quest_desc: [
		"&3Сделай:&r чугун — трубы, баки и печи TFMG."
		"&3Чем:&r пресс над чашей с горелкой: железный слиток + уголь."
		"&3Дальше:&r коксовая печь, огнеупорный кирпич."
	]
	quest.53DF778E5B05A4F3.title: "Чугун"
	quest.53F82D88C3C56553.quest_desc: [
		"&3Сделай:&r ретранслятор снабжения — ранец достаёт склад с форпоста: &6160 блоков&r вокруг ретранслятора."
		"&3Чем:&r крафтеры: громоотвод, 2 передатчика, медный корпус, 2 медные катушки, электромедь (R)."
		"&3Где:&r на форпосте, к току: &616 FE/т&r, пока чанк загружен, и &6100 FE&r за передачу. Лампа горит — в сети."
		"&7&o— Служба доставки: «Мы не опаздываем. Мы просто далеко».&r"
	]
	quest.53F82D88C3C56553.title: "Ретранслятор снабжения"
	quest.5419BEC0D04A20F0.quest_desc: [
		"&3Сделай:&r контроллер ракеты — с него стартуют и тормозят; без него станция ракету не соберёт."
		"&3Чем:&r крафтеры, 5 рядов: 2 рычага + ядро навигации / 3 звёздные карты / 3 титановые пластины / 3 схемы / 3 блока промышленного железа."
		"ПКМ по контроллеру — управление, как у поезда (не дальше 8 блоков). Пробел — отсчёт 10 с, ещё раз — отмена."
	]
	quest.5419BEC0D04A20F0.title: "Контроллер ракеты"
	quest.54231138C74C436B.quest_desc: [
		"&3Сделай:&r андезитовый сплав — валы, шестерни, корпуса, стол трансмутации."
		"&3Чем:&r миксер над чашей без нагрева: андезит + железный или цинковый самородок."
		"Миксер делает не то (печь, молот)? Положи сплав в &eфильтр чаши&r."
		"&3Дальше:&r андезитовый корпус."
	]
	quest.54231138C74C436B.title: "Андезитовый сплав — миксером"
	quest.54836B2556E2C657.quest_desc: [
		"&3Сделай:&r марсианскую сталь — обшивка +8, термостойкий скафандр, электролизёр, продвинутая схема."
		"&3Чем:&r пресс над чашей с горелкой: титановый слиток + сырая марсианская железная руда + вулканический пепел → 2."
		"&3Где:&r руда и пепел — только на Марсе (обычная кирка)."
		"Электролизёр: вода → кислород + водород, без атмосферы. Продвинутая схема — терморегулятор и звёздный навигатор."
	]
	quest.54836B2556E2C657.title: "Марсианская сталь"
	quest.54D2D1744EDB509D.quest_desc: [
		"&3Сделай:&r коксовую печь: уголь → кокс за ~минуту, попутно креозот и CO₂."
		"&3Чем:&r миксер или крафтеры: 4 чугунных слитка + блок промышленного железа → 2."
		"&3Где:&r ставь рядами: CO₂ — сверху, креозот — сбоку."
		"&3Дальше:&r коксовая пыль."
	]
	quest.54D2D1744EDB509D.title: "Коксовая печь"
	quest.556DE5924DA9D57F.quest_desc: [
		"&3Сделай:&r ход под водой: водомёт толкает водой под давлением — нужны вода из цистерны и вращение."
		"&3Чем:&r миксер: помпа, пропеллер Create, 5 медных блоков. Гребной винт проще: пропеллер, промышленный железный блок, вал — на вал."
		"&3Дальше:&r прочное стекло."
	]
	quest.556DE5924DA9D57F.title: "Водомёт и винт"
	quest.557E6274128BBD2E.quest_desc: [
		"&3Сделай:&r датчик высоты — сигнал по высоте, диапазон в окне блока. Сам сбросит или прибавит газ: наверху воздух реже и тяга слабее."
		"&3Чем:&r крафтеры столбиком: бумага, железный лист, андезитовый корпус."
	]
	quest.557E6274128BBD2E.title: "Датчик высоты"
	quest.5595A4942C76A170.quest_desc: [
		"&3Сделай:&r Форсаж II — тяга ×3, сопротивление на треть меньше: биплан 45 бл/с. Топлива ×2."
		"&3Чем:&r сборка по шагам: Форсаж I → 2 слитка метеоритного железа → чертёж форсажа → механизм точности → Пилот II (чертёж и удостоверение не тратятся)."
		"&3Где:&r чертёж — за первый «Воздушный бой» (волна 24), железо — из метеорита."
		"{\"text\": \"▶ Волна 24: Воздушный бой\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6A13AEBFD75DFA61\"}}"
		"{\"text\": \"▶ Слиток метеоритного железа\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1C38E72D15B444D8\"}}"
	]
	quest.5595A4942C76A170.title: "Форсаж II"
	quest.55BEB26DF436B36E.quest_desc: [
		"&3Сделай:&r стража из &dмежпланетного сплава&r: атака 85, здоровье 1000, не горит, гасит взрывы, отбивает снаряды."
		"&3Чем:&r 4 механизма точности на круг: металлическому — 36 сплава и 144 механизма, псу — 9 и 36."
		"{\"text\": \"▶ Межпланетный сплав\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"539485CE657AFD69\"}}"
		"Отметь, когда страж встанет у алтаря."
	]
	quest.55BEB26DF436B36E.title: "Страж из сплава"
	quest.55D9A07AF1C76AFC.quest_desc: [
		"Цена прыжка с человека: &e100 000 FE + 250 FE за блок&r (по горизонтали; Незер считается ×8):"
		"&e300 бл.&r — 175 000 FE; &e1 000 бл.&r — 350 000 FE; &e1 400 бл.&r (дальняя фактория) — 450 000 FE; &e5 000 бл.&r — 1 350 000 FE."
		"Питомец — четверть цены хозяина. Запас врат 6 000 000 FE — дальше ~23 600 блоков не достать."
		"Перезарядка после окна: &e10 с + 1 с на каждые 100 блоков&r, не больше 2 минут."
		"{@pagebreak}"
		"&cНабег&r: врата у алтаря (и у форпоста в осаде) держат оборону — уйти через них нельзя. Прийти можно, и &eза полцены&r: «подмога»."
		"&dМежду мирами&r: Верхний мир ↔ Незер ↔ Край — с &e30-й пройденной волны&r, +2 000 000 FE и +30 с перезарядки. На планеты — только ракетой: туда врата канал не держат. На самой планете врата работают как дома."
		"Входящие врата — в одну сторону: пока к ним идёт переход, войти в их плёнку нельзя."
		"Сломаешь пульт — заряд пропадёт, врата уйдут из сети. Сломаешь блок рамы — арка разберётся, окно закроется на обоих концах."
	]
	quest.55D9A07AF1C76AFC.title: "Справка: врата"
	quest.56635B3491872F7C.quest_desc: [
		"Разметчик отмечает &aзону базы&r: внутри неё монстры сами не появляются."
		"Рецепт: палка + кремень + уголь (подойдёт древесный) — миксер."
		"ПКМ по блоку — первый угол, по противоположному — второй. Зона — колонна на всю высоту мира; с Shift на первом клике — только между высотами кликов."
		"{@pagebreak}"
		"ПКМ в воздух — в какой ты зоне; Shift + ПКМ в воздух — удалить эту зону. С разметчиком в руке видны границы и точки спавна орды."
		"Зон сколько угодно и любого размера. Но набег приходит снаружи: чем больше база, тем длиннее периметр."
		"&7&o— Отдел землеустройства Axiomativ: «Всё, что внутри забора, — наше. Всё, что снаружи, — хочет внутрь».&r"
	]
	quest.56635B3491872F7C.title: "Разметчик базы"
	quest.56666CC5F6622986.quest_desc: [
		"Атака / здоровье голема целиком из одного металла:"
		"&6Медь&r 10 / 50 (молния не страшна) · &7Железо&r 15 / 100"
		"&eЛатунь&r 15 / 150 (стойкость к магии) · &eЗолото&r 5 / 20 (регенерация)"
		"&8Незерит&r 30 / 300 (огнеупорный) · &3Скалк&r 30 / 500"
		"&cCataclysm&r (игнитиум, витерит, курсиум) 30–40 / ~400"
		"&fТитан&r 40 / 400 · &9Лунный сапфир&r 35 / 480"
		"&cМарсианская сталь&r 50 / 550 · &8Вольфрам&r 65 / 750"
		"&dМежпланетный сплав&r 85 / 1000"
	]
	quest.56666CC5F6622986.title: "Справка: металлы"
	quest.5720C739A6A1590D.quest_desc: [
		"&3Сделай:&r латунный экструдер: блок сырой руды снизу — 1 удар на блок."
		"&3Чем:&r крафтеры 3×4 (11 штук) — R в JEI."
		"База кормит сама; шахта — ради редкостей и жил."
		"&3Дальше:&r пар."
		"{\"text\": \"▶ Этап 6 · Пар\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"258C4CE4D34290E4\"}}"
	]
	quest.5720C739A6A1590D.title: "Латунный экструдер"
	quest.5739B17782550F0D.quest_desc: [
		"&3Сделай:&r фильтры воздуха — скафандры, наполнитель кислорода, диффузор подлодки, противогаз."
		"&3Где:&r болота: тёмный тлеющий торфяник, над ним дым."
		"&3Чем:&r экструдер, сбоку вода и грязь → торф → вентилятор через огонь → активированный уголь. Пресс над чашей: 2 угля + бумага + железный самородок → фильтр."
		"{\"text\": \"▶ Скафандр\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"206F6135673F26E9\"}}"
	]
	quest.5739B17782550F0D.title: "Торфяник"
	quest.575231C024676318.quest_desc: [
		"SU на полном газу."
		"&eДизель CDG&r: дизель &66 144&r, бензин и биодизель &64 096&r, этанол и масло &62 048&r."
		"&eМодульный&r, на блок: дизель &68 192&r, бензин &66 144&r, этанол &63 072&r."
		"&eОгромный&r: дизель &616 384&r, бензин &612 288&r, этанол &66 144&r."
		"Турбокомпрессор — ×2. TFMG — в очках. Паровой двигатель — &616 384&r."
	]
	quest.575231C024676318.title: "Сколько даёт двигатель"
	quest.575E2449004F7BBA.quest_desc: [
		"&eПланшет инженера&r: &6J&r — окно с поиском и цепочкой до сырья, у каждого шага — чем делать. Справа на экране «▶ СЕЙЧАС» — что можно сделать прямо сейчас из кармана."
		"&6P&r над предметом в JEI, сундуке или инвентаре — закрепить себе (до 3), &6Shift+P&r — цель смены для всех. &6Shift+ПКМ&r пустой рукой по машине — что она делает. &6Shift+J&r — панель подробно / кратко / скрыта."
		"Командой: &e/pin N&r — себе, &e/pin team N&r — цель смены, убрать — &e/unpin&r."
		"&eПрикрепить квест&r — кнопка в окне квеста: его задачи видны на экране. Этапы «Пути смены» для этого и сделаны."
		"Закладки JEI — &eA&r над предметом: свой список в окне JEI."
	]
	quest.575E2449004F7BBA.title: "Как не держать цепочку в голове"
	quest.577D5A25C2A53FC5.quest_desc: [
		"&3Сделай:&r записи наблюдений — наука открывает планеты в Атласе."
		"&3Чем:&r телескоп — крафтеры: линза (форпост «Кварцевый карьер») + 2 латунных слитка + 3 палки. ПКМ — карта неба: выбери планету и держи запись; нужна бумага, запись падает под ноги."
		"На Земле — только ночью (на Луне, Марсе, Меркурии — и днём). Одна запись планеты за сутки: за ночь снимай все планеты."
	]
	quest.577D5A25C2A53FC5.title: "Телескоп и записи"
	quest.57E36735D748B165.quest_desc: [
		"&3Сделай:&r турель из одного блока — автопушка или пушка на компактном лафете."
		"&3Чем:&r ствол — к левой грани с валом; боковые валы — наклон, верх и низ — поворот. Передняя грань — выстрел, задняя — сборка (ключом меняются). Патроны — воронкой. Рецепт — R в JEI."
		"Вертикальный лафет на вахте закрыт: слезть с пушки на нём — уронить сервер."
		"&3Дальше:&r автоподача."
	]
	quest.57E36735D748B165.title: "Компактные лафеты"
	quest.582913C503B5526D.quest_desc: [
		"Справка: Луна."
		"&eУсловия&r — вакуум, &6−183 °C&r, тяжесть &61,6 м/с²&r, теплозащита &60&r. Железного скафандра хватает. Телескоп работает и днём, факелы гаснут."
		"&eСапфир&r — в жеодах: блоки падают сами → дробилка → 3–4 осколка; друзы — шёлковым касанием. Осколок + наждачка → полированный; кристалл — 3 полированных + 2 железа + 2 редстоуна (миксер)."
		"&eЕщё&r — ледяные и светокаменные пещеры, лунные руды."
	]
	quest.582913C503B5526D.title: "Справка: Луна"
	quest.58CBE83DFE54E852.quest_desc: [
		"&3Сделай:&r жидкость призыва — без неё рассадник стоит."
		"&3Чем:&r миксер с нагревом: огненный стержень + жемчуг Эндера + 250 мБ воды → случайная. Видовая: случайная + ключ (кожа и пшеница → корова, порох → крипер, кость → скелет)."
	]
	quest.58CBE83DFE54E852.title: "Жидкости призыва"
	quest.58CDE5A8D0227B98.quest_desc: [
		"&3Сделай:&r корпус — основа всех самолётов Immersive Aircraft."
		"&3Чем:&r крафтеры 3×3: брёвна сверху и снизу, 3 алюминиевых листа в середине."
		"&3Где:&r алюминий — форпост «Бокситовый карьер»."
		"&3Дальше:&r биплан (влево)."
		"&7&o— Служба доставки: «Самолёт из брёвен — экологично. Горит тоже экологично».&r"
	]
	quest.58CDE5A8D0227B98.title: "Корпус самолёта"
	quest.590411A05AAAE42D.quest_desc: [
		"&3Сделай:&r блоки Незера без Незера."
		"&3Чем:&r вентилятор сквозь огонь душ: песок → песок душ, земля → почва душ, булыжник → чернит. Первый песок душ — из Незера."
	]
	quest.590411A05AAAE42D.title: "Призрачная обработка"
	quest.59635B6F608A15C5.quest_desc: [
		"&3Сделай:&r разделочную доску — из куска больше порций."
		"&3Чем:&r миксер: 4 доски + 2 палки. Продукт на доску, удар ножом: говядина → 2 фарша, капуста → 2 листа. Без рук — пила на ленте."
		"&3Дальше:&r кастрюля."
	]
	quest.59635B6F608A15C5.title: "Разделочная доска"
	quest.598870E2C08934FE.quest_desc: [
		"&3Сделай:&r портативную дрель — копать быстро."
		"&3Чем:&r крафтеры: латунь, 2 шестерни, паровой двигатель и головка дрели Stuff 'N Additions. Чары «Копание» — область 3×3. Ест топливо и воду."
	]
	quest.598870E2C08934FE.title: "Портативная дрель"
	quest.5988745A12ACBC81.quest_desc: [
		"&3Сделай:&r механическое точило — снимает чары с хлама, мелет опыт в жидкость."
		"&3Чем:&r крафтеры 3×3: 8 сплавов вокруг вала; под точило — осушитель."
	]
	quest.5988745A12ACBC81.title: "Механическое точило"
	quest.59DE800C3269A551.quest_desc: [
		"&3Сделай:&r сканер поверхности: чанки с нефтью светятся на сетке 5×5 (границы — F3+G)."
		"&3Чем:&r 6 ламп, корпус тяжёлой машины, 2 стальных механизма; вращение снизу через машинный ввод."
	]
	quest.59DE800C3269A551.title: "Сканер поверхности"
	quest.5A02A7B022B6C246.quest_desc: [
		"&3Сделай:&r стену — она покупает секунды для ловушек и турелей."
		"Моб, который 3 с не продвинулся к алтарю, грызёт блок перед собой:"
		"&eБулыжник&r — &64 с&r"
		"&eГлубинный сланец&r — &66 с&r, &eкирпичи сланца&r — &67 с&r"
		"&eЖелезный блок&r — &610 с&r, &eобсидиан&r — &660 с&r"
		"Машины, сундуки, турели, пушки — всё с блок-сущностью — орда не грызёт. Камень — на стену, железо и обсидиан — на ворота."
		"&3Дальше:&r коридор-ловушка."
	]
	quest.5A02A7B022B6C246.title: "Стена и сколько её грызут"
	quest.5A4B58E3D3636EAA.quest_desc: [
		"Волны 50–59: краб-душитель, оса-немезида, жнецы, заразители, глубинники и драугры Cataclysm и подволна &dпротив щита&r (стрекозы — сквозь щит, крабы — ×10 по щиту, осы выжигают запас). Боссы: 50 — &4Диаболос-истребитель&r, 55 — матриарх и артроплевра."
		"Мечом это уже не держится: нужна &6промышленная оборона&r — турели, пушки, големы."
		"{@pagebreak}"
		"&6Веха каждому&r: &dЯдро навигации&r — без него не собрать контроллер ракеты (глава «Космос»). И &5Сердце ночи&r."
	]
	quest.5A4B58E3D3636EAA.title: "Волна 50: ядро навигации"
	quest.5A88EE2812A0A03D.quest_desc: [
		"&3Сделай:&r Маяк трассы и проложи трассу в небе."
		"&3Чем:&r деплоер — ракета фейерверка на компас."
		"&3Как:&r &e/race new <название>&r, лети и жми ПКМ маяком: кольцо встаёт там, где ты, поперёк взгляда — смотри по ходу полёта. Shift+ПКМ — убрать, &e/race radius 3–16&r, &e/race done&r. Без маяка — &e/race ring&r."
		"&3Дальше:&r позови смену на заезд."
	]
	quest.5A88EE2812A0A03D.title: "Своя трасса"
	quest.5A91E4F3C341DE2D.quest_desc: [
		"&3Сделай:&r узел снабжения — «антенна» склада: через него ранец видит всё, что лежит на базе."
		"&3Чем:&r крафтеры: складская связь, 2 электронные лампы, латунный корпус, механизм точности, 2 электромеди (R)."
		"&3Где:&r вплотную к складу: видит сундуки, бочки и хранилища, которые касаются его и друг друга. Склад на упаковщиках Create — ПКМ по узлу настроенной складской связью, и узел видит всю сеть."
		"&3Дальше:&r ранец снабжения."
	]
	quest.5A91E4F3C341DE2D.title: "Узел снабжения"
	quest.5AF0534F6432C4D1.quest_desc: [
		"&3Сделай:&r стереть жилу в чанке, чтобы поставить нужный зонд."
		"&3Чем:&r миксер: TNT, 2 пороха, андезитовый сплав. Тратится за раз."
		"&7&oГеология — наука точная: не понравилась жила — взорвали и поставили другую.&r"
	]
	quest.5AF0534F6432C4D1.title: "Очиститель жилы"
	quest.5B0D0D05577E8BCF.quest_desc: [
		"&3Сделай:&r оборону током — башня сама бьёт монстров молнией, достаёт летунов. К 22-й волне «Механоиды» — обязательна."
		"&3Чем:&r механические крафтеры: латунный корпус, 2 конденсатора, медная катушка, громоотвод, 2 электромеди (R). Конденсатор — форпост «Солеварня»."
		"&3Где:&r выше стен: нужна прямая видимость от верхушки, сквозь блоки и стекло молния не бьёт. Ток — к любой стороне основания, кроме верха."
		"{@pagebreak}"
		"Запас &650 000 FE&r, приём до &62 000 FE/т&r. Раз в секунду — ближайший монстр (мобы набега первыми), перескок на соседа в 4 блоках. Выстрел — &62 000 FE&r, перескок — ещё 500."
		"Своих, питомцев, големов и мирных не трогает, блоки не ломает. Ponder — W в JEI."
		"{\"text\": \"▶ Волна 22 · Механоиды\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"074742062F9FA498\"}}"
	]
	quest.5B0D0D05577E8BCF.title: "Тесла-башня"
	quest.5B0EAEACFF067C03.quest_desc: [
		"&3Сделай:&r ленту — возить предметы между машинами."
		"&3Чем:&r миксер: 6 сушёных ламинарий; ПКМ лентой по валу, потом по второму."
		"Депо — стоячий кусок ленты, на нём прессуют и промывают. Андезитовый шлюз забирает и кладёт предметы. Жернов и колёса берут только сверху."
	]
	quest.5B0EAEACFF067C03.title: "Лента, депо и шлюзы"
	quest.5B2534CC31A2A47B.quest_desc: [
		"&3Сделай:&r 32 факела — свет здесь главная защита: в темноте (и ночью под небом) тает рассудок и появляются монстры."
		"&3Чем:&r миксер: палка + уголь или древесный уголь → 4. Древесный уголь — брёвна в печи."
		"Факел в левой руке светит на ходу (F — переложить); факелы по пути — дорога назад."
		"&3Дальше:&r кровать."
	]
	quest.5B2534CC31A2A47B.title: "Запас света"
	quest.5B383EC023412952.quest_desc: [
		"&3Сделай:&r каменную соль → электролит для конденсаторов: без них ток на базе не идёт дальше генератора."
		"&3Где:&r пляжи: розово-белый соляной пласт у самой воды."
		"&3Чем:&r экструдер на пласт, вода с обеих сторон → каменная соль. Миксер: соль + 500 мБ воды → &6500 мБ&r электролита. Дробилка делает из каменной соли обычную — для Northstar и кухни."
		"&3Дальше:&r конденсатор."
	]
	quest.5B383EC023412952.title: "Солеварня"
	quest.5B8F62B271946896.quest_desc: [
		"У кольца выхода орды встают &6вожаки&r — светятся, толще (~660 HP), держатся своего места и злят мобов рядом («Сила I», «Скорость I»)."
		"Пока вожаки живы, орда идёт &cпо кругу&r. Нужна вылазка за стены: убить всех вожаков — победа. Через 8 минут вожаки идут на алтарь сами."
		"Повтор — 53 (вожаков больше, они толще)."
		"Первое прохождение: &6тотем бессмертия&r и осколки орды."
	]
	quest.5B8F62B271946896.title: "Волна 29: Охота на вожаков"
	quest.5BBEB820DBEDDA72.quest_desc: [
		"&3К концу этапа:&r сталь и нефтепродукты на потоке, поезда возят груз и ток с форпостов."
		"• &eСталь&r — быстро миксером с нагревом, на поток — домна TFMG."
		"• &eНефть:&r сканер поверхности ищет залежь, качалка качает, перегонная колонна делит на топливо."
		"• &eПоезд:&r рельсы, станция, контроллер, расписание — возит продукты форпостов на базу."
		"• &eТок поездом:&r геотермальный генератор на источнике → зарядная станция → энергоячейки → разрядная станция на базе."
		"&3Волны:&r 38 «Осада форпоста» — стены, турели и прожектор и у форпостов; 43 «Конвой» — довести обоз через засады: транспорт и огонь по площади."
		"{@pagebreak}"
		"{\"text\": \"▶ Первая сталь\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"431F293EFF616CE7\"}}"
		"{\"text\": \"▶ Первый поезд\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0A1DAFEE8419EA9C\"}}"
		"{\"text\": \"▶ Шаг 7: энергофорпост\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"68AEF2EB9277660D\"}}"
		"&3Дальше:&r этап 12 — космос."
	]
	quest.5BBEB820DBEDDA72.title: "Этап 11 · Сталь, нефть и ток поездом"
	quest.5C6DE81149094BAE.quest_desc: [
		"&3Сделай:&r качалку над залежью (задача — основа насоса):"
		"1) столб промышленных труб до залежи (пила: сталь → 8 труб);"
		"2) наверху основа, позади держатель молота (красная метка основы — от него);"
		"3) над ними соединитель, головка и части молота — всё суперклеем;"
		"4) снизу машинный ввод, над ним кривошип. Залежь кончается — запас в очках."
		"&7&o— Техника безопасности: молот не видит разницы между нефтью и вами.&r"
	]
	quest.5C6DE81149094BAE.title: "Нефтяная качалка"
	quest.5C9ADD5918630CF4.quest_desc: [
		"&3Сделай:&r гнездо — дом и зарядка дронов: батарея ниже 12 % — дрон сам летит сюда и возвращается заряженным."
		"&3Чем:&r механические крафтеры: латунный лист, депо, латунный лист; конденсатор, латунный корпус, конденсатор; электромедь, медная катушка C\\&A, электромедь."
		"&3Где:&r на базе, к сети: ток с любой стороны, кроме верха, до 4 000 FE/т. Поставил — стало домом."
	]
	quest.5C9ADD5918630CF4.title: "Гнездо дронов"
	quest.5CC2972B8E23DC31.quest_desc: [
		"&3Сделай:&r балластный клапан — насос между морем и цистернами."
		"&3Чем:&r крафтеры шахматкой или миксер: 5 медных самородков, 4 медных блока."
		"Трубы Create к цистернам, вращение на клапан, грань — к морю. Направление вращения — набор или откачка."
		"&3Дальше:&r погружение."
	]
	quest.5CC2972B8E23DC31.title: "Балластный клапан"
	quest.5CD1EC681729A76D.quest_desc: [
		"&3Сделай:&r взлети — ПКМ по оседланному дракону."
		"Прыжок — вверх, «Снижаться» — вниз, летит куда смотришь; «Атака дракона» — дыхание. Клавиши — Управление → «Драконы». Отметь после полёта."
		"&3Дальше:&r гибриды."
	]
	quest.5CD1EC681729A76D.title: "В небо!"
	quest.5D0BB0FB363BCF9C.quest_desc: [
		"&3Сделай:&r оборону там, где орда реально идёт."
		"Орда выходит кольцом в 30–45 блоках от алтаря, за зоной базы, и идёт к нему. Моб ближе 2 блоков к алтарю — провал. Набег идёт, пока кто-то ближе 160 блоков; живых мобов разом — до 120."
		"&3Дальше:&r стены → ловушки → турели → пушки → радар."
		"{\"text\": \"▶ Этап 3 · Алтарь и первые волны\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2B5D5FE8FC36C5DE\"}}"
	]
	quest.5D0BB0FB363BCF9C.title: "Как ходит орда"
	quest.5D619F38B169BB70.quest_desc: [
		"&3Сделай:&r незерак без Незера."
		"&3Чем:&r экструдер: лава с двух сторон, снизу почва душ. Незерак → колёса → мука → промывка: &625 %&r самородок золота."
	]
	quest.5D619F38B169BB70.title: "Незерак без Незера"
	quest.5E0607B3F18523E3.quest_desc: [
		"&3Сделай:&r улучшения к форсажу: бронекорпус (урон ÷3, тяга −10 %) и экономайзер (топливо ×0,4)."
		"&3Чем:&r сборка по шагам. Бронекорпус: усиление корпуса → прочный лист → стальной лист → прочный лист → пресс → Пилот III. Экономайзер: промышленные механизмы → механизм точности → жидкостная труба → электромедь → Пилот III."
	]
	quest.5E0607B3F18523E3.title: "Бронекорпус и экономайзер"
	quest.5E46C064FCD78091.quest_desc: [
		"&3Сделай:&r булава — удар с высоты, самый сильный в игре."
		"&3Чем:&r крафтеры: тяжёлое ядро + стержень вихря."
		"&3Где:&r ядро — редкая добыча набегов 43–49 и хранилищ испытаний; стержни — с вихрей (набеги с 14-й)."
		"Урон 6; с высоты +4 за каждый из первых 3 блоков, +2 за следующие 5, +1 дальше, падение гасится. Заряд ветра подбрасывает: прыжок, удар, повтор."
		"&7&o— Техника безопасности: промах булавой с 30 блоков — это не промах. Это падение.&r"
	]
	quest.5E46C064FCD78091.title: "Булава"
	quest.5E4F935500884B5E.quest_desc: [
		"&3Сделай:&r пара блоков, суперклей по ним, сборщик рядом — рычаг вверх. По штуковине можно ходить и дёргать рычаги на ходу."
		"&3Чем:&r суперклей Create или мёдоклей (дозатор льёт мёд на железный лист)."
		"&3Дальше:&r пропеллеры, аэростат, колёса или балласт."
	]
	quest.5E4F935500884B5E.title: "Первая штуковина"
	quest.5E512EAAD7AD8E46.quest_desc: [
		"&3Сделай:&r деплоер, который бьёт как игрок, пока крутится вал."
		"&3Чем:&r меч в руку деплоеру (ПКМ мечом), ключом — режим удара. Урон меча, Острота работает, мобы на него не злятся."
		"Добыча падает ему в руку — забирай воронкой. Для игры он игрок: «игроцкий» лут (и конденсаторы стражей) выпадает."
		"&3Дальше:&r мясорубка."
	]
	quest.5E512EAAD7AD8E46.title: "Деплоер с мечом"
	quest.5E7E779ADCC9DF09.quest_desc: [
		"&3Сделай:&r поставь яйцо и нажми по нему ПКМ — дракончик вылупится через ~10 минут, вырастет ещё за ~10."
		"Рядом не дерись и яйцо не ломай. Отметь, когда вылупится."
		"&3Дальше:&r приручение."
		"&7&o— Столовая: «Это не омлет. Повторяем: это НЕ омлет».&r"
	]
	quest.5E7E779ADCC9DF09.title: "Вылупление"
	quest.5E9B9A280ABBD6B0.quest_desc: [
		"&3Сделай:&r пороховые заряды — снаряд летит на них."
		"&3Чем:&r пресс: 3 оружейного пороха → спрессованный; пустой заряд — нитки и шерсть; вместе в миксере — заряд."
		"Заряды — в блоки ствола (в дуле 20 % на разрыв). Больше нормы — разрыв 50 %, мало — снаряд застрянет 25 %."
		"{\"text\": \"▶ Оружейный порох\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2BC1B58A4F6EE6D5\"}}"
	]
	quest.5E9B9A280ABBD6B0.title: "Пороховой заряд"
	quest.5E9F40AEAEB40403.quest_desc: [
		"&3Сделай:&r броня из межпланетного сплава — защита &e24&r, не горит в лаве."
		"&3Чем:&r крафтеры в ряд: сплав | незеритовая вещь | сплав; на комплект 8 сплавов."
		"{\"text\": \"▶ Межпланетный сплав\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"539485CE657AFD69\"}}"
		"&3Дальше:&r энергощит."
	]
	quest.5E9F40AEAEB40403.title: "&dБроня из межпланетного сплава&r"
	quest.5EBA2668E0066D4F.quest_desc: [
		"&3Сделай:&r заряжать ячейки на форпосте."
		"&3Чем:&r крафтеры: депо, медный корпус, 2 медные катушки, 2 конденсатора, электромедь."
		"&3Как:&r ток с любой стороны, до &68 000 FE/т&r; ячейка — за 12,5 с. Ячейки — в 4 гнезда сверху (воронка, лента, ПКМ); полная выходит сама вперёд через люк — на ленту, в сундук или в портативный складской интерфейс у перрона."
	]
	quest.5EBA2668E0066D4F.title: "Зарядная станция"
	quest.5F03E560473FFEB2.quest_desc: [
		"&3Сделай:&r механизм точности — для контроллера, руки, загрузчиков чанков."
		"&3Чем:&r сборка по шагам: золотой лист проходит 3 деплоера (шестерня, большая шестерня, железный самородок), 5 кругов; ≈80 % выхода."
	]
	quest.5F03E560473FFEB2.title: "Механизм точности"
	quest.5F66150BE3C4D321.quest_desc: [
		"Съешь — &d+1 сердце максимума навсегда&r, до +5. Шестое не приживётся — вернётся в инвентарь, отдай другу."
		"Только из набегов: изредка в добыче и наверняка за первое прохождение 50-й, 60-й и каждой 10-й с 70-й; в Бесконечности — каждой 5-й. За сотую — сразу три."
		"Ни купить, ни продать: EMC у него нет."
		"&7&oСердце ночи ещё тёплое. Не спрашивай, чьё.&r"
	]
	quest.5F66150BE3C4D321.title: "Сердце ночи"
	quest.5F6E91CF98C1DAB5.quest_desc: [
		"&3Сделай:&r монитор и связь блоков радара."
		"&3Чем:&r монитор (3 лампы, латунный корпус, механизм точности → 3) — рядом складываются в экран. Передатчик данных (Data Link) связывает блоки до 128."
		"&3Дальше:&r сетевой контроллер."
	]
	quest.5F6E91CF98C1DAB5.title: "Монитор и связь"
	quest.60055E81B084F741.quest_desc: [
		"&3Сделай:&r межпланетное точило (аддон Axiomativ) — сплавляет металлы разных планет."
		"&3Чем:&r крафтеры: жернов, 3 титановых листа, вольфрамовый лист, 2 механизма точности. Крутить от 100 об/мин (32 SU на об/мин)."
		"Подача — воронкой, желобом, лентой или ПКМ; забирать — ПКМ пустой рукой или воронкой снизу."
	]
	quest.60055E81B084F741.title: "&dМежпланетное точило&r"
	quest.60435D2A4499BA6F.quest_desc: [
		"Вся орда &7невидима&r. Видно только в луче &eпрожектора&r (аддон Axiomativ): в луче моб теряет невидимость и светится ещё 5 с после."
		"Ставьте прожекторы на подходах к стене, на ток. Турели и тесла тоже бьют только тех, кого видно."
		"&8Блэкаут&r (56) — то же, но у защитников весь набег «Тьма»: свет и цель даёт только прожектор."
		"Первое прохождение: &6Призменная линза&r."
	]
	quest.60435D2A4499BA6F.title: "Волна 34: Невидимки"
	quest.6068DECB682A4365.quest_desc: [
		"&3Сделай:&r пилу в полу коридора — урон каждому, кто идёт мимо."
		"&3Чем:&r утопи пилу лезвием вверх, дай вращение. Урон за удар:"
		"&e32 об/мин&r — &63,5&r, &e64&r — &65&r, &e128&r — &68&r, &e256&r — &610&r"
		"Моб после удара полсекунды неуязвим: на 256 об/мин ~&620&r урона/с. Бур бьёт так же."
		"&3Дальше:&r вентилятор с лавой."
	]
	quest.6068DECB682A4365.title: "Пила в полу"
	quest.6093A92FF80FA235.quest_desc: [
		"&3Сделай:&r драконью броню — от кожи до алмаза."
		"&3Где:&r сундуки построек; надевается в инвентаре дракона. ПКМ сундуком по дракону — он понесёт сундук."
	]
	quest.6093A92FF80FA235.title: "Броня и сундук"
	quest.6098697A991695C9.quest_desc: [
		"&3Сделай:&r генератор, который растёт вместе с магнитами: &622–540 FE/т&r на катушку при 64 об/мин."
		"&3Чем:&r катушка динамо — миксер: 8 электромеди + блок андезитового сплава. До 8 катушек на валу, вокруг каждой 12 магнитов рамкой 5×5 без углов, в конце ряда — углеродный накопитель (щётки)."
		"FE/т = сумма сил магнитов × об/мин × 0,0293. Магнетит — форпост «Магнитная аномалия»."
		"{\"text\": \"▶ Магнитная аномалия\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"25FE55697EDE4ECC\"}}"
	]
	quest.6098697A991695C9.title: "Катушка динамо и магниты"
	quest.614B14F253B142DB.quest_desc: [
		"&3Сделай:&r укрепления вокруг домны — плавка вдвое быстрее."
		"&3Чем:&r 3 стальных слитка + 3 тяжёлые пластины (сталь прессом) + 3 огнеупорных кирпича → 4."
	]
	quest.614B14F253B142DB.title: "Укрепления домны"
	quest.6198B25FE394E4CE.quest_desc: [
		"&3Сделай:&r топливо. 6 выходов: 340 мБ нефти → 120 тяжёлой нефти, 60 дизеля, 60 бензина, 60 газа, 30 керосина, 10 нафты."
		"Тяжёлую нефть гони ещё раз. Полный бак на выходе глушит башню — включи «уничтожать излишек»."
		"&3Дальше:&r двигатели; керосин и нафта — ракете."
		"{\"text\": \"▶ Ракетное топливо\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1172882304DE25C3\"}}"
	]
	quest.6198B25FE394E4CE.title: "Бензин, дизель, керосин"
	quest.61FD7D8079AA53C1.quest_desc: [
		"&3Сделай:&r выход доменной печи: блок чугуна, 4 чугунные трубы, 4 огнеупорных кирпича."
		"&3Где:&r вокруг — цилиндр из огнеупорного кирпича, в стене — люк (горячий воздух). Засыпка сверху, второй люк наверху собирает печной газ. Топливо и таймер — в очках."
	]
	quest.61FD7D8079AA53C1.title: "Доменная печь"
	quest.623A961731713FA8.quest_desc: [
		"&3К концу этапа:&r свой самолёт с пушкой, удостоверение пилота и вылеты за метеоритами."
		"• &eБиплан&r (Immersive Aircraft): корпус и пропеллер — алюминий (Бокситовый карьер, саванна), кабина — кварцевое стекло (Кварцевый карьер, пустыня)."
		"• &eВращающаяся пушка&r на самолёт — к 24-й «Воздушному бою»: ульи ранит только тот, кто в воздухе."
		"• &eПилот III&r — аэроклуб считает налёт сам (&e/aeroclub&r): лучшие самолёты и Форсаж I."
		"• &eМетеорит&r падает раз в 2–3 игровых дня в 400–900 блоках от алтаря: столб света, метка в чате."
		"&3Волны:&r 24 — бой в воздухе; 28 «Побег» — вся команда на транспорте; 36 — долететь ~280 блоков до гнезда."
		"{@pagebreak}"
		"{\"text\": \"▶ Готовый самолёт\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"135091C07022C9A1\"}}"
		"{\"text\": \"▶ Аэроклуб: Пилот III\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1A33CB476C1A29D4\"}}"
		"{\"text\": \"▶ Метеорит\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1F7106947E9DF5CB\"}}"
		"&3Дальше:&r этап 11 — сталь, нефть и ток поездом."
	]
	quest.623A961731713FA8.title: "Этап 10 · Небо"
	quest.625E481953585276.quest_desc: [
		"&3Сделай:&r расписание — поезд ездит сам."
		"&3Чем:&r миксер: прочный лист + бумага → 4. Составь маршрут и отдай машинисту: горелке или любому существу перед контроллером."
	]
	quest.625E481953585276.title: "Расписание поезда"
	quest.629E15D96732EB91.quest_desc: [
		"&3Сделай:&r отчёт в штаб — слиток аксиомита и слиток стабилита на руках: смена дошла до края карты компании."
		"Бухгалтерия EMC оценивает каждый в 40 960."
		"&7&o— Штаб: «Отчёт принят. Свобода от рутины — со следующей смены».&r"
	]
	quest.629E15D96732EB91.title: "&6Отчёт в штаб&r"
	quest.62D949F92F5E380D.quest_desc: [
		"&3Сделай:&r стол трансмутации: сдал вещь — получил &eEMC&r и знание о ней; знание покупается за EMC. Покупка и продажа — по одной цене, EMC общий на команду."
		"&3Чем:&r миксер — 4 андезитовых сплава, андезитовый корпус, 2 редстоуна, 2 камня."
		"&cНельзя&r купить и продать технику Create и сплавы (латунь, сплав, сталь, дроблёная руда): их делает только завод."
		"{@pagebreak}"
		"&eЛимит покупок:&r не больше 64 штук каждого предмета за 5 минут — один счёт на сервер. Остаток и сброс — над хотбаром при покупке."
		"&eВыкуп:&r проданное за последние 10 минут покупается обратно без лимита."
		"Тот же лимит у планшетов, сетки арканного планшета, звена EMC и прочих. &cКонденсаторов EMC нет&r: поставленные стоят без дела — забери вещи."
	]
	quest.62D949F92F5E380D.title: "Стол трансмутации"
	quest.63884CBF99FC1C65.quest_desc: [
		"Частые беды физических штуковин."
		"&eНе взлетает&r — тяги меньше массы: ещё винт, пропеллер на подшипнике или рама легче."
		"&eТолкает не туда&r — ключ по пропеллеру (реверс)."
		"&eНе разбирается&r — крен до 4°, почти без скорости, у земли."
		"&eСдувает с палубы&r — скобы (самородок железа над андезитовым сплавом)."
		"Неудачную штуковину разбери и собери снова — блоки не теряются."
	]
	quest.63884CBF99FC1C65.title: "Справка: если не летит"
	quest.6396C3E683386BB8.quest_desc: [
		"Орду берёт &bтолько ток&r: тесла-башня (аддон Axiomativ), молния — посох молний, заряд. Пули, мечи и турели — мимо."
		"Строй тесла-башни заранее и держи сеть: залпы едят энергию. Повторы — 44 и 64."
		"Первое прохождение: &6Сердечник катушки&r."
	]
	quest.6396C3E683386BB8.title: "Волна 22: Механоиды"
	quest.63BAEF061288EE28.quest_desc: [
		"Что платит больше обычного — держи запас на складе."
		"&eСрочный&r (каждый пятый): срок 1 игровой день (≈ &620&r мин), объём меньше, плата &6×2&r."
		"&eЦепочка&r — три заказа подряд у одной фактории: все три — премия &6+50 %&r и посылка. Сгорел шаг — цепочка сорвана."
		"&e«Мост через реку»&r (волны 6–30) — посылка: зонд железной жилы."
		"&e«Аэродром у фактории»&r (15–45) — заряд молнии."
		"&e«Станция на Луне»&r (с 40-й) — справка справа."
		"&7&o— Юротдел: сдача после срока — не сдача, а подарок.&r"
	]
	quest.63BAEF061288EE28.title: "Справка: срочные заказы и цепочки"
	quest.63D73C7D0A577B48.quest_desc: [
		"&3Сделай:&r ракетную станцию — собирает ракету, выбирает курс, проверяет запасы; летит вместе с ракетой."
		"&3Чем:&r крафтеры: 9 титановых пластин, 5 титановых слитков, 4 закалённых механизма, 2 схемы, 2 железные шестерни, навигационный компьютер."
		"Окно (ПКМ): Fuel, Thrusters, Heat Shielding, Navigator, Computers. Слот — для Атласа или Обратного билета; кнопки «Собрать Ракету» и «Disassemble Rocket»."
		"Компоновка целиком — Ponder: W на станции в JEI."
		"&3Дальше:&r сборка ракеты."
	]
	quest.63D73C7D0A577B48.title: "Ракетная станция"
	quest.63F586606A40A32E.quest_desc: [
		"&3Сделай:&r известняковый песок — единственный флюс домны."
		"&3Чем:&r жернов или колёса по известняку Create (прослойки среди пород Create)."
	]
	quest.63F586606A40A32E.title: "Флюс: известняковый песок"
	quest.642C38A2F7823EF0.quest_desc: [
		"&3Сделай:&r посох равновесия — радиус 12: своим +4 сердца и регенерация, врагам 16 урона и слабость."
		"&3Чем:&r крафтеры: «стабилит | божественная жемчужина | стабилит», «эссенция | золотой стержень | эссенция», золотой стержень внизу."
		"&3Где:&r стабилит — наши планеты, звёздная кирка."
		"&7&o— ОТК: «Равновесие — это когда у орды минус, а у бригады плюс».&r"
	]
	quest.642C38A2F7823EF0.title: "Посох равновесия"
	quest.6436250ACE0D60A8.quest_desc: [
		"&3Сделай:&r нож — режет мясо на доске, собирает дикие овощи и солому."
		"&3Чем:&r миксер: кремень + палка (железный — слиток + палка, быстрее)."
		"&3Дальше:&r доска, дикие грядки, хлеб."
		"&7&o— Техника безопасности: нож — кухонный инструмент. Зомби об этом не знают.&r"
	]
	quest.6436250ACE0D60A8.title: "Нож"
	quest.648B4A2170FD0077.quest_desc: [
		"&3Сделай:&r броня эха — комплект даёт &aСилу II&r и &aСопротивление II&r навсегда. Защита 20, вязкость 12."
		"&3Чем:&r крафтеры в ряд: шаблон эха | незеритовая вещь | слиток эха."
		"&eСлиток&r — незеритовый слиток, сборка по шагам, 5 кругов: лава → пресс → плавленое эхо → огненный порошок → пресс. &eПлавленое эхо&r — миксер на сверхнагреве из 2 осколков. &eШаблон&r — пресс с нагревом: осколок эха, глубинный сланец, огненный порошок."
		"&3Где:&r осколки эха — сундуки древних городов."
	]
	quest.648B4A2170FD0077.title: "Броня эха"
	quest.64B2071B71444A15.quest_desc: [
		"&3Сделай:&r рама, 3–4 крепления по углам, шины, двигатель на борту, вращение на валы креплений. Поехали."
		"Руль — сигнал сбоку крепления (тяговый рычаг или пульт), тормоз — сверху."
		"Транспорт нужен к «Побегу»: пешком от Пожирателя не уйти."
		"&3Дальше:&r бур-вездеход."
		"{\"text\": \"▶ Волна 28: Побег\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1531C3C2A9EA07F1\"}}"
	]
	quest.64B2071B71444A15.title: "Первая машина"
	quest.64CD01588A6A664E.quest_desc: [
		"&3Сделай:&r авиаторские очки — видно тягу пропеллера и нагрузку: хватит ли на взлёт, ясно ещё на земле."
		"&3Чем:&r миксер или крафтер: кожа + инженерные очки."
	]
	quest.64CD01588A6A664E.title: "Авиаторские очки"
	quest.6503EB1CA12CEEC8.quest_desc: [
		"&3Сделай:&r конденсатор луча стража — без него лазерную турель не собрать."
		"&3Где:&r стражи у океанских монументов (появляются снова): &625 %&r, с Добычей III — &655 %&r. Древний конденсатор — с древних стражей (по трое на монумент, навсегда): &615 %&r / &645 %&r."
		"Убить должен игрок или деплоер. За EMC конденсаторы не торгуются."
		"&3Дальше:&r лазерная турель."
	]
	quest.6503EB1CA12CEEC8.title: "Охота на стражей"
	quest.652D8C7BE73B6E6F.quest_desc: [
		"&3Сделай:&r латунный корпус — основа крафтеров, баков, станций, поездов."
		"&3Чем:&r окорённое бревно поставь блоком и ПКМ латунным слитком (или деплоер со слитком)."
		"&3Дальше:&r электронная лампа."
	]
	quest.652D8C7BE73B6E6F.title: "Латунный корпус"
	quest.65323940C7E98B08.quest_desc: [
		"&3Эта глава — маршрут смены:&r 12 этапов слева направо, от ящика до космоса. Внизу — &eкарта замков&r: к какой волне что построить."
		"&3Этап&r — шестиугольник со списком предметов-задач. Засчитываются сами, когда предмет окажется в инвентаре: поставленную машину сними ключом (Shift+ПКМ) и поставь обратно."
		"&3Прикрепить&r — кнопка в окне квеста: задачи этапа будут на экране."
		"&3▶ Синие ссылки&r в описаниях открывают подробный квест в другой главе."
		"{@pagebreak}"
		"&3Рецепты:&r в JEI &6R&r — из чего, &6U&r — где нужен, &6W&r — Ponder (сценка Create). &6J&r — планшет инженера: поиск и цепочка до сырья. &6P&r над предметом (в JEI, сундуке, инвентаре) — закрепить справа на экране с подсказкой «▶ СЕЙЧАС»; убрать — &e/unpin&r."
		"&3Застрял&r — глава «Частые вопросы»."
		"{\"text\": \"▶ Частые вопросы\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"005E934BAF69625A\"}}"
		"{\"text\": \"▶ Словарь смены\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"36EC191493CF8DB8\"}}"
		"&7&oОтдел кадров: «Инструктаж считается пройденным, если вы его открыли». Юротдел: «…и не закрыли сразу».&r"
	]
	quest.65323940C7E98B08.title: "Как читать эту книгу"
	quest.65643FB540C724EF.quest_desc: [
		"&3Сделай:&r стопку таблеток: одна спора — 6 штук, каждая +25 % рассудка."
		"&3Чем:&r миксер: сахар + сладкие ягоды + маленький цветок + спора → 6. Настойке жизни — 2 споры."
		"{\"text\": \"▶ Рассудок: что ест и что лечит\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"359D349B31911454\"}}"
	]
	quest.65643FB540C724EF.title: "Успокоительное из спор"
	quest.65BDB0A73D405268.quest_desc: [
		"&3Сделай:&r крупнокалиберную автопушку — свои бронебойные и фугасные выстрелы."
		"&3Чем:&r крафтеры из стальных частей автопушки CBC: казённик — 2 стальных казённика, 2 пружины, 4 стали, механизм точности; ствол — 2 стальных ствола, 4 стали."
		"Выстрел: бронебойный (или зенитный + порох) снаряд + снаряжённая гильза + сталь → 2."
	]
	quest.65BDB0A73D405268.title: "Крупнокалиберная автопушка"
	quest.65CB6AE9800DF7D3.quest_desc: [
		"Риск за добычу: в пульте вкладка &eУсловия&r (в чате — строка «Условия смены») — включай перед набегом, орда станет злее, а добычи больше."
		"Бросков обычной добычи ×(1 + бонус/2), артефакт смены — лишние броски: целая часть бонуса наверняка, дробная — шансом. Условие, которое на этой волне ничего не меняет, бонуса не даёт."
		"{@pagebreak}"
		"&6Афиша&r: всегда — &cДвойная смена&r (+60 %), &cНочь боссов&r (+40 %), &cЖелезная воля&r (+60 %, смерть защитника = провал). Ещё 4 меняются с рассветом."
		"Сменные: Стеклянная пушка (+25 %), Ярость (+30 %), Подрывной день (+20 %, с 18-й), Без света (+20 %), &cХрупкий алтарь&r (прочность 1, +30 %), &cЧемпионы&r (×4 в каждой подволне, +35 %), &cЭскалация&r (каждую минуту злее, +30 %), &cЖивучие&r (Регенерация II, +25 %), &cРучная работа&r (машины бьют вполовину, +35 %)."
		"Включённые видны всегда — их можно выключить; условие из контракта — тоже."
		"&7&o— Бухгалтерия: «Премия за вредность начисляется посмертно. Шутка. Или нет».&r"
	]
	quest.65CB6AE9800DF7D3.title: "Условия смены"
	quest.65EBFC16CC926C3D.quest_desc: [
		"&3Сделай:&r лазерную турель — сама находит моба и жжёт, пока крутится вал."
		"&3Чем:&r крафтеры 5×3 (призмарин, стекло, вал, цинк, конденсатор стража — R в JEI). Не ниже 30 об/мин."
		"Бьёт 1 цель в 17 блоках на &66&r. Заряд луча: &e32 об/мин&r — 4,5 с, &e64&r — 3,5 с, &e128&r — 2,5 с, &e256&r — 1,5 с. Кого бить — настройка на турели."
		"{\"text\": \"▶ Волна 26 · Бронеколонна\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"3DF6876E559D757D\"}}"
	]
	quest.65EBFC16CC926C3D.title: "Лазерная турель"
	quest.663530EB05D899C2.quest_desc: [
		"&3Сделай:&r тепло без топлива — для Стирлинга, позже для нагревателей."
		"&3Чем:&r тепловые трубы — миксер: 3 терракоты + медный лист + 2 цинковых самородка → 4. Обыкновенный солнечный теплогенератор — крафтеры: 3 кварцевых стекла (форпост «Кварцевый карьер»), 4 железных слитка, 2 трубы."
		"{@pagebreak}"
		"&eСолнечный теплогенератор&r: обыкновенный — до &620&r тепла/с, продвинутый — до &660&r (днём, под небом; в дождь слабее, ночью 0)."
		"&eТруба&r над лавой, огнём, магмой — &66/с&r; над горелкой — &624/с&r, на торте — &642/с&r. Каждая труба теряет 1/с."
		"&cНе копи тепло:&r блок, где больше &610 000&r тепла, превращается в лаву."
	]
	quest.663530EB05D899C2.title: "Тепло: солнце и трубы"
	quest.664ED02D22778AFB.quest_desc: [
		"&3Сделай:&r кабину: на пульт ставятся модули — штурвал, рычаг, джойстик, педаль, кнопки, каждый на свою частоту."
		"&3Чем:&r миксер: латунный корпус, электронная лампа, механизм точности, передатчик, редстоун-связь."
		"Сигнал в поворот — сервопривод Aeroworks или адаптер наклона Create Propulsion."
		"&7&o— Юротдел: «Кто за штурвалом — тот и виноват».&r"
	]
	quest.664ED02D22778AFB.title: "Пульт управления"
	quest.673A7292B8F58775.quest_desc: [
		"&3Сделай:&r аэрофотоаппарат — ищет жилы Create Ore Excavation с воздуха."
		"&3Чем:&r сборка по шагам: латунный корпус → подзорная труба → электронная лампа → механизм точности → Пилот III. Плёнка — миксер: 3 бумаги, чёрный краситель, слизь → 6."
		"{@pagebreak}"
		"Лети выше 150 с аппаратом в руке или в багажнике: снимает сам, ПКМ — сразу. Снимок = плёнка."
		"&eКадр&r — 7×7 чанков на 150+, 9×9 на 200+, 11×11 на 250+."
		"Жилы — в чате и Xaero «[Добавить]»; все — &e/atlas&r (&e/atlas железо&r — по типу)."
	]
	quest.673A7292B8F58775.title: "Аэрофотоаппарат"
	quest.676D2249E255B12B.quest_desc: [
		"&3Сделай:&r люк опыта — опыт жидкостью в баке."
		"&3Чем:&r блок опыта на жидкостный люк (ПКМ), люк — на бак. ПКМ — сдать опыт, Shift+ПКМ — забрать."
	]
	quest.676D2249E255B12B.title: "Люк опыта"
	quest.6830526159D51413.quest_desc: [
		"Инь-Янь идёт по орбите Земли, на 60° позади неё. Расколота надвое: чёрные земли Инь и белые Ян — квадратами по 8192 блока, у X = 0, Z = 0 сходятся все четыре."
		"&3Долететь:&r наука 7, оба навигатора; до неё около 1 а.е."
		"+20 °C, земная тяжесть, воздух — разреженный водород: скафандр обязателен. Теплозащита 60 + 0,1 за блок. Садишься в те же X/Z — стартуй ближе к 0, 0."
	]
	quest.6830526159D51413.title: "&6Инь-Янь: планета равновесия&r"
	quest.686F94EE226A9895.quest_desc: [
		"&3Сделай:&r стальной ствол — 8 зарядов (незер-сталь — 10)."
		"&3Чем:&r сталь CBC — миксер с нагревом: 2 железных слитка + уголь → 2. Ствол — 5 слоёв: отлить, просверлить, собрать наращивателем, потом 5 минут вентилятор сквозь лаву. Шов отнимает 2 заряда."
		"&3Дальше:&r фугасы, магазин."
	]
	quest.686F94EE226A9895.title: "Стальные стволы"
	quest.6880D921FDA3F837.quest_desc: [
		"Справка: что даёт экструдер и чем дробить породу."
		"&eБулыжник&r → жернов → гравий → промывка: железо"
		"&eГранит&r → красный песок → промывка: медь"
		"&eДиорит&r → колёса: 25 % цинка + кварц"
		"Скорость: 32 об/мин — блок за &62,5 с&r, 256 — за &60,35 с&r."
		"{@pagebreak}"
		"Снизу: булыжник — &64&r удара на блок, груда руды — &62&r, блок сырой руды — &61&r (латунный экструдер)."
		"Порода колёсами: &eкримзит&r — 40 % дроблёного железа + 40 % самородка, &eверидий&r — 80 % меди, &eазурин&r — 30 % цинка + лазурит, &eохрум&r — 20 % золота."
	]
	quest.6880D921FDA3F837.title: "Справка: завод без шахты"
	quest.689528CB26C0E3A3.quest_desc: [
		"&3Сделай:&r волшебная наковальня — поднимать уровень заклинаний."
		"&3Чем:&r крафтеры по раскладке JEI."
		"Свиток + чернила следующей редкости → уровень выше; оружие + свиток → оружие колдует; броня или книга + сфера → бонус (до 3)."
		"&3Дальше:&r мифрил, сфера улучшения."
	]
	quest.689528CB26C0E3A3.title: "Волшебная наковальня"
	quest.68AEF2EB9277660D.quest_desc: [
		"&3Сделай:&r ток в руках — &62 млн FE&r в ячейке. Провод с дальнего месторождения не дотянуть — ток возят поездом."
		"&3Чем:&r сборка по шагам, один круг: на конденсатор — второй конденсатор, электромедь, латунный лист, пресс (R). В стопке одна, заряд не утекает."
		"&3Дальше:&r зарядная станция → генератор на месторождении → разрядная станция на базе → поезд."
	]
	quest.68AEF2EB9277660D.title: "Шаг 7 · Энергофорпост: ячейка"
	quest.694F131770861161.quest_desc: [
		"Что привозит снабженец: 8–11 лотов, цены в жетонах (каждый раз чуть разные)."
		"&eВсегда&r — Ящик снабжения &6~8&r, ракеты для элитр или салют &6~4&r"
		"&eПластинка&r &6~7&r · &eсаженцы и цветы&r &6~2–6&r · &eшаблон отделки&r &6~11–18&r"
		"&eКниги чар&r &6~8–18&r (Починка дороже всех) · &eсвиток заклинания&r &6~10–16&r"
		"&eКосметика&r — рог козы, узоры флагов, бирки, седло, кепка; синий аксолотль &6~20&r"
		"&eКарта клада&r &6~10&r · &eсхрон разбойников&r &6~14&r"
		"{@pagebreak}"
		"&eРедкость&r (почти в каждом втором визите) — нюхач, сердце моря, тотем, зачарованное яблоко, эхо-осколки; с 5-й волны — &6яйцо дракона ~112&r, с 15-й — &6элитры ~88&r"
		"&eЗапас&r — на всю команду, 1–4 штуки на лот. Уходит через сутки."
		"&e/trader&r — где он и до когда · &e/trader post&r — лавка там, где стоишь (&e/trader post clear&r — снова у алтаря)"
		"Ящик снабжения и яйцо дракона — без цены EMC: стол их не покупает и не продаёт."
	]
	quest.694F131770861161.title: "Справка: снабженец"
	quest.69B53E0B6FA14ADE.quest_desc: [
		"&3Сделай:&r ток для машин TFMG — у них своя сеть с вольтами."
		"&3Чем:&r сборочная линия на валу, 3 круга: конденсатор TFMG → стальной лист → намотка медной катушки TFMG → электромедь → стальной механизм → отвёртка. Работает от 40 об/мин."
		"С FE-машинами стыкуется только кабельным узлом TFMG вплотную. Нужен просто ток — бери генератор переменного тока."
	]
	quest.69B53E0B6FA14ADE.title: "Генератор TFMG"
	quest.69C0C60E738BFA33.quest_desc: [
		"&3Сделай:&r звёздный навигатор — пропуск на Аксиоматив и Инь-Янь: без него ракета не летит, прибывшего иначе вернёт на Землю."
		"&3Чем:&r крафтеры: 2 межпланетных сплава + продвинутая схема / 2 механизма точности + ядро навигации / схема + 2 звёздные карты."
		"Носи в инвентаре (не тратится) — у каждого пассажира, иначе полёт отменён для всех. Второе ядро — 65 536 EMC. Межпланетный навигатор на борту тоже нужен."
	]
	quest.69C0C60E738BFA33.title: "&dЗвёздный навигатор&r"
	quest.6A13AEBFD75DFA61.quest_desc: [
		"&3Что:&r вместо орды — ульи-матки над базой, из них летят стрекозы и шершни. Ульи ранит только тот, кто в воздухе. 12 минут."
		"&3Построй к ней:&r самолёт с вращающейся пушкой (этап 10), элитры или дракон; тесла-башня тоже достаёт."
		"&3Ключ:&r чертёж форсажа — Форсаж II и III. Повторы — 42, 58. Только у алтаря базы под открытым небом."
	]
	quest.6A13AEBFD75DFA61.title: "Волна 24 · Воздушный бой"
	quest.6A226AA9E85F7950.quest_desc: [
		"&3Сделай:&r свинец — пули и дробь всех ружей."
		"&3Где:&r руда Gunsmithing — в камне и сланце; годится и свинец TFMG."
		"&3Чем:&r дробилка → промывка → вентилятор через лаву (печь руду не плавит). Картечь — самородки на пиле."
		"&3Дальше:&r бумажные патроны, щит."
	]
	quest.6A226AA9E85F7950.title: "Свинец"
	quest.6A24AF99B3061795.quest_desc: [
		"&3Сделай:&r стержни и провода: слиток → 2 стержня, лист → 2 провода (сначала пресс, потом стан)."
		"&3Чем:&r вращение; бросай сверху или подавай воронкой и лентой."
		"&3Дальше:&r железный стержень — в генератор, медные провода — в медную катушку."
		"&7&oСтан не спрашивает, что ты в него кладёшь. Главное — не руку.&r"
	]
	quest.6A24AF99B3061795.title: "Прокатный стан"
	quest.6A79D752E0C6BF84.quest_desc: [
		"Справка: &6легендарные&r артефакты волн — с 27-й волны, основа позднего билда."
		"&6Кровь титана&r — +12 HP; вне боя +0,5 HP/с."
		"&6Щиток бригадира&r — +3 брони, +20 % стойкости к отбрасыванию, −12 % урона: самый большой срез среди артефактов волн."
		"&6Жетон второго дыхания&r — +4 HP; смертельный удар оставляет 1 HP и даёт 2 с неуязвимости, раз в 5 мин. Срабатывает раньше тотема — тотем цел."
		"Шанс каждого за победу: ≈0,14 % на 27-й волне, ≈0,97 % на 50-й, ≈3,8 % на 100-й."
	]
	quest.6A79D752E0C6BF84.title: "&6Легендарные&r артефакты"
	quest.6A8067E1681759B9.quest_desc: [
		"&3Сделай:&r квантовый ранец — склад отовсюду: любое расстояние, любое измерение, без ретрансляторов."
		"&3Чем:&r сборка по шагам на Mk2: небесный кристалл → межпланетный сплав → звёздная карта → небесный кристалл → энергоячейка → пресс."
		"&3Как:&r &66 млн FE&r, передача 60 + 0,25 FE за блок, из другого измерения +2 000 FE."
		"&7&o— Бухгалтерия: «Квантовая доставка списывается до того, как вы её заказали».&r"
	]
	quest.6A8067E1681759B9.title: "Квантовый ранец"
	quest.6A850784B9615901.quest_desc: [
		"&3Сделай:&r первые самородки — из породы."
		"&3Чем:&r жернов: булыжник → гравий, гранит → красный песок. Вентилятор сквозь воду на депо — промывка."
		"&eГравий&r → 25 % железа + кремень, &eкрасный песок&r → 25 % меди + редстоун."
		"&3Дальше:&r пресс и сплав."
	]
	quest.6A850784B9615901.title: "Первый металл: жернов и промывка"
	quest.6AF7098360A5E993.quest_desc: [
		"&3Сделай:&r меч эха — 8 урона, врагу &cСлабость II&r и &cТьма II&r на 5 с: громила под слабостью почти не ранит."
		"&3Чем:&r крафтеры в ряд: шаблон эха | незеритовый меч | слиток эха."
		"{\"text\": \"▶ Броня эха: где слиток и шаблон\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"648B4A2170FD0077\"}}"
		"&3Дальше:&r булава."
	]
	quest.6AF7098360A5E993.title: "Меч эха"
	quest.6B16D539F4FAB0E8.quest_desc: [
		"&3Сделай:&r экран, на котором видна вся база: ток, форпосты, поезда, набег, метеорит, заказы факторий. Больше не надо облетать форпосты, чтобы узнать, что один встал."
		"&3Чем:&r механические крафтеры: 2 дисплейных табло, 2 электронные лампы, латунный корпус, электромедь — сразу &62 экрана&r."
		"&3Как:&r ставь на стену; экраны рядом (одна стена, одна сторона) складываются в один — до &64×3&r. На 1×1 — коротко, на 4×3 — всё: график тока за 10 минут, список форпостов с выработкой в минуту, поезда с часами прибытия, метеорит и заказы."
		"{@pagebreak}"
		"&3ПКМ&r — окно: «Ток», «Форпосты» (там же «Переименовать»), «Поезда», «Смена», «Журнал»."
		"&3Тревоги:&r пока в мире есть хоть один экран, форпост встал (нет вращения, выход забит, чанк не загружен), поезд сошёл с рельс или ток на исходе — плашка в углу экрана у всех, раз на событие, и запись в журнал смены. Выключить для себя — внизу окна."
		"Экструдеры на месторождениях попадают в диспетчерскую сами — из сети форпостов. Остальное — датчиком."
		"&7&o— Служебная записка диспетчера: «Форпост не встал. Форпост решил отдохнуть. Разница — в загрузчике чанков».&r"
	]
	quest.6B16D539F4FAB0E8.title: "Диспетчерская"
	quest.6B1E8CF16AA099E5.quest_desc: [
		"&3Сделай:&r межпространственный ретранслятор — ранец Mk2 в Незере, Энде и на планетах достаёт склад базы."
		"&3Чем:&r крафтеры: небесный кристалл, ретранслятор снабжения, 2 метеоритного железа, 2 линзы, энергоячейка (R)."
		"&3Где:&r в другом измерении, к току: &6128 FE/т&r и &6500 FE&r за передачу, радиус &6256&r бл. Ранцу — +4 000 FE за передачу."
	]
	quest.6B1E8CF16AA099E5.title: "Межпространственный ретранслятор"
	quest.6B33460399FB68BA.quest_desc: [
		"&3Сделай:&r замкнутая оболочка, горелка под ней, всё проклеено и собрано сборщиком. Дай сигнал — всплывёт, когда подъём перевесит вес."
		"Высоту держит сам; вниз — ослабь сигнал. Вперёд — пропеллер с двигателем."
		"Задача — 16 оболочек на первый шар."
		"&3Дальше:&r левитит."
		"&7&o— Пресс-служба: «Мы не летаем медленно. Мы летаем вдумчиво».&r"
	]
	quest.6B33460399FB68BA.title: "Дирижабль поднялся"
	quest.6B4A80C8D04DFF1C.quest_desc: [
		"&3Сделай:&r сеть тока: генератор → провод → машины."
		"&3Чем:&r &eмедная катушка&r — пустая катушка + 4 медных провода, &aбез резины&r (рецепт R). Пустые — миксер: 2 железных листа + железный стержень → 24. &eНизковольтный соединитель&r — миксер: медный стержень + сплав + слизь → 3."
		"&3Как:&r соединитель на генератор и на машину; с катушкой в руке ПКМ по одному, потом по другому. Малый + медь — &6без лимита&r, до 4 проводов, пролёт &632&r блока. Режим «забирать/отдавать» ставится сам, поправить — ключом."
		"&3Дальше:&r накопитель — шаг 5; к 22-й волне — тесла-башня."
	]
	quest.6B4A80C8D04DFF1C.title: "Шаг 4 · Провод: медная катушка"
	quest.6BE2AB1CA7A7B150.quest_desc: [
		"Модули брони по слотам (рецепты — R в JEI):"
		"&eПружинные ботинки&r — падение &60&r"
		"&eШаговый подъёмник&r — шаг на блок без прыжка"
		"&eУскоритель бега&r (поножи) — скорость &6+30 %&r"
		"&eПрыжковые пружины&r (поножи) — прыжок &6~2,2&r блока"
		"&eБронепластина&r (нагрудник) — защита &6+4&r, вязкость &6+2&r"
		"&eЭнергощит&r (нагрудник) — своя ветка"
		"&eНочное видение&r (шлем) — квест ниже"
	]
	quest.6BE2AB1CA7A7B150.title: "Справка: модули"
	quest.6C0ECF8DB46B242F.quest_desc: [
		"&3Сделай:&r копи осколки орды — из них завод варит эссенцию пробуждения."
		"&3Где:&r мобы набега: осколки падают в &eкопилку набега&r, после победы её получает каждый защитник; провал — копилка сгорает. Босс — 4–8 наверняка."
		"Шанс с моба: волны 1–15 — 0,5–1,5 %, 16–70 — 1,5–6 %, дальше до 8 %; ванильные мобы — вдвое реже. Копилка сейчас — &e/nsart&r."
		"&3Дальше:&r пыль орды."
		"&7&o— Отдел снабжения: «Орда не знает, что её разбирают на запчасти. Не говорите ей».&r"
	]
	quest.6C0ECF8DB46B242F.title: "&dОсколок орды&r"
	quest.6C1319E4F7619FC0.quest_desc: [
		"&3Сделай:&r дожить до рассвета и отметить галочку."
		"Помогают свет вокруг базы, стены с дверью, костёр рядом и таблетки в кармане."
		"{\"text\": \"▶ Дальше — этап 3: алтарь\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2B5D5FE8FC36C5DE\"}}"
		"&7&oПресс-служба: «Смена прошла штатно. Потерь нет. Тех, кого нет, — тоже нет».&r"
	]
	quest.6C1319E4F7619FC0.title: "Пережить первую ночь"
	quest.6C3AD885DB6C2F69.quest_desc: [
		"В глубоких тёмных пещерах водится &cПещерный житель&r. Драться бесполезно — очень живучий."
		"Услышал — уходи к свету и наверх, не оборачивайся."
		"&7&oОтдел по работе с ордой: «С Пещерным жителем мы не работаем. Он работает с нами».&r"
	]
	quest.6C3AD885DB6C2F69.title: "Справка: пещерный житель"
	quest.6C614AF71546A618.quest_desc: [
		"Справка: &cмифические&r артефакты волн — с 43-й волны, ради них гриндят 50+."
		"&cПесочные часы смены&r — +2 брони; после удара моба или снаряда — 1 с полной неуязвимости, перезарядка 6 с (огонь и яд щит не тратят)."
		"&cСердце орды&r — +14 HP; вампиризм 6 % (до 3 HP за удар); вне боя +0,5 HP/с."
		"Шанс каждого за победу: ≈0,3 % на 43-й волне, ≈0,62 % на 50-й, ≈4,8 % на 100-й, ≈7,2 % на ∞20."
		"&7&oПесочные часы смены: одна секунда бессмертия, потом шесть секунд объяснительной.&r"
	]
	quest.6C614AF71546A618.title: "&cМифические&r артефакты"
	quest.6C6C1196E042B5E3.quest_desc: [
		"&3Сделай:&r звёздную кирку — только она (и стабилитовая) добывает аксиомит и стабилит."
		"&3Чем:&r крафтеры: 3 межпланетных сплава сверху, незеритовая кирка, под ней звёздный осколок (алтарь, первое прохождение 70-й волны — каждому)."
		"Прочность 2 500, скорость 10. Ещё осколки — редкая добыча волн 70+ и стол трансмутации."
		"{\"text\": \"▶ Волна 70\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"0445124ADFD41179\"}}"
	]
	quest.6C6C1196E042B5E3.title: "Звёздная кирка — осколок 70-й волны"
	quest.6C7048DAF23AD178.quest_desc: [
		"&3Сделай:&r книга заклинаний — колдует вписанное за ману."
		"&3Чем:&r хлипкий журнал — крафтеры: 2 медных слитка, нить, 6 бумаги; дорогие книги — больше ячеек."
		"ПКМ книгой — встаёт в свой слот; &eR&r — выбрать, &eV&r — колдовать."
		"&3Дальше:&r свитки, посохи."
	]
	quest.6C7048DAF23AD178.title: "Книга заклинаний"
	quest.6C9D773A2FC527F8.quest_desc: [
		"Волны 60–69: особые варианты — &8Невидимый жнец&r, Голиаф-титан, Бешеный богомол, Краб-владыка, подрывники-тяжеловесы. Боссы парами: 60 — Трисектор и Скорпиоид, 65 — Диаболос и Драконохвост."
		"Оборона должна работать без вас: турели, ремонт, патроны на потоке. Людей — не меньше двух."
		"&6Первое прохождение&r: &5Сердце ночи&r и сильный артефакт каждому."
	]
	quest.6C9D773A2FC527F8.title: "Волна 60: Ночь невидимок"
	quest.6CA219A30AA20749.quest_desc: [
		"&3Сделай:&r Атлас (книга + титановый слиток, миксер) — «ключ зажигания» станции."
		"&3Чем:&r астрономический стол (обтёсанное бревно, 4 деревянные плиты, железный слиток, бумага — миксер): Атлас + записи → наука."
		"Науки нужно: Земля 1, Луна 2, Марс 5, Венера и Меркурий 6, Инь-Янь 7, Аксиоматив 8. Каждая следующая запись с той же планеты весит ×0,9: с Земли Луна — 3 ночи, Марс — 7, Венера и Меркурий — 9."
		"Быстрее — снимать с Луны: счёт свой, и можно днём."
	]
	quest.6CA219A30AA20749.title: "Атлас и наука"
	quest.6DB17E94A8B8DC7D.quest_desc: [
		"&3Сделай:&r броня школы — усиливает заклинания своей школы."
		"&3Чем:&r миксер: вещь робы + руна школы + эссенция. Пустая руна — деплоер кладёт эссенцию на полированный глубинный сланец; руна школы — пустая + 8 фокусов (крафтеры 3×3)."
		"&eФокусы:&r огонь — стержень всполоха, лёд — замороженная кость, молния — молния в бутылке, свет — божественная жемчужина, Энд — жемчуг Края, кровь — флакон крови, заклятие — изумруд, природа — ядовитый картофель."
	]
	quest.6DB17E94A8B8DC7D.title: "Броня школы"
	quest.6E192BEA8931C4CD.quest_desc: [
		"&3Сделай:&r побей рекорд режима в своём классе оружия. Первый результат — эталон."
		"&3Награда:&r 3–4 жетона смены, если лучше прежнего на 5 % (очки — хотя бы +2, время — хотя бы на 0,5 с); до 8 жетонов в день."
		"Рекорды — на табло над рубежом, &e/tir top&r и в журнале смены."
		"&7&o— Техника безопасности: мишень не стреляет в ответ. Динамит тоже, но лучше не проверять.&r"
	]
	quest.6E192BEA8931C4CD.title: "Снайпер смены"
	quest.6E1ED7079EA38D72.quest_desc: [
		"&3Сделай:&r щит — закрыться от стрел скелетов и разбойников."
		"&3Чем:&r крафтеры, раскладка как на верстаке."
		"ПКМ — блок спереди; топор выбивает щит на 5 с."
		"&3Дальше:&r железная броня."
	]
	quest.6E1ED7079EA38D72.title: "Щит"
	quest.6ED17F493EBED118.quest_desc: [
		"&3Сделай:&r сборщик добычи — добыча без моба и без лагов."
		"&3Чем:&r крафтеры 5×5, как рассадник, но в центре бочка, без вала. Ставь в точку появления, выводи шлюзом."
	]
	quest.6ED17F493EBED118.title: "Сборщик добычи"
	quest.6ED7257BB0C28FE8.quest_desc: [
		"&3Сделай:&r доставку между мирами: буровая на Марсе → передатчик → склад на Земле. Ток на арену — тем же путём."
		"&3Чем:&r передатчик предметов Create: Ender Transmission — механические крафтеры 5×5 (R: обсидиан, эндер-жемчуг, око Края, механизмы точности, желоб)."
	]
	quest.6ED7257BB0C28FE8.title: "Доставка с планет"
	quest.6F0ED9E8085BFCE5.quest_desc: [
		"&3Сделай:&r шины: ПКМ по передней грани крепления."
		"&3Чем:&r маленькая — деплоер кладёт резину на вал; обычная — вал в кольце из 4 резины; большая — вал, 2 ремня, 2 резины; гигантская — 8 резины."
		"&3Где:&r резина — форпост «Каучуковая плантация»."
		"&3Дальше:&r первая машина."
	]
	quest.6F0ED9E8085BFCE5.title: "Шины"
	quest.6F174BDE59A5B3BF.quest_desc: [
		"Какой уровень даст котёл — по основанию бака."
		"&e1×1&r — 1 горелка: уголь &61&r, торт &62&r (32 768 SU)"
		"&e2×2&r — 4 горелки: уголь &64&r, торт &68&r (131 072 SU)"
		"&e3×3&r — 9 горелок: уголь &69&r, торт &618&r (294 912 SU, максимум)"
		"Высота бака: 4 блока под уголь, 8 — под торт; выше ничего не добавляет."
		"Котёл 18 пьёт &6180 мБ/т&r (две помпы на 256 об/мин) и ест ~&63,4&r торта в минуту."
		"&7&oКотёл 18 — это когда соседи думают, что у тебя поезд. Всегда.&r"
	]
	quest.6F174BDE59A5B3BF.title: "Справка: уровни котла"
	quest.6F3FDF1B1C44B4CF.quest_desc: [
		"&3Сделай:&r латунного дрона — копает, носит вещи или существ."
		"&3Чем:&r крафтеры 3×3: 2 пропеллера, редстоун-связь, 2 сплава, механизм точности. Модули — с пульта дрона."
	]
	quest.6F3FDF1B1C44B4CF.title: "Латунный дрон"
	quest.6F4F9C4D098CF5DC.quest_desc: [
		"&3Сделай:&r фонарь со светом 15 без тока — для базы и трассы."
		"&3Чем:&r деплоер кладёт звёздную пыль на стекло."
	]
	quest.6F4F9C4D098CF5DC.title: "Звёздный фонарь"
	quest.6F8E8FF64145C30B.quest_desc: [
		"&eСвисток:&r зажми ПКМ — откроется круговое меню, выбери «Свистнуть» и отпусти."
		"&eНе зовётся:&r свисток в инвентаре, ты не верхом, вокруг ~3×4×3 без блоков (выйди из-под крыши), 5 с между вызовами. Погибший зовётся через 60 с."
		"&eНевидим у хозяина:&r перезайди на сервер. Клавиша «Позвать дракона» — V, её делят ещё 6 модов: переназначь."
	]
	quest.6F8E8FF64145C30B.title: "Дракон не зовётся или пропал"
	quest.6FB0F8636A241397.quest_desc: [
		"Как сдать груз и забрать плату."
		"&eСдача&r — воронка, жёлоб, лоток сверху или конец ленты в терминал; руками — ПКМ стопкой или «Сдать из инвентаря» в окне (ПКМ по терминалу). Берёт только недостающее, лишнее остаётся у вас."
		"&eЗаказ&r — в окне и в очках инженера: что, сколько сдано, срок, плата. Сдача общая на смену."
		"&eКасса&r — кнопка «Забрать» или лоток/жёлоб &cснизу&r (воронка сбоку кассу не выгребет): жетоны едут домой тем же поездом."
		"Терминал не ломается, перенести факторию может только админ."
	]
	quest.6FB0F8636A241397.title: "Справка: терминал и касса"
	quest.6FBB17163563987D.quest_desc: [
		"&3Сделай:&r буровую — качает руду из жилы сама, пока жила не кончится (или вечно, если бесконечная)."
		"&3Чем:&r механические крафтеры, рецепт R: латунь, механизмы точности, лампы, механический бур."
		"&3Как:&r над жилой, вставить сменный бур, дать вращение. Незериту и закалённому алмазу — лаву трубой."
	]
	quest.6FBB17163563987D.title: "Буровая установка"
	quest.6FD1D61B190A391F.quest_desc: [
		"&3Сделай:&r горелку аэростата — греет воздух в оболочке над собой. Топлива не ест: сильнее редстоун-сигнал — полнее шар."
		"&3Чем:&r крафтеры, рецепт — R в JEI."
		"Одна горелка — до 500 м³, несколько складываются. Паровое сопло на котле Create занимает 1 уровень котла."
		"&3Дальше:&r первый дирижабль."
	]
	quest.6FD1D61B190A391F.title: "Горелка аэростата"
	quest.6FE93BB8113FA436.quest_desc: [
		"Справка: трофеи боссов Cataclysm — с 70-й волны (мини-боссы до 92-й, настоящие с 80-й). Самые сильные в паке."
		"Падают за победу на волне с боссом: легендарный 15 %, мифический 10 % каждому; первое прохождение — наверняка одному из вас."
		"&6Аметистовый панцирь&r — +4 брони, отражает 20 % урона вплотную, нет хватки краба. &7Аметистовый краб, Клаудиан.&r"
		"&6Медальон гладиатора&r — +2 урона; за убийство Сила I и Скорость I на 6 с. &7Кобольдиатор, Аптргангр, Уаджет.&r"
		"&6Ядро голема&r — +3 брони, +2 прочности брони, нет отбрасывания и паралича. &7Голем Края, Рыскун.&r"
		"{@pagebreak}"
		"&cОко Стража Края&r — +6 HP; второе дыхание с телепортом в сторону, раз в 3 мин. &7Страж Края (с 80-й).&r"
		"&cЯдро Игниса&r — огнестойкость; аура: монстры в 4 блоках горят, 2 урона в секунду. &7Игнис (с 82-й).&r"
		"&cВенец Маледиктуса&r — +3 урона, нет иссушения; удары: Иссушение II и Слабость I на 3 с. &7Маледиктус, Предвестник.&r"
		"&cОжерелье реликта&r — −12 % урона, подводное дыхание, нет замедления и слепоты. &7Древний реликт, Сцилла.&r"
		"&cНезеритовое сердце&r — +12 HP, +4 брони, +2 прочности брони, −5 % скорости. &7Незеритовое чудовище (с 92-й).&r"
		"&7&o— Отдел трофеев: «Голову Игниса на стену не вешать. Она до сих пор горячая».&r"
	]
	quest.6FE93BB8113FA436.title: "&cТрофеи боссов Cataclysm&r"
	quest.7029C1577D3B1501.quest_desc: [
		"Какая волна чего потребует — строй заранее. Прогноз у алтаря пишет, что ждёт."
		"&e15&r — заряд молнии за победу → ток (этап 7)"
		"&e16&r — мобы модов, пауки лезут по стенам → крыша, урон по площади"
		"&e22&r — орду берёт только ток → тесла-башни (этап 9)"
		"&e24&r — бой в воздухе → самолёт с пушкой (этап 10)"
		"&e26&r — только машины → турели, пушки, големы"
		"&e28&r — побег → транспорт на всех"
		"{@pagebreak}"
		"&e32&r — только магия → посохи, заклинания"
		"&e34&r — невидимки → прожекторы"
		"&e36&r — гнездо в ~280 блоках → полёт"
		"&e38&r — осада форпоста → оборона форпостов (этап 8)"
		"&e43&r — конвой → охрана обоза на транспорте"
		"&e50&r — ядро навигации → ракета (этап 12); &e70&r — звёздный осколок → кирка"
		"Особые стадии повторяются крепче: 42–68."
	]
	quest.7029C1577D3B1501.title: "Карта замков"
	quest.7036B8873470BA20.quest_desc: [
		"&3Сделай:&r всполох-чародея — чары жидким опытом, без стола."
		"&3Чем:&r 3 крафтера в ряд: кузнечный шаблон | горелка всполоха | стол зачарования. Опыт из бака, уровень — на панели (до &630&r)."
		"&7&oВсполох-чародей зачаровывает всё. Кроме бухгалтерии.&r"
	]
	quest.7036B8873470BA20.title: "Всполох-чародей"
	quest.705095DD857BF7D7.quest_desc: [
		"&3Сделай:&r резину — золотая и электрумовая катушки, высоковольтный соединитель, провода New Age, шины, шасси самолёта, уплотнитель кислорода. Медной катушке резина не нужна."
		"&3Где:&r джунгли: пятно красной латеритной почвы с серыми гевеями."
		"{@pagebreak}"
		"&3Чем:&r нож для подсочки (деплоер кладёт железный лист на палку) → ПКМ по стволу → латекс раз в 3 с. Ствол работает только на латеритной почве, до 6 в высоту; срубил — поставь снова."
		"Без рук: деплоер с ножом через клетку от ствола, латекс забирай воронкой с фильтром «латекс»."
		"Миксер с нагревом: 2 латекса + серная пыль → 3 резины."
		"&7&oГевея плачет латексом. Бухгалтерия плачет от счёта за серу. Все при деле.&r"
	]
	quest.705095DD857BF7D7.title: "Каучуковая плантация"
	quest.705B3EAB1D7AFA9A.quest_desc: [
		"Сколько стоит передача и куда достаёт связь. Передача — стак одного предмета."
		"&eMk1&r — &6400 000 FE&r; &6200 + 2 FE&r за блок до узла; база &6128&r бл.; только своё измерение"
		"&eMk2&r — &61,6 млн FE&r; &6120 + 1 FE&r за блок; база &6192&r бл.; другое измерение — &6+4 000 FE&r"
		"&eMk3&r — &66 млн FE&r; &660 + 0,25 FE&r за блок; отовсюду; другое измерение — &6+2 000 FE&r"
		"&eРетранслятор&r — &6160&r бл. вокруг; &616 FE/т&r + &6100 FE&r за передачу"
		"&eМежпространственный&r — &6256&r бл.; &6128 FE/т&r + &6500 FE&r за передачу"
		"Mk1 на краю базы — 456 FE за передачу: полного заряда хватит на ~870. Связь и цена — /axsupply status."
	]
	quest.705B3EAB1D7AFA9A.title: "Справка: ранец снабжения в цифрах"
	quest.7074755FA491960A.quest_desc: [
		"&3Сделай:&r тесто — хлеб без рук."
		"&3Чем:&r миксер: 3 пшеницы → хлеб. Линия: жернов → мука; мука + вода (миксер) → тесто; вентилятор через огонь → хлеб."
		"&3Дальше:&r насест."
	]
	quest.7074755FA491960A.title: "Хлеб на потоке"
	quest.707C719598FB65D9.quest_desc: [
		"&3Сделай:&r посох мода — усиливает заклинания и колдует выбранное по ПКМ."
		"&3Чем:&r посох старца — лопата, железный слиток, эссенция по диагонали (пустые клетки — заглушки слота)."
		"&3Дальше:&r наши посохи: у каждого своё заклинание."
	]
	quest.707C719598FB65D9.title: "Посохи мода"
	quest.70AA6E20E81CFD85.quest_desc: [
		"&3Сделай:&r крылья — подъёмная сила на скорости, винту остаётся тянуть вперёд."
		"&3Чем:&r крафтеры 3×3 или миксер: железные листы по углам, самородки по бокам, сплав в центре → 4. Закалённое — крыло в печи, копикат — под пилой."
		"&3Дальше:&r реактивный двигатель."
	]
	quest.70AA6E20E81CFD85.title: "Крылья"
	quest.70B5C892A8456D7E.quest_desc: [
		"&3Сделай:&r Пилот I — военный дирижабль и Форсаж III."
		"&3Чем:&r налёт 60 км, высота 260+, 10 посадок на ангар-док, 3 минуты в воздухе в грозу, участие в «Воздушном бою» (минута в воздухе или улей, сбитый с самолёта) и «Значок беглеца» в инвентаре (его не забирают)."
		"{\"text\": \"▶ Волна 24: Воздушный бой\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6A13AEBFD75DFA61\"}}"
		"{\"text\": \"▶ Волна 28: Побег — значок беглеца\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"1531C3C2A9EA07F1\"}}"
	]
	quest.70B5C892A8456D7E.title: "Пилот I"
	quest.70D7CC025ABCB528.quest_desc: [
		"&3Сделай:&r ядро навигации — без него нет контроллера ракеты."
		"&3Где:&r алтарь, первое прохождение 50-й волны — каждому защитнику. Выучи его на столе трансмутации: второе (для звёздного навигатора) — 65 536 EMC."
		"{\"text\": \"▶ Волна 50\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2296AD0A128BC153\"}}"
	]
	quest.70D7CC025ABCB528.title: "Ядро навигации — 50-я волна"
	quest.710081270063F8BA.quest_desc: [
		"&3Сделай:&r стальные пластины — для револьвера, дробовика и гатлинга."
		"&3Чем:&r миксер на &cсверхнагреве&r (торт всполоха): железный слиток + угольная пыль → сталь; пресс → пластина."
		"Оружию годится любая сталь, но квест ждёт пластину Gunsmithing."
		"&3Дальше:&r револьвер, картофельная пушка."
	]
	quest.710081270063F8BA.title: "Сталь для ружей"
	quest.7140196463FAE2AE.quest_desc: [
		"&3Сделай:&r купи у снабженца ящик и открой — ПКМ."
		"&3Внутри:&r ракеты, еда, опыт, слитки; часто книга чар, пластинка, шаблон отделки или свиток; изредка — тотем, зачарованное яблоко, элитры, яйцо дракона, артефакт смены."
		"&7&o— Бухгалтерия: «Содержимое ящика — коммерческая тайна. Даже от нас».&r"
	]
	quest.7140196463FAE2AE.title: "Ящик снабжения"
	quest.7171E67739DF54DC.quest_desc: [
		"&3Сделай:&r пару дробильных колёс — сырую руду дробят только они."
		"&3Чем:&r крафтеры 5×5: &e21 крафтер&r (в ящике 9). Крафтер: лампа + латунный корпус + мёртвый верстак столбиком → 3; верстак — 4 доски прессом."
		"Колёса крутятся &cнавстречу&r друг другу, сыпь сверху."
		"&3Дальше:&r дроблёная руда."
		"&7&o— Техника безопасности: руки между колёс не суют. Ещё раз: не суют.&r"
	]
	quest.7171E67739DF54DC.title: "Дробильные колёса"
	quest.71DC388F3C61DB8C.quest_desc: [
		"&3Сделай:&r Форсаж I — тяга ×2: биплан 27 бл/с вместо 13,5. Топлива ×1,6."
		"&3Чем:&r сборка по шагам: двигатель → электромедь → стержень всполоха → механизм точности → пресс → Пилот III (не тратится)."
		"В ячейку улучшений; форсаж один на самолёт, с улучшениями мода складывается."
		"{@pagebreak}"
		"Скорость биплана, бл/с — без / с лучшими улучшениями мода:"
		"&eБез форсажа&r — &613,5&r / &631&r"
		"&eФорсаж I&r — &627&r / &647&r"
		"&eФорсаж II&r — &645&r / &667&r"
		"&eФорсаж III&r — &664&r / &680&r"
		"Потолок: 50 бл/с ниже высоты 100, 80 — выше 160."
	]
	quest.71DC388F3C61DB8C.title: "Форсаж I"
	quest.721226B028FF97C7.quest_desc: [
		"Пара мобов опаснее сотни зомби:"
		"&eВедьма&r — зелья и лечение: первой, издалека"
		"&eЗаклинатель&r — вексы сквозь стены"
		"&eВизер-скелет&r — иссушение: не подпускай"
		"&eОпустошитель&r — 100 HP, таран: под пилы"
		"Мобы модов (с 16-й): чем бить — значки угроз в досье волны у алтаря."
	]
	quest.721226B028FF97C7.title: "Справка: кого снимать первым"
	quest.722333FEE3F97701.quest_desc: [
		"&3Сделай:&r роба волшебника — больше маны, основа брони школ."
		"&3Чем:&r магическая ткань — шерсть и 8 эссенций (крафтеры 3×3); из ткани — вещи робы."
		"&3Дальше:&r броня школы."
		"&7&o— Отдел кадров: роба волшебника — не дресс-код. Но коллеги оценят.&r"
	]
	quest.722333FEE3F97701.title: "Роба волшебника"
	quest.724C7100B630DF65.quest_desc: [
		"Моб дошёл до алтаря — это ещё не провал: алтарь держит &e3 удара&r (босс бьёт за двоих). Моб исчезает, над хотбаром — «Алтарь повреждён», в полосе волны — прочность ❤❤❤."
		"Прочность кончилась — &cпровал&r: добычи нет, у всей команды минус сердца максимума: волны 1–20 — 1, 21–50 — 2, дальше — 3. На арене — всегда 1."
		"{@pagebreak}"
		"Проклятие копится до −5 сердец, но &aалтарь не запирает&r: каждая победа на волне не ниже «лучшая − 5» снимает одно сердце. Сразу — стопкой ресурса за сердце: ПКМ по алтарю или воронкой (от 64 брёвен до 32 тория)."
		"Каждая победа ещё и &aзатягивает рану&r каждому, кто получил добычу."
		"Рана — за каждую смерть, кроме своей техники (пила, тесла, пушки) и союзников (игрок, дракон, питомец). Раны и проклятие вместе не опустят здоровье ниже 3 сердец."
		"&7&o— Бухгалтерия Axiomativ: «Долги гасятся работой. Сердца к оплате по-прежнему не принимаются».&r"
	]
	quest.724C7100B630DF65.title: "Прочность алтаря и проклятие"
	quest.72B123024288763B.quest_desc: [
		"Справка: Меркурий."
		"&eУсловия&r — вакуум, днём до &6+434 °C&r, ночью до &6−200 °C&r, тяжесть &63,7 м/с²&r. Теплозащита &6100 + 2&r за блок: обшивка из марсианской стали или вольфрама."
		"Днём без скафандра из марсианской стали горишь — садись ночью."
		"&eДобыча&r — вольфрам (только здесь), светокаменная руда, обычные руды."
	]
	quest.72B123024288763B.title: "Справка: Меркурий"
	quest.73412CDE10A401D6.quest_desc: [
		"&3Сделай:&r свисток — позвать свой поезд к себе."
		"&3Чем:&r миксер: медный слиток + латунный самородок. ПКМ свистком по машинисту — привязка; потом свисток на рельсах или у станции зовёт поезд."
	]
	quest.73412CDE10A401D6.title: "Свисток вызова поезда"
	quest.7348F756244BA78A.quest_desc: [
		"&3Сделай:&r кузница свитков — свои свитки вместо ожидания добычи."
		"&3Чем:&r крафтеры по раскладке JEI (пустые клетки — заглушки)."
		"Внутрь: чернила (их редкость — уровень) + бумага + фокус школы → выбери заклинание."
		"&3Дальше:&r чернила, наковальня."
	]
	quest.7348F756244BA78A.title: "Кузница свитков"
	quest.736E1771B8D1AFBE.quest_desc: [
		"Есть в самом Create: &eсхематика и перо&r — выделить постройку и сохранить; &eсхематичный стол&r — записать на пустую схематику; &eстроительная пушка&r — строит по схеме из сундука с материалами."
		"Пустая схематика — бумага + голубой краситель (миксер)."
	]
	quest.736E1771B8D1AFBE.title: "Чертежи, чтобы строить модулями"
	quest.737798268A331D1C.quest_desc: [
		"Справка: Венера."
		"&eУсловия&r — всегда &6+464 °C&r, углекислота &6~91 атм&r, тяжесть &68,87 м/с²&r, теплозащита &6250 + 5&r за блок."
		"Нужны скафандр из марсианской стали и вольфрамовый корпус (+20 за лист): листов — больше сотни."
		"&eДобыча&r — венерианский гравий (концентрат рутила щедрее песка), угольная руда. В озёра серной кислоты не лезть."
		"&7&o— Турагентство Axiomativ: «Венера — для тех, кому на Меркурии было прохладно».&r"
	]
	quest.737798268A331D1C.title: "Справка: Венера"
	quest.73867618D704282A.quest_desc: [
		"&3Сделай:&r энергощит Mk2 — запас 500 единиц (500 000 FE), доля та же — 50 %."
		"&3Чем:&r крафтеры (R в JEI); ставится поверх Mk1, заряд сохраняется."
		"&3Дальше:&r справка «Энергощит»."
	]
	quest.73867618D704282A.title: "Энергощит Mk2"
	quest.741AD72C451408C4.quest_desc: [
		"Справка: лишние артефакты волн — в переплавку: &e3 одного уровня → 1 случайный следующего&r."
		"Как: &e/nsart reforge&r или вкладка «Артефакты» в пульте алтаря. Берёт из инвентаря (не из слотов) самый низкий уровень, где набралось три; сначала повторы."
		"Потолок — &cмифический&r. Трофеи боссов, артефакты арены и пробуждённые не переплавляются."
	]
	quest.741AD72C451408C4.title: "Переплавка 3 → 1"
	quest.742E217E8017112E.quest_desc: [
		"&3Сделай:&r синий лёд — для экструдеров базальта и эндерняка."
		"&3Чем:&r снег — экструдер между двух вод выше 150; 9 снега прессом → лёд; промывка: лёд → плотный → синий."
	]
	quest.742E217E8017112E.title: "Синий лёд"
	quest.74C61454ED9F7075.quest_desc: [
		"&3Сделай:&r ангар-док — чинит и заправляет самолёт над собой."
		"&3Чем:&r механические крафтеры: 3 железных листа; электромедь, бойлер самолёта, электромедь; андезитовый корпус, механизм точности, андезитовый корпус."
		"Ставь вровень с полом; центр самолёта — в квадрате 7×7, не выше 4 блоков."
		"{@pagebreak}"
		"&eТок&r — с любой стороны, кроме верха: до &610 000 FE/т&r, запас &6500 000 FE&r."
		"&eРемонт&r — 5 % корпуса в секунду, &6500 FE&r за 1 % (бронекорпус — втрое дороже)."
		"&eЗаправка&r — 50 FE за тик горения: биплан на полном баке ~16 минут. Сундук рядом (не сверху) — топливо и без тока."
	]
	quest.74C61454ED9F7075.title: "Ангар-док"
	quest.756309A2E9194896.quest_desc: [
		"&3Сделай:&r ведро нефти из бака у качалки."
		"&3Где:&r стальные баки (бочка + 2 тяжёлые пластины → 2) — они же основа перегонной башни."
		"&3Дальше:&r башня TFMG или колонна CDG."
	]
	quest.756309A2E9194896.title: "Нефть"
	quest.75992F7000BD731C.quest_desc: [
		"&3Сделай:&r &62 000 FE/т&r с одного генератора без топлива — как 4–5 паровых двигателей."
		"&3Где:&r только на геотермальном источнике (базальт с огненным жерлом, над ним дым): бесплодные земли, вулканы, базальтовые скалы; глубоко (−56…0) — у лавы. На поле 4–6 источников."
		"&3Чем:&r крафтеры: генератор переменного тока, медный корпус, жидкостный бак, 2 трубы, 2 электромеди. Вода — 10 мБ/т (без неё 500 FE/т)."
		"Работает, пока чанк загружен: загрузчик чанков на форпосте."
	]
	quest.75992F7000BD731C.title: "Геотермальный генератор"
	quest.75D4EA183A7216E8.quest_desc: [
		"&3Сделай:&r пропеллер — тяга: смотрит вверх — поднимает, вбок — толкает. Ставится прямо на вал."
		"&3Чем:&r крафтеры столбиком: пропеллер Create, деревянная плита, вал."
		"Куда толкает — зависит от блока и вращения вала; развернуть — ключом."
		"&3Дальше:&r портативный двигатель."
	]
	quest.75D4EA183A7216E8.title: "Пропеллер"
	quest.75E4613658460314.quest_desc: [
		"&3Сделай:&r кварцевое стекло — кабины самолётов, солнечные теплогенераторы New Age, солнечная панель Northstar."
		"&3Где:&r пустыни: белая блестящая жила среди песка."
		"&3Чем:&r экструдер на жилу, сбоку песчаник и вода → кварцевый песок → вентилятор через лаву → кварцевое стекло."
		"&3Дальше:&r линза; самолёт — глава «Транспорт»."
	]
	quest.75E4613658460314.title: "Кварцевый карьер"
	quest.75F82658768FAA4D.quest_desc: [
		"&3Сделай:&r базальт."
		"&3Чем:&r экструдер: синий лёд и лава по бокам, снизу почва душ."
	]
	quest.75F82658768FAA4D.title: "Базальт"
	quest.76E6188D5A1B5F5E.quest_desc: [
		"&3Сделай:&r Форсаж III — тяга ×4, сопротивление вдвое меньше: биплан 64 бл/с, с улучшениями мода 80. Топлива ×2,5 — поставь экономайзер."
		"&3Чем:&r сборка по шагам: Форсаж II → небесный кристалл → слиток метеоритного железа → электромедь → чертёж форсажа → пресс → Пилот I."
		"&3Где:&r небесный кристалл — небесные острова."
		"&7&o— Пресс-служба: «Самолёт не разбился. Он стремительно сблизился с горой».&r"
	]
	quest.76E6188D5A1B5F5E.title: "Форсаж III"
	quest.773E1E8AE9F7B7CF.quest_desc: [
		"&3Сделай:&r титан — из него вся ракета. На Земле руды нет: первый титан — химией."
		"1) Концентрат рутила — дробилка: известняк (50 % на 2) или песок (25 %)."
		"2) Соль — дробилкой из базальта (биом «Базальтовые скалы»)."
		"3) Натриевый катализатор — соль под дозатором, 500 мБ лавы."
		"{@pagebreak}"
		"4) Газообразный углерод — пресс над чашей с горелкой: 3 угля → 1000 мБ."
		"5) Тетрахлорид титана — миксер с перегревом (торт всполоха): 3 концентрата + катализатор + цинковый слиток + 500 мБ углерода → 500 мБ."
		"6) Слиток — сборка по шагам из прочного листа: 500 мБ лавы → пресс → 500 мБ тетрахлорида → пресс → 1000 мБ воды."
		"С планет руда пойдёт обычным путём: дробилка → печь или промывка."
		"{\"text\": \"▶ Этап 12 «Пути смены»\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"78AD58675653495C\"}}"
	]
	quest.773E1E8AE9F7B7CF.title: "&6Титан: варим на Земле&r"
	quest.773E29288CF753D6.quest_desc: [
		"&3Сделай:&r латунь — вторая половина Create: корпуса, лампы, крафтеры, поезда."
		"&3Чем:&r миксер над чашей с горящей горелкой: медь + цинк → 2. Броня вместо латуни — положи латунь в &eфильтр чаши&r."
		"&3Дальше:&r дробильные колёса."
		"{\"text\": \"▶ Латунный корпус и лампа\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"652D8C7BE73B6E6F\"}}"
		"&7&o— ОТК: «Холодная латунь — это медь и цинк, которые лежат рядом и молчат».&r"
	]
	quest.773E29288CF753D6.title: "Латунь"
	quest.7740332F1426A7C8.quest_desc: [
		"&3Сделай:&r светлый стабилит — и тёмный тоже: слиток только из двух половинок."
		"&3Где:&r светлый — в кальците земель Ян, тёмный — в чернокамне земель Инь, y от −8 до 72. Только звёздная кирка; у точки 0, 0 рядом все четыре квадрата."
		"Половинку не берут ни печь, ни дробилка, ни вентилятор."
	]
	quest.7740332F1426A7C8.title: "Стабилит: две половинки"
	quest.77C243DA55D090E6.quest_desc: [
		"&3Сделай:&r чинить броню, инструмент и оружие током — без наковальни, опыта и «Слишком дорого!»."
		"&3Чем:&r механические крафтеры: механическая рука, стойка для брони, наковальня, 2 медные катушки, 2 точных механизма, 2 андезитовых корпуса, электромедь."
		"&3Как:&r ставь (2 блока в высоту), ток — к любой стороне низа, до &620 000 FE/т&r. &6ПКМ вещью&r — повесить на манекен; &6Shift+ПКМ&r пустой рукой — переодеться: вся броня с тебя на манекен, с манекена на тебя, оружие — в руку. ПКМ пустой рукой — окно с прочностью и ценой."
		"{@pagebreak}"
		"Чинит &64 %&r прочности в секунду, вещи по очереди сверху вниз. Энергощит нагрудника заряжает, как купол генератора щита."
		"Воронки и руки Create кладут вещь в её слот и забирают только готовое — стойку можно поставить в линию."
		"&7&o— Отдел снабжения: «Слитки на починку больше не выдаём. Выдаём ток. Ток тоже не бесплатный».&r"
	]
	quest.77C243DA55D090E6.title: "Ремонтная стойка"
	quest.77C6703FDB6111D1.quest_desc: [
		"&3Сделай:&r выведи на экран любую машину, а не только экструдеры."
		"&3Чем:&r механические крафтеры: беспроводное звено, дисплейный адаптер, электромедь — &62 датчика&r."
		"&3Как:&r ставь на любую грань машины. Бур, пила, любая машина Create — это форпост (обороты, выход, выработка в минуту); генератор (геотермальный, гидро, генератор C\\&A) — выработка в FE/т; аккумулятор и станции ячеек — запас и куда идёт ток; склад — сколько занято и сколько энергоячеек."
		"Лампа датчика: &aзелёная&r — работает, &eжёлтая&r — простаивает или выход забит, &cкрасная&r — нет вращения или машины. ПКМ по датчику — окно сразу на этой машине."
		"&7Ток базы на экране — это сумма датчиков: поставь их на генераторы и на аккумулятор, иначе экран честно скажет «нет датчиков».&r"
	]
	quest.77C6703FDB6111D1.title: "Датчик диспетчерской"
	quest.784C7BEA8FE085AA.quest_desc: [
		"&3Сделай:&r ПВО — летуны не идут коридором, их сбивают. Задача — 4 перепонки фантома."
		"Фантомы (с 14-й волны) кружат в ~16 блоках над алтарём, вексы (с 20-й) — в ~8 и проходят сквозь стены. Пара лазерных турелей у алтаря прикрывает небо."
		"Радар видит ±20 по высоте. С 85-й летают боссы. ПВО на токе — тесла-башня, без радара."
		"{\"text\": \"▶ Волна 24 · Воздушный бой\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6A13AEBFD75DFA61\"}}"
	]
	quest.784C7BEA8FE085AA.title: "ПВО"
	quest.7867EFE5FD87DD23.quest_desc: [
		"&3Сделай:&r запас метеоритного железа — для Форсажа II–III и тесла-техники следующего уровня (U по предмету в JEI)."
		"&3Чем:&r железная кирка или лучше, по руде в кратере. Взрыв её не берёт, бур Create разобьёт впустую. Печь и вентилятор не плавят."
		"&3Дальше:&r дробильные колёса."
		"&7&oНа ощупь тёплое. На вкус — не проверяй.&r"
	]
	quest.7867EFE5FD87DD23.title: "Метеоритное железо"
	quest.78A29090A2EF60E9.quest_desc: [
		"Зачем: один форпост — как десять экструдеров. Буровая бурит то же сырьё, что экструдер на этом месторождении, но вдесятеро быстрее и без блоков по бокам."
		"&eСборка&r — механические крафтеры, сетка 5×5: &eканатный шкив&r (кронблок), &e4 алюминиевых листа&r (Бокситовый карьер), &eлинза&r (Кварцевый карьер), &e2 радиатора&r (Ледник), &eпрецизионный механизм&r, &eмеханический бур&r, &eмеханическая помпа&r, &e2 электромеди&r (награда 15-й волны) и &e3 латунных корпуса&r. Рецепт — в JEI (R)."
		"{@pagebreak}"
		"&eПостановка:&r целься в блок месторождения — клетка над ним станет центром основания 3×3, вышка вырастет на &67&r блоков. Привод с латунным фланцем и зеброй — с твоей стороны: туда вал."
		"Нужно месторождение под центром. Грунт и камень вышка расчистит сама, слои месторождения внутри объёма снимет и вернёт при разборке — встаёт и на склонах. Мешают только постройки, руда и машины (красная рамка)."
		"{@pagebreak}"
		"&eТемп&r — как 10 экструдеров на тех же оборотах: &e64 об/мин&r — &62 шт/с&r, &e256&r — &67,5 шт/с&r (&6450&r в минуту). Нагрузка &648 SU&r на об/мин, на 256 — &612 288 SU&r."
		"&eТок&r — насос бурового раствора: &62 FE/т&r на об/мин (на 256 — &6512 FE/т&r), провод к любой части основания, запас &664 000 FE&r. Без тока бур идёт вполсилы."
		"{@pagebreak}"
		"&eЗабирать:&r воронка или лоток Create на любой стороне основания, желоб — под угловой частью. Склад на 9 ячеек: полон — бур стоит."
		"Очки инженера покажут, что бурит и чего не хватает. Лампа на приводе: зелёная — полная сила, янтарная — без тока, серая — нет вращения, красная — не на месторождении. Наглядно — Ponder: наведи на буровую в JEI и зажми &eW&r."
		"Буровая на месторождении входит в сеть форпостов: осада может прийти и к ней. Загрузчик чанков — как для экструдеров."
		"&7&o— ОТК: «Вышка мигает красным не потому, что ей плохо. Это ей хорошо».&r"
	]
	quest.78A29090A2EF60E9.title: "Буровая установка"
	quest.78A694FC4AC929DC.quest_desc: [
		"&3Сделай:&r мясорубку в конце коридора: вентилятор сдувает и жжёт, пилы режут, деплоеры с мечами добивают. Задача — 4 пилы."
		"Орда приходит туда сама и гибнет, пока крутится вал, — без тебя."
		"&3Дальше:&r лазерные турели."
		"&7&o— Столовая: «Фарш сегодня не подаём. По техническим причинам».&r"
	]
	quest.78A694FC4AC929DC.title: "Мясорубка"
	quest.78AD58675653495C.quest_desc: [
		"&3К концу этапа:&r ракета летает на Луну и планеты, из их металлов — межпланетный сплав, звёздная кирка добывает руды Аксиоматива."
		"• &eЯдро навигации&r — за 50-ю волну: без него нет контроллера ракеты."
		"• &eРакета:&r титан, схемы, закалённый механизм, ускорители, топливо в баках, теплозащита. Скафандр — фильтр воздуха (Торфяник), звёздные карты — Обсерватория."
		"• &eЛуна → Марс → Меркурий:&r марсианская сталь и вольфрам → межпланетное точило → межпланетный сплав."
		"• &eЗвёздная кирка&r — из осколка 70-й волны; только она добывает аксиомит и стабилит."
		"&3Волны:&r 50 — промышленная оборона; 70–100 — Кошмар: 18 подволн и боссы Cataclysm."
		"{@pagebreak}"
		"{\"text\": \"▶ Сборка ракеты\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"2BB90C762D8DE0FB\"}}"
		"{\"text\": \"▶ Чек-лист перед стартом\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"369117D4B69EA320\"}}"
		"{\"text\": \"▶ Звёздная кирка\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"6C6C1196E042B5E3\"}}"
		"&7&oЕсли ракета не взлетела — это не провал, а очень короткий полёт.&r"
	]
	quest.78AD58675653495C.title: "Этап 12 · Космос"
	quest.79049C351BB0ADD1.quest_desc: [
		"&3Сделай:&r незеритовая головка — 11 урона по шести мобам, 17 пневмоударом."
		"&3Чем:&r крафтеры в ряд: шаблон незеритового улучшения | алмазная головка | незеритовый слиток. Чары сохраняются."
		"&3Где:&r незерит — древние обломки Незера и добыча набегов."
		"&3Дальше:&r меч эха."
	]
	quest.79049C351BB0ADD1.title: "Незеритовая головка"
	quest.79713E00CE3F45AC.quest_desc: [
		"&3Сделай:&r вращение из тепла — без угля и воды."
		"&3Как:&r тепло принимает только &eсверху&r. От 50 тепла/с — &6512 SU&r (16 об/мин), от 100 — &61 024 SU&r (32 об/мин)."
		"Полный Стирлинг — 2 продвинутых теплогенератора (днём) или ~20 труб над лавой (всегда). Рецепт — R."
		"&7&oСила — 1/16 парового двигателя. Зато не ест и не взрывается. Стажёр мечты.&r"
	]
	quest.79713E00CE3F45AC.title: "Двигатель Стирлинга"
	quest.798AC21976DE3822.quest_desc: [
		"&3Сделай:&r аксиомитовый слиток — металл, ради которого строили заводы."
		"&3Где:&r руда в сером туфе (до y ≈ 160) и в глубинном сланце ниже 0, глубоко — крупные жилы. Только звёздная кирка."
		"&3Чем:&r печь не плавит: дробилка (с сырья 1 + 50 %, с руды 2 + 50 %) → вентилятор над лавой или огнём."
	]
	quest.798AC21976DE3822.title: "Аксиомит: руда → слиток"
	quest.798ACE3CE5DB69E8.quest_desc: [
		"Кровавая луна (14–15): &cфантомы&r в небе, невидимые &8тени&r-пауки, вихри, пещерные пауки. Босс — &4Голиаф&r: паук ArPhEx, быстрый, ~560 HP."
		"Готовьтесь: алмазная броня и оружие с чарами, вдвоём-втроём; стрелки или турели, которые бьют вверх."
		"&6Веха каждому&r: &dЗаряд молнии&r — в деплоер Create, бить по медному слитку: выйдет &eэлектрическая медь&r. Без неё не собрать ни один генератор тока (глава «Энергия»)."
		"{@pagebreak}"
		"Дальше в орды &cпостепенно&r приходят мобы модов и премьера каждую волну (квест «Премьеры»)."
	]
	quest.798ACE3CE5DB69E8.title: "Волна 15: заряд молнии"
	quest.799CA552C9730DC4.quest_desc: [
		"Справка: Марс."
		"&eУсловия&r — углекислый воздух &60,006 атм&r, &6−100 °C&r (железный скафандр держит), тяжесть &63,71 м/с²&r, теплозащита &650 + 0,05&r за блок. Телескоп — и днём, концентратор собирает углерод."
		"&eДобыча&r — марсианская железная руда (сталь), вулканический пепел, марсианский гравий (дробилка → соль), клубника."
	]
	quest.799CA552C9730DC4.title: "Справка: Марс"
	quest.7A0F0FB1F4DD3514.quest_desc: [
		"С 21-й волны часть стадий — &dособые&r: они заставляют строить и играть иначе, а не стоять за той же стеной."
		"&eНеуязвимость&r (22, 26, 32, 44, 48, 52, 64, 68) — орду берёт только ток, машины или магия. &eНевидимки&r (34, 56) — видно только в луче прожектора."
		"&eСценарий&r — задача вместо подволн, только у алтаря базы под небом: воздушный бой (24, 42, 58), побег (28, 46, 62), штурм гнезда (36, 54, 66), конвой (43, 63). &eОсада форпоста&r (38, 57)."
		"{@pagebreak}"
		"&eНовые&r, идут и на арене: &dРитуал&r (21, 51), &dОхота на вожаков&r (29, 53), &dГидра&r (33, 59), &dПоединок&r (39, 61), &dУдержание рубежей&r (47, 67)."
		"Кратные 5 остаются за боссами. За первое прохождение каждой особой стадии — &6награда стадии&r и &dартефакт смены наверняка&r."
		"Прогноз у алтаря и досье заранее пишут, какая стадия ждёт и что понадобится."
		"&7&o— Бригадир: «Кто думал, что смена — это стоять у стены, тот её ещё не видел».&r"
	]
	quest.7A0F0FB1F4DD3514.title: "Особые стадии"
	quest.7A39018E4BE93584.quest_desc: [
		"&3Сделай:&r физический сборщик — превращает постройку в штуковину с массой: самолёт, дирижабль, машину, подлодку."
		"&3Чем:&r крафтеры: рычаг сверху, под ним андезитовый корпус, по бокам сплав."
		"Берёт себя, блок под собой и всё приклеенное. Рычаг вверх — собрать, вниз — разобрать (ровно, у земли, без скорости)."
		"{\"text\":\"▶ Вики: физический сборщик (открыть)\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://createaeronautics.miraheze.org/wiki/Physics_Assembler\"}}"
	]
	quest.7A39018E4BE93584.title: "Физический сборщик"
	quest.7A54A188DFC80DA9.quest_desc: [
		"Справка: артефакты арены падают &eтолько за победу на арене&r в теме этой волны — отдельный бросок каждому, 12 % (Звёздная бездна — 4 %), первое прохождение ×2."
		"&eШахта&r (1–15): &5Каска проходчика&r — +3 брони, +30 % к копанию, нет усталости; &5Шахтёрский обушок&r — +2 урона, +10 % скорости атаки."
		"&eКаньон пауков&r (16–29): &5Паучий шёлк&r — +10 % скорости, не держат паутина, замедление и яд; &6Ядовитая железа&r — +2 урона, удары: Иссушение I на 4 с."
		"&eВечная мерзлота&r (30–44): &5Осколок мерзлоты&r — +2 брони, ударившему вплотную Замедление III на 3 с; &6Сердце метели&r — +10 HP, нет замедления и мороза."
		"{@pagebreak}"
		"&eПекло&r (45–59): &6Пепельное сердце&r — +6 HP, огнестойкость, ударивший горит 5 с; &cКорона пекла&r — +3 урона, огнестойкость, удары поджигают на 4 с."
		"&eКрай&r (60–69): &6Перо Края&r — +10 % скорости, нет урона от падения, Shift — медленное падение; &cОсколок пустоты&r — +8 HP, уклонение 15 %."
		"&eКошмар&r (70–99): &cФонарь кошмара&r — +8 HP, ночное зрение, нет Тьмы и слепоты, во тьме рассудок не падает; &6Коготь кошмара&r — +4 урона, вампиризм 6 %."
		"&eЗвёздная бездна&r (100+): &bОсколок звезды&r — +12 HP, +10 % скорости, −8 % урона, 1 с неуязвимости после удара (раз в 5 с)."
	]
	quest.7A54A188DFC80DA9.title: "&dАртефакты арены&r"
	quest.7A5BB064B668F255.quest_desc: [
		"Дракон — верховой зверь с дыханием, бронёй и сундуком; зовётся свистком даже из другого мира."
		"Путь: яйцо → вылупление → рыба → седло → в небо."
		"&cДыхание задевает своих&r — не дыши огнём рядом с командой."
	]
	quest.7A5BB064B668F255.title: "Драконья ферма"
	quest.7A9E4A6FA2EA52AF.quest_desc: [
		"&3Сделай:&r валы — «провод» Create: несут вращение к машинам."
		"Вращение — скорость (об/мин) и нагрузка (SU): съели больше запаса — встаёт вся сеть. Смотри в очки."
		"&3Чем:&r сплав на пилу → 6 валов."
		"{\"text\": \"▶ Источники силы: колёса и пар\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"021C59A76EC5D8D5\"}}"
	]
	quest.7A9E4A6FA2EA52AF.title: "Вал и вращение"
	quest.7AA1D2EC840C70E1.quest_desc: [
		"&3Сделай:&r пост из 9 крафтеров — верстак на всю игру."
		"&3Чем:&r стена 3×3 лицом в одну сторону, ключом сведи стрелки к крафтеру-выходу; вращение — рукоятка или водяное колесо."
		"Детали — ПКМ в лицевые стороны. Сборка идёт, когда заполнены &eвсе&r крафтеры группы: лишние сними ключом. Готовое — в сундук или депо у выхода."
		"&3Дальше:&r пила."
	]
	quest.7AA1D2EC840C70E1.title: "Сборочный пост"
	quest.7B2C996C9330FAFF.quest_desc: [
		"&3Сделай:&r электронные лампы — «мозг» крафтеров, деплоеров, стрелок."
		"&3Чем:&r миксер: кварц + 8 редстоуна → розовый кварц; отполируй наждачкой (кварц во второй руке, держи ПКМ); лампа — полированный кварц + железный лист (миксер)."
		"&3Дальше:&r механизм точности и рельсы."
	]
	quest.7B2C996C9330FAFF.title: "Электронная лампа"
	quest.7B5A4EFA0A80ED25.quest_desc: [
		"&3Сделай:&r 16 досок — пила из ящика первый станок вахты."
		"&3Чем:&r пила зубьями вверх, бревно сверху → 6 досок. В фильтр пилы — то, что хочешь &eполучить&r, иначе она перебирает варианты по кругу."
		"Палки, ступеньки, плиты — тоже пилой. &cПила режет и вахтовика — не стой на ней.&r"
		"&3Дальше:&r кирка."
	]
	quest.7B5A4EFA0A80ED25.title: "Пила: доски и палки"
	quest.7BBB4E8FDBB83821.quest_desc: [
		"&3Сделай:&r отстреляй серию в тире: &e/tir&r и кнопка режима."
		"&3Где:&r коридор арены (&e/arena&r), когда нет набега и «Выживания». Огневой рубеж — белая линия за алтарём: в счёт только выстрелы из-за неё."
		"&3Чем:&r любое дальнобойное — огнестрел, лук, арбалет, трезубец, посохи, заклинания."
		"&3Дальше:&r рекорд тира."
	]
	quest.7BBB4E8FDBB83821.title: "Тир на арене"
	quest.7C1F5670809C5930.quest_desc: [
		"&3Сделай:&r праздничный бургер — вся глава в одном блюде."
		"&3Чем:&r миксер: хлеб, котлета, капуста, томат, лук. Котлета: говядина → пила → фарш → печь или вентилятор с огнём."
		"&7&o— Отдел по работе с ордой: «Орда ест вахтовиков, вахтовики — бургеры».&r"
	]
	quest.7C1F5670809C5930.title: "Праздничный бургер"
	quest.7D067AFBD3DC3961.quest_desc: [
		"&3Сделай:&r конденсаторы — из них тесла-башня, аккумулятор, электромотор, энергоячейки, генератор щита и энергощиты."
		"&3Чем:&r миксер: медный лист + цинковый лист + факел из редстоуна + &6100 мБ&r электролита."
		"&3Дальше:&r тесла-башня — к 22-й волне."
		"{\"text\": \"▶ Тесла-башня\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"5B0D0D05577E8BCF\"}}"
	]
	quest.7D067AFBD3DC3961.title: "Конденсатор"
	quest.7D06BCB9E657D0AA.quest_desc: [
		"&3Сделай:&r автопосадку — тормозит у грунта сама. Ставится в корпус и приклеивается."
		"&3Чем:&r крафтеры: 9 титановых пластин, 4 титановых слитка, 4 полированных лунных сапфира, кристалл сапфира, 4 схемы и ещё одна ракетная станция."
		"Маяк (Rocket Waypoint) — точка посадки: крафтеры, титан, вольфрам, 2 компьютера (R в JEI). ПКМ Атласом по маяку — точка в списке станции; маяк сломан — полёт отменён."
	]
	quest.7D06BCB9E657D0AA.title: "Автопосадка и Маяк"
	quest.7D1C2E958E9CA27B.quest_desc: [
		"&3Сделай:&r коксовую пыль — топливо домны (уголь и кокс она не ест)."
		"&3Чем:&r жернов или дробильные колёса. В домну — сверху, с рудой и флюсом."
		"&7&oКокс — это уголь, который прошёл курсы повышения квалификации.&r"
	]
	quest.7D1C2E958E9CA27B.title: "Коксовая пыль — топливо домны"
	quest.7D38ACB180CFD7F0.quest_desc: [
		"&3К концу этапа:&r латунь из миксера с горелкой — вторая половина Create: латунные корпуса, лампы, новые крафтеры, поезда."
		"• &eГорелка:&r пустая горелка (4 железных листа + незерак, крафтеры крестом) → ПКМ по живому всполоху в крепости Незера. Портал: обсидиан (вода на источник лавы) и огниво."
		"• &eМедь и цинк:&r промывка красного песка или стол трансмутации."
		"• &eЛатунь:&r миксер над чашей, под ней горящая горелка: медь + цинк → 2. Выходит не то — латунь в фильтр чаши."
		"• &eКорпус и лампа:&r рецепты — R; лампа нужна крафтерам и деплоерам."
		"&3Волны:&r 5–14: железная броня, щит, лук; с 8-й ведьмы — снимай первыми."
		"{@pagebreak}"
		"{\"text\": \"▶ Горелка всполоха\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"35392A512115E122\"}}"
		"{\"text\": \"▶ Латунь\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"773E29288CF753D6\"}}"
		"{\"text\": \"▶ Электронная лампа\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"7B2C996C9330FAFF\"}}"
		"&3Дальше:&r этап 5 — завод."
	]
	quest.7D38ACB180CFD7F0.title: "Этап 4 · Латунь"
	quest.7D71F73C8A9DE129.quest_desc: [
		"ПКМ зарядом: всё враждебное в радиусе &e48 блоков&r — насмерть; у кого 150 HP и больше (боссы) — &c−35%&r здоровья. Блоки целы, игроки и големы — тоже."
		"Заряд тратится, перезарядка 60 с. С 80-й даже рядовой моб набега толще 150 HP — ему тоже только −35%."
		"{@pagebreak}"
		"Механические крафтеры: 4 слитка стабилита, 3 слитка аксиомита (руды наших планет, нужна звёздная кирка), TNT и радиоактивный торий."
		"&7&o— Техника безопасности: перед подрывом крикните «Ложись!». Орде всё равно, а вам спокойнее.&r"
	]
	quest.7D71F73C8A9DE129.title: "&eТактический ядерный заряд&r"
	quest.7EBEF8695B8AB4C0.quest_desc: [
		"&3Сделай:&r андезитовый корпус — для депо, миксера, экструдера, стола."
		"&3Чем:&r окорённое бревно (пила с фильтром «окорённое») поставь и ПКМ по нему сплавом — так «собирать руками» можно. Позже — деплоер."
		"&3Дальше:&r стол трансмутации."
	]
	quest.7EBEF8695B8AB4C0.title: "Андезитовый корпус"
	quest.7EC630A4A315D46F.quest_desc: [
		"&3Сделай:&r узнать, что и сколько в жиле, — и записать в атлас."
		"&3Чем:&r механические крафтеры (R: латунь, лампа, механизм точности, механический бур)."
		"&3Как:&r поставь на жилу, &eсверху медный баллон&r с воздухом, ПКМ — старт. Готово — ПКМ атласом."
	]
	quest.7EC630A4A315D46F.title: "Пробоотборник"
	quest.7F274304A2B7CC90.quest_desc: [
		"&3Сделай:&r эссенцию пробуждения — одна на круг сборки."
		"&3Чем:&r миксер на &eсупернагреве&r (горелка на торте всполоха): 16 пыли орды + звёздный осколок + 1 000 мБ лавы. С магией: 8 пыли + 8 арканной эссенции + осколок + лава."
		"&3Где:&r звёздный осколок — веха 70-й волны, добыча Кошмара или 131 072 EMC. Итого ~15 осколков орды на эссенцию."
		"&3Дальше:&r пробуждение."
	]
	quest.7F274304A2B7CC90.title: "&6Эссенция пробуждения&r"
	quest.7F5182591CB8A08F.quest_desc: [
		"&3Сделай:&r то, что горит в реакторе."
		"&3Чем:&r сборочная линия из радиоактивного тория: пресс → деплоер с железным листом → пресс."
		"1 топливо — 24 мин работы стержня; в стержень влезает до 12 (4,8 ч)."
	]
	quest.7F5182591CB8A08F.title: "Ядерное топливо"
	quest.7F8A5BCF1F2BC876.quest_desc: [
		"&3Сделай:&r голема из металлов планет — в разы крепче незерита."
		"&3Чем:&r та же сборка, в круге ещё механизмы точности и ключ: титан и сапфир — 1, марсианская сталь — 2, вольфрам — 3."
		"{\"text\": \"▶ Космос: металлы планет\", \"color\": \"aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"change_page\", \"value\": \"773E1E8AE9F7B7CF\"}}"
		"&3Дальше:&r страж из сплава."
	]
	quest.7F8A5BCF1F2BC876.title: "Космические металлы"
	quest.7FDAFA4F8A44DEA3.quest_desc: [
		"&3Сделай:&r делить тепло: без вентилей ближний нагреватель уйдёт в суперогонь и съест всё."
		"&3Как:&r в разрыв трубы перед нагревателем, тепло идёт по стрелкам. В окошке на боку — режим и число нагревателей (до 4, 0 — закрыт): &6обычный&r — 200 тепла/с (чаша «нагрета»), &bсуперогонь&r — 550 (котлу ровно 3 уровня). Редстоун 15 — закрыт."
		"&3Чем:&r крафтеры: жидкостный вентиль, 2 тепловые трубы, электронная лампа, электромедь."
	]
	quest.7FDAFA4F8A44DEA3.title: "Тепловой вентиль"
	quest.7FE6CF4D0290C173.quest_desc: [
		"Веха: &4Страж Края&r и два &5Голема Края&r. Страж стягивает гравитацией с укрытий."
		"Дальше по кругу настоящие боссы: Игнис (с 82-й), Маледиктус (85-й), Предвестник (87-й), Древний реликт (90-й), Незеритовое чудовище (92-й), Сцилла (95-й). Мини-боссы — парами."
		"&6Первое прохождение&r: сильный артефакт и &5Сердце ночи&r."
	]
	quest.7FE6CF4D0290C173.title: "Волна 80: две тени"
	quest.7FE7DE0EC8DCE5AE.quest_desc: [
		"&eНе зовётся:&r свисток в инвентаре, ты не верхом, вокруг ~3×4×3 без блоков, 5 с между вызовами; погибший — через 60 с. Причина — над хотбаром."
		"&eСвисток молчит:&r ПКМ зажимают, а не щёлкают. Клавиша «Позвать дракона» (V) занята ещё 6 модами — переназначь в Управлении."
		"&eНевидим, сесть нельзя:&r перезайди на сервер; не помогло — админ перенесёт."
		"&7&o— Служба поддержки: «Вы пробовали выключить и включить мир?»&r"
	]
	quest.7FE7DE0EC8DCE5AE.title: "Дракон пропал?"
	quest.7FFAED499CB00CC3.quest_desc: [
		"Купол радиусом 24 блока вокруг генератора: монстры не проходят внутрь, их удары и снаряды гаснут. Над головой — видимая сфера, сверху — полоска «Щит»."
		"Питание — током: толстый кабель от аккумуляторов. Прочность растёт с запасом энергии, но &6вдвое больше энергии — только в 1,5 раза прочнее&r; каждый удар списывает энергию. Упал — 10 с перезагрузки."
		"{@pagebreak}"
		"Против щита в волнах 50+ есть своя подволна: &dпронзатели&r (вексы) проходят сквозь купол, &cразрушители&r (опустошители) бьют по нему в 10 раз сильнее, &5разрядники&r (ведьмы) выжигают запас."
		"Сигнал редстоуна гасит купол — между набегами выключайте: он тратит 1% запаса в минуту."
		"{@pagebreak}"
		"Сборка — механические крафтеры: 4 межпланетных сплава, 4 электрические меди, маяк и модульный аккумулятор."
		"&7&o— ОТК: «Купол защищает от зомби, скелетов и плохого настроения. От вексов — нет».&r"
	]
	quest.7FFAED499CB00CC3.title: "&aГенератор щита&r"
	task.1D6C4B66A3EB9AFE.title: "Волна 5 пройдена"
}
