	chapter.6B800B0BDBD97B68.title: "Сталь, нефть и топливо"
	chapter.731F21B1388F0EC9.chapter_subtitle: ["Мобы и опыт, загрузчики чанков, снаряжение, фабрика блоков"]
	chapter.731F21B1388F0EC9.title: "Автоматизация всего"
	chapter.776B79B076735E90.chapter_subtitle: ["Бурение, EMC, сканер и зонды"]
	chapter.776B79B076735E90.title: "Жилы и экономика"
	chapter.7B1A7BF00B1F7A99.chapter_subtitle: ["Стены, ловушки, турели и большие пушки — чтобы орда не дошла до алтаря"]
	chapter.7B1A7BF00B1F7A99.title: "Оборона базы"
	chapter.7E76287511290763.chapter_subtitle: ["Тьма, рассудок и те, кто в ней живёт"]
	chapter.7E76287511290763.title: "Ночная смена"
	file.0000000000000001.title: "Create: Ночная смена"
	quest.009008A465A1264B.quest_desc: [
		"Тепло New Age — тихий бесплатный помощник: без угля, но и сил немного."
		"Откуда: солнечные теплогенераторы (днём), тепловые трубы над лавой или горелкой."
		"Куда: двигатель Стирлинга (вращение) или нагреватель под котлом (вместо горелки)."
		"&cНе копи тепло впрок:&r блок, накопивший больше &610 000&r тепла, превращается в лаву."
	]
	quest.009008A465A1264B.title: "3 · Тепло"
	quest.00C1E5D9F1E192B0.quest_desc: [
		"Готовые сборки на 4 слота — от чего отталкиваться. Меняй под волну: против стрел и магии — срез урона, против толпы в ближнем — щит и отражение."
		"&eТанк&r: &bСердце Вахты&r + &cСердце орды&r + &6Кровь титана&r + &5Каменное сердце&r. +52 HP → 82 HP с пятью Сердцами ночи, лечение вне боя 2 HP/с."
		"&eБез божественного&r: &cСердце орды&r + &6Кровь титана&r + &5Каменное сердце&r + &aСтальная пряжка&r. +40 HP → 70 HP: реально к 60–70-й волне."
		"&eСтена&r: &6Щиток бригадира&r + &cОжерелье реликта&r + &5Чётки дозорного&r + &aНашивка ОТК&r. −34 % урона до брони и длинная передышка после удара."
		"{@pagebreak}"
		"&eБессмертный&r: &cПесочные часы смены&r + &6Жетон второго дыхания&r + &5Чётки дозорного&r + &cОсколок пустоты&r. Щит 1 с раз в 6 с, второе дыхание раз в 5 мин, уклонение 15 %. Нимб бессменного заменяет сразу часы и жетон — щит и дыхание не складываются, работает лучший."
		"&eВампир&r: &5Перчатка мясника&r + &cСердце орды&r + &6Жало скорпиоида&r + &bНимб бессменного&r. Вампиризм 20 % (потолок), до 5 HP за удар; удары травят и замедляют."
		"&eПоджигатель&r: &cЯдро Игниса&r + &cКорона пекла&r + &6Пепельное сердце&r + &cРог диаболоса&r. Аура жжёт всё рядом, удары поджигают, атакующие горят, убийства лечат; огонь тебе не страшен."
		"&7&oИдеальный билд — тот, в котором ты дожил до раздачи добычи.&r"
	]
	quest.00C1E5D9F1E192B0.title: "Билды"
	quest.00FFADF948AC3736.quest_desc: [
		"&6Механический жнец&r Create на движущейся конструкции (тележка, поршень) собирает и пересаживает всё, мимо чего едет."
		"&6Вакуумный харвестер&r (миксер: жнец, кожух с вентилятором, латунный корпус, желоб) стоит на месте: вращение заряжает (64 об/мин — 30 с), потом разом всасывает спелое вокруг."
		"{@pagebreak}"
		"Урожай забирай с любой стороны, кроме стороны вала."
		"&6Разбрызгиватель&r Slice & Dice под трубой поливает грядки водой или удобрением."
		"&7&o— ОТК: «Жнец не отличает капусту от ноги. Не стойте на грядке».&r"
	]
	quest.00FFADF948AC3736.title: "Уборка без рук"
	quest.01594BCF4B0FAA93.quest_desc: [
		"Большому самолёту мало готового винта. &6Пропеллерный подшипник&r крутит лопасти, которые ты собрал сам из парусов: от 2 парусов перед ним — уже пропеллер."
		"Больше парусов — сильнее тяга."
		"Крафтеры столбиком: деревянная плита, железный лист, латунный корпус."
	]
	quest.01594BCF4B0FAA93.title: "Пропеллер своими руками"
	quest.01617CC30A73058B.quest_desc: [
		"Превращает найденную жилу в товар: ПКМ сканером по земле в чанке с настоящей жилой — &eзонд&r этого типа навсегда появится в столе трансмутации у всей команды."
		"Первый скан каждого типа на сервере дарит один зонд."
		"Рецепт — механические крафтеры: 3 латунных слитка, электронная лампа, детектор жил."
	]
	quest.01617CC30A73058B.title: "Сканер жил"
	quest.01B7C3894344A90F.quest_desc: [
		"Экструдер: вода и лава по бокам, скорость &eне выше 4 об/мин&r. Замедлить: маленькая шестерня → большая (÷2)."
		"Колёсами обсидиан → порошок, из него — прочные листы для поездов."
	]
	quest.01B7C3894344A90F.title: "Обсидиан"
	quest.0201C86BA400031C.quest_desc: [
		"Из-за алтаря выходит &4Пожиратель&r — неубиваемый и чуть быстрее бегущего человека. Вся команда должна добраться до &aточки эвакуации&r в ~400 блоках за 4 минуты."
		"Направление и расстояние — над хотбаром, над точкой столб света. Пешком не уйти: машина, самолёт, поезд, лошадь."
		"Отстал больше чем на 48 блоков — Пожиратель прыгает за спину. Повторы — 46 и 62."
		"Первое прохождение: &6Значок беглеца&r."
	]
	quest.0201C86BA400031C.title: "Волна 28: Побег"
	quest.021C59A76EC5D8D5.quest_desc: [
		"Бесплатное вращение с первого дня: &6256 SU&r (&68 об/мин&r × 32)."
		"Поставь колесо на вал так, чтобы вода текла по лопастям &eв одну сторону&r. Больше воды силы не прибавит."
		"Колёса на одном валу складываются: 4 колеса = &61 024 SU&r."
		"Рецепт — миксер: 8 досок + вал."
		"&7&oРыба в реке была против. Её никто не спрашивал.&r"
	]
	quest.021C59A76EC5D8D5.title: "Водяное колесо"
	quest.02B25E310B8069D6.quest_desc: [
		"Зачем: разобрать кучу мобов за стеной, не высовываясь."
		"Миксер: медный самородок, латунная и железная пластины, шестерня, порох."
		"Взрыв &e20 урона&r в радиусе 4 блоков, бросок — ПКМ. Лучше всего — через стену в толпу у ворот."
		"&eТермитная граната&r TFMG (4 термитных порошка + алюминий) — взрыв и пожар."
		"&7&o— Отдел кадров напоминает: чеку выдёргивают из гранаты, а не наоборот.&r"
	]
	quest.02B25E310B8069D6.title: "Осколочная граната"
	quest.03272886A0764215.quest_desc: [
		"Вдвое больше силы у той же реки: &6512 SU&r (&64 об/мин&r × 128)."
		"Занимает 3×3 блока, вал — через центр. Вода так же течёт по лопастям в одну сторону."
		"Крутит медленно: для быстрых машин поставь передачу большая шестерня → маленькая (×2 к оборотам)."
		"Рецепт — миксер: водяное колесо + 8 досок."
	]
	quest.03272886A0764215.title: "Большое водяное колесо"
	quest.03D58C0D28130D2F.quest_desc: [
		"Кошмар (70–100): в каждой волне 18 подволн, мобов втрое больше, они крупнее и толще: все модовые мобы, подволны &cL_Ender's Cataclysm&r и Свита Кошмара (крабы, жнецы, моли). У каждой волны — «звезда вечера»."
		"Босс — каждую волну: сначала мини-боссы (Кобольдиатор, Аметистовый краб, Уаджет, Рыскун, Аптргангр, Голем Края, Клаудиан), с 80-й — настоящие."
		"{@pagebreak}"
		"Боссы Cataclysm базу не ломают, но у них &eпотолок урона&r за удар и в секунду — одной пушкой не задавить, нужны время и много стволов."
		"&6Веха каждому&r: &dЗвёздный осколок&r — из него собирают Звёздную кирку (копает руды наших планет). И &5Сердце ночи&r."
		"&7&o— Отдел по работе с ордой: «С 70-й волны орда не приходит. Она переезжает».&r"
	]
	quest.03D58C0D28130D2F.title: "Волна 70: звёздный осколок"
	quest.03D8DE952203E77C.quest_desc: [
		"&616 384 SU&r с одного двигателя — в &664&r раза больше водяного колеса."
		"Двигатель ставят на стенку бака, перед ним — вал. На полной мощности вал крутится на &664 об/мин&r."
		"Один уровень котла — один двигатель: котлу 18 нужно &618&r двигателей."
		"Рецепт — механические крафтеры столбиком: золотой лист, андезитовый сплав, медный блок."
		"{@pagebreak}"
		"&eКак проверить:&r надень инженерные очки и посмотри на бак — видно уровень котла и что его держит: нагрев, вода или размер."
		"Без горелки двигатель крутит в пассиве — слабо, зато бесплатно."
		"&7&o— Отдел кадров: «Двигатель отработал смену и не попросил прибавки. Берём в штат».&r"
	]
	quest.03D8DE952203E77C.title: "Паровой двигатель"
	quest.0503A513927D11DF.quest_desc: [
		"Ночью и в пещерах здесь по-настоящему темно: без света не видно почти ничего, а в темноте тает рассудок."
		"Мир открыт с первого дня: копай, строй, ставь заводы. Главное испытание — &5набеги на алтарь&r, волну выбираете сами (глава «Алтарь и набеги»)."
		"План на первую ночь: свет → кровать → рассудок. Потом — база и алтарь."
		"&7&o— Отдел кадров Axiomativ: «Ночная смена оплачивается по двойному тарифу. Посмертно — по тройному».&r"
	]
	quest.0503A513927D11DF.title: "Ночи здесь другие"
	quest.054A25D32F75CDFE.quest_desc: [
		"Зачем: одна линия — все блоки и подхват ресурсов без единого ручного шага."
		"Латунный просеиватель: просеиватель + 4 латуни + 3 латунных листа + блок редстоуна (миксер)."
		"С латунной сеткой из гравия и песка идут дроблёная руда, лазурит, кварц, опыт."
		"&7&o— Отдел маркетинга Axiomativ: «Всегда есть решение». Обычно это ещё одна лента.&r"
	]
	quest.054A25D32F75CDFE.title: "Фабрика блоков"
	quest.05989202445BDA9F.quest_desc: [
		"Волны 27–34: богомолы (удар на 15), термиты, плоские пауки, шершни, ныряльщики. Босс 30-й — &4Артроплевра-мерзость&r."
		"Провал с 27-й стоит &c5 сердец&r. Готовьтесь: мясорубка в коридоре, автопушки, запас лечения, броня с «Защитой»."
		"&7&o— ОТК: «Ног в этой волне больше, чем в отделе кадров. Мы пересчитали».&r"
	]
	quest.05989202445BDA9F.title: "Волна 30: Артроплевра"
	quest.05BFAC295E23C671.quest_desc: [
		"Мобы набега &eгрызут стены&r на пути к алтарю: булыжник ~4 с, глубинный сланец ~6 с, железный блок ~10 с, обсидиан — минута."
		"Машины, сундуки, валы, всё с блок-сущностью, пушки и турели они &aне трогают&r."
		"Путь ищут на 64 блока — длинный коридор-ловушка работает. Великаны после 70-й грызут и третий блок прохода."
		"С 18-й волны — &cподрывники&r: не грызут, а взрывают (квест «Подрывники»)."
		"{@pagebreak}"
		"&eТочки спавна&r: встань, где должна выходить орда, — &e/nightshift spawn add&r (20–128 блоков от алтаря, вне зоны, до 8 точек). Орда пойдёт в твой коридор."
		"&e/nightshift spawn list&r, &eremove&r (ближняя), &eclear&r (снова кольцом)."
		"Зомби лезут друг на друга, пауки — по стенам. Фантомы и вексы кружат над алтарём: провалом они не считаются, но волна не кончится, пока живы."
		"{@pagebreak}"
		"&7&oСтена из булыжника держит орду четыре секунды. Хватит, чтобы помолиться. Коротко.&r"
	]
	quest.05BFAC295E23C671.title: "Стены и точки спавна"
	quest.064C83DE0B941189.quest_desc: [
		"Зачем: первое дальнобойное оружие Create — стреляет едой."
		"Механические крафтеры: андезитовый сплав, точный механизм, 3 трубы, 2 медных слитка. Бывает и в редкой добыче набегов."
		"{@pagebreak}"
		"Урон по снаряду:"
		"&eкартошка&r — 5 (раз в 0,75 с)"
		"&eпечёная&r — 5 и поджог"
		"&eзолотая морковь&r — 12"
		"&eдыня&r — 8, отбрасывает"
		"&eсладкие ягоды&r — 3 × 3"
		"&7&o— Столовая против. Орда — тоже.&r"
	]
	quest.064C83DE0B941189.title: "Картофельная пушка"
	quest.06AA8DFEA3F70CB5.quest_desc: [
		"Зачем: по рельсам Create ездят поезда (ванильные вагонетки — отдельно)."
		"Последовательная сборка: шпалы (плиты) → 2 самородка железа или цинка → пресс."
		"Кладутся от точки к точке: повороты и подъёмы Create строит сам."
	]
	quest.06AA8DFEA3F70CB5.title: "Рельсы"
	quest.06B5CD629BA1C0AF.quest_desc: [
		"Зачем: из самородков — слитки, из слитков — листы для горелки, пилы и всего железного."
		"&6Пресс&r над &6чашей&r: 9 самородков в чаше → слиток (квадрат 3×3 из одного пресс сжимает сам)."
		"Пресс над &6депо&r: слиток → железный лист."
	]
	quest.06B5CD629BA1C0AF.title: "Слитки и листы: пресс"
	quest.07393EA56E1D767B.quest_desc: [
		"Подлодка — та же физическая штуковина: сборщик и клей, просто вместо пропеллера вверх — балласт."
		"Схлопывание корпуса от давления включено. Для глубины — прочное стекло и толстые стены."
		"Тормозной гак и декомпрессионная камера помечены авторами «в разработке, не использовать»."
		"{@pagebreak}"
		"&6Поплавок&r (8 шерсти + мембрана: ламинария под прессом) выталкивает к поверхности — для лодок и буёв."
		"&6Подводная мина&r (миксер: 4 промышленных железных блока, ванильный магнетит, 4 динамита)."
		"&7&o— Отдел по работе с ордой: «Утопленники тоже заслуживают сюрпризов».&r"
	]
	quest.07393EA56E1D767B.title: "Советы капитану"
	quest.0811D15A56819E96.quest_desc: [
		"Зачем: без этого блока на борту ракета летает только к Луне. К Марсу, Венере, Меркурию и нашим планетам — только с ним (строка Navigator: Required)."
		"Механические крафтеры: 6 титановых пластин + 2 титановых слитка + 5 полированных лунных сапфиров + 4 схемы + навигационный компьютер."
		"{@pagebreak}"
		"Поставь в корпус и приклей вместе со всем."
		"Планеты по сложности: Марс (сталь) → Меркурий (вольфрам, жара днём) → Венера (жара всегда, вольфрамовый корпус). Справки — в ряду сверху."
		"&7&o— Навигационный отдел: «Луна — это ещё двор. Дальше начинается улица».&r"
	]
	quest.0811D15A56819E96.title: "Межпланетный навигатор"
	quest.081BCC72EBCBE493.quest_desc: [
		"Дракон ест &6рыбу&r. Покорми дракончика сырой рыбой — станет твоим (сердечки над головой)."
		"Команды — клавиша &6«Меню команд дракону»&r (Управление → «Драконы (Dragon Mounts)»): сидеть, за мной, гулять; мирный, нейтральный, агрессивный."
		"Инвентарь дракона (статы, броня, седло) — &6Shift + ПКМ&r по своему дракону."
	]
	quest.081BCC72EBCBE493.title: "Приручение"
	quest.0842BE7A53F7464B.quest_desc: [
		"Зачем: пушка стреляет сама, только если кто-то видит цель."
		"&6Вращатель антенны&r (электронная лампа, механический подшипник, 3 железные пластины), на него — &6приёмник антенны&r (без него «No Receiver Found») и рефлекторы. Дай вращение."
		"Дальность: 20 блоков + 10 за каждый рефлектор, до 1 000. Обзор 90°, по высоте ±20 блоков."
	]
	quest.0842BE7A53F7464B.title: "Радар"
	quest.084D8406F225C967.quest_desc: [
		"Победа — добыча &aкаждому&r в этом мире, кто был в игре хотя бы на &eполовине подволн&r — расстояние до алтаря не важно (к боссу зайти в игру не выйдет)."
		"Бросков: по одному за подволну, два за каждого босса, с 70-й — ещё по одному за каждую волну после 69-й."
		"Таблица богатеет с волной: от дерева и железа до алмазов, незерита и тория. У броска 14% на &dредкое&r: рюкзаки, книги, тотемы, элитры, звезда Незера, зонды жил."
		"{@pagebreak}"
		"Раз за набег — шанс на &5артефакт&r: от 3% до 60%, после 69-й +1% за волну. С 70-й — ещё особые броски: череп визера, незерит с чарами, элитры, маяк."
		"&6Первое прохождение&r: зонд жилы на команду — за первую волну нового состава (1, 4, 8, 14, 20, 27, 35, 43, 50, 60); сильный артефакт каждому — каждая 5-я с 20-й."
		"{@pagebreak}"
		"Артефакты носят в слотах аксессуаров (кнопка в инвентаре): облако в бутылке, кроссовки, силовая перчатка, кристальное сердце… всего почти 50."
		"Ещё их роняет &5подражатель&r — моб-сундук волн с 35-й."
		"&7&o— Бухгалтерия EMC: «Добыча не облагается налогом. Облагается только тот, кто не дожил до раздачи».&r"
	]
	quest.084D8406F225C967.title: "Добыча"
	quest.08F1549241E129A6.quest_desc: [
		"Засчитается, как только окажешься на Луне (в меню станции — The Moon)."
		"Первое дело — лунный сапфир (справка «Луна» сверху): из него автопосадка и Межпланетный навигатор."
		"{@pagebreak}"
		"&6Как вернуться&r: после посадки открой станцию (ПКМ) — к ногам выпадет &6Обратный билет&r."
		"Положи его в слот станции вместо Атласа и выбери «Previous takeoff» — сядешь ровно туда, откуда взлетел. «Hold position» — в те же X/Z, где стоишь."
		"{@pagebreak}"
		"Билет сгорает при посадке. Топливо на обратный путь — в тех же баках; норма теплозащиты Земли действует и на обратном пути."
		"Можно и по Атласу, но тогда в нём должна быть открыта Земля."
		"&7&o— Маленький шаг для вахтовика, огромный счёт за топливо для бухгалтерии.&r"
	]
	quest.08F1549241E129A6.title: "&6Ступил на Луну&r"
	quest.092F3AC53112DA4F.quest_desc: [
		"После сотой шкала не кончается: &dБесконечность&r — волны ∞1, ∞2, ∞3… Почти одни боссы, мобов и силы всё больше, без потолка."
		"Боссы Cataclysm толстеют не больше чем вдвое, а вот свита растёт без предела."
		"Каждая 5-я новая волна — сильный артефакт и &5Сердце ночи&r каждому; обычный артефакт падает почти всегда."
		"&7&oБесконечность — это когда отпуск согласовали, но дату не поставили.&r"
	]
	quest.092F3AC53112DA4F.title: "Бесконечность"
	quest.095F889A350581BE.quest_desc: [
		"Горелка под баком даёт котлу нагрев: &61&r уровень на обычном топливе, &62&r — на торте всполоха (перегрев)."
		"Горелку не крафтят: пустая горелка (4 железных листа + незерак) → ПКМ по живому всполоху или спавнеру."
		"Считаются только горелки прямо под дном: под 3×3 их влезает &69&r."
		"{@pagebreak}"
		"&eТопливо&r (воронкой или деплоером):"
		"уголь — &680 с&r"
		"угольный блок — &6800 с&r"
		"торт всполоха — &6160 с&r, перегрев"
		"Торт: пресс над бассейном жмёт основу (яйцо + сахар + незераковая мука), дозатор заливает &6250 мБ&r лавы."
		"Лава, огонь или магма под баком — «пассив»: &62 048 SU&r на весь котёл."
		"&7&o— Столовая: торт всполоха не для людей. Уже попробовали? Теперь знаете.&r"
	]
	quest.095F889A350581BE.title: "Горелка: топливо и торт"
	quest.09AAC059978BF8D7.quest_desc: [
		"Сколько даёт один экструдер и где взять больше."
		"Экструдер: &64&r удара на штуку сырья. Удар = 200 / floor(1 + 59 × об/мин / 512) тиков."
		"&e64 об/мин&r — &612&r шт/мин; &e128&r — &6~21&r; &e256&r — &6~43&r."
		"Рычаг: больше экструдеров на месторождении и выше обороты. Месторождение — пятно 5–10 блоков: места хватит на несколько машин."
		"{@pagebreak}"
		"&eОдин экструдер на 64 об/мин, в минуту:&r"
		"&eсера&r — 12 корок → &630&r серной пыли"
		"&eсоль&r — 12 каменной соли → &66&r вёдер электролита"
		"&eмагнетит&r — 12 сырого → &624&r порошка → &66&r блоков"
		"&eкварц&r — &612&r стекла (или линз)"
		"&eбоксит&r — 12 → &6~18&r алюминиевых слитков"
		"{@pagebreak}"
		"&eгелий&r — 12 инея → &612&r баллонов (&648&r оболочек)"
		"&eлёд&r — 12 криокристаллов → &624&r радиатора"
		"&eторф&r — 12 → &66&r фильтров воздуха"
		"&eсветогриб&r — 12 → &636&r спор (&6216&r таблеток успокоительного)"
		"&eзвёздная пыль&r — &612&r звёздных карт"
		"&eгевея&r — один ствол до &620&r латекса (раз в 3 с)."
	]
	quest.09AAC059978BF8D7.title: "Справка: форпосты в цифрах"
	quest.09F356C146A17F96.quest_desc: [
		"Зачем: очередь снарядов без разборки и перезарядки."
		"Детали — чугун, бронза или сталь: казённик (с экстрактором), ствол, возвратная пружина. Всё отливается и сверлится, ставится на крепление пушки."
		"Длина ствола с казёнником: чугун — до 3, бронза — 5, сталь — 7."
		"{@pagebreak}"
		"Темп задаёт сила сигнала на грани выстрела: от 10 выстрелов в минуту (сила 1) до 300 (сила 15)."
		"Патроны: &eпулемётный&r — 8, &eбронебойный&r — 14, &eзенитный&r — 10 + 15 осколков. Контейнер для боеприпасов — на 64 снаряда или 128 пулемётных."
		"{@pagebreak}"
		"Мод CBC: Advanced Technologies добавляет тяжёлую автопушку (до 150 в минуту) и спаренную (до 600) — рецепты в JEI (R)."
	]
	quest.09F356C146A17F96.title: "Автопушка"
	quest.0A0C129FCF5B1753.quest_desc: [
		"Греет воздух для домны. Рецепт: 2 чугунных бака, 2 чугунные трубы, 2 огнеупорных кирпича → &a2 нагревателя&r."
		"Топливо (&6креозот или печной газ&r) — снизу, воздух — сбоку (воздухозаборник), горячий воздух выходит сверху — трубой в люк домны."
		"Со временем копится CO₂ и глушит нагреватель — поставь рядом дымовую трубу или вытяжку."
		"{@pagebreak}"
		"&7&oЭкономика замкнулась: кокс греет домну, домна даёт газ, газ греет воздух. Бухгалтерия плачет от счастья.&r"
	]
	quest.0A0C129FCF5B1753.title: "Воздухонагреватель"
	quest.0A1DAFEE8419EA9C.quest_desc: [
		"Зачем: поезд возит руду и людей между базами, пока ты воюешь с ордой."
		"На станции открой меню → режим сборки. Тележки — ПКМ железнодорожным корпусом по рельсам, блоки к ним — суперклеем."
		"Нужен контроллер лицом вперёд. Подтверди сборку на станции; разобрать — тоже только там."
		"&7&o— Служба доставки Axiomativ: поезд опаздывает, только если его съели. Такое было один раз. Дважды.&r"
	]
	quest.0A1DAFEE8419EA9C.title: "Первый поезд"
	quest.0A1E924D269679FA.quest_desc: [
		"&9Сверхредкие&r артефакты волн (3) — вампиризм, тяжёлая броня, отражение в ближнем бою."
		""
		"&9Клык кровососа&r — +1 урона в ближнем бою; вампиризм 5 % нанесённого урона (до 2 HP за удар). Считается весь урон, нанесённый тобой, и стрелы из твоего лука тоже."
		"&9Наплечник из сплава&r — +4 брони; +2 прочности брони. Прочность брони режет именно крупные удары — против боссов."
		"&9Шипастый ошейник&r — +1 брони; отражает 25 % урона ближнего боя обратно. Стрелы и заклинания не отражает — только удары вплотную."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 3 — с волны 8: ≈0,23 % на 8-й, ≈0,61 % на 15-й, ≈2,7 % на 50-й, ≈4 % на 100-й за победу (без первого прохождения)."
	]
	quest.0A1E924D269679FA.title: "&9Сверхредкие&r артефакты"
	quest.0A221ACB167F5182.quest_desc: [
		"Готовые части — в &6механические крафтеры&r, получится &eдержатель голема&r."
		"Металлический: рука — тело — рука в ряд, ноги под телом. Человекоподобный: столбик тело / руки / ноги. Пёс: тело над ногами."
		"ПКМ держателем по земле — голем выходит. В крафтере же меняют части готового держателя."
		"{@pagebreak}"
		"Живого голема лечит &6ПКМ слитком&r его металла. Держатель с нулём здоровья чинится на наковальне тем же слитком."
		"&7&o— Бухгалтерия: «Голем окупается за одну ночь. Если пережил её».&r"
	]
	quest.0A221ACB167F5182.title: "Голем в сборе"
	quest.0A3DAD1655477A4B.quest_desc: [
		"Клапан — трубами к цистерне, вращение на клапан, грань — к морю. Лодка набирает воду и тонет. Реверс — откачка, всплытие."
		"Не тонет и не всплывает — клапан не соединён трубами или не крутится."
		"&7&o— Подлодка — единственный транспорт, где «утонул» значит «всё по плану».&r"
	]
	quest.0A3DAD1655477A4B.title: "Первое погружение"
	quest.0A56940FBB7439AE.quest_desc: [
		"Для супов и бургера нужны томаты, капуста и лук."
		"&6Томат&r зреет на 4-й стадии: плод и семена. Изредка падает гнилой томат — не еда."
		"&6Капуста&r — только на последней, 7-й стадии; раньше — одни семена."
		"Держи по паре грядок постоянно в росте."
	]
	quest.0A56940FBB7439AE.title: "Урожай"
	quest.0AFB1385552891D0.quest_desc: [
		"Зачем: понять правило вахты — от него зависит вся игра."
		"Смену перебросило в чужой мир. Верстак мёртв, сетка 2×2 — тоже: &6руками только собирать&r — ставить блоки и класть детали. Остальное — машины Create."
		"У бригадира — &6Ящик вахтовика&r с механизмами (поставь — всё внутри). У каждого — ключ, очки и «Инструктаж вахтовика»."
		"&7&o— Axiomativ: «Свобода от рутины». Рутину крафта у вас уже отобрали. Не благодарите.&r"
	]
	quest.0AFB1385552891D0.title: "Прибытие"
	quest.0B8DDB0E251F417E.quest_desc: [
		"&eГенератор переменного тока&r — самый простой ток: один блок, КПД &690 %&r."
		"Сборка — механические крафтеры: 4 электромеди, 6 железных листов, железный стержень, 2 андезитовых сплава. Стержень катает прокатный стан."
		"Берёт &664 SU&r на каждый об/мин и даёт:"
		"&664 об/мин&r — &6108 FE/т&r"
		"&6256 об/мин&r — &6432 FE/т&r"
		"На 256 об/мин это &616 384 SU&r — ровно один паровой двигатель."
		"{@pagebreak}"
		"Ток отдаёт соседним блокам сам, в сеть — через соединитель на генераторе."
		"&7&o— Отдел по работе с ордой: «Генератор гудит. Зомби на гул не идут. Идут на тебя, ты рядом».&r"
	]
	quest.0B8DDB0E251F417E.title: "Генератор C&A"
	quest.0C5F009A7468C1F1.quest_desc: [
		"Самый сильный источник без топлива: до &68 192 SU&r."
		"Подшипник — миксер: камень + деревянная плита + вал. На его лицо прилепи суперклеем паруса (шерсть тоже считается) — минимум &68&r штук."
		"ПКМ по подшипнику — ветряк собран и крутится. Сторону вращения выбирают прокруткой на подшипнике."
		"{@pagebreak}"
		"&eСчитаем:&r каждые &68&r парусов = &6+1 об/мин&r, потолок — &616 об/мин&r (&6128&r парусов)."
		"Сила — &6512 SU&r на каждый об/мин:"
		"8 парусов — &6512 SU&r"
		"64 паруса — &64 096 SU&r"
		"128 парусов — &68 192 SU&r"
		"&7&oВетер бесплатный. Шерсть — нет: овцы уже подали жалобу в профсоюз.&r"
	]
	quest.0C5F009A7468C1F1.title: "Ветряк: подшипник и паруса"
	quest.0CA383208BFFC4DA.quest_desc: [
		"Зачем: теперь шахта окупается — сырая руда даёт &e1,5&r дроблёной, руда блоком (шёлковое касание) — &e2,5&r."
		"Дальше: &6промывка&r — 9 самородков + побочка, или сразу &6плавка&r — печь или вентилятор сквозь лаву. Металла одинаково (9 самородков = слиток), промывка — ради побочки:"
		"железо — 75 % редстоуна, медь — 50 % глины, цинк — 25 % пороха, золото — 50 % кварца."
	]
	quest.0CA383208BFFC4DA.title: "Дроблёная руда"
	quest.0CB6A55DA838EA09.quest_desc: [
		"Камень, который тянет вверх: каждый блок тянет вверх (10 kpg в единицах мода), без шара и горелки. Добыть нельзя — только отлить."
		"&6Смесь&r: миксер с нагревом — 4 порошка эндерняка (эндерняк в дробилку), 2 цинковых самородка, 500 мБ &eгелия&r (форпост «Высотный конденсатор») → 500 мБ."
		"{@pagebreak}"
		"Вылей смесь блоком и поставь рядом огонь (костёр, горелку) — смесь застынет в левитит вместе с соседними блоками смеси."
		"Эндерняк — только из Энда."
	]
	quest.0CB6A55DA838EA09.title: "Левитит"
	quest.0CB839EC6B4FFE19.quest_desc: [
		"Котёл — это обычные баки, к которым прикручены двигатели."
		"Бак: медный лист + бочка + медный лист, столбиком на механических крафтерах."
		"Баки рядом и друг на друге сливаются в один. Размер котла — &64&r блока бака на &61&r уровень. Ширина до 3×3, высота до 32."
		"&7&o— Техника безопасности: бак не взрывается. Запомни это чувство, дальше по главе оно пройдёт.&r"
	]
	quest.0CB839EC6B4FFE19.title: "Жидкостный бак"
	quest.0D7095A54027C586.quest_desc: [
		"Главное улучшение для орды: погибший голем выпадает &6держателем с нулём здоровья&r и сам прыгает к тебе в инвентарь, если ты рядом."
		"Крафтеры плюсом: тотем бессмертия сверху, эндер-жемчуг слева и справа, якорь возрождения снизу, пустое улучшение в центре."
		"{@pagebreak}"
		"Важно для арены: после набега блоки восстанавливаются, а големы — нет. Без этого улучшения погибший голем пропадает насовсем."
		"&7&o— Техника безопасности: голем умирает не насовсем. Сотрудники — насовсем. Не путайте.&r"
	]
	quest.0D7095A54027C586.title: "Бессмертный голем"
	quest.0DA29650B2A99689.quest_desc: [
		"Зачем: летать над базой и над ордой."
		"Механическая сборка: элитры, медный баллон, 2 механизма точности, латунные листы, жёлобы, вал (R)."
		"Прыжок — вверх, Shift — вниз, &6G&r — вкл/выкл, &6H&r — «режим наведения» (зависание). Ест сжатый воздух из баллона."
	]
	quest.0DA29650B2A99689.title: "Реактивный ранец"
	quest.0DBAB77BAE915A5D.quest_desc: [
		"С 18-й волны в орде &cподрывники&r — светящиеся муравьи на 6 HP. Бегут к стене и взрываются: дыра ~2 блока; рядом с игроком — взрыв по игроку."
		"Не берут: машины и всё с блок-сущностью, пушки и турели, &eобсидиан&r и прочее взрывоустойчивое. Добежал до алтаря — взрывается там, но набег не проваливает."
		"{@pagebreak}"
		"Что делать: сбивать на подходе — луки, турели, ловушки; второй слой стены за первым; обсидиан там, где орда упирается."
		"С 59-й — &4подрывник-тяжеловес&r: крупнее, крепче, дыра втрое больше."
		"&7&o— Отдел кадров: «Подрывники работают без выходных. Ровно до первого взрыва».&r"
	]
	quest.0DBAB77BAE915A5D.title: "Подрывники"
	quest.0E9B75BD4A8ACA52.quest_desc: [
		"Зачем: лучшая кирка смены — и сделана из того, что добыто на наших планетах, а не выдана за выслугу."
		"Механические крафтеры: &eстабилит — аксиомит — стабилит&r сверху, под ними &e2 межпланетных сплава&r (рукоять)."
		"Копает руды наших планет, как Звёздная, но: прочность &e6 000&r, скорость &e14&r, урон выше, &aне горит в лаве&r, зачаровывается лучше незерита."
		"&7&o— ОТК: «Свет и тьма в одной кирке. Сломать её не может никто. Даже вы. Особенно вы».&r"
	]
	quest.0E9B75BD4A8ACA52.title: "&dСтабилитовая кирка&r"
	quest.0F09FFA3A4ED3DAF.quest_desc: [
		"Какой провод сколько проводит."
		"&eC&A&r — лимит у соединителя, катушка на поток не влияет:"
		"&eНизковольтный&r (малый) + любая катушка — &61 000 FE/т&r, 4 провода, пролёт 16"
		"&eВысоковольтный&r (большой) + золото или электрум — &6без лимита&r, 6 проводов, пролёт 32"
		"Малый ↔ большой — любая катушка, пролёт 16. Большой ↔ большой медью — нельзя."
		"{@pagebreak}"
		"&eNew Age&r — лимит у провода, пролёт до &616&r:"
		"&eмедь&r — &61 024 FE/т&r"
		"&eзаряж. железо&r — &62 048 FE/т&r"
		"&eзаряж. золото&r — &64 096 FE/т&r"
		"&eзаряж. алмаз&r — &68 192 FE/т&r"
		"Тянут между электрическими коннекторами New Age. Провод — сборка по шагам: лист → деплоер с резиной → пила = &64&r провода; алмазный — тоже с резиной в каждом круге."
		"{@pagebreak}"
		"&eTFMG&r — своя сеть (кабельные изоляторы и узлы). С C&A и New Age не стыкуется: только через FE-блок вплотную."
		"&7&oПровод тоньше волоса держит 1 000 FE/т. Волос — нет. ОТК проверил, волос не вернули.&r"
	]
	quest.0F09FFA3A4ED3DAF.title: "Справка: провода и соединители"
	quest.0FF3009B62FC3F73.quest_desc: [
		"Рядом с нашим миром есть &8Тёмное измерение&r (мод The Afterdark): темно, мобы сильнее, зато есть тайники."
		"Вход — алтари телепорта в &8Глубокой тьме&r. Нужен &eкатализатор телепорта&r (только из сундуков: шахты, древний город, клады, крепости): ПКМ им по алтарю — 5 переходов."
		"Обратно — ПКМ по алтарю там, без катализатора. Бери свет и таблетки: переход тоже бьёт по рассудку."
	]
	quest.0FF3009B62FC3F73.title: "Тёмная сторона"
	quest.102D14365F5DC1B3.quest_desc: [
		"Лечит одну рану — возвращает сердце, отнятое смертью. Без ран пить бесполезно."
		"Только миксер: медовая бутылка + светящиеся ягоды + сладкие ягоды + костная мука + 2 &eцелебные споры&r → &a2 настойки&r."
		"Светящиеся ягоды растут в пышных пещерах. Мёд без ульев: нагретый миксер — 2 сахара + цветок + вода, спаутом в бутылки."
	]
	quest.102D14365F5DC1B3.title: "Настойка жизни"
	quest.104662E6DA217044.quest_desc: [
		"Зачем: вторая половина инвентаря на спине — меньше ходок в темноту."
		"Сборщики: сундук в центре, кожа и нити вокруг (R). Кожа без коров — миксер с нагревом: 3 гнилой плоти + вода."
		"&6ПКМ&r — открыть, &6B&r — открыть надетый."
		"{@pagebreak}"
		"Больше места — железный рюкзак (8 железа вокруг). Улучшение &6«Подбор»&r — нужное само падает в рюкзак."
		"Верстак и камнерез в рюкзаке на вахте убраны."
	]
	quest.104662E6DA217044.title: "Рюкзак"
	quest.10AB8BC67127FF0D.quest_desc: [
		"Бригадир наконец рассказал, куда уходят отчёты смены: на &bАксиоматив&r — родную планету компании Axiomativ. Холодный стальной мир: заводы, литейные, мёрзлые равнины. Отсюда приходят приказы."
		"{@pagebreak}"
		"Долететь: наука &68&r в Атласе, Межпланетный навигатор на борту, Звёздный навигатор у каждого."
		"Науку быстрее снимать с Луны и Марса: у каждого наблюдателя свой счёт. С одной Земли — ~16 ночей."
		"{@pagebreak}"
		"Тяжесть 11 м/с² — ускорителей больше, чем для Земли. Теплозащита 80 + 0,3 за блок. Планета далеко (2,2 а.е.) — топлива больше, чем до Марса."
		"Воздух — тонкий углекислый, −120 °C: железный скафандр держит. Посадка — в те же X/Z."
		"&7&o— Приёмная штаба: «Вы опоздали на планёрку на 70 волн».&r"
	]
	quest.10AB8BC67127FF0D.title: "&6Аксиоматив: штаб компании&r"
	quest.10F9F025767F43F1.quest_desc: [
		"Зачем: очередь, которая не будит соседей."
		"Механические крафтеры: пластины, ящик для инструментов, медный баллон, точный механизм, труба, гидровентиль — рецепт в JEI (R)."
		"&e10 выстрелов в секунду&r, магазин на 40: гвоздь — 5 урона, стальной — 8. Пуля не даёт мобу неуязвимости после удара — очередь бьёт вся."
		"{@pagebreak}"
		"Бесшумный: обычный выстрел злит всех враждебных мобов в 20 блоках, гвоздемёт — нет."
		"Гвозди: 3 железных самородка в миксере → 9 гвоздей, или на конвейере самородок → пила → пресс → 6."
	]
	quest.10F9F025767F43F1.title: "Гвоздемёт"
	quest.11275B17FBDCC7ED.quest_desc: [
		"Главная работа тока — заряжать то, что без него не сделать."
		"&eЭлектризатор New Age&r стоит над депо или лентой, как пресс; ест вращение и ток."
		"На каждые 10 об/мин: обыкновенный &64&r, продвинутый &616&r, укреплённый &664 FE/т&r. На 256 об/мин ≈ &6100 / 410 / 1 640 FE/т&r."
		"Обыкновенный — миксер: андезитовый корпус + громоотвод."
		"{@pagebreak}"
		"&eЭлектризатор заряжает:&r"
		"железо (слиток, лист) — &61 000 FE&r"
		"золото (слиток, лист) — &62 000 FE&r"
		"алмаз — &610 000 FE&r"
		"бутылка → пузырёк опыта — &650 000 FE&r"
		"Заряженное — в магниты, провода, теплогенераторы, моторы, нагреватель."
		"{@pagebreak}"
		"&eКатушка Теслы C&A&r — тоже над депо или лентой:"
		"золотой слиток или лист → электрум — &636 000 FE&r (~5 с);"
		"золотой провод или стержень → электрум — &618 000 FE&r."
		"Предметы с батареей — &65 000 FE/т&r."
		"Серебра в паке нет: электрум — только катушкой Теслы."
		"&7&oПузырёк опыта за 50 000 FE. Бухгалтерия заплакала. Опытом.&r"
	]
	quest.11275B17FBDCC7ED.title: "Справка: зарядка"
	quest.1172882304DE25C3.quest_desc: [
		"Зачем: ускорители жгут топливо из жидкостных баков Create на борту. Заливай баки до сборки."
		"Энергия, ГДж на 1 мБ:"
		"&eБиотопливо&r (и биоэтанол Create Additions) — 0,25"
		"&eГазообразный водород&r — 0,5"
		"&eЖидкий водород&r, &eнафта TFMG&r — 0,75"
		"&eЖидкие углеводороды&r, &eкеросин TFMG&r — 1"
		"&eМетан&r — 2"
		"Дизель и бензин ракете не годятся."
		"{@pagebreak}"
		"&eБиотопливо&r — проще всего: пресс над чашей с горелкой, 3 сушёные ламинарии + костная мука → 150 мБ."
		"&eУглеводороды&r — миксер над ПЕРЕГРЕТОЙ чашей: 3 натриевых катализатора + 500 мБ углерода + 500 мБ воды → 500 мБ."
		"&eКеросин и нафта&r — дистилляционная башня TFMG (глава «Топливо и двигатели»)."
		"{@pagebreak}"
		"Сколько — станция пишет точно. На 1 массы: взлёт 30 × тяжесть старта (Земля = 1), посадка 10 × тяжесть цели, перелёт 10 × расстояние в а.е."
		"Ракета массой 50: до Луны ~1600 ГДж, обратно ~750 — это ~2,3 ведра углеводородов или ~9,3 ведра биотоплива."
		"{@pagebreak}"
		"&cТопливо на весь рейс списывается в момент старта&r — запас на обратную дорогу вези в тех же баках."
		"До планет перелёт зависит от того, как они стоят: следи за строкой Travel и выбирай окно."
		"{\"text\":\"▶ Вики Northstar: топливо (англ.)\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://github.com/Astronauts-of-Create/Northstar-Redux/wiki/Fuel\"}}"
		"&7&o— Бухгалтерия: «Биотопливо дешёвое. Поэтому его нужно много. Поэтому оно дорогое».&r"
	]
	quest.1172882304DE25C3.title: "Ракетное топливо"
	quest.11807A46F6FD8F33.quest_desc: [
		"Защита полного комплекта:"
		"&eмедь / цинк / латунь&r CSA — 14 / 15 / 16"
		"&eжелезо&r — 15"
		"&eалмаз, незерит, эхо&r — 20"
		"Выше 30 защита не растёт — это потолок игры."
		"{@pagebreak}"
		"Части из Cataclysm: &eкостяная броня рептилии&r (шлем + нагрудник, 17), &eнаплечники цветущего камня&r (9, лечат). Материалы — с кобольдов и аметистового краба (70+)."
		"&eИгнитовая и проклятая&r броня Cataclysm — механическими крафтерами в ряд: шаблон мода | незеритовая вещь | слиток (Игнис, Маледиктус). &eЧудовищный шлем&r — незеритовый шаблон | незеритовый шлем | рог чудовища."
		"Броня ArPhEx (хитин и выше) — из тварей его измерения."
		"Скафандры Northstar — в главе «Космос», реактивные ранцы — в «Автоматизации всего»."
	]
	quest.11807A46F6FD8F33.title: "Справка: броня"
	quest.11AE4E7F06713FBD.quest_desc: [
		"Зачем: подхват — немного металла и полезной мелочи из гравия, песка и пыли."
		"Миксер: андезитовый корпус + шестерня + камень + 2 доски + 2 палки. Вставь сетку (ПКМ), сыпь сверху, крути шестернёй сбоку."
		"&6Андезитовая сетка&r (сплав + 8 палок) по гравию: по 10 % железа и цинка, 7,5 % меди, 5 % золота, кремень."
		"{@pagebreak}"
		"Нитяная сетка по земле — камешки, семена, саженцы; часть рецептов — только в затопленном сите."
		"Латунные сетки — в латунном сите: вместо самородков дроблёная руда."
		"На вахте сито — подхват, не завод: металлы в нём урезаны вчетверо."
		"&7&o— Бухгалтерия: сито — как наша премия. Что-то просыпается, но в основном гравий.&r"
	]
	quest.11AE4E7F06713FBD.title: "Просеиватель и сетки"
	quest.11B7267B7F280CBD.quest_desc: [
		"Семена не купить — они растут в дикой природе: неприметные кусты среди травы. Сломай куст:"
		"&aдикий рис&r (у воды) — рис; &aдикие томаты&r — семена томата, изредка плод; &aдикая капуста&r — семена капусты; &aдикий лук&r — сразу луковица."
		"Там же дикие морковь, картофель и свёкла."
	]
	quest.11B7267B7F280CBD.title: "Дикие грядки"
	quest.12BE751E2935630C.quest_desc: [
		"Ночной дозор (волны 1–3): зомби, малыши, бегуны, пауки. Каменного меча и стены вокруг алтаря хватит."
		"&6Награда&r: добыча каждому, кто держал алтарь, и &6зонд жилы&r на команду (уголь или медь)."
		"Засчитывается всей команде при первом прохождении."
		"&7&o— Инструктаж: «Первая волна — ознакомительная. Умирать на ней можно, но стыдно».&r"
	]
	quest.12BE751E2935630C.title: "Волна 1: первая победа"
	quest.135091C07022C9A1.quest_desc: [
		"Детали (миксер, если не сказано иное):"
		"&eДвигатель&r — котёл (7 меди + печь), доменная печь, 3 булыжника, 2 поршня."
		"&eПропеллер&r — крафтеры в ряд: алюминиевый лист, вал, алюминиевый лист."
		"&eПарус&r — крафтеры: 6 белых ковров, 2 алюминиевых листа, нить."
		"{@pagebreak}"
		"Модели — механические крафтеры:"
		"&6Биплан&r — 3 корпуса, кварцевое стекло кабины, двигатель, пропеллер. Быстрый."
		"&6Винтокрыл&r — 2 корпуса, пропеллер, 2 паруса, кварцевое стекло. Без двигателя: летит на мускулах."
		"&6Дирижабль&r — двигатель, 2 корпуса, 4 паруса и 2 баллона гелия. Медленный, послушный."
		"Дальше: квадрокоптер, бамбуковый кукурузник на поплавках, Экономичный самолёт и Алый биплан — рецепты в JEI."
		"Алюминий, кварцевое стекло и гелий — только с форпостов: глава «Сеть форпостов»."
		"{@pagebreak}"
		"ПКМ самолётом по земле — поставить. Сел, &6E&r — инвентарь самолёта: уголь или другое топливо печи в слот «Топливо»."
		"Пробел — газ или вверх, Shift — сбросить газ или вниз, WASD — рули. Двойной Shift — высадка, B — ракетный форсаж."
		"Все клавиши — Управление → Immersive Aircraft."
	]
	quest.135091C07022C9A1.title: "Готовый самолёт"
	quest.13720189D8B60053.quest_desc: [
		"Зачем: вершина обычной брони."
		"Защита &e20&r, вязкость &e12&r, отбрасывает на 40 % слабее, не горит в лаве."
		"Улучшение — механическими крафтерами в ряд: шаблон | алмазная вещь | незеритовый слиток. Чары сохраняются."
		"&7&o— Техника безопасности: незерит не горит в лаве. Вы — горите.&r"
	]
	quest.13720189D8B60053.title: "Незеритовая броня"
	quest.1409D189B5A4B25E.quest_desc: [
		"Зачем: первый полный комплект — зомби и скелеты бьют в разы слабее."
		"Механические крафтеры, раскладка как на верстаке. Полный комплект — 24 слитка."
		"Защита комплекта — &e15&r (шлем 2, нагрудник 6, поножи 5, ботинки 2)."
		"Зачаруй на Защиту: столом зачарований или машинами Create Enchantment Industry."
	]
	quest.1409D189B5A4B25E.title: "Железная броня"
	quest.144751B87537B6D6.quest_desc: [
		"Зачем: в команде книга общая — квест, сделанный одним, засчитан всем."
		"&e/ftbteams party create НочнаяСмена&r — создать."
		"&e/ftbteams party invite <ник>&r — позвать; друг принимает приглашение в чате."
		"&7&o— Бухгалтерия: зарплата общая, премия общая, объяснительные — персональные.&r"
	]
	quest.144751B87537B6D6.title: "Одна смена — одна команда"
	quest.160E154A7BFCDF86.quest_desc: [
		"Шаблон — под &6механическую пилу&r, в фильтр пилы — нужная часть (без фильтра пила перебирает всё по кругу)."
		"Металлический: тело, рука, ноги. Человекоподобный: тело, руки, ноги. Пёс: тело, ноги."
		"Верстак големов убран: в нём прятались верстак, камнерез и кузня «в кармане». Разборки голема на части тоже нет — собирай сразу как надо."
		"&7&o— ОТК: «Голем без фильтра на пиле — это не голем, а конструктор „Сделай сам“».&r"
	]
	quest.160E154A7BFCDF86.title: "Голые части: пила"
	quest.16915B107FB94D45.quest_desc: [
		"Ручное оружие броню &cне берёт&r. Работают турели, пушки Create Big Cannons, тесла, големы, деплоеры и взрывы."
		"Повторы — 48 и 68."
		"Первое прохождение: &6Бронеплита ОТК&r."
	]
	quest.16915B107FB94D45.title: "Волна 26: Бронеколонна"
	quest.173248E40D04FCA5.quest_desc: [
		"Пульт от голема. Режимы: &eследовать&r, &eбродить&r вокруг точки, &eстоять&r, &eпатруль&r по маршруту."
		"ПКМ по голему — сменить режим. ПКМ по мобу — големы рядом атакуют его. &6Shift + ПКМ&r по голему — его инвентарь (оружие, броня) и статы."
		"{@pagebreak}"
		"Рецепт диагональный: золото, шаблон голема, палки. Пустые клетки — крафтеры с &6крышкой слота&r (крышку делает пресс из железной решётки)."
		"Родня: &6жезл возвращения&r (эндер-жемчуг вместо золота) убирает големов в инвентарь, &6жезл призыва&r (раздатчик) выпускает обратно. Удобно в дорогу."
	]
	quest.173248E40D04FCA5.title: "Жезл команды"
	quest.175B80529FFB40F7.quest_desc: [
		"Зачем: чернила и эликсиры жидкостью, переработка лишних свитков."
		"Механические крафтеры 3×3: котёл в центре, 4 железных слитка (по бокам и сверху по углам), снизу эссенция | пепельная эссенция | эссенция."
		"&6Пепельная эссенция&r на вахте — вентилятор через огонь душ по эссенции волшебства (в мире — с древних рыцарей Незера)."
		"{@pagebreak}"
		"Нагрев не нужен: котёл «кипит», когда в нём есть жидкость (ведро воды или труба). Ненужный свиток в воде — с шансом 50 % превращается в чернила своей редкости."
		"Эликсиры: уклонения, дубовой кожи, невидимости, сильного лечения — рецепты в JEI (R)."
	]
	quest.175B80529FFB40F7.title: "Алхимический котёл"
	quest.17C3D0CDD3773E4F.quest_desc: [
		"Зачем: лазер из головы. Буквально."
		"Механические крафтеры: незеритовый шлем, конденсатор древнего стража, прочные листы Create, осколки и кристаллы призмарина."
		"Защита &e5&r, вязкость &e4&r. Клавиша &eR&r — непрерывный луч: 8 урона (+4 магией) на 15 блоков, растёт от Силы. Тратит прочность шлема."
		"&7&o— ОТК: «Смотреть на орду теперь можно и нужно».&r"
	]
	quest.17C3D0CDD3773E4F.title: "Шлем-излучатель"
	quest.1861EF00B945866F.quest_desc: [
		"Зачем: держать больше чанков и ездить с ними."
		"Сборка 5×5: стекло, якорь возрождения, латунные корпуса, механизмы точности, вал. Гаст — так же."
		"Радиус 1×1 / 3×3 / 5×5: чем больше, тем выше нужны обороты."
		"На поезде держит 3×3 чанка без вращения, на станции — пока там стоит поезд."
		"&7&oГаст в коробке держит чанк. Гаст не рад. Гаста никто не спрашивал.&r"
	]
	quest.1861EF00B945866F.title: "Латунный загрузчик чанков"
	quest.18984F35EFC9F4EC.quest_desc: [
		"Медь после удара молнии — деталь &eвсех&r генераторов:"
		"генератор C&A — &64&r шт.;"
		"катушка New Age — &68&r шт.;"
		"генератор TFMG — &63&r шт."
		"Не покупается и не продаётся за EMC — только деплоер. Поставь линию и копи запас."
		"&7&oЕсли медь стала тёплой и тихо жужжит — поздравляем, это она.&r"
	]
	quest.18984F35EFC9F4EC.title: "Электрическая медь"
	quest.190E507AE2C83EB5.quest_desc: [
		"Машина — штуковина на колёсах: груз и люди по земле без рельсов. Колесо держит &6колёсное крепление&r."
		"Крафтеры столбиком: андезитовый корпус, пружина, железный лист. Пружина: железный лист, самородок железа, железный лист → 2 шт."
		"Сигнал сверху — тормоз. Сигнал сбоку — поворот колеса в ту сторону. Жёсткость подвески — в панели параметров, это настоящая физика на кочках."
	]
	quest.190E507AE2C83EB5.title: "Колёсное крепление"
	quest.192A9E87FB0BF09E.quest_desc: [
		"Зачем: менять скорость без коробок передач."
		"Большая ↔ маленькая по диагонали: с большой на маленькую — скорость &e×2&r, обратно — &e÷2&r. Две большие под прямым углом уводят вращение на другую ось."
		"Машина ест SU пропорционально скорости: разогнал вдвое — ест вдвое."
		"Рецепт: вал + 2 доски (миксер)."
	]
	quest.192A9E87FB0BF09E.title: "Большая шестерня"
	quest.1A3B36E257B08F8E.quest_desc: [
		"Зачем: таскать блоки, а с чарами — и мобов."
		"Медь + 2 шестерни + гидравлический двигатель + медный магнит (8 меди вокруг незеритового слитка)."
		"Чары «Гравитационная пушка» — ловит и швыряет существ. Ест воду."
	]
	quest.1A3B36E257B08F8E.title: "Магнитная блокопушка"
	quest.1AD77E9FFCC09760.quest_desc: [
		"Зачем: земля для ферм и сит без лопаты."
		"Миксер: песок + гравий + 900 мБ воды → земля."
		"Миксер: земля + 250 мБ воды → ил. Ил + пшеница → прессованный ил → кирпичи (пресс)."
	]
	quest.1AD77E9FFCC09760.title: "Земля и ил"
	quest.1B3BC032BE51D42E.quest_desc: [
		"Зачем: постоянный бонус к броне или книге — больше маны, сильнее школа, короче перезарядка."
		"Пустая сфера: мифрил в центре, 4 волшебных слитка по углам, 4 пепельные эссенции по сторонам — крафтеры 3×3."
		"Сфера школы: пустая сфера в центре + 8 рун этой школы. Сфера маны: + 8 рун волшебства (пустая руна + 8 эссенций). Ставится на волшебной наковальне."
		"Пустые сферы и сферы маны изредка падают в редкой добыче поздних волн."
		"&7&oТри сферы на нагруднике — и ты уже не вахтовик, а архимаг на окладе.&r"
	]
	quest.1B3BC032BE51D42E.title: "Сфера улучшения"
	quest.1B532706F4DD6F3A.quest_desc: [
		"Зачем: EMC-магазин вахты — сдать лишнее и купить нужное, например цинк."
		"Миксер, без нагрева: &e4 сплава + андезитовый корпус + 2 редстоуна + 2 камня&r (камень — булыжник в печи)."
		"Положил предмет — получил &6EMC&r и можешь покупать такие же. Сдача по полной цене."
		"{@pagebreak}"
		"Купить: ресурсы, ваниль, инструменты, стройблоки. Цинк и медь — 512 EMC, железо — 1 024, уголь — 256, булыжник — 1."
		"&cНельзя&r: руду, технику Create, сплавы, латунь, дроблёную руду — их делает только завод."
		"&7&o— Бухгалтерия: «Тысяча булыжников — и слиток железа ваш. Считайте это ипотекой».&r"
	]
	quest.1B532706F4DD6F3A.title: "Стол трансмутации"
	quest.1C0B7950C978D6EB.quest_desc: [
		"Целебные споры — основа &eуспокоительного&r (одна спора — 6 таблеток) и &eнастойки жизни&r (2 споры). Без спор рассудок не лечится."
		"&eГде:&r грибные поля (на поверхности) и пышные пещеры (на полу пещеры). Примета — светящаяся синяя грибница."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на грибницу, сбоку вода и блок мха → &6светогриб&r."
		"Жернова → &63&r целебные споры (+25 % светокаменной пыли)."
		"&eУспокоительное&r — миксер: сахар + сладкие ягоды + цветок + спора → 6. &eНастойка жизни&r — мёд, светящиеся ягоды, сладкие ягоды, костная мука и 2 споры."
	]
	quest.1C0B7950C978D6EB.title: "Грибные пещеры"
	quest.1C53FB94F3D33399.quest_desc: [
		"Мясо без стада и охоты: &6клетка&r Caged Mobs растит «виртуальное» животное."
		"ПКМ &6семплером ДНК&r по корове, потом ПКМ по клетке блоком травы (среда) и заполненным семплером."
		"Корова раз в ~минуту: говядина 50 %, кожа 40 %, капля молока 30 %."
		"{@pagebreak}"
		"&6Клетка с воронкой&r (клетка, 2 редстоуна, воронка) отдаёт добычу вниз. &6Улучшение готовки&r — сразу жареное."
		"У семплера и клетки рецепты «с дырками»: пустые места крафтеров закрой крышками слота."
		"&7&o— Юротдел: корова в клетке виртуальная. Стейк настоящий.&r"
	]
	quest.1C53FB94F3D33399.title: "Мясо из клетки"
	quest.1CA73A2F9FA9AB14.quest_desc: [
		"Заготовка любой части голема: один шаблон — одна часть."
		"&6Механические крафтеры 3×3&r: медный слиток в центре, палки крестом по бокам, глина по углам."
		"Сколько нужно: металлическому — 4 (тело, 2 руки, ноги), человекоподобному — 3, псу — 2."
	]
	quest.1CA73A2F9FA9AB14.title: "Шаблон голема"
	quest.1CDF7057BD782920.quest_desc: [
		"Голем — охранник без сна, еды и отпуска. Бьёт всех врагов, кроме криперов: ставь у алтаря и склада."
		"&6Металлический&r — танк. &6Человекоподобный&r — носит оружие и броню голема. &6Пёс&r — быстрый, на нём ездят."
		"Верстака големов нет. Путь: шаблон → пила → линия сборки → крафтеры."
		"&7&o— Отдел кадров: идеальный сотрудник. Жаль, в ведомости он числится как «инвентарь».&r"
	]
	quest.1CDF7057BD782920.title: "Цех големов"
	quest.1D77D26E368A22F5.quest_desc: [
		"Тепло — в ˚T, всё в секунду."
		"&eТеплообменник&r — уголь 200, торт 400 ˚T/с"
		"&eТЭН&r — до 600 ˚T/с, 3 FE/т за 1 ˚T/с"
		"&eНагреватель&r тратит: 100 — нагрев, 400 — нагрев (котлу 2 уровня), 500 — суперогонь"
		"&eВентиль&r — обычный 200, суперогонь 550 ˚T/с на нагреватель"
		"{@pagebreak}"
		"&eТруба&r теряет 1 ˚T/с и несёт примерно &620 000 / длина&r ˚T/с:"
		"10 блоков — ~1 800"
		"20 блоков — ~1 000"
		"30 блоков — ~700"
		"Больше тепла или дальше — клади 2–3 трубы рядом, они складываются."
		"Теплообменник и ТЭН не греют сеть выше &68 000 ˚T&r: дальше тепло просто не уходит (горелка горит впустую)."
	]
	quest.1D77D26E368A22F5.title: "Справка: котельная в цифрах"
	quest.1DB8105E4DA61380.quest_desc: [
		"Зачем: пушка стреляет сама, как только навелась."
		"&6Fire Controller&r (редстоун, 2 компаратора, точный механизм, латунный корпус) ставь так, чтобы его сигнал шёл в грань выстрела крепления. Связь — тем же передатчиком."
		"{@pagebreak}"
		"Стреляет, когда цель в прицеле с упреждением и не в безопасной зоне. Подачу боеприпасов (контейнер, механическая рука) продумай заранее."
		"&7&oАвтоматика не устаёт, не спит и не просит премию. Бухгалтерия плачет от счастья.&r"
	]
	quest.1DB8105E4DA61380.title: "Разрешение на выстрел"
	quest.1DC2DCB789843948.quest_desc: [
		"Без форпостов не сделать провода и магниты, патроны, самолёты, подлодки, скафандры и даже таблетки от рассудка. Каждое такое сырьё рождается только в своём уголке мира."
		"&eМесторождение&r — особый блок в своём биоме: светится, над ним дымок или искры. Не ломается, не двигается поршнем и контрапцией — унести нельзя."
		"Генерируется только в &eновых&r чанках: в обжитых местах ищи дальше."
		"{@pagebreak}"
		"&eКак найти:&r"
		"1) Компас природы (рецепт — в JEI) → нужный биом;"
		"2) прилетел — ищи светящееся пятно 5–10 блоков в поперечнике; биомы и приметы — в квестах справа."
		"{@pagebreak}"
		"&eКак работает:&r механический экструдер Create ставится &eна&r месторождение, по бокам — два блока из рецепта (вода, лава, блок железа, жидкая сера, пустота…)."
		"Экструдер выдавливает сырьё, дальше 1–2 машины Create — дробилка, вентилятор, миксер, пресс. Руками ничего."
		"Ставь у форпоста &eзагрузчик чанков&r Create Power Loader: без него экструдеры спят, пока тебя нет рядом."
		"{@pagebreak}"
		"&eКак связать:&r готовый продукт — в ящик у станции, поезд Create с расписанием возит его на базу. Один поезд может объезжать несколько форпостов."
		"Продукция форпостов не покупается и не продаётся за EMC."
		"&7&o— Отдел логистики: «Вахтовик с ведром серы через полкарты — это не логистика, это паломничество».&r"
	]
	quest.1DC2DCB789843948.title: "Зачем форпосты и как их связать поездами"
	quest.1DF089F6B46653BC.quest_desc: [
		"Наконечник для буровой: 2 железных блока + 5 железных слитков. Не путать с механическим буром Create."
		"Буры: железный → алмазный → незеритовый. Жилы незерита и закалённого алмаза берёт только незеритовый — и ещё просит лаву."
		"&7&o— Отдел закупок: «Бур — расходник. Как и оптимизм».&r"
	]
	quest.1DF089F6B46653BC.title: "Сменный бур"
	quest.1E4435CC30E236DE.quest_desc: [
		"Семена томата и капусты, лук — на вспаханную землю у воды, как пшеницу."
		"&6Рис&r — в воду глубиной в 1 блок."
		"Засевай сразу полосу: урожай отдаёт семена обратно."
		"&6ПКМ по спелой грядке&r — собрать и сразу пересадить (мод Right Click Harvest)."
	]
	quest.1E4435CC30E236DE.title: "Посадка"
	quest.1E4BD02D9BF9BE76.quest_desc: [
		"Котёл 18 без угля и тортов: &66&r стержней вместо 9 горелок на тортах."
		"&eДетали:&r"
		"реакторный корпус — сборочная линия из кирпичей: электризатор &6500 FE&r → деплоер с железным листом → пресс → &64&r корпуса;"
		"реакторное стекло — миксер: 5 стёкол + 4 корпуса;"
		"стержень — механические крафтеры: 4 корпуса, 4 золотых листа, 2 &eрадиатора с хладагентом&r (форпост «Ледник»), 4 реакторных стекла, 2 топлива → &62&r стержня."
		"теплоотвод — миксер: 2 корпуса + 2 тепловые трубы + 500 мБ хладагента."
		"{@pagebreak}"
		"&eСборка:&r"
		"1) стержни в ряд;"
		"2) загрузчик реакторного топлива вплотную к ряду: кидай в него топливо, он делит его между стержнями (до &632&r в сторону);"
		"3) реакторные теплоотводы вплотную — отдают тепло в трубы;"
		"4) трубы → нагреватели под котлом."
		"Стержень без топлива не греет."
		"{@pagebreak}"
		"&cОпасно:&r"
		"стержень с теплом больше &616 000&r взрывается;"
		"работающий стержень фонит радиацией вокруг;"
		"сломанный заряженный стержень тоже взрывается."
		"Отводи тепло с запасом, рядом не стой."
		"&7&o— Пресс-служба: «Небольшой хлопок на объекте. Объекта нет — проблемы нет».&r"
	]
	quest.1E4BD02D9BF9BE76.title: "Ядерный реактор"
	quest.1E4D226185FC212A.quest_desc: [
		"Миксер Create заменяет часть кухни: 2 томата + миска → &6томатный соус&r, капуста → 2 листа."
		"Резка — пилой на ленте или &6слайсером&r Slice & Dice (нож внутри, режет на депо или ленте)."
		"{@pagebreak}"
		"Кастрюля на автомате (Central Kitchen): горелка блейза снизу, &6механическая рука&r кладёт продукты и миски, воронка забирает готовое, трубы льют жидкости."
		"Сварил раз руками — дальше пусть кухня работает сама."
	]
	quest.1E4D226185FC212A.title: "Кухня без рук"
	quest.1E68FEAD8DD9CB10.quest_desc: [
		"Зачем: без заглушки не собрать диагональные рецепты — ножницы, удочку, жезлы."
		"Сборщики держатся группой только стенка к стенке. Пустые клетки рецепта займи сборщиками с заглушкой (ПКМ заглушкой по сборщику): группа цела, клетка считается пустой."
		"Заглушка на вахте — прессом из &6железной решётки&r (или 3 латунных самородка)."
	]
	quest.1E68FEAD8DD9CB10.title: "Заглушка слота"
	quest.1EEFAB07D0D8A70B.quest_desc: [
		"Зачем: без формы металл просто растечётся по бассейну."
		"Литейные формы режет пила с фильтром из &eокорённой&r древесины (обычное бревно не подойдёт)."
		"&6Песок для отливки&r (миксер: 2 песка, земля, шарик глины) — ПКМ по форме, уходит 1 шт. Потом залей расплав трубой или носиком."
		"{@pagebreak}"
		"Сколько металла (90 мБ = слиток):"
		"&eдуло&r — 630 мБ (7 слитков)"
		"&eствол&r — 1 080 мБ (12)"
		"&eказённик и конец&r — по 810 мБ (9)"
		"Чугун застывает от 2 минут, крупное — дольше. Формы можно ставить столбиком — отливка выйдет цельной."
	]
	quest.1EEFAB07D0D8A70B.title: "Формы и отливка"
	quest.1F2A1A9AED2364A7.quest_desc: [
		"Мотор ест ток и крутит вал на нужных оборотах — без потерь. Теряет только генератор."
		"&eМотор C&A&r — &616 384 SU&r за &6480 FE/т&r на 256 об/мин (&664 SU&r на об/мин, не меньше &68 FE/т&r)"
		"&eОбыкновенный&r (New Age) — &6512 SU&r, &615 FE/т&r, до 128 об/мин"
		"&eУсиленный&r — &62 048 SU&r, &660 FE/т&r, до 256"
		"&eУкреплённый&r — &68 192 SU&r, &6240 FE/т&r, до 256"
		"{@pagebreak}"
		"Курс у всех один: &61 FE/т ≈ 34 SU&r. Круг «пар → ток → мотор» возвращает КПД генератора: C&A — &690 %&r."
		"Удлинители New Age (×2 и ×8) умножают и силу, и расход."
		"Обороты — прокруткой на моторе. Мотор New Age включают и выключают редстоуном."
		"&7&o— ОТК: «Генератор → мотор → генератор — не вечный двигатель, а обогреватель за счёт компании».&r"
	]
	quest.1F2A1A9AED2364A7.title: "Справка: моторы"
	quest.1F3E4DFE744C723D.quest_desc: [
		"Под землёй лежат &eрудные жилы&r — огромные запасы, которые буровая качает без шахты и кирки."
		"Детектор: око Края, аметист, редстоуновая руда и 2 палки — рецепт в JEI (R). ПКМ по земле — подскажет, есть ли жила рядом."
	]
	quest.1F3E4DFE744C723D.title: "Детектор рудных жил"
	quest.1F93228FE232CC76.quest_desc: [
		"Зачем: для Межпланетного точила, Маяка и лучшей обшивки (+20 теплозащиты)."
		"Вольфрам есть только на Меркурии. Годится и руда, и сырой вольфрам (обычная кирка, буровая установка) — всё идёт в дробилку."
		"Руда с Шёлковым касанием выгоднее: из блока — 2 дроблёных + 50 %, из сырого — 1 + 50 %."
		"{@pagebreak}"
		"Руда или сырой → дробилка → Дроблёный рудный вольфрам → вентилятор над лавой или огнём → слиток. Или промывка → 9 самородков + 75 % кварца."
		"Жилы для буровой установки там тоже есть: сырой вольфрам с неё — туда же, в дробилку."
		"&7&o— ОТК: «Вольфрам тяжёлый. Ракета из вольфрама — тем более».&r"
	]
	quest.1F93228FE232CC76.title: "Вольфрам с Меркурия"
	quest.1FD83CEEED53B59F.quest_desc: [
		"Зачем: видеть, кто тебя ест. Невидимки набегов — «Тень», «Невидимый жнец» — в луче прожектора теряют невидимость и светятся сквозь стены."
		"&eПрожектор&r светит туда, куда ты смотришь при установке: луч &632 блока&r, сквозь стекло, до первого блока."
		"Ключ Create по боку — наклон на ступень (от −45° до +60°, 8 ступеней), по верху — поворот."
		"{@pagebreak}"
		"В луче: невидимки видны и подсвечены, пока в луче, и ещё &65 с&r; фантомы отлетают; под лучом на земле светло — монстры там не появятся."
		"Ток: &6150 FE/т&r с любой стороны, запас 20 000 FE. Без тока или с сигналом редстоуна гаснет — днём гаси датчиком дневного света."
		"Сборка — механические крафтеры: стекло, лампа, 2 латунных листа, 2 электронные лампы, электрическая медь (после 15-й волны)."
		"&7&o— Отдел по работе с ордой: «Невидимость — не повод не платить по счетам. Включите свет».&r"
	]
	quest.1FD83CEEED53B59F.title: "Прожектор: видеть невидимок"
	quest.1FEE1D4A77C9DAFE.quest_desc: [
		"Зачем: точечный удар по врагу издалека — молния в точку взгляда, до 48 блоков."
		"Бьёт в первого врага на луче (или в блок): врагам в радиусе 2,5 — 14 урона магией и поджог на 3 с. Молния «зрелищная»: базу не поджигает, своих не бьёт."
		"Мана 10, перезарядка 1,5 с, прочность 400."
		"Механические крафтеры: ряд «электрическая медь | заряд молнии | электрическая медь», под ним «эссенция | медный стержень | эссенция», внизу по центру ещё медный стержень (пустые клетки — крышки слота)."
		"&7&o— Техника безопасности: молнию направлять от себя. Проверено отделом кадров. Посмертно.&r"
	]
	quest.1FEE1D4A77C9DAFE.title: "Посох молнии"
	quest.200EF6B4A3B73B4B.quest_desc: [
		"Зачем: без ускорителей ракета не оторвётся. Ставятся в самый низ корпуса. В игре — «Rocket Thruster»."
		"&eКамера сгорания&r (миксер или механические крафтеры): 4 титановые пластины + пропеллер + закалённый механизм + отделитель кислорода."
		"&eУскоритель&r: 6 титановых пластин + пропеллер + камера сгорания."
		"{@pagebreak}"
		"&eОтделитель кислорода&r: 3 железные пластины + электронная лампа + 3 жидкостные трубы → 2 шт."
		"Сколько нужно: тяжесть × масса / 500, берётся бо́льшая тяжесть из двух планет. С Земли — 1 ускоритель на ~50 массы."
		"{@pagebreak}"
		"&eМасса&r — по блокам ракеты: обычный блок = 1, железный блок и вольфрамовые листы, обшивка = 5, вольфрамовый и золотой блок = 10. Топливо и груз не весят."
		"&7&o— Если ракета не взлетела — это не провал, это очень короткий полёт.&r"
	]
	quest.200EF6B4A3B73B4B.title: "Ракетный ускоритель"
	quest.2022B22D15FA1B25.quest_desc: [
		"Зачем: на входе в атмосферу ракета греется. Мало теплозащиты — старт запрещён (строка Heat Shielding в станции красная)."
		"Норма — у каждой планеты своя, берётся бо́льшая из старта и цели. Земля: &e100 + 0,4 за каждый блок ракеты&r. Нормы планет — в справках."
		"{@pagebreak}"
		"Защита за полный блок:"
		"&e+3&r — блок промышленного железа, титановые обшивка, листы, колонна; железный блок (весит ×5)."
		"&e+8&r — то же из марсианской стали."
		"&e+20&r — вольфрамовые блок, листы, обшивка, колонна (тяжёлые)."
		"{@pagebreak}"
		"Пример: 2 ускорителя, 2 бака, сиденье, контроллер, станция + 48 блоков промышленного железа = 55 блоков. Норма 122, защита 144 — летит."
		"Дешевле всего промышленное железо: пила режет 1 железный слиток в 2 блока."
		"Полный список — JEI, категория Heat Shielding."
		"&7&o— Техника безопасности: обшивку ставят снаружи. Изнутри она защищает только от оптимизма.&r"
	]
	quest.2022B22D15FA1B25.title: "Корпус и теплозащита"
	quest.206F6135673F26E9.quest_desc: [
		"Зачем: без полного комплекта в вакууме теряешь сердце в секунду («forgot their spacesuit»)."
		"Миксер или механические крафтеры:"
		"&eШлем&r: железный шлем + 5 тонированного стекла + 3 железные пластины."
		"&eНагрудник&r: железный нагрудник + медный баллон Create + 3 прочной ткани + 4 железные пластины."
		"&eПоножи, ботинки&r: железные + 4 прочной ткани + 4 железные пластины."
		"{@pagebreak}"
		"&eПрочная ткань&r: 4 нитки + 2 шерсти."
		"Воздух — в нагруднике: 1800 мБ, расход 1 мБ в секунду, то есть полчаса."
		"Холод ниже −32 °C железный скафандр держит. Жара выше 300 °C (Венера, день на Меркурии) — только скафандр из марсианской стали."
		"Шлемы и нагрудники обоих скафандров собираются с &eфильтром воздуха&r (форпост «Торфяник», глава «Сеть форпостов»)."
		"&7&o— Отдел кадров: скафандр — не дресс-код, а условие выживания. Хотя и дресс-код тоже.&r"
	]
	quest.206F6135673F26E9.title: "Скафандр: все 4 части"
	quest.20DE064F242F4E1A.quest_desc: [
		"Зачем: отлитые ствол и дуло — сплошные болванки."
		"&6Пушечная дрель&r (миксер: железный слиток, андезитовый корпус, 2 трубы, шток поршня). В её бак — вода, до 1 000 мБ."
		"Заготовку крутит механический подшипник, дрель — не медленнее него. Нагрузка дрели — 8 SU на 1 об/мин."
		"Конец пушки отливается сразу готовым."
		"{@pagebreak}"
		"Отдельные блоки соединяет &6сварочный аппарат&r (латунные и железная пластины, вентиль, горелка), но шов отнимает у чугуна 1 заряд. Выгоднее лить цельную пушку."
	]
	quest.20DE064F242F4E1A.title: "Сверление"
	quest.20E4E214449B4273.quest_desc: [
		"Нашествие (8–13): зомби в кольчуге с мечами, ведьмы, поборники, разбойники, утопленники с трезубцами. Вожак орды — 140 HP, алмазный меч."
		"Ведьм и поборников снимайте первыми. Провал с 8-й волны стоит &c3 сердца&r."
		"&7&oВедьма в орде — как бухгалтер на стройке: сама не бьёт, но всем от неё хуже.&r"
	]
	quest.20E4E214449B4273.title: "Волна 10: Нашествие"
	quest.21172F3016C5CB6F.quest_desc: [
		"Голод бьёт не только по сердечкам: при 4 окорочках и меньше &cрассудок тает&r на 0,2 в секунду. Сытный обед, наоборот, лечит голову."
		"Руками тут не крафтят, но &aжарить можно&r: печь, коптильня и костёр еду готовят (руду — нет)."
		"Хлеб из ящика кончится быстро. Ниже — как больше не думать о еде."
		"{@pagebreak}"
		"Три дорожки: &eверхняя&r — грядка, &eсредняя&r — кухня, &eнижняя&r — хлеб, мясо, яйца и рыба без рук. В конце — бургер."
		"&7&o— Столовая Axiomativ: «Обед строго по расписанию. Расписание — когда орда ушла».&r"
	]
	quest.21172F3016C5CB6F.title: "Столовая открыта"
	quest.218DDF47E1508988.quest_desc: [
		"Зачем: станция — точка сети, место сборки и разборки поезда."
		"Миксер: железнодорожный корпус + компас → &e2 станции&r. Компас — 4 железа + редстоун (миксер)."
		"Ставь вплотную к рельсам."
	]
	quest.218DDF47E1508988.title: "Железнодорожная станция"
	quest.22689166CC61803D.quest_desc: [
		"Зачем: из жидкого металла льют стволы."
		"Чугунный слиток — пресс над нагретым бассейном: железный слиток + уголь."
		"Плавка: &6крышка для плавки&r (4 андезитовых сплава) на бассейн с горелкой снизу. Слиток — 90 мБ за 9 с, блок — 810 мБ."
		"Чугун — самый дешёвый металл для пушки: держит 2 заряда пороха. Начинай с него."
		"&7&o— ОТК: «Пушка без пороха — это памятник. Памятники орду не останавливают».&r"
	]
	quest.22689166CC61803D.title: "Чугун и плавка"
	quest.2314D43D50466F2B.quest_desc: [
		"Металл задаёт силу голема, поэтому голую часть «одевают» на &6линии сборки&r (последовательная сборка Create)."
		"Обычный цикл: &eдеплоер&r кладёт слиток → &eпресс&r бьёт 3 раза. Для космических металлов в цикле ещё точные механизмы и ключ."
		"{@pagebreak}"
		"Циклов на часть: металлический — 9, человекоподобный — 6, пёс — тело 6, ноги 3."
		"Слитков на голема: металлический — 36, человекоподобный — 18, пёс — 9."
		"Точный цикл для своего металла — в JEI (R по части). Части можно делать из разных металлов."
	]
	quest.2314D43D50466F2B.title: "Часть из металла"
	quest.2318D7EFDBE50618.quest_desc: [
		"Гелий — &eоболочки аэростатов&r Aeronautics, &eлевитит&r и &eдирижабль&r Immersive Aircraft (грузовой и боевой собираются из него)."
		"&eГде:&r горы, на высоте от 180. Примета — голубой лёд на вершине, вокруг облачка."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на гелиевый лёд, по бокам пусто (воздух) → &6гелиевый иней&r."
		"Миксер с нагревом → 250 мБ &6гелия&r. Заправщик в железный лист → &6баллон гелия&r."
		"&eОболочка:&r деплоер с баллоном над шерстью любого цвета → 4 оболочки. &eЛевитит:&r 4 эндерняковой пыли + 2 цинковых самородка + 500 мБ гелия, нагрев. &eДирижабль:&r 2 баллона в рецепте."
		"&7&o— Техника безопасности: гелий не вдыхать. Голос станет смешным, а приказы бригадира — нет.&r"
	]
	quest.2318D7EFDBE50618.title: "Высотный конденсатор"
	quest.23790F79B2B609BB.quest_desc: [
		"Три задания на команду — строка &eКонтракты бригадира&r в меню алтаря (или &e/nscontracts&r). Наведи — цель и награда."
		"Виды: убить N мобов вида X в набегах, пройти волну, пройти волну &cбез единой смерти&r, пройти волну &cс условием смены&r, завалить босса, победить на арене в теме."
		"{@pagebreak}"
		"Награда — &aкаждому в сети&r: артефакт смены наверняка (как с волны на 5–10 выше вашей лучшей), ресурсы, за трудные контракты с 30-й — &5Сердце ночи&r, за условия с 70-й — звёздный осколок."
		"Выполненный меняется на новый с рассветом, висящий дольше 3 игровых дней — тоже. Цели растут вместе с вашей лучшей волной."
		"&7&o— Бригадир: «Работа не волк. Волк — это вон тот, с тремя головами. Иди работай».&r"
	]
	quest.23790F79B2B609BB.title: "Контракты бригадира"
	quest.23C6E8B8A1FF42FB.quest_desc: [
		"Зачем: пушка на креплении поворачивается валами и стреляет по редстоуну."
		"&6Крепление пушки&r — механические крафтеры: 2 железные пластины, 4 вала, андезитовый корпус, 2 оружейного пороха. Сигнал в грань с молотом собирает пушку, в грань с огнём — стреляет."
		"{@pagebreak}"
		"Заряжать — разобранную: &6пушечный заряжатель&r с толкающей головкой толкает порох и снаряд по оси, как поршень. Руками — &6толкатель снарядов&r (до 3 блоков, тратит сытость)."
		"Застрял снаряд — &6банник&r вытаскивает его."
		"&7&oЛучшее место для пушки — там, где её ствол смотрит не на вас.&r"
	]
	quest.23C6E8B8A1FF42FB.title: "Крепление и выстрел"
	quest.2436DCEE675739AA.quest_desc: [
		"Ток (FE) — не новый источник, а переделка вращения: генератор ест SU и отдаёт FE."
		"Цепочка пака:"
		"1) заряд молнии — 15-я волна;"
		"2) деплоер с зарядом бьёт по меди;"
		"3) электрическая медь → генератор."
		"Без заряда молнии не собрать ни одного генератора."
		"{@pagebreak}"
		"&eКакой генератор:&r"
		"C&A — один блок, &690 %&r, проще всех;"
		"катушки New Age — с магнитами, &633–92 %&r;"
		"TFMG — своя сеть с вольтами."
		"Справа — справки: магниты, моторы, хранение, зарядка, провода."
		"&7&o— Юротдел: «Молния, ударившая в медь по приказу деплоера, — производственная, а не стихийная».&r"
	]
	quest.2436DCEE675739AA.title: "4 · Ток"
	quest.24B6DBCED47E2AC6.quest_desc: [
		"Зачем: из него — станции и контроллер поезда."
		"&6Прочный лист&r (обсидиан колёсами → порошок → последовательная сборка, рецепт — R) кликни на латунный корпус руками или активатором."
	]
	quest.24B6DBCED47E2AC6.title: "Железнодорожный корпус"
	quest.2521B5D333C76592.quest_desc: [
		"Любая еда: &a+0,8 рассудка&r за каждые пол-окорочка, полный бонус — раз в 5 минут. Чем сытнее блюдо, тем лучше для головы."
		"Лечат сверху (общий откат ~13 мин):"
		"&6Мёд&r +6, &6золотая морковь&r +7, &6золотое яблоко&r +8, &6зачарованное&r +13."
		"{@pagebreak}"
		"Золотая морковь — миксер: морковь + 8 золотых самородков. Золотое яблоко — яблоко + 8 золотых слитков."
		"&cВредно для головы:&r гнилая плоть, паучий глаз, ядовитый картофель, иглобрюх — −5; хорус −3."
		"Успокоительное (+25 %) — глава «Ночная смена»."
	]
	quest.2521B5D333C76592.title: "Справка: еда и рассудок"
	quest.253E58BB36CEEECF.quest_desc: [
		"Зачем: чтобы машина брала только нужное и не путала цинк с медью."
		"Миксер: 2 железных самородка + шерсть."
		"Вставь в слот фильтра шлюза, активатора, руки или пилы (ПКМ). Внутри фильтра — список разрешённых предметов."
		"Правило: где машина может взять не то — туда фильтр."
		"&7&o— Отдел кадров: фильтр — единственный в Axiomativ, кто умеет вежливо отказывать.&r"
	]
	quest.253E58BB36CEEECF.title: "Фильтр предметов"
	quest.25D36F30E4AC8C69.quest_desc: [
		"Когда пропеллеров мало — реактивная тяга Create Propulsion. Работает по редстоун-сигналу, топливо подаётся сзади."
		"&6Твердотопливный&r — жжёт предметы из сундука за собой (ключом открыть люк). Миксер: 3 железных листа, 2 медных, 2 андезитовых сплава, желоб, труба."
		"{@pagebreak}"
		"&6Жидкостный&r — жидкое топливо по трубам в тыл. Скипидар: ель в дробилку → смола, смола + вода в миксере. Подходит ли другое — Shift на жидкости в JEI."
		"Можно собрать блок 2×2×2 или 3×3×3 из двигателей — топливо тогда ТОЛЬКО с тыла."
	]
	quest.25D36F30E4AC8C69.title: "Реактивный двигатель"
	quest.25D6A5CCAB623FD8.quest_desc: [
		"Дешёвый и без стали: 2 поршня, огниво, блок латуни, 2 плиты полированного чернокамня, бак Create."
		"Ест дизель, бензин, биодизель, этанол и растительное масло — расход одинаковый, мощность разная (см. «Сколько даёт двигатель»)."
		"Дальше — модульный (блоки в линию до 21, SU складываются) и огромный; обоим нужен &eрадиатор с хладагентом&r (форпост «Ледник»). Турбокомпрессор удваивает и обороты, и SU."
		"{@pagebreak}"
		"&7&o— Отдел кадров: «Дизель не спит, не ест и не просит отпуск. Идеальный сотрудник, если не считать выхлопа».&r"
	]
	quest.25D6A5CCAB623FD8.title: "Дизельный двигатель"
	quest.25FE55697EDE4ECC.quest_desc: [
		"Магнетит — в &eмагниты New Age&r (катушки динамо), &eмоторы&r (New Age, электромотор C&A), &eкатушки тесла-башни&r и подшипник радара. Руда магнетита больше не генерируется."
		"&eГде:&r горы, на высоте от 120. Примета — фиолетовый камень, вокруг искры портала."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на аномалию, сбоку лава и блок железа (не тратится) → &6сырой магнетит&r."
		"Дробилка → &62&r магнетитового порошка. Пресс над бассейном: 4 порошка → блок магнетита (магнит силы 1 и деталь простого мотора)."
		"Старые блоки магнетита из шахт дробятся в порошок."
		"{@pagebreak}"
		"&eТеперь с магнетитом:&r редстоун-магнит, высоко-активный, незеритовый, продвинутый и укреплённый моторы, электромотор C&A, катушка тесла-башни (шаг деплоера), подшипник радара. Рецепты — в JEI (R)."
		"&7&oКомпас на аномалии сходит с ума. Как и бухгалтер, увидевший смету на магниты.&r"
	]
	quest.25FE55697EDE4ECC.title: "Магнитная аномалия"
	quest.26583EE3D60C0310.quest_desc: [
		"Без воды котёл стоит: каждый уровень пьёт &610 мБ/т&r."
		"Помпа (шестерня + труба) качает &6об/мин ÷ 2&r мБ/т: на &6256 об/мин&r — &6128 мБ/т&r, это &612&r уровней. Котлу 18 — две помпы."
		"Труба открытым концом в бассейн 2×2 — вода не кончается. Другой конец — в любую стенку бака."
		"&7&oКотёл без воды — дорогая печка. Котёл без воды на тортах — дорогая печка с претензией.&r"
	]
	quest.26583EE3D60C0310.title: "Вода для котла"
	quest.265D285BE690A008.quest_desc: [
		"Здоровье самой толстой подволны на одного игрока (вдвоём — ×1,5):"
		"&eДо 49-й&r — до ~1 000 HP: мечи, луки, стены."
		"&e50-я&r ~2 100, &e69-я&r ~8 700: мобов в 1,5→2,5 раза больше, здоровье +50%→+300%."
		"&e70-я&r ~19 000, &e80-я&r ~38 000, &e100-я&r ~95 000: мобов ×3 и больше, здоровье +400% и растёт, сами крупнее (×1,2 → ×1,6)."
		"{@pagebreak}"
		"С 16-й — мобы модов (ArPhEx, Northstar, Cataclysm), с 70-й — ещё и отдельные подволны Cataclysm: драугры, пылающие берсерки, глубинники, коралловые големы."
		"Живых мобов набега одновременно не больше 120 — остальные ждут очереди."
		"Итог: с 50-й держат не руки, а завод — главы «Башенная оборона», «Пушки и оборона», «Големы»."
	]
	quest.265D285BE690A008.title: "Шкала угрозы"
	quest.26B7189575B37E49.quest_desc: [
		"Зачем: ускорить рудную породу вдвое, а потом вчетверо."
		"&e9 дроблёных руд&r прессом над чашей → &6груда&r. Под экструдер вместо булыжника: 2 удара на блок вместо 4. Железу — груда железа, меди — медная и т. д."
		"Потолок — &6блок сырой руды&r снизу: 1 удар, но только в латунном экструдере."
		"&7&oКатализатор не тратится. Единственный сотрудник Axiomativ, которого не выжали.&r"
	]
	quest.26B7189575B37E49.title: "Катализатор: груда руды"
	quest.26D4945737F6CCB3.quest_desc: [
		"Зачем: заклинания бьют и лечат издалека, когда меч уже не дотягивается, а пушки ещё не построены."
		"Магия — мод &6Iron's Spells 'n Spellbooks&r. Путь: эссенция → книга заклинаний → свитки → начертательный стол → кузница свитков → волшебная наковальня."
		"Станции мода (начертательный стол, кузница свитков, волшебная наковальня, алхимический котёл) работают руками: это не верстаки. А вот сами станции, книги и броню собирают &6механические крафтеры&r, бесформенное — миксер."
		"Свитки, чернила, эссенция и сферы выпадают в &6добыче набегов&r — с 1-й волны."
		"&7&o— Служебная записка: «Магия на вахте разрешена. Руками — только колдовать».&r"
	]
	quest.26D4945737F6CCB3.title: "Магия на вахте"
	quest.27494CDCCB4DCF99.quest_desc: [
		"До 49-й волны хватает мечей, луков и стен. Дальше волны рассчитаны на промышленную оборону:"
		"&e50–69&r: мобов ×1,5 → ×2,5, живучесть +50 % → +300 %."
		"&e70+&r: мобов ×3 (к 100-й ×6), живучесть +400 % и растёт; мобы крупнее — выше 2 блоков, грызут и третий блок стены. В подволнах — мобы Cataclysm."
		"{@pagebreak}"
		"Подволна 70-й — &e~19 тыс. HP&r, 100-й — &e~95 тыс.&r"
		"20 продвинутых турелей (≈800 урона/с) снимают подволну 70-й за полминуты, 100-й — за пару минут."
		"Боссы Cataclysm: не больше 20–25 урона за удар и 12–20 в секунду — хоть сто турелей. Держи их подальше от алтаря: коридор, стены, големы."
		"{@pagebreak}"
		"Последние доводы — генератор щита (купол на 24 блока) и тактический ядерный заряд. Их квесты — в главе «Алтарь и набеги»."
	]
	quest.27494CDCCB4DCF99.title: "Справка: волны 50–100"
	quest.275FE568C2DBF365.quest_desc: ["Самолёту нужны алюминиевый корпус и пропеллер, кабине — кварцевое стекло, дирижаблю и аэростату — гелий. Три форпоста — и небо твоё."]
	quest.275FE568C2DBF365.title: "Небо"
	quest.278E718C3770929D.quest_desc: [
		"Зачем: сердцевина сфер улучшения и лучшего снаряжения мага."
		"Руда — глубоко, ниже Y −38, и не на открытом воздухе; добывается незеритовой киркой."
		"Печь руду не плавит: рудный мифрил в &6дробилку&r → мифриловый лом (+25 % ещё один). 4 лома квадратом → слиток (пресс над бассейном или крафтеры 2×2)."
	]
	quest.278E718C3770929D.title: "Мифрил"
	quest.27B3F98DBEED2A10.quest_desc: [
		"Зачем: вся орда пойдёт одной дорогой — там её и встречай."
		"Мобы ищут путь к алтарю и идут по нему, пока он есть; грызть начинают, только когда застряли. Оставь один открытый проход — длинный извилистый коридор — и стены вокруг никто не тронет."
		"Решётки вместо стен коридора: видно и можно стрелять, а пройти нельзя."
		"Моб, который заметил игрока, идёт на него, а не по коридору. Стреляй из-за решётки, не выходи."
	]
	quest.27B3F98DBEED2A10.title: "Коридор-ловушка"
	quest.27F7FB8A91EB946D.quest_desc: [
		"Зачем: проверить оборону целиком."
		"Стены ведут орду в коридор, мясорубка перемалывает толпу, турели и пушки добивают, небо над алтарём прикрыто."
		"Отметь, когда целая волна прошла, а ни один моб не подошёл к алтарю ближе 2 блоков."
		"&7&o— Пресс-служба Axiomativ: «Орда прибыла на объект. Объект прибыл на орду».&r"
	]
	quest.27F7FB8A91EB946D.title: "Крепость"
	quest.27FDDAEDB93E2BEF.quest_desc: [
		"Зачем: быстрее копать и сильнее бить, пока горит топливо."
		"&6Андезитовый&r (тепловой двигатель): Спешка II + Слабость, ест топливо."
		"&6Латунный&r (паровой): Спешка + Сила, топливо и воду."
		"&6Медный&r (гидравлический): Сила II + Утомление, только воду."
		"&7&o— Отдел кадров: экзоскелет не заменяет вахтовика. Пока.&r"
	]
	quest.27FDDAEDB93E2BEF.title: "Экзоскелеты"
	quest.2842951F59F2E86D.quest_desc: [
		"Рыбачит, только когда &6едет&r в составе конструкции (тележка, лифт, поршень) по открытой воде — как игрок с удочкой."
		"Крафтеры 2×2: защитная сеть, палки, андезитовый сплав → 2 сети."
		"Лавовая сеть (цепи, стержень блейза) ловит в лаве."
	]
	quest.2842951F59F2E86D.title: "Рыболовная сеть"
	quest.2888590EA4BC7883.quest_desc: [
		"&5Эпические&r артефакты волн (3) — крупные бонусы с ценой: каменное сердце замедляет."
		""
		"&5Каменное сердце&r — +8 к здоровью (4 сердца); +25 % сопротивления отбрасыванию; −5 % скорости. Цена — шаг медленнее: против быстрых волн подумай дважды."
		"&5Чётки дозорного&r — −5 % входящего урона; неуязвимость после удара дольше на 0,6 с (как Крест-ожерелье). Передышка складывается с Оберегом сторожа и Крест-ожерельем."
		"&5Перчатка мясника&r — +2 урона в ближнем бою; вампиризм 10 % нанесённого урона (до 3 HP за удар). Лучше с быстрым оружием: лечение — с каждого удара."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 3 — с волны 15: ≈0,15 % на 15-й, ≈1,7 % на 50-й, ≈4,8 % на 100-й за победу (без первого прохождения)."
		"&7&oЧётки дозорного перебирают не для молитвы, а чтобы считать секунды до следующего удара.&r"
	]
	quest.2888590EA4BC7883.title: "&5Эпические&r артефакты"
	quest.291F7DFD4AC666B2.quest_desc: [
		"Зачем: жечь толпу в коридоре струёй огня."
		"Механические крафтеры: горелка ифрита, желоба, бак, трубы, латунные пластины, андезитовый сплав."
		"Огненные шары по &e2 урона&r ~7 раз в секунду и поджигают. Заправка ПКМ по оружию: горючее (ведро лавы — полный бак) и вода."
		"{@pagebreak}"
		"Визер-скелетам и магмовым кубам огонь нипочём."
		"Огнемёты есть ещё в TFMG и Create Stuff Additions — рецепты в JEI (R)."
	]
	quest.291F7DFD4AC666B2.title: "Всполохомёт"
	quest.2941F343D52B2027.quest_desc: [
		"Хладагент — &eохлаждение реактора&r New Age (теплоотвод, стержни) и &eтяжёлые двигатели&r: большой и огромный дизель CDG, большой двигатель TFMG."
		"&eГде:&r ледяные биомы — ледяные шипы, морозные пики, мёрзлые биомы Terralith. Примета — сине-белая мёрзлая земля в снежинках."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на мерзлоту, сбоку плотный лёд и вода → &6криокристалл&r."
		"Миксер: криокристалл + 250 мБ воды → &6500 мБ хладагента&r."
		"Заправщик в медный лист (250 мБ) → &6радиатор&r. Теплоотвод реактора — миксер: 2 корпуса + 2 трубы + 500 мБ хладагента."
	]
	quest.2941F343D52B2027.title: "Ледник"
	quest.29FD0B60775645E1.quest_desc: [
		"Зачем: броне — новые свойства, а вещь остаётся той же: чары, прочность и имя сохраняются."
		"Модуль ставят &6механические крафтеры&r: модуль + вещь своего слота рядом, раскладка любая. На вещь — по одному модулю каждого типа: второй такой же крафтеры не примут и ничего не съедят."
		"Первый — &eПружинные ботинки&r: урон от падения 0. Сборка по шагам: латунный лист → деплоер с блоком слизи → деплоер с железным листом → пресс, два круга."
		"{@pagebreak}"
		"Что стоит на вещи — видно в подсказке: строка «Модули: …», прибавки — в обычных строках атрибутов брони."
		"&7&o— Техника безопасности: прыгать с крыши разрешено. Приземляться на коллег — нет.&r"
	]
	quest.29FD0B60775645E1.title: "Модули брони"
	quest.29FF03022EEE798D.quest_desc: [
		"Свисток зовёт дракона к тебе даже из другого мира. Крафтеры: железо по углам, доски по бокам, краситель в центре."
		"&6Shift + ПКМ&r свистком по своему дракону — привязать («Свисток привязан: …»)."
		"Позвать: &6зажми ПКМ&r — откроется круговое меню, выбери «Свистнуть» и отпусти. Или клавиша «Позвать дракона»."
		"{@pagebreak}"
		"Привязка хранится у тебя, по &6цвету&r свистка: потерял — сделай новый того же цвета. Разные цвета — разные драконы."
		"Погибший дракон зовётся снова через &e60 с&r (подсказка на свистке)."
	]
	quest.29FF03022EEE798D.title: "Свисток"
	quest.2A1A1E144D91C595.quest_desc: [
		"Сколько зарядов держит ствол:"
		"&eбревно&r — 0 (любой заряд опасен)"
		"&eкованое железо&r — 1"
		"&eчугун&r — 2 (шов −1)"
		"&eбронза&r — 4"
		"&eсталь&r — 8 (шов −2)"
		"&eнезер-сталь&r — 10"
		"Итог — меньшее из ствола и затвора, минус швы."
		"&7&o— Юротдел: «Превышение нормы пороха — не рационализаторство».&r"
	]
	quest.2A1A1E144D91C595.title: "Справка: материалы пушек"
	quest.2A48D211E264865E.quest_desc: [
		"Зачем: без чернил кузница свитков стоит."
		"&6Обычные&r — миксер: чернильный мешок + эссенция + пузырёк."
		"Выше — тоже миксер: 4 пузырька чернил + металл → 1 пузырёк следующей редкости (+3 пустых): обычные + медь → &eнеобычные&r, + железо → &eредкие&r, + золото → &eэпические&r, + аметист → &eлегендарные&r."
		"Или алхимический котёл — тот же рецепт жидкостью: 1000 мБ чернил + металл → 250 мБ следующих."
		"&7&oЛегендарные чернила: четыре пузырька эпических, один аметист и вера в светлое будущее.&r"
	]
	quest.2A48D211E264865E.title: "Чернила"
	quest.2B29212FBD9DC938.quest_desc: [
		"Зачем: мозг Ракетной станции; ещё нужен Межпланетному навигатору и Маяку."
		"Последовательная сборка из железной пластины, 2 круга: полированный алмаз → закалённый механизм → гравирование → схема → &eзвёздная карта&r (форпост «Обсерватория») → гравирование."
		"На один компьютер: 2 алмаза, 2 закалённых механизма, 2 схемы, 2 звёздные карты. Алмаз полирует деплоер с наждачкой."
		"{@pagebreak}"
		"Лишние компьютеры — в &6Стойку с компьютерами&r на борту: каждый срезает ~0,8% топлива, максимум −40% при 48 штуках."
		"Стойка — механические крафтеры: 6 андезитового сплава + 3 железные пластины → 2 стойки."
	]
	quest.2B29212FBD9DC938.title: "Навигационный компьютер"
	quest.2B3AF03BB3F2FDE0.quest_desc: [
		"Сундук + аметист + карта + книга с пером — записная книжка будущей шахты."
		"Хранит, где какая жила и сколько в ней (бесконечные помечены «∞»). По атласу буровой выбирают, что качать."
		"Работающую буровую тоже можно «опросить»: ПКМ атласом по ней."
	]
	quest.2B3AF03BB3F2FDE0.title: "Атлас рудных жил"
	quest.2B3F74E1D633B85A.quest_desc: [
		"Зачем: мобы по графику — кожа, нить, порох, кость без охоты."
		"Механическая сборка 5×5 (25 сборщиков): латунь, латунные листы, железные решётки, изумруд, вал."
		"Нужно &e≥ 100 об/мин&r и жидкость призыва сбоку: 100 мБ на моба."
		"&cБез сборщика добычи&r рассадник выпускает живых мобов. Криперов тоже. Прямо на базе."
		"&7&o— Отдел по работе с ордой: наконец-то орда, которая приходит по расписанию.&r"
	]
	quest.2B3F74E1D633B85A.title: "Механический рассадник"
	quest.2B67A130566B547B.quest_desc: [
		"Зачем: каждая катушка сверху — дальше, больнее и длиннее цепь. До &64&r в высоту; кольцо одно на катушку — видно, сколько стоит."
		"Сборка по шагам на конвейере: &eмедный корпус&r → деплоер с &eмедной катушкой C&A&r → деплоер с &eэлектрической медью&r → деплоер с &eмагнетитовым порошком&r (форпост «Магнитная аномалия») → пресс, &62 круга&r."
		"{@pagebreak}"
		"Катушек — дальность / урон / перескоков / FE за выстрел с полной цепью:"
		"&e0&r — 8 / 6 / 1 / &62 500&r"
		"&e1&r — 12 / 8 / 2 / &63 000&r"
		"&e2&r — 16 / 10 / 3 / &63 500&r"
		"&e3&r — 20 / 12 / 4 / &64 000&r"
		"&e4&r — 24 / 14 / 5 / &64 500&r"
		"Пять перескоков — шесть целей за выстрел: до &684 урона в секунду&r по толпе."
		"{@pagebreak}"
		"В бою без передышки башня с полной цепью ест &6125–225 FE/т&r. Генератор C&A на 256 об/мин даёт &6432 FE/т&r — хватит на две башни с 4 катушками или на три без катушек."
		"Между волнами башня не тратит ничего. Полный запас — &611 залпов&r с полной цепью, даже если провод перебили."
	]
	quest.2B67A130566B547B.title: "Катушки: растим башню"
	quest.2B93C5ECE763DE47.quest_desc: [
		"На глубине давление: у каждого блока свой предел, дальше трескается и схлопывается. Обычное стекло сдаётся первым."
		"&6Прочное стекло&r (миксер): 8 стёкол + промышленный железный блок; медное — медный блок вместо железа."
		"{@pagebreak}"
		"&6Барометр&r показывает давление и глубину: 5 прочных стёкол, ведро воды, 3 промышленных железных блока."
		"&7&o— Техника безопасности: иллюминатор из обычного стекла — отличный способ быстро узнать, какая тут глубина.&r"
	]
	quest.2B93C5ECE763DE47.title: "Прочное стекло"
	quest.2BB90C762D8DE0FB.quest_desc: [
		"Компоновка снизу вверх, как в пондере станции:"
		"&e1.&r Ускорители — в самый низ."
		"&e2.&r Над ними — жидкостные баки с топливом."
		"&e3.&r Сундук или бочка под груз — по желанию."
		"&e4.&r Сиденье Create, Контроллер, Ракетная станция; для планет — Межпланетный навигатор."
		"&e5.&r Металлическая обшивка — где угодно."
		"{@pagebreak}"
		"&e6.&r Склей всё &6Суперклеем&r одной областью. Без клея станция пишет «No rocket controls attached»."
		"&e7.&r Атлас — в слот станции. Выбери планету («Поверхность»), точку «Hold position» (те же X/Z) и нажми «Save destination»."
		"&e8.&r Fuel, Thrusters, Heat Shielding, Navigator должны быть в норме."
		"&e9.&r «Собрать Ракету» — блоки станут одной ракетой."
		"{@pagebreak}"
		"Забыл что-то — «Disassemble Rocket», дострой и собери снова."
		"{\"text\":\"▶ Northstar Redux на Modrinth\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://modrinth.com/mod/northstar-redux\"}}"
		"&7&o— Служебная записка ОТК: «Ракета без суперклея — это салют».&r"
	]
	quest.2BB90C762D8DE0FB.title: "&6Сборка ракеты: по шагам&r"
	quest.2BC1B58A4F6EE6D5.quest_desc: ["Сера — для оружейного пороха и вулканизации резины. Резина — изоляция всех проводов. Начни с Серного источника: без серы нет и резины."]
	quest.2BC1B58A4F6EE6D5.title: "Порох и резина"
	quest.2C06507CCB856B9D.quest_desc: [
		"Зачем: первая броня мага — добавляет ману."
		"Кожаная вещь + эссенция волшебства → миксер (бесформенный рецепт). Так же шлем, поножи и сапоги."
		"Кожу на вахте дубит миксер с нагревом: 3 гнилой плоти + вода."
	]
	quest.2C06507CCB856B9D.title: "Мантия странствующего мага"
	quest.2C866220A120C30C.quest_desc: [
		"&eCreate: Diesel Generators&r — простая перегонка: контроллер из 2 андезитовых сплавов, железной пластины, 2 труб и часов (4 штуки за раз)."
		"Колонна высотой от 3 блоков, снизу — горелка. 100 мБ нефти → &a50 дизеля + 50 бензина&r (перегрев — 75 + 75). Сборка — в Ponder (W на предмете)."
		"Своих залежей у CDG тут нет: нефть одна, от качалки TFMG. Колонна CDG её принимает, а башня TFMG чужую нефть не берёт."
	]
	quest.2C866220A120C30C.title: "Второй путь: колонна CDG"
	quest.2CC8CCC2EDA2288D.quest_desc: [
		"Подлодка тонет и всплывает балластом: цистерна набирает воду — вниз, откачивает — вверх (Create Deep Seas)."
		"Крафтеры 3×3 (или миксер): андезитовый сплав по углам, железные листы по бокам, жидкостный бак в центре."
		"Одна цистерна тянет около 75 блоков корпуса — тяжёлой лодке нужно несколько."
	]
	quest.2CC8CCC2EDA2288D.title: "Балластная цистерна"
	quest.2CE5CDB303BB7864.quest_desc: [
		"Веха: &4Древний реликт&r и два &6Уаджета&r. Реликт огромный — застревает в узких коридорах, песчаные бури мешают целиться."
		"Маледиктус и Предвестник &eлетают&r: наземные ловушки бесполезны, нужны купол и зенитки."
		"&6Первое прохождение&r: сильный артефакт и &5Сердце ночи&r."
		"&7&o— Пресс-служба: «До конца смены десять волн. Или десять некрологов — как пойдёт».&r"
	]
	quest.2CE5CDB303BB7864.title: "Волна 90: почти конец"
	quest.2D977C8542ABDF12.quest_desc: [
		"&aРедкие&r артефакты волн (3) — ощутимо: срез урона, длиннее передышка после удара."
		""
		"&aСтальная пряжка&r — +6 к здоровью (3 сердца); +10 % сопротивления отбрасыванию. Первый шаг к «плотному» билду."
		"&aНашивка ОТК&r — −5 % входящего урона. Срез считается до брони и складывается с «Защитой» и энергощитом."
		"&aОберег сторожа&r — +1 брони; неуязвимость после удара дольше на 0,3 с (как Крест-ожерелье). Удар в передышку проходит только разницей с прошлым — толпа бьёт реже."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 3 — с волны 1: ≈0,59 % на 1-й, ≈1,5 % на 15-й, ≈2,8 % на 50-й, ≈2,4 % на 100-й за победу (без первого прохождения)."
		"&7&o— ОТК: «Нашивку получает тот, кто прошёл проверку. Проверка — пережить волну».&r"
	]
	quest.2D977C8542ABDF12.title: "&aРедкие&r артефакты"
	quest.2DC6D6DFEA84D5FC.quest_desc: [
		"Зачем: бесконечный камень без кирки — сырьё для металла, стекла и стройки."
		"Миксер: &e3 стекла + андезитовый корпус + вал&r."
		"По бокам — вода и лава, &6под экструдером — блок нужной породы&r: булыжник даёт булыжник, гранит — гранит; так же андезит, диорит, туф. Нижний блок не тратится."
		"{@pagebreak}"
		"Скорость: на 32 об/мин — блок за 2,5 с, на 256 — за 0,35 с."
		"Булыжник → жернов → гравий → промывка: железо. Гранит → красный песок: медь. Диорит → колёса: 25 % цинка + кварц."
		"Обсидиан — при скорости не выше 4 об/мин (фильтр экструдера — «обсидиан»)."
	]
	quest.2DC6D6DFEA84D5FC.title: "Экструдер: своя порода"
	quest.2DDBA2AB73BF01A6.quest_desc: [
		"Зачем: JEI отвечает на «из чего это и куда это» быстрее любого бригадира."
		"Наведи на предмет: &6R&r — его рецепты, &6U&r — где он нужен. Поиск — строка внизу экрана."
		"Вкладка над рецептом = машина, которая его делает."
		"{@pagebreak}"
		"Вкладка «Создание» (&6мёртвый верстак&r) — не приговор. Её рецепты делают машины:"
		"&eфигурные&r — механические сборщики;"
		"&eбесформенные&r — миксер над чашей;"
		"&eквадрат 2×2 / 3×3 из одного&r — пресс над чашей;"
		"&eступеньки, плиты, двери&r — пила."
		"&7&oВерстак не умер. Он ушёл на удалёнку и не отвечает на звонки.&r"
	]
	quest.2DDBA2AB73BF01A6.title: "JEI: R и U"
	quest.2E084D0D4BD44A58.quest_desc: [
		"Огнеупорная глина лежит жилами под землёй. Обожги её шарики в печи — выйдут огнеупорные кирпичи; 4 кирпича → блок &6огнеупорного кирпича&r."
		"Только из этих блоков строятся стены домны и воздухонагреватели."
	]
	quest.2E084D0D4BD44A58.title: "Огнеупорный кирпич"
	quest.2E0A18A49AA1C801.quest_desc: [
		"&6Физический подшипник&r поворачивает прикреплённую часть, &6штурвал&r крутит его рукой: зажми ПКМ и веди мышью."
		"Подшипник: плита, промышленный железный блок, шестерня (столбиком). Штурвал: большая шестерня, андезитовый корпус, вал."
		"{@pagebreak}"
		"&cТонкость:&r в панели подшипника проверь режим блокировки редстоуном — иначе поворот «отпускает», когда не нужно."
		"&7&o— ОТК: «Самолёт без руля — это не самолёт, а очень дорогая стрела».&r"
	]
	quest.2E0A18A49AA1C801.title: "Руль: штурвал и подшипник"
	quest.2E2B96F9D175D3DE.quest_desc: [
		"Зачем: жжёт толпу на расстоянии и отталкивает её."
		"Поставь лаву (или огонь) перед вентилятором — поток за ней поджигает мобов:"
		"&eсквозь лаву&r — 4 урона и огонь на 10 с"
		"&eсквозь огонь&r — 2 урона и огонь на 2 с"
		"Поток тянется до 20 блоков на 256 об/мин и толкает мобов — можно сдувать орду на пилы."
		"Визер-скелетам и магмовым кубам огонь нипочём."
	]
	quest.2E2B96F9D175D3DE.title: "Вентилятор с лавой"
	quest.2E4CBB3E62737A6D.quest_desc: [
		"Зачем: без затвора пушку не зарядить."
		"Казённик отливается и сверлится, как дуло. В него вставляют &6выдвижной затвор&r (3 чугунных слитка + 2 шестерни) — руками или деплойером."
		"Затвор тоже ограничивает заряд: выдвижной чугунный — 2, бронзовый и стальной — 4, винтовой стальной — 8."
		"&6Скорострельный механизм&r в выдвижном затворе — перезарядка механической рукой, без разборки пушки (лимит — 2 заряда)."
	]
	quest.2E4CBB3E62737A6D.title: "Казённик и затвор"
	quest.2EA5301A0872E5B3.quest_desc: [
		"Одна катушка, 12 магнитов: сила, FE/т на 64 / 256 об/мин, КПД."
		"&eМагнетитовый железняк&r (1) — &622 / 90&r, &633 %&r"
		"&eРедстоун-магнит&r (2) — &645 / 180&r, &650 %&r"
		"&eВысоко-активный&r (4) — &690 / 360&r, &667 %&r"
		"&eОбогащённый железняк&r (8) — &6180 / 720&r, &680 %&r"
		"&eНезеритовый магнит&r (24) — &6540 / 2 160&r, &692 %&r"
		"Якорь возрождения — тоже магнит, сила 4."
		"{@pagebreak}"
		"&eГде взять:&r"
		"железняк — пресс над бассейном: 4 магнетитовых порошка → блок (форпост «Магнитная аномалия»; руда больше не генерируется);"
		"редстоун-магнит — крафтеры: блок редстоуна + 4 железных самородка + 4 магнетитового порошка → 2;"
		"высоко-активный — крафтеры: 3 заряж. золота + 4 заряж. железа + 2 магнетитового порошка → 4;"
		"обогащённый — миксер: 4 железняка + заряж. алмаз + 4 заряж. золота → 2;"
		"незеритовый — крафтеры: 4 заряж. алмаза + блок магнетита + 4 незеритовых обломка → 2."
		"{@pagebreak}"
		"&eПуть:&r редстоун-магниты → первый ток → электризатор → высоко-активные → обогащённые."
		"Паровой двигатель через катушки даёт &6160 / 240 / 320 / 384 / 443 FE/т&r (по строкам таблицы). Генератор C&A — &6432&r."
		"Незерит почти не лучше обогащённого по КПД, зато катушек втрое меньше."
		"&7&oЖелезняк миллионы лет лежал в земле и ждал именно тебя. Не подведи.&r"
	]
	quest.2EA5301A0872E5B3.title: "Справка: магниты"
	quest.2ECBF16F87D4CAC1.quest_desc: [
		"Ключ ко всему току: без него нет электрической меди, а значит — ни одного генератора."
		"Выдаётся за &eпервое&r прохождение &e15-й волны&r — каждому защитнику."
		"Не расходуется. Ещё можно купить на столе трансмутации за &68 192 EMC&r, если стол его уже знает."
		"&7&oГром — это аплодисменты орды за 15-ю волну. Больше она хлопать не будет.&r"
	]
	quest.2ECBF16F87D4CAC1.title: "Заряд молнии"
	quest.2F27FD3FABF74065.quest_desc: [
		"Зачем: Ponder показывает, куда ставить блок и что ему нужно для запуска, — вместо угадывания."
		"Наведи на блок Create (в инвентаре или в JEI) и держи &6W&r — запустится сценка с подписями."
		"Особенно выручает со сборщиками, дробильными колёсами, вентилятором и поездами."
	]
	quest.2F27FD3FABF74065.title: "Ponder: механика в картинках"
	quest.2FBF34DA191F4F4E.quest_desc: [
		"Волны 16–26: пауки, сколопендры и скорпионы ArPhEx, &cподрывники&r, стрекозы, муравьи, мёрзлые зомби. Босс 20-й — &4Паучиха-матриарх&r (~1 100 HP, плодит паучат), 25-й — &4Термитный король&r."
		"Пауки лезут по стенам, прыгуны — через стены: крыша над алтарём окупится."
		"С этой волны за первое прохождение каждой 5-й — &5сильный артефакт&r каждому."
	]
	quest.2FBF34DA191F4F4E.title: "Волна 20: Паучиха-матриарх"
	quest.2FC167169892DA63.quest_desc: [
		"Каждые &e5 ночей&r к базе приходят гости сами. Это целая волна — на &e10 ниже твоей лучшей&r: прошёл 40-ю — придёт 30-я, в начале — 1-я. Победа в обычном набеге обнуляет счётчик."
		"К закату будьте у алтаря: пока никого нет рядом, гости ждут на границе."
		"Дошли до алтаря — проклятие &c−2 сердца&r у всех, добычи нет. Отбились начисто — добыча как за эту волну и &a−1 сердце&r проклятия."
		"Арену малые набеги не трогают — только базу."
		"{@pagebreak}"
		"&7&o— Служба доставки Axiomativ: «Гости прибыли по графику. Претензии к гостям не принимаются».&r"
	]
	quest.2FC167169892DA63.title: "Малые набеги"
	quest.2FCFABA930668036.quest_desc: [
		"Над базой зависают &bульи-матки&r (3 шт., ~550 HP) в 45–70 блоках от алтаря и на 50–65 выше. Каждые 12 с из них вылетают стрекозы, шершни и саранча."
		"Ульи ранит только тот, кто &bв воздухе&r: самолёт (роторная пушка Immersive Aircraft), элитры, дракон. Тесла-башня тоже достаёт."
		"Сбить все ульи за 12 минут. Повторы — 42 и 58."
		"Первое прохождение: &6Чертёж форсажа&r."
	]
	quest.2FCFABA930668036.title: "Волна 24: Воздушный бой"
	quest.30DE9EDE66363F31.quest_desc: [
		"Сырьё для ядерного топлива."
		"Ториевая руда — в обычном камне, Y 20…120, &62&r жилы на чанк. Удача на кирке работает."
		"Миксер: торий + камень + глина + &61 000 мБ&r воды → &62&r тория. Руды хватит надолго."
		"Дробильные колёса: торий → радиоактивный торий (&610 %&r), попутно железные самородки и опыт."
		"&7&oТорий назван в честь бога грома. Молния в этой главе уже была — у нас традиция.&r"
	]
	quest.30DE9EDE66363F31.title: "Торий"
	quest.312E6921C891CC59.quest_desc: [
		"Двух взрослых прирученных драконов покорми рыбой — отложат яйцо. Разные породы — &6яйцо-гибрид&r с чертами обоих."
		"Детёныш может взять породу по месту: огненный — у лавы, водный — у воды, ледяной — в холоде, лесной — в лесу, незерский — в Незере, эндер — в Энде, скалковый — во тьме, небесный — высоко в горах."
	]
	quest.312E6921C891CC59.title: "Гибриды"
	quest.3143F5CDAE9CD77D.quest_desc: [
		"&bБожественные&r артефакты волн (2) — только с 90-й волны и очень редко, в основном в Бесконечности."
		""
		"&bСердце Вахты&r — +18 к здоровью (9 сердец); +4 брони; −10 % входящего урона; вне боя +1 HP/с (5 с без урона). Лучший артефакт танка."
		"&bНимб бессменного&r — вампиризм 10 % нанесённого урона (до 4 HP за удар); после удара моба — 1 с полной неуязвимости, перезарядка 4 с; второе дыхание: смертельный удар оставляет 1 HP, 3 с неуязвимости; раз в 2 мин. С Песочными часами не складывается: работает лучший щит — этот."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 2 — с волны 90: ≈0,27 % на 90-й, ≈0,9 % на 100-й, ≈2,5 % в Бесконечности (∞20) за победу (без первого прохождения)."
	]
	quest.3143F5CDAE9CD77D.title: "&bБожественные&r артефакты"
	quest.31884BC4276B531D.quest_desc: [
		"Зачем: чтобы завод работал, пока ты далеко."
		"Сборщики 3×3: 3 стекла, якорь возрождения, 2 андезитовых корпуса, вал."
		"Пустым загрузчиком ПКМ по &6гасту&r — пойман. Вращение снизу держит чанк; пропало — чанк отпустит с небольшой задержкой."
	]
	quest.31884BC4276B531D.title: "Андезитовый загрузчик чанков"
	quest.3245368928B123AE.quest_desc: [
		"Зачем: взрыв достаёт тех, кто стоит рядом с целью."
		"&6Фугасный снаряд&r — механические крафтеры: 5 железных слитков, 2 спрессованной нитроцеллюлозы, плита. Взрыв сильный, взрыватель — только в головную часть."
		"{@pagebreak}"
		"Взрыватели (как ставить — Ponder, W на снаряде):"
		"&eударный&r — срабатывает в 2 из 3 случаев"
		"&eинерционный&r — в 9 из 10"
		"&eс таймером&r и &eбесконтактный&r — для подрыва над толпой"
		"&eпроводной&r — по редстоуну"
	]
	quest.3245368928B123AE.title: "Фугасы и взрыватели"
	quest.32494E2D2F556718.quest_desc: [
		"Сладкое у Create — через жидкости и дозатор."
		"&6Шоколад&r — миксер с нагревом: сахар, какао, молоко."
		"Дозатор: ягоды + шоколад → ягоды в глазури; яблоко + мёд → медовое яблоко; хлеб + молоко → сладкий рулет."
		"{@pagebreak}"
		"&6Чай строителя&r (спешка): миксер с нагревом — листва, 250 мБ воды, молоко; потом дозатор в бутылку."
		"Мёд — ещё и +6 к рассудку."
		"&7&o— Столовая: «Чай строителя не заменяет сон. Но очень старается».&r"
	]
	quest.32494E2D2F556718.title: "Сладкий цех"
	quest.32A403330C10E18C.quest_desc: [
		"Яйца без погони за курами. &6Миксер&r: 3 холста, 4 бамбука, пшеница. Холст — 4 соломы прессом над бассейном."
		"ПКМ пустым насестом по взрослой курице — она внутри (цыплят не берёт; ещё можно поводком)."
		"Несёт сама. Корм лентой или механической рукой — быстрее."
	]
	quest.32A403330C10E18C.title: "Насест"
	quest.32B7B81DD798CAD8.quest_desc: [
		"Где брать силу — сравнение путей в цифрах."
		"&e1. Колёса&r — &6256–8 192 SU&r, даром и навсегда. Старт."
		"&e2. Пар&r — &616 384 SU&r на двигатель, котёл до &618&r двигателей = &6294 912 SU&r. Главный источник."
		"&e3. Тепло&r — Стирлинг &6512–1 024 SU&r без топлива; нагреватель греет котёл без угля."
		"{@pagebreak}"
		"&e4. Ток&r — не источник, а переделка вращения: генератор C&A берёт &616 384 SU&r, отдаёт &6432 FE/т&r (КПД &690 %&r)."
		"&e5. Атом&r — стержень реактора &6600 тепла/с&r = 3 уровня котла. &66 стержней&r = котёл 18 без угля."
		"Все цифры видны в &eинженерных очках&r: надень и посмотри на машину."
		"{@pagebreak}"
		"&eЗачем ток, если вал и так крутится?&r"
		"Вдаль вращение несёт цепной конвейер: пролёт до &632&r блоков."
		"Ток нужен для &eзарядки&r: электризатор (магниты, моторы, теплогенераторы) и катушка Теслы (электрум)."
		"И для компактной сети: генераторы у котла → толстый кабель → моторы на &6256 об/мин&r."
		"&7&o— Бухгалтерия: «Ток — это пар, научившийся ходить по проводам».&r"
	]
	quest.32B7B81DD798CAD8.title: "Энергия: что выбрать"
	quest.33444D6CF34F28A8.quest_desc: [
		"Зачем: схемы идут почти во всё — компьютер, станцию, контроллер, кислородные машины."
		"&eГравировальный станок&r — механические крафтеры: 4 титановые пластины + механизм точности + 3 полированного розового кварца + аметистовый кристалл Northstar + вал."
		"{@pagebreak}"
		"Станок работает как пресс: над конвейером или депо, крутится валом. В сборке это шаг «Гравирование»."
		"&eСхема&r — последовательная сборка из железной пластины, 5 кругов: полированный аметист → медная пластина → золотая пластина (деплоерами) → гравирование. Выход 70%."
		"&7&o— ОТК: «Незаконченная схема — тоже схема. Незаконченная».&r"
	]
	quest.33444D6CF34F28A8.title: "Схема и гравировальный станок"
	quest.336E7B754D05AD3C.quest_desc: [
		"Сколько держит (удар — до брони):"
		"&eпаук, удар 15&r — щит берёт 7,5 = 7 500 FE: Mk1 — ~26 ударов, Mk2 — ~66;"
		"&eбосс, удар 110&r — щит берёт 55 = 55 000 FE: Mk1 — 3–4 удара, Mk2 — ~9."
		"Не хватает заряда на половину удара — гасит, сколько осталось."
		"{@pagebreak}"
		"Не гасит: яд и магию (в том числе тьму рассудка), иссушение, голод, утопление, удушье в блоке, пустоту и /kill. Поднятый щит в руке принимает удар раньше — заряд не тратится."
		"Под двумя куполами быстрее не заряжается. Купол отдаёт заряд, но сам ниже порога не опускается."
		"Заряд виден над хотбаром в процентах и голубой полоской на иконке нагрудника."
	]
	quest.336E7B754D05AD3C.title: "Справка: энергощит"
	quest.33949459D93D20CF.quest_desc: [
		"Нагрузка на вал (SU на 1 об/мин):"
		"&eобычная турель&r — 4 SU"
		"&eпродвинутая&r — 8 SU"
		"На 256 об/мин: обычная — 1 024 SU, продвинутая — 2 048 SU."
		"20 продвинутых на 256 об/мин — около 41 000 SU. Это уже электростанция: паровые двигатели или электромоторы (глава «Электричество»)."
		"Ниже 30 об/мин турель не стреляет вовсе."
	]
	quest.33949459D93D20CF.title: "Справка: питание турелей"
	quest.33E96C5EAAAD3D74.quest_desc: [
		"Зачем: главный калибр обороны с 50-й волны."
		"Рецепт как у обычной, но тёмный призмарин и конденсатор &6древнего&r стража."
		"Держит &e10 целей&r разом: на 256 об/мин — 6 урона раз в 1,5 с по каждой, ≈ &e40 урона/с&r. 20 таких турелей ≈ 800 урона/с."
		"Ставь их так, чтобы круги по 17 блоков перекрывали коридор и мясорубку."
		"&7&o— ОТК: «Турель не промахивается. Промахивается тот, кто её поставил не туда».&r"
	]
	quest.33E96C5EAAAD3D74.title: "Продвинутая турель"
	quest.33EA20BC35D99D61.quest_desc: [
		"Зачем: разные снаряды — для разных целей."
		"&eМешок с картечью&r — 25 картечин по 15: лучший выбор против толпы."
		"&eШрапнельный&r — 50 осколков по 8, с взрывателем рвётся над ордой."
		"&eТяжёлый&r — 30 урона, пробивает стены; &eбронебойный&r — 50."
		"&eФугасный&r — 30 и взрыв (квест ниже по ряду)."
		"{@pagebreak}"
		"Тяжёлый снаряд — миксер: 4 железных слитка, 2 самородка, плита. Металлические шарики для мешка и шрапнели — рецепт в JEI (R)."
	]
	quest.33EA20BC35D99D61.title: "Снаряды"
	quest.33EB747527C6AAA4.quest_desc: [
		"Артефакты смены делают &aтебя плотнее&r: мобов не ослабляем — переживаешь поздние волны за счёт своего билда."
		"Надеваются в слоты &eРеликвия&r — их 4: инвентарь → кнопка Curios (значок у куклы игрока). 4 слота — 4 решения: больше здоровья, меньше урона, вампиризм, трофей босса или бессмертие на секунду — выбирай."
		"&cОдинаковые не складываются&r: второй такой же в слот не встанет. Разные — суммируются; неуязвимость после удара и второе дыхание — работает лучший из надетых."
		"{@pagebreak}"
		"Где взять — три источника: &6артефакты волн&r (19) — бросок за любую победу; &dартефакты арены&r (13) — только за победу на арене в её теме; &6трофеи боссов&r (14) — за победу на волне с этим боссом."
		"Лишние артефакты волн — в &eпереплавку&r: 3 одного уровня → 1 следующего (/nsart reforge или кнопка у алтаря)."
		"Ни купить, ни продать: EMC у них нет. После смерти и смены надетого эффекты включаются за секунду; /nsart — что даёт твой билд."
		"{@pagebreak}"
		"Потолки суммы: срез урона ≤35 %, вампиризм ≤20 % (до 5 HP за удар), лечение вне боя ≤2 HP/с, отражение ≤50 %, уклонение ≤25 %."
		"Здоровье: 20 + &d5 Сердец ночи&r (+10) + 4 лучших по здоровью (+56) = &a86 HP&r — больше четырёх рядов сердец. Потолок здоровья от артефактов — +60 (пробуждённые доходят до него за три слота), срез урона упирается в 35 %."
		"Артефакты мода Artifacts (крест-ожерелье, кристальное сердце…) носятся в своих слотах и складываются с этими."
		"&7&o— Отдел кадров: «Четыре слота — не ограничение, а корпоративная культура. Пятый выдают посмертно».&r"
	]
	quest.33EB747527C6AAA4.title: "Как это работает: слоты, билды, шансы"
	quest.350402D904DEB977.quest_desc: [
		"Орда идёт &cне на базу, а на форпост&r — механический экструдер на месторождении (глава «Сеть форпостов»). Моб у экструдера — &cпровал&r."
		"Форпост выбирается из сети команды: каждый экструдер на месторождении входит в неё сам, список — &e/outposts&r. Без форпостов стадию не начать."
		"Кто далеко — кнопка телепорта к форпосту придёт со стартом. Стены, турели и прожекторы ставьте и там."
		"Повтор — 57: форпост случайный, укрепляйте все."
		"Первое прохождение: &6Ядро бастиона&r."
	]
	quest.350402D904DEB977.title: "Волна 38: Осада форпоста"
	quest.35392A512115E122.quest_desc: [
		"Зачем: латунь мешается только с подогревом — горелка ставится под чашу."
		"&6Пустая горелка&r: 4 железных листа крестом, незерак в центре — 5 сборщиков крестом."
		"Всполоха не крафтят, его ловят: с пустой горелкой в руке ПКМ по живому всполоху (или спавнеру) в крепости Незера."
		"{@pagebreak}"
		"Портал: обсидиан (вода на источник лавы; ведро лавы — в ящике) + огниво (железо и кремень, миксер)."
		"Горелка ест уголь и всё горючее: кормить руками, активатором или механической рукой."
		"&7&o— Отдел по работе с ордой: всполох горит на работе. Как и все в Axiomativ, но хотя бы по делу.&r"
	]
	quest.35392A512115E122.title: "Горелка всполоха"
	quest.359D349B31911454.quest_desc: [
		"Шкала &dрассудка&r — у хотбара. Упадёт низко — начнутся видения, у самого нуля тьма начнёт убивать."
		"&cТает&r: в темноте (ночью под небом тоже темно), рядом с монстрами (злые — вдвое быстрее), от урона, в дождь и в воде, на голодный желудок, при переходе в другое измерение, от удара молнии. Гнилая плоть и паучий глаз — тоже минус."
		"{@pagebreak}"
		"&aЛечат&r: горящий &6костёр&r в 5 блоках, светлое место, сон, питомец рядом, друзья в здравом уме, ковёр и тропинка под ногами, мёд, золотая морковь и яблоки, таблетки «Успокоительное»."
		"Во время набега у алтаря рассудок &aне падает&r — держится на уровне начала набега."
		"&7&o— Медпункт Axiomativ: «Голоса в голове — не повод пропускать смену. Если говорят по делу — тем более».&r"
	]
	quest.359D349B31911454.title: "Рассудок"
	quest.36276A9BB7F78AA3.quest_desc: [
		"Зачем: один вход на весь склад — положил, и само разложилось."
		"Бочки и сундуки Sophisticated Storage ставь вплотную, рядом — контроллер: всё соседнее станет одним складом."
		"Контроллер: 2 компаратора, камень, доски, деревянное хранилище (R). Работает со шлюзами и лентами Create."
	]
	quest.36276A9BB7F78AA3.title: "Складской контроллер"
	quest.363F2895D397D822.quest_desc: [
		"Духов ранит &dтолько магия&r: посохи, заклинания Iron's Spells, зелья вреда."
		"Повтор — 52."
		"Первое прохождение: &6Эссенция духа&r."
	]
	quest.363F2895D397D822.title: "Волна 32: Духи"
	quest.3657C1A4FAB03885.quest_desc: [
		"&e/arena&r — отдельное измерение: коридор 21 × 128 блоков под стеклянной крышей, вокруг — каньон. Алтарь у входа, орда выходит из ворот в дальнем конце. Назад — &e/arena&r ещё раз."
		"Стены, пол, крыша и фонари &aне ломаются&r: ни грызением, ни подрывниками. Пол ровный — турели ставь куда угодно. Фантомы и летуны из-под крыши не улетят."
		"{@pagebreak}"
		"Строй турели, щит, ловушки — постройки сохраняются между набегами. После набега арена &aоткатывается&r к снимку в момент выхода орды: взрывы и боссы следов не оставят."
		"Откатываются &eблоки&r. Сундуки, заряд батарей и патроны — как в конце набега (без дюпа), сломанное хранилище вернётся пустым. Големы и драконы — мобы, их откат не спасает."
		"Ток с базы — передатчиком энергии Ender Transmission. Волны и проклятие общие с базой."
		"&7&o— Отдел по работе с ордой: «На арене ядерка разрешена. Всё равно потом откатим».&r"
	]
	quest.3657C1A4FAB03885.title: "Арена"
	quest.36689E871BD9E1C6.quest_desc: [
		"Зачем: мозг сети — решает, в кого стрелять."
		"&6Network Controller&r: рецепт &cсъедает все три фильтра&r. Передатчиком данных — ПКМ по контроллеру, потом ставь линк к монитору, к радару и к одному из контроллеров оружия."
		"{@pagebreak}"
		"Сделай ещё один &6Targeting Filter&r: включи &eAuto Target&r и &eMob&r, выключи &eAnimal&r — и вставь в контроллер."
		"&cПо умолчанию&r Auto Target выключен, а Animal включён: пушка будет палить по коровам."
		"&7&o— Столовая благодарит отдел обороны за 40 кг говядины. Просит больше так не делать.&r"
	]
	quest.36689E871BD9E1C6.title: "Сетевой контроллер"
	quest.3674C97A553636B1.quest_desc: [
		"Поток вентилятора обрабатывает то, что лежит на депо, едет по ленте или брошено в поток. Режим задаёт блок перед вентилятором:"
		"&bвода&r — промывка (руда, гравий, песок);"
		"&6огонь, костёр&r — копчение (еда);"
		"&cлава&r — плавка (дроблёная руда, песок);"
		"&5огонь душ&r — призрачная (песок душ, черныт)."
		"Скорость не ускоряет обработку — только дальность. Сырую руду поток не плавит."
	]
	quest.3674C97A553636B1.title: "Вентилятор: четыре режима"
	quest.3683F15199866889.quest_desc: [
		"Разносит кислород электролизёра по герметичному корпусу — ныряй надолго. Тратит пропорционально размеру лодки."
		"Включается &6редстоун-сигналом&r, без сигнала стоит."
		"Механические крафтеры: 2 &eфильтра воздуха&r (форпост «Торфяник»), пропеллер, форсунка, осушитель, 2 электронные лампы, 2 редстоун-связи."
		"Дыра в обшивке — удушье всё равно догонит: сначала герметичность."
	]
	quest.3683F15199866889.title: "Кислородный диффузор"
	quest.369117D4B69EA320.quest_desc: [
		"Пройди список — и только потом Пробел."
		"&e•&r Все 4 части скафандра НА ТЕБЕ, нагрудник заправлен."
		"&e•&r В станции Атлас, выбрана «Поверхность» (не Orbit — там пустота), нажато «Save destination»."
		"&e•&r Fuel, Thrusters, Heat Shielding — в норме."
		"&e•&r В баках топливо и на обратный путь."
		"{@pagebreak}"
		"&e•&r С собой: кирка, еда, бумага, запасной кислород. Обычные факелы без воздуха гаснут — бери светокаменные Northstar."
		"&e•&r Для планет — Межпланетный навигатор на борту; для наших — Звёздный навигатор в кармане."
		"&e•&r Все пассажиры стоят внутри ракеты — остальных она не возьмёт."
		"{@pagebreak}"
		"&6Посадка&r без автопосадки — держи &eПробел&r, пока скорость внизу экрана зелёная (до 5 м/с). Быстрее — ракета взрывается о грунт."
		"Видишь «Use Rocket Controls to slow down!» — ПКМ по Контроллеру и держи Пробел."
		"Садишься в те же X и Z, откуда взлетел, на самый верхний блок. Или на Маяк."
		"&7&o— Техника безопасности: вакуум прощает ровно одну ошибку. Последнюю.&r"
	]
	quest.369117D4B69EA320.title: "&eЧек-лист перед стартом&r"
	quest.36DE1D2FAB859594.quest_desc: [
		"Зачем: видеть в кромешной тьме ночи и пещер без факела в руке."
		"Модуль на шлем: ночное зрение, пока шлем надет. Снял — эффект гаснет сразу."
		"Крафтеры: подзорная труба, 2 светящихся чернильных мешка, 2 электронные лампы, точный механизм, 2 латунных листа, золотая морковь."
		"Рассудок считает свет вокруг, а не то, что ты видишь: от «тьма убивает» прибор не спасает."
		"&7&o— Отдел кадров: «Теперь вы видите, что в темноте. За то, что вы увидели, отдел кадров не отвечает».&r"
	]
	quest.36DE1D2FAB859594.title: "Прибор ночного видения"
	quest.381CF6B331367254.quest_desc: [
		"Зачем: металл без шахты — экструдер выдавливает рудную породу, колёса дробят её в руду."
		"Сбоку — &6блок металла&r (не тратится) и лава, снизу — булыжник:"
		"&eжелезо&r → кримзит, &eмедь&r → веридий, &eцинк&r → азурин, &eзолото&r → охрум."
		"{@pagebreak}"
		"Колёсами: кримзит — 40 % дроблёного железа + 40 % самородка; веридий — 80 % меди; азурин — 30 % цинка + лазурит; охрум — 20 % золота."
		"С булыжником снизу — 4 удара на блок. Быстрее — катализатор."
	]
	quest.381CF6B331367254.title: "Рудная порода"
	quest.38B96CB993ED1D01.quest_desc: [
		"Зачем: медь + цинк = латунь, ключ ко второй половине игры."
		"&6Медь&r — с промывки красного песка или со стола (512 EMC)."
		"&6Цинк&r проще всего купить на столе (512 EMC). Ещё: азурин (голубой камень в шахте) в жернове — 6 %; сито с андезитовой сеткой по гравию — 10 %."
		"Самородки → слиток: пресс над чашей."
	]
	quest.38B96CB993ED1D01.title: "Медь и цинк"
	quest.38BFD00AD522076F.quest_desc: [
		"Электрическая медь на конвейере — сколько угодно."
		"Дай &eдеплоеру&r (автономный активатор) заряд молнии — ПКМ зарядом или воронкой. Под ним — депо или лента с медью: деплоер бьёт молнией по слиткам."
		"Заряд &aне тратится&r — один на всю жизнь базы."
		"&7&oПоговорка врёт: молния бьёт в одно место и дважды, и десять тысяч раз. Мы проверили.&r"
	]
	quest.38BFD00AD522076F.title: "Молния в деплоере"
	quest.3947E4DD03FEF6DA.quest_desc: [
		"Зачем: тяжёлым мобам — тяжёлый ответ."
		"Механические крафтеры: андезитовый сплав, трубы, латунные и стальные пластины, желоба, брёвна."
		"&eРакета&r: 5 + взрыв &e20&r в радиусе 4 — &cи ломает блоки&r. &eМалая ракета&r: взрыв 8, радиус 3, 5 штук за сборку. В магазине 4, можно залпом."
		"{@pagebreak}"
		"Насадка &6баллистазука&r (два маховика, пластины, нитки, брёвна) стреляет копьями: &e20 урона&r, 4 копья за сборку. Копья — не для рукопашной, это снаряды."
		"Без патронов ракетницей бьют как дубиной: 12 урона. На неё же ставится &eбольшой штык&r (латунная + 4 железные пластины)."
		"&7&oСамая частая причина смерти ракетчика — стена в двух шагах. Своя.&r"
	]
	quest.3947E4DD03FEF6DA.title: "Ракетница"
	quest.394B0D9B5D293247.quest_desc: [
		"Сера нужна для &eоружейного пороха&r (все патроны Gunsmithing, заряды и гильзы Create Big Cannons) и &eрезины&r. Других источников серной пыли больше нет."
		"&eГде:&r бесплодные земли (озёра прямо на поверхности) и глубокие пещеры ниже высоты −12 в любом биоме. Примета — жёлтое озеро жидкой серы, дно и берега из серного источника, над ним столб дыма."
		"{@pagebreak}"
		"&eЦепочка:&r"
		"1) ведро жидкой серы из озера;"
		"2) экструдер на блок источника; с одной стороны — жидкая сера, с другой — вода → &6серная корка&r;"
		"3) дробилка (жернова или колёса) → &62&r серной пыли (+50 % ещё одна)."
		"Сера Незера (блоки TFMG, жила бура) годится только на переплавку в жидкую серу: миксер с нагревом."
		"{@pagebreak}"
		"&eОружейный порох&r — миксер: серная пыль + порох + древесный уголь → &63&r. Только он идёт в патроны и заряды; обычный порох остался для ТНТ и фейерверков."
		"&7&oПахнет тухлыми яйцами. Отдел кадров настаивает, что это запах прогресса.&r"
	]
	quest.394B0D9B5D293247.title: "Серный источник"
	quest.39ADAE75A36F405C.quest_desc: [
		"Зачем: большая пушка на креплении стреляет трижды подряд, без ручной зарядки."
		"Магазин ставится к собранному креплению пушки. В каждую из трёх колонок — снаряд и заряженная большая гильза; автоматика кладёт сначала снаряды, потом гильзы."
		"Цикл заряжания стартует, когда готовы все три пары. Пустые гильзы выходят с боков, сзади и снизу — под воронку."
		"Крафтеры или миксер: 3 латунных листа, 2 латунных корпуса, пушечный заряжатель, 2 блока технического железа, редстоун."
	]
	quest.39ADAE75A36F405C.title: "Магазин на 3 выстрела"
	quest.39DC36FC4BCD8389.quest_desc: [
		"Поздняя энергетика: котёл 18 без угля, тортов и всполохов."
		"Цепочка: торий → радиоактивный торий → ядерное топливо → стержни → теплоотводы → трубы → нагреватели под котлом."
		"Стержень = &6600&r тепла/с = один нагреватель на &63&r уровня. &66 стержней&r = котёл 18 = &6294 912 SU&r."
		"{@pagebreak}"
		"&cРадиация и взрывы&r — прочитай квест реактора до сборки, а не после."
		"&7&o— Отдел кадров: вакансия «оператор реактора» снова открыта. И снова. И снова.&r"
	]
	quest.39DC36FC4BCD8389.title: "5 · Атом"
	quest.39E1B145A85F9274.quest_desc: [
		"Зачем: разогнать толпу у алтаря — ударная волна вокруг себя, радиус 10."
		"Каждому мобу набега и монстру: 30 урона магией, отброс и замедление II на 3 с."
		"Мана 40, перезарядка 8 с, прочность 300, не горит в лаве."
		"Механические крафтеры: «сплав | волшебный слиток | сплав», под центром — 2 латунных стержня. Волшебный слиток — 8 эссенций вокруг железного, медного или золотого слитка (крафтеры 3×3)."
	]
	quest.39E1B145A85F9274.title: "Посох сплава"
	quest.3A41ED9C7325801D.quest_desc: [
		"Шанс артефакта волн за победу и уровень, если выпал. Строки — для обычного прохождения."
		""
		"&eВолна 1&r — артефакт 8 %: &fобычный 78&r · &aредкий 22&r"
		"&eВолна 15&r — артефакт 15,4 %: &fобычный 55&r · &aредкий 30&r · &9сверхредкий 12&r · &5эпический 3&r"
		"&eВолна 30&r — артефакт 23,2 %: &fобычный 38&r · &aредкий 30&r · &9сверхредкий 20&r · &5эпический 10&r · &6легендарный 3&r"
		"&eВолна 50&r — артефакт 33,7 %: &fобычный 24&r · &aредкий 25&r · &9сверхредкий 24&r · &5эпический 15&r · &6легендарный 9&r · &cмифический 4&r"
		"{@pagebreak}"
		"&eВолна 70&r — артефакт 44,2 %: &fобычный 14&r · &aредкий 19&r · &9сверхредкий 24&r · &5эпический 20&r · &6легендарный 14&r · &cмифический 9&r"
		"&eВолна 100&r — артефакт 60 %: &fобычный 6&r · &aредкий 12&r · &9сверхредкий 20&r · &5эпический 24&r · &6легендарный 19&r · &cмифический 16&r · &bбожественный 3&r"
		"&eБесконечность 10&r — артефакт 72,5 %: &fобычный 5&r · &aредкий 11&r · &9сверхредкий 19&r · &5эпический 24&r · &6легендарный 20&r · &cмифический 16&r · &bбожественный 4&r"
		"&eБесконечность 20&r — артефакт 85 %: &fобычный 4&r · &aредкий 10&r · &9сверхредкий 18&r · &5эпический 24&r · &6легендарный 21&r · &cмифический 17&r · &bбожественный 6&r"
		""
		"Первое прохождение: шанс ×1,5 (до 95 %), каждая 10-я волна — наверняка. Божественные — только с 90-й и очень редко."
		"Артефакты арены и трофеи боссов — отдельные броски сверх этого."
		"&7&o— Бухгалтерия EMC: «Артефакты на баланс не ставим. Их нельзя купить — только выстрадать».&r"
	]
	quest.3A41ED9C7325801D.title: "Шансы по волнам"
	quest.3A7FEC2616BCC8B5.quest_desc: [
		"Яйцо не купить и не собрать — только найти в &6сундуках построек&r. Порода зависит от постройки, список — в справке «Породы»."
		"Сундук заполняется при первом открытии: старые, но нетронутые постройки тоже годятся."
		"{@pagebreak}"
		"Поздний путь: клетка Caged Mobs с образцом &5Эндер-дракона&r роняет чешую (20 %). 9 чешуек — пресс над бассейном → яйцо Эндер-дракона. Оно тоже вылупляется: выйдет эндер-дракончик."
	]
	quest.3A7FEC2616BCC8B5.title: "Яйцо дракона"
	quest.3ACD1946BC62D931.quest_desc: [
		"&6Туф&r: миксер андезит + диорит → 2 туфа; или экструдер с туфом снизу."
		"&6Кальцит&r: пресс над чашей — гравий + 3 костной муки."
		"&6Капельник&r: миксер — кальцит + 200 мБ воды."
	]
	quest.3ACD1946BC62D931.title: "Туф, кальцит, капельник"
	quest.3AFD165303DC1F36.quest_desc: [
		"Зачем: главное сырьё магии — книги, ткань, слитки, руны, чернила."
		"В мире её дают только сундуки и маги. На вахте — &6миксер с нагревом&r (горелка блейза под бассейном): лазурит + осколок аметиста + светопыль + самородок опыта → 1 эссенция."
		"Ещё — добыча набегов: 2–16 штук за бросок, чем дальше волна, тем больше."
		"Самородки опыта — побочка дробления руд, аметист — миксер с нагревом (кальцит + кварц + вода)."
	]
	quest.3AFD165303DC1F36.title: "Эссенция волшебства"
	quest.3B3BC2D592599387.quest_desc: [
		"Зачем: бьёт полукругом до 6 мобов разом и достаёт на 5 блоков."
		"Механические крафтеры: механический поршень, латунный блок, медный баллон, окорённое бревно, 3 андезитовых сплава. На него ставится головка."
		"&eГоловка молота&r — до 6 целей: камень 5, железо 7, алмаз 9, незерит 11. Копает 3×3."
		"&eГоловка топора&r — 1 цель, +4: от 9 до 15. Валит дерево целиком."
		"{@pagebreak}"
		"ПКМ — пневмоудар: +6 урона, 20 воздуха за удар (в молоте 900). Воздух — из медного баллона Create."
		"Головки (миксер): молот — 7 камней, железный блок + 6 слитков, алмазный блок + 6 алмазов; топор — 5 камней, блок + 4 слитка, блок + 4 алмаза."
		"&7&oКогда в руках молот, всё вокруг похоже на зомби. Особенно зомби.&r"
	]
	quest.3B3BC2D592599387.title: "Пневмомолот"
	quest.3B7D9C7933E1D1BB.quest_desc: [
		"Улучшение даёт голему свойство: огнестойкость, защиту от молний, размер и другие. Слотов у голема немного — выбирай."
		"&6Пустое улучшение&r (4 шт.) — крафтеры: аметист в центре, железо крестом, глина по углам."
		"Потом пустое + компоненты (молниезащита — 4 громоотвода вокруг). Все рецепты — в JEI (U по пустому)."
		"{@pagebreak}"
		"Ставит улучшение &6деплоер&r: держатель голема на депо или ленте, улучшение в руке деплоера."
		"Так же деплоер ставит шаблоны-расширители слотов."
	]
	quest.3B7D9C7933E1D1BB.title: "Улучшения"
	quest.3BCE829443992885.quest_desc: [
		"Зачем: самопалу нужны патроны — десятками."
		"Миксер: свинцовый самородок + оружейный порох + бумага → 3 патрона."
		"Выгоднее на конвейере (сборка по шагам): бумага → деплойер с оружейным порохом → деплойер со свинцовым самородком → &e4 патрона&r."
		"С картечью вместо самородка — патрон с картечью (2 шт.)."
		"&eОружейный порох&r — миксер: серная пыль + обычный порох + древесный уголь → 3. Только он идёт в патроны и заряды. Сера — форпост «Серный источник» (глава «Сеть форпостов»)."
		"&7&o— Бухгалтерия: «Патроны списываются по факту выстрела. Промахи — тоже».&r"
	]
	quest.3BCE829443992885.title: "Бумажные патроны"
	quest.3C83F989C78C435A.quest_desc: [
		"Зачем: руки вахтовика внутри машины — ставит блоки, кликает предметами, бьёт."
		"&6Активатор&r: андезитовый корпус + латунная рука + электронная лампа (миксер). Работает с клеткой в двух блоках перед собой. Дай ему предмет (ПКМ) — будет им пользоваться: сплав на бревно → корпус."
		"{@pagebreak}"
		"&6Механическая рука&r (латунь и механизм точности, рецепт — R) перекладывает предметы: ПКМ рукой по источникам (синие), ещё раз — по приёмникам (жёлтые), потом поставь руку."
		"Активаторы на ленте — это последовательная сборка: механизм точности, рельсы."
	]
	quest.3C83F989C78C435A.title: "Автономный активатор и рука"
	quest.3CC38EECAC712063.quest_desc: [
		"Зачем: бесконечные гравий, песок и пыль — сырьё для стекла, земли и сит."
		"Булыжник с экструдера → &6жернов&r → гравий → &6колёса&r → песок (+ кремень, глина) → жернов → пыль."
		"Песок в печь — стекло."
	]
	quest.3CC38EECAC712063.title: "Гравий, песок и пыль"
	quest.3D93F7DA49468431.quest_desc: [
		"Каждое заклинание тратит ману. Полоска маны — у хотбара, видна, когда мана не полная или в руках магия."
		"Восстановление: 1 % от максимума каждые полсекунды (при 100 маны — 2 в секунду). Больше маны дают мантии и робы мага, кольцо маны, сферы улучшения маны."
		"&eR&r — панель (колесо) заклинаний книги, &eV&r — применить выбранное, &eЛевый Alt + колёсико&r — листать панель."
		"R и V заняты и другими модами: если не срабатывает — Настройки → Управление → «Iron's Spells 'n Spellbooks - Основное», поставь свободные клавиши."
		"&7&o— Бухгалтерия: мана — единственный ресурс, который восстанавливается сам. Не привыкайте.&r"
	]
	quest.3D93F7DA49468431.title: "Справка: мана и клавиши"
	quest.3DCA31B7087B87A2.quest_desc: [
		"Арена меняет облик по номеру волны: на старте набега, если тема другая, за отсчёт перестраиваются стены, крыша, ворота, ландшафт и даже погода. Пол и ваши постройки не трогаются."
		"У каждой темы свой &eприкол&r — эффекты на время набега на арене (дома их нет)."
		"{@pagebreak}"
		"&7Шахта&r (1–15) — без сюрпризов."
		"&6Каньон пауков&r (16–29) — вам «Спешка II», орде «Скорость I»."
		"&bВечная мерзлота&r (30–44) — снег; вам «Скорость I», орда медленнее, но с «Сопротивлением II»."
		"&cПекло&r (45–59) — пепел, орда горит и злее («Сила I»), вам огнестойкость."
		"{@pagebreak}"
		"&dКрай&r (60–69) — низкая гравитация: вы прыгаете выше и падаете медленно, но и орда скачет через стены в два блока."
		"&3Кошмар&r (70–99) — тьма накатывает каждые 30 с, зато орда светится."
		"&5Звёздная бездна&r (100+) — вам «Регенерация I», орде «Сопротивление II»."
		"&7&o— Отдел по работе с ордой: «Обстановку меняем, чтобы вам не было скучно умирать в одном и том же интерьере».&r"
	]
	quest.3DCA31B7087B87A2.title: "Темы арены"
	quest.3E4DC2FF5F9E9A11.quest_desc: [
		"Дирижаблю не нужна тяга вверх — его держит горячий воздух в оболочке. Медленно, зато тихо и грузоподъёмно."
		"Деплоер с &eбаллоном гелия&r над шерстью любого цвета → 4 оболочки (гелий — форпост «Высотный конденсатор», глава «Сеть форпостов»). Промывка делает любую оболочку белой."
		"Воздух держат только &eпустые клетки&r внутри, сами оболочки — нет. Заполняется сверху вниз: дыра в третьем слое — наполнятся только два верхних."
		"Вал сквозь оболочку — только через «вал в оболочке» того же цвета."
	]
	quest.3E4DC2FF5F9E9A11.title: "Оболочка аэростата"
	quest.3E5CB0645B9A0F13.quest_desc: [
		"Звук здесь объёмный: слышно, откуда шорох и за какой стеной шаги. Играйте в наушниках — так страшнее и честнее."
		"Не всё, что слышишь и видишь, — правда. Даже «свой» может оказаться не своим: договоритесь о кодовом слове."
		"&7&oЕсли друг шёпотом зовёт тебя в тёмную шахту — это не друг. Или очень плохой друг.&r"
	]
	quest.3E5CB0645B9A0F13.title: "Прислушивайся"
	quest.3E607BBDA9DA7D25.quest_desc: [
		"Зачем: пауки лезут по стенам, а зомби встают друг другу на головы."
		"Козырёк — блок, нависающий наружу поверх стены, или сплошная крыша над коридором. Он обрывает и паука, и живую лестницу."
		"Фантомам и вексам стены не помеха — они летают (ряд «Поздняя оборона»)."
		"&7&o— Техника безопасности: паук на потолке — это не баг, это паук.&r"
	]
	quest.3E607BBDA9DA7D25.title: "Козырёк от пауков"
	quest.3E8C22C1E7E253B1.quest_desc: [
		"Объёмный ферментер (бочка + 2 андезитовых сплава): сахар, тростник, яблоки, картофель, лук или томаты + костная мука → &6этанол&r, 400 мБ за цикл."
		"Возобновляемое топливо для дизеля: нефть кончилась, а новую качалку строить лень."
		"&7&o— Столовая Axiomativ: «Картошку со склада не брать. Она ушла на топливо».&r"
	]
	quest.3E8C22C1E7E253B1.title: "Топливо без нефти"
	quest.3EB3DCC9CCA7B9A5.quest_desc: [
		"Зачем: тепло без топлива и горелок — когда тока много (реактор, ряд генераторов)."
		"&eТЭН&r — блок тепловой сети: ток к любой стороне, тепловые трубы — тоже с любой."
		"Цена: &63 FE/т за 1 ˚T/с&r, до &6600 ˚T/с&r (1 800 FE/т). Один нагреватель на обычном — &6600 FE/т&r, на суперогне — &61 650 FE/т&r."
		"Для сравнения: горелка на угле даёт те же 200 ˚T/с, а через котёл и генератор C&A — 432 FE/т. ТЭН дороже, зато без угля и лент."
		"Сеть горячая — ТЭН ждёт и ток не тратит. Сигнал редстоуна — выключить."
		"Сборка — механические крафтеры: 4 медных листа, медная катушка C&A, конденсатор, 2 тепловые трубы, электрическая медь."
		"&7&o— Бухгалтерия: «Греть током дорого. Греть всполохами дёшево, но всполохи просят торт».&r"
	]
	quest.3EB3DCC9CCA7B9A5.title: "ТЭН: тепло из тока"
	quest.3EC55E8A9E16874C.quest_desc: [
		"Зачем: отбиться в первую ночь, пока нет машин."
		"Каменный меч — на сборочном посту (9 механических крафтеров), раскладка как на верстаке."
		"Урон мечей: &eкамень&r 5, &eжелезо&r 6, &eалмаз&r 7, &eнезерит&r 8. Полный замах — раз в 0,6 с; удар без замаха в разы слабее."
		"Топор бьёт на 9–10, но медленнее."
		"{@pagebreak}"
		"Мечи модов (урон · скорость):"
		"&eмедный, цинковый&r CSA — 4"
		"&eлатунный&r CSA — 5"
		"&eстальной&r TFMG — 6, прочность 1 000"
		"&eлитиевый клинок&r TFMG — 7 с зарядом"
		"&eмарсианский&r Northstar — 9"
		"&7&o— Отдел кадров: «Меч выдаётся под роспись. Орда — без».&r"
	]
	quest.3EC55E8A9E16874C.title: "Первый клинок"
	quest.3F32929BF605AE5F.quest_desc: [
		"Волны 35–49: крабы-душители, &cПещерный житель&r, пауки-похитители, голиафы, паучья моль, осы, жнецы. Боссы: 35 — &4Скорпиоид-кровопийца&r (летает), 40 — &4Пустотный драконохвост&r (летает), 45 — &4Арахноид-трисектор&r."
		"Готовьтесь: зенитные турели, обсидиан на опасных участках стены, энергощит и артефакты. Это последняя эпоха ручного оружия — дальше нижний ряд."
	]
	quest.3F32929BF605AE5F.title: "Волна 40: Драконохвост"
	quest.3F54E637A97857D1.quest_desc: [
		"Боссы ArPhEx приходят каждую 5-ю волну с 15-й по 65-ю. С каждого — свой трофей по характеру: хитин, жало, рог."
		"Трофей падает за победу на волне, где был босс: легендарный — 15 %, мифический — 10 % каждому защитнику; при &eпервом прохождении&r волны с боссом — наверняка одному из вас. Трофей занимает слот «Реликвия» — это и есть выбор."
		"{@pagebreak}"
		"&6Хитин матриарх&r — +4 брони; +2 прочности брони; иммунитет: яд, некроз. Пауки-отшельники и заразители больше не страшны. &7Боссы: Голиаф (волна 15), Паучиха-матриарх (волны 20 и 55).&r"
		"&6Панцирь подземного короля&r — +10 к здоровью (5 сердец); +2 брони; +30 % сопротивления отбрасыванию; +25 % скорости копания. Толстый панцирь и привычка рыть. &7Боссы: Термитный король (волна 25), Артроплевра-мерзость (волны 30 и 55).&r"
		"&6Жало скорпиоида&r — вампиризм 8 % нанесённого урона (до 3 HP за удар); твои удары: Яд II на 3 с, Замедление I на 3 с. Вампиризм ядом: травит и пьёт. &7Босс: Скорпиоид-кровопийца (волны 35 и 60).&r"
		"{@pagebreak}"
		"&6Хвост драконохвоста&r — +15 % скорости; иммунитет: сверхтяжесть, контроль хаоса, хаос драконохвоста; ударившему тебя вплотную: Слабость II на 4 с. Ударившего вплотную хлещет пустотой. &7Босс: Пустотный драконохвост (волны 40 и 65).&r"
		"&cКлинок трисектора&r — +4 урона в ближнем бою; +15 % скорости атаки. Режет быстро и глубоко. &7Босс: Арахноид-трисектор (волны 45 и 60).&r"
		"&cРог диаболоса&r — +6 к здоровью (3 сердца); +3 урона в ближнем бою; убийство лечит 4 HP. Каждое убийство — глоток жизни. &7Босс: Диаболос-истребитель (волны 50 и 65).&r"
	]
	quest.3F54E637A97857D1.title: "&6Трофеи боссов ArPhEx&r"
	quest.404F6AAA2C0EB4E3.quest_desc: [
		"Малыш из мода Create Golems Galore — помощник-пресс, не боец."
		"&6Промышленный железный блок&r под &6прессом&r → шляпа. Поставь шляпу сверху на блок андезитового сплава — выйдет андезитовый голем."
		"Латунная шляпа (промышленный латунный блок под прессом) — латунный вариант."
		"&7&o— Пресс-служба: «Да, у нас пресс ходит на ногах. Нет, профсоюза у него нет».&r"
	]
	quest.404F6AAA2C0EB4E3.title: "Андезитовый голем"
	quest.40A90820DDCB08CC.quest_desc: [
		"Рассудок почти на нуле (3% и ниже), а вокруг кромешная тьма — тьма бьёт на &c1 сердце каждые 2 секунды&r, броня не спасает."
		"Спасает: выйти к свету, взять в руку факел, фонарь или светокамень, съесть таблетку."
		"Убила тьма — после возрождения рассудка чуть больше, чтобы не умирать по кругу."
		"&7&oТьма не кусается. Она просто ждёт, пока ты кончишься сам.&r"
	]
	quest.40A90820DDCB08CC.title: "Тьма убивает"
	quest.40A93CAB5BCB6AF7.quest_desc: [
		"Зачем: бить из-за стены, пока нет пороха и стали."
		"Лук и арбалет — механические крафтеры, раскладка как на верстаке. Стрелы — тоже."
		"&eЛук&r: полный натяг — 6 урона, крит — до 10. &eАрбалет&r бьёт так же, но держит заряд и с Пронзанием прошивает строй."
		"Сила V на луке — +150 % к урону. С Бесконечностью хватит одной стрелы."
		"&7&o— Бухгалтерия: «Стрелы — расходный материал. Скелеты — поставщик»&r"
	]
	quest.40A93CAB5BCB6AF7.title: "Лук и арбалет"
	quest.40BC59080DC10129.quest_desc: [
		"Собери на одной штуковине: пропеллер, портативный двигатель, штурвал с подшипником, тяговый рычаг. Встань на борт, дай газ."
		"Тяга перевесила массу — ты в воздухе. Не перевесила — очки покажут, сколько не хватает: добавь винт или облегчи раму."
		"&7&o— Если самолёт не взлетел — это не провал, а очень короткий полёт.&r"
	]
	quest.40BC59080DC10129.title: "Взлёт!"
	quest.40C50273936EC3A2.quest_desc: [
		"Двигатель собран и крутит вал — отметь галочку."
		"Трубы, подведённые к корпусу, сами тянут топливо из соседних баков."
		"Мощность TFMG-двигателя плавает: топливо, число цилиндров и газ. Точные SU и обороты — в очках."
		"&7&oДвигатель внутреннего сгорания: внутри горит топливо, снаружи — дедлайны.&r"
	]
	quest.40C50273936EC3A2.title: "Мотор на ходу"
	quest.413A163084692EA3.quest_desc: [
		"Рецепт: 2 стальных слитка, корпус тяжёлой машины, 3 тяжёлые пластины → &a2 блока&r. В ряд — до 5 блоков."
		"Собирается по деталям: ПКМ валом — выход вращения; очки показывают, какая деталь следующая (коленвал: 3 алюминиевые пластины + 3 арматуры, цилиндры…)."
		"{@pagebreak}"
		"ПКМ пустой схемой меняет тип цилиндров: обычный (бензин, керосин, нафта), дизельный, газовый (сжиженный газ), простой (креозот, печной газ)."
		"Управление — &6контроллер двигателя&r: ПКМ им по предмету-передатчику, потом по двигателю; клавиши — в настройках управления, раздел TFMG."
	]
	quest.413A163084692EA3.title: "Двигатель TFMG"
	quest.4150BFBBBA5AE66E.quest_desc: [
		"Для вертолёта: &6гироскопический подшипник&r держит пропеллер строго вверх, даже когда корпус кренится."
		"&6Механизм гироскопа&r — последовательная сборка из железного листа: деплоеры кладут шестерню, вал, латунный самородок, 5 кругов."
		"{@pagebreak}"
		"Подшипник — крафтеры столбиком: плита, механизм гироскопа, алюминиевый лист, латунный корпус."
		"&6Умный пропеллер&r (столбиком: пропеллер, механизм гироскопа, алюминиевый лист, латунный корпус → 2 шт.) — готовый винт, который сам разворачивается вверх."
	]
	quest.4150BFBBBA5AE66E.title: "Гироскоп: вертолёт"
	quest.4258DA3E82C76B90.quest_desc: [
		"&fОбычные&r артефакты волн (3) — первые лишние сердца, броня и лечение между подволнами."
		""
		"&fЗаплатка вахтовика&r — +4 к здоровью (2 сердца). Первые лишние сердца — пришить и забыть."
		"&fЖетон смены&r — +1 брони; +5 % скорости. Быстрее к алтарю — и от него, если что-то пошло не так."
		"&fТермос бригадира&r — вне боя +0,5 HP/с (5 с без урона). Лечит между подволнами, если по тебе не попадают."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 3 — с волны 1: ≈2,1 % на 1-й, ≈2,8 % на 15-й, ≈2,7 % на 50-й, ≈1,2 % на 100-й за победу (без первого прохождения)."
	]
	quest.4258DA3E82C76B90.title: "&fОбычные&r артефакты"
	quest.42B84590A81466C4.quest_desc: [
		"Кровать — точка возрождения: умер — проснёшься здесь, а не у спавна мира."
		"Кровать собирает миксер: 3 доски + 3 шерсти одного цвета (квест ждёт красную)."
		"Сон возвращает часть рассудка. В ночь набега не поспать: алтарь держит ночь до конца волн."
		"&7&o— Техника безопасности: кровать ставить внутри базы. Снаружи на ней спят другие.&r"
	]
	quest.42B84590A81466C4.title: "Точка возрождения"
	quest.43011314638F3A38.quest_desc: [
		"Таблетка: &e+25%&r рассудка сразу. Есть можно в любой момент, даже сытым."
		"Только миксер Create: сахар + сладкие ягоды + любой маленький цветок + &eцелебные споры&r → &a6 таблеток&r. Споры — форпост «Грибные пещеры»: пышные пещеры или грибные поля (глава «Сеть форпостов»)."
		"Поставь на поток: перед шахтой и перед набегом держи стопку."
		"&7&o— Фармотдел Axiomativ: «Побочные эффекты: спокойствие, ясность, желание выйти на вторую смену».&r"
	]
	quest.43011314638F3A38.title: "Успокоительное"
	quest.431F293EFF616CE7.quest_desc: [
		"Горячий воздух — в люк, сверху — руда + известняковый песок + коксовая пыль."
		"Выгоднее всего &eсырое железо&r: 1 штука → 288 мБ стали (2 слитка). Дроблёная руда или железная пыль — по 144 мБ."
		"Выходят жидкая сталь, шлак и печной газ (газ — обратно в нагреватель). Сталь разливай в &6литейный бассейн&r: 144 мБ → слиток."
		"&7&o— Отдел закупок Axiomativ: «Сталь варим сами. Поставщики не выдержали ночных смен».&r"
	]
	quest.431F293EFF616CE7.title: "Первая сталь"
	quest.43AB898E82F67601.quest_desc: [
		"Зачем: первое ружьё — одна пуля, но какая."
		"Сборка: андезитовый сплав, железная пластина, огниво, окорённое бревно (миксер или крафтеры)."
		"&e10 урона&r бумажным патроном, 1 выстрел — и 3,5 с перезарядки. Бумажный патрон с картечью — 12 дробин, 20 урона на весь заряд вблизи."
		"{@pagebreak}"
		"Насадки (меню оружия): длинный ствол, ствол мушкетона, многозарядные камеры, приклад, прицел."
		"&eШтык&r (латунная + 2 железные пластины) — чтобы колоть, когда кончились патроны."
		"&7&oПоследний патрон — для зомби. Штык — для следующего.&r"
	]
	quest.43AB898E82F67601.title: "Самопал"
	quest.43B32A69C5B37F32.quest_desc: [
		"Зачем: с поздних волн удары пробивают любую броню. Энергощит снимает &e50 %&r урона ДО брони — броня режет остаток, защита множится."
		"Модуль на &eлюбой нагрудник&r (незерит, сплав, Cataclysm…): механические крафтеры — модуль + нагрудник + электрическая медь. Чары и прочность сохраняются."
		"Mk1 — крафтеры: 4 электрические меди, 2 конденсатора, 2 электрумовых листа, модульный аккумулятор."
		"{@pagebreak}"
		"Заряд: 1 000 FE за единицу поглощённого урона. Mk1 — 200 000 FE = 200 единиц. Кончился — нагрудник работает как обычный, над хотбаром «Энергощит разряжен»."
		"Заряжается &cтолько под куполом генератора щита&r: стой внутри — полный за 10 с. Катушка Теслы, энерджайзер и батареи его не заряжают."
		"&7&o— Бухгалтерия: «Щит бесплатный. Платит купол».&r"
	]
	quest.43B32A69C5B37F32.title: "&bЭнергощит&r"
	quest.43FE6A7416401283.quest_desc: [
		"&eБойлер-нагреватель&r греет котёл вместо горелки — теплом, без угля и тортов."
		"Ставится под дно бака, тепло подводят трубами:"
		"&650&r тепла/с — только пассив"
		"&6100&r/с — &61&r уровень (как уголь)"
		"&6400&r/с — &62&r уровня (как торт)"
		"&6500&r/с — &63&r уровня, лучше торта"
		"500/с солнцем не набрать — это реактор: один стержень = один нагреватель на 3 уровня."
		"{@pagebreak}"
		"Рецепт — миксер: пустая горелка + 2 трубы + заряженное железо + 4 железных самородка."
		"Заряженное железо делает электризатор — справка «Зарядка» в стадии «Ток»."
		"&7&oНагреватель на реакторе — как горелка, только светится в темноте. И ты тоже.&r"
	]
	quest.43FE6A7416401283.title: "Нагреватель под котлом"
	quest.4423BC3944555606.quest_desc: [
		"Финал «Кузница»: &4Незеритовое чудовище&r и &4Игнис&r разом плюс вся орда: 18 подволн, мобов в 6 раз больше, сами в 1,6 раза крупнее."
		"&6Награда каждому&r: &53 Сердца ночи&r, &e2 звезды Незера&r и сильный артефакт."
		"&7&o— Пресс-служба Axiomativ: «Смена закрыта. Орда уведомлена. Переработка — в Бесконечности».&r"
	]
	quest.4423BC3944555606.title: "Волна 100: финал смены"
	quest.443ADCBE0E31176B.quest_desc: [
		"Звёздные карты — путь в космос. Ядро навигации (награда 50-й волны) без них бесполезно: &eконтроллер ракеты&r (3 карты), &eзвёздный навигатор&r (2), &eмежпланетный навигатор&r Northstar (2), &eкомпьютер наведения&r (по карте в каждом круге сборки)."
		"&eГде:&r самые высокие пики — от высоты 200. Примета — тёмно-синий камень со звёздами, светится, над ним искры."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на звёздный камень, по бокам пусто → &6звёздная пыль&r."
		"Сборка по шагам на конвейере: бумага → деплоер со звёздной пылью → деплоер со светящимся чернильным мешком → пресс = &6звёздная карта&r."
		"&7&oЗвездочёт Axiomativ получает надбавку за высоту. И за то, что не боится её.&r"
	]
	quest.443ADCBE0E31176B.title: "Обсерватория"
	quest.448B006147B5FDA1.quest_desc: [
		"Куда складывать ток про запас."
		"&eАккумулятор C&A&r — &62 000 000 FE&r на блок. Блоки сливаются: до 3×3 в ширину и 5 в высоту — &690 000 000 FE&r. Приём и отдача — без лимита."
		"Миксер: латунный корпус + медный стержень + электрумовый провод + 2 конденсатора. Конденсатор — миксер: медный и цинковый листы, факел из редстоуна и 100 мБ электролита (форпост «Солеварня»)."
		"Подключение — соединитель на аккумулятор и провод к сети."
		"{@pagebreak}"
		"&eНакопитель TFMG&r — &62 500 000 FE&r на блок, для сети TFMG."
		"Мелкий запас есть и в машинах: генератор и мотор C&A — по &65 000 FE&r, мотор New Age — от &616 000 FE&r."
		"&7&oАккумулятор на 90 миллионов FE — как копилка, только разбить молотком не выйдет. Мы пробовали.&r"
	]
	quest.448B006147B5FDA1.title: "Справка: хранение"
	quest.448C11C81BCE9735.quest_desc: [
		"Главный источник силы в паке. Порядок сборки:"
		"1) баки — это котёл;"
		"2) горелки под дно бака;"
		"3) вода помпой;"
		"4) паровые двигатели на стенки."
		"Котёл имеет &eуровень&r от 0 до &618&r. Уровень = меньшее из трёх: нагрев, вода, размер. Уровень N кормит N двигателей по &616 384 SU&r."
		"Таблица — справка «Уровни котла»."
	]
	quest.448C11C81BCE9735.title: "2 · Пар"
	quest.44FB9161122A88F5.quest_desc: [
		"&6Тяговый рычаг&r выдаёт аналоговый редстоун-сигнал: зажми ПКМ и потяни — это твой газ. Ключом сигнал инвертируется."
		"Крафтеры: палка над латунным корпусом."
		"Сигнал веди на то, что должно слушаться: реверс, сцепление, горелку, двигатели."
	]
	quest.44FB9161122A88F5.title: "Газ"
	quest.46097C31CBD877FE.quest_desc: [
		"Воздух под водой: электролизёр делает кислород из воды и тока (FE). Воду — трубами."
		"Крафтеры: стекло, пружина, стекло; медный блок, электронная лампа, медный блок; 3 медных блока."
		"Ток — глава «Электричество»: генератор C&A на валу или генераторы New Age."
		"&7&o— Бухгалтерия: «Кислород — не расход, а инвестиция в сотрудника».&r"
	]
	quest.46097C31CBD877FE.title: "Электролизёр"
	quest.461C80366979523A.quest_desc: [
		"В воздухе штуковина оторвана от наземных валов — пропеллер крутит двигатель на борту. Топливо печи жжёт сам, подавать можно воронкой. Торт блейза — перегрев: вдвое больше оборотов и силы."
		"{@pagebreak}"
		"&6Узел двигателя&r — последовательная сборка из железного листа: пила → пресс, 8 кругов, выход ~50 % (остальное — обрезки)."
		"&6Крафтеры&r столбиком: железный лист, узел двигателя, доменная печь. Цвет — любым красителем."
	]
	quest.461C80366979523A.title: "Портативный двигатель"
	quest.4647E91516588EFE.quest_desc: [
		"Блок базы — фундамент алтаря. Ставится только &eвнутри зоны базы&r; над ним должно быть пусто — там вырастает &5Алтарь смены&r."
		"Рецепт: костёр, резной каменный кирпич и 5 каменных кирпичей (миксер или крафтеры)."
		"Алтарь не ломается. Переезд — сломай блок базы, алтарь уйдёт с ним (идущий набег отменится)."
		"Shift + ПКМ по блоку базы с блоком в руке — просто строить рядом."
		"{@pagebreak}"
		"&7&o— Техника безопасности: алтарь не тушить. Он не для этого горит.&r"
	]
	quest.4647E91516588EFE.title: "Блок базы и алтарь"
	quest.4653E9EEEA38CD03.quest_desc: [
		"Только в &6Межпланетном точиле&r: светлый + тёмный стабилит → 1 стабилитовый слиток."
		"Одна половинка не плавится нигде: равновесие — только когда обе вместе."
		"Слиток нужен для &dСтабилитовой кирки&r — она ниже."
		"&7&o— Отдел по работе с ордой: «Свет и тьма договорились. Орде бы так».&r"
	]
	quest.4653E9EEEA38CD03.title: "Стабилитовый слиток"
	quest.4758E9E111669784.quest_desc: [
		"Зачем: без кирки нет камня, а без камня — ни андезита, ни гравия, ни металла."
		"Собери на сборщиках &6деревянную кирку&r (доски сверху, палки столбиком), накопай булыжника — и собери &6каменную&r."
		"Кирка — первый фигурный рецепт: где важен порядок клеток, там только сборщики."
		"{@pagebreak}"
		"В шахте бери булыжник, &6андезит&r, &6гранит&r, уголь. Сырую руду копи &eвпрок&r: печь её не плавит, жернов не мелет. Её раздробят колёса после латуни — с бонусом ×1,5."
		"В темноте и на глубине падает &5рассудок&r: факелы и еда с собой."
		"&7&o— Техника безопасности: в шахту спускаются с факелом. Без факела тоже спускаются, но один раз.&r"
	]
	quest.4758E9E111669784.title: "Кирка и спуск в шахту"
	quest.475FB140DE9CB6C6.quest_desc: [
		"Зачем: толпа у стены — его любимое блюдо."
		"2 ствола — два залпа почти подряд, заряжается по одному патрону. Урон — на весь заряд вблизи, дальше слабеет:"
		"&eдробь&r — 20 (12 дробин)"
		"&eфлешетты&r — 25 (6 гвоздей)"
		"&eстальные флешетты&r — 30, пробивают"
		"&eзажигательный&r — 20 + огонь на 5 с"
		"{@pagebreak}"
		"Гильзы: латунная пластина → пресс-форма → бумага → оружейный порох → 4 гильзы; дальше деплойер кладёт картечь, гвоздь, стальной гвоздь или огненный порошок."
		"Насадки: барабаны, автоматический зарядник, длинные или рассеивающие стволы, приклад."
		"&7&o— Техника безопасности: дробовиком не открывают двери. Особенно свои.&r"
	]
	quest.475FB140DE9CB6C6.title: "Дробовик"
	quest.479F0A6AA26C07A3.quest_desc: [
		"Алюминий — &eкорпус и пропеллер&r самолётов Immersive Aircraft, &eпарус-крыло&r, умный пропеллер и гироскопический подшипник Aeronautics, цилиндры и большой двигатель TFMG. Боксит в горах больше не генерируется."
		"&eГде:&r саванны и плато. Примета — рыжий бокситовый пласт."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на пласт, сбоку вода и блок глины → &6боксит&r."
		"Дробилка → &6дроблёный алюминий&r (+50 %)."
		"Вентилятор через лаву (или печь) → &6алюминиевый слиток&r; промывка → 10 самородков."
		"Ванна-электролизёр TFMG из бокситового порошка тоже работает — порошок падает при дроблении."
	]
	quest.479F0A6AA26C07A3.title: "Бокситовый карьер"
	quest.47F332A4CE098BA9.quest_desc: [
		"Кастрюле нужен огонь снизу: &6плита&r, костёр или &6горелка блейза&r (Central Kitchen) — горелка ещё и ускоряет варку."
		"Плита — &6миксер&r: 3 железа, 4 кирпича, костёр."
		"{@pagebreak}"
		"&6Сковорода&r (миксер: 4 железа + кирпич) на плите жарит то же, что печь: бекон, яичницу — на виду."
		"Костёр — миксер: уголь, 3 бревна, 3 палки."
		"&7&o— Столовая: «Плита не отапливает барак. Мы проверяли. Трижды».&r"
	]
	quest.47F332A4CE098BA9.title: "Огонь: плита и сковорода"
	quest.48443F5795D4DD05.quest_desc: [
		"Зачем: одна котельная вместо горелки под каждым бассейном. Горелки стоят рядом, их жар идёт по тепловым трубам к &eнагревателям&r под бассейнами и котлами."
		"&eТеплообменник&r ставится &eна горелку всполохов&r. Трубы цепляются сверху и с боков."
		"Горелка на угле — &6200 ˚T/с&r (ровно один нагреватель на обычный нагрев), на торте всполоха — &6400 ˚T/с&r. Без топлива — ноль."
		"Топливо горелка ест как обычно: уголь — &680 с&r, торт — &6160 с&r суперогня и ещё &6250 с&r обычного. Котельную удобно кормить одним конвейером."
		"{@pagebreak}"
		"&eСхема:&r 4–8 горелок в ряд, на каждой теплообменник, сверху общая труба → магистраль → &eвентили&r → нагреватели."
		"4 горелки на угле — &6800 ˚T/с&r: 4 нагревателя на обычный нагрев или 1 на суперогонь. На тортах вдвое больше — 2 на суперогонь (8 горелок — 5)."
		"Сеть котельная греет не выше &68 000 ˚T&r — до лавы (10 000) не дойдёт."
		"Сборка — механические крафтеры: медный корпус, тепловая труба, 2 медных листа, электрическая медь. Рецепт — в JEI (R)."
		"&7&o— ОТК: «Всполох в котельной греет лучше, чем всполох на свободе. Проверено на всполохах».&r"
	]
	quest.48443F5795D4DD05.title: "Котельная: теплообменник"
	quest.48E420D53A0BA874.quest_desc: [
		"&6Латунный экструдер&r (сборка, R): синий лёд и лава по бокам, снизу блок эндерняка — один раз принести из Энда."
		"Эндерняк → жернов → дроблёный → сито."
	]
	quest.48E420D53A0BA874.title: "Эндерняк"
	quest.48E881DFD6B3194F.quest_desc: [
		"Зачем: нагрудник после крафта пустой. Заправь до старта."
		"&eНаполнитель кислорода&r (механические крафтеры): 4 титановые пластины + 2 железные + схема + отделитель кислорода + &eфильтр воздуха&r (форпост «Торфяник»)."
		"&eАтмосферный концентратор&r (механические крафтеры): 4 титановые пластины + 4 шерсти + пропеллер + отделитель кислорода + 2 схемы + жидкостный бак + вал."
		"{@pagebreak}"
		"Концентратор крутится валом (быстрее вал — быстрее сбор) и копит газ из воздуха. Помпа и трубы — в Наполнитель."
		"ПКМ нагрудником по Наполнителю — вставить, пустой рукой — забрать. 6 мБ за тик: полный баллон за 15 секунд."
		"{@pagebreak}"
		"Концентратор берёт то, что в воздухе: на Земле — кислород, на Марсе и Венере — углерод, на Луне и Меркурии — ничего."
		"Наполнитель работает и на борту: поставь в ракету с баком кислорода — заправишься на месте."
		"&eЭлектролизёр&r (из марсианской стали) делает кислород из воды где угодно — это позже."
	]
	quest.48E881DFD6B3194F.title: "Кислород: заправка"
	quest.491272F16FC2DDA7.quest_desc: ["Хладагент держит тяжёлые двигатели и реактор, фильтры дают дышать под водой и в космосе."]
	quest.491272F16FC2DDA7.title: "Холод и болото"
	quest.495D204B1F3208FC.quest_desc: [
		"Зачем: личный аргумент против ночной орды."
		"Механические крафтеры: стальные пластины и слитки, латунные пластины, шестерни, точный механизм, андезитовый сплав."
		"&e8 урона, 4 выстрела в секунду&r (32 в секунду), лента на 100, раскручивается перед очередью. Бронебойный патрон — 12 и пробивает 2 цели."
		"{@pagebreak}"
		"Патроны: латунная пластина → пресс-форма → оружейный порох → 4 гильзы; гильза + свинцовый + медный самородки → патрон (стальной вместо свинцового — бронебойный)."
		"Насадки: барабанный магазин, паровой двигатель."
		"&7&oГатлинг не решает проблему орды. Он решает орду.&r"
	]
	quest.495D204B1F3208FC.title: "Гатлинг"
	quest.4A02A98E37913188.quest_desc: [
		"Зачем: крутить пушку к цели по горизонту и по высоте."
		"&6Контроллер горизонтального прицеливания&r — под крепление пушки, &6вертикального&r — рядом. Обоим нужно вращение."
		"Передатчик данных: ПКМ по креплению, затем линк на каждый контроллер."
		"Работает только с креплениями Big Cannons (большие пушки и автопушки). Лазерные турели и ракетные установки радар не наводит."
	]
	quest.4A02A98E37913188.title: "Наводчики"
	quest.4AAC4C0B6EC1E5CE.quest_desc: [
		"Пыль — то, что дробилка достаёт из осколка; из неё варят эссенцию."
		"&eДробильные колёса&r: осколок → пыль + 10 % ещё одна. &eЖернова&r: 1 к 1 и медленнее. Хочешь быстрее — больше колёс и оборотов."
		"Руками не мелется: «Вахта» — руками только собирать."
	]
	quest.4AAC4C0B6EC1E5CE.title: "Пыль орды"
	quest.4AE3A069B2294E37.quest_desc: [
		"В паке ещё несколько кухонных модов, все на машинах Create:"
		"&eCreate Food&r — пицца, булки, мороженое, супы-жидкости."
		"&eCreate Confectionery&r — шоколад, конфеты, пряники."
		"&eGarnished&r — орехи, соусы, закуски."
		"&eCreate Winery&r — вино из винограда."
		"&eSome Assembly Required&r — сэндвичи."
		"{@pagebreak}"
		"Как найти рецепт: наведи на предмет в JEI и нажми &6R&r — видно, какая машина его делает. &6U&r — куда он идёт дальше."
		"&7&o— Отдел кадров: шоколад в каске не носить. Тает.&r"
	]
	quest.4AE3A069B2294E37.title: "Справка: ещё кухни"
	quest.4B15D3F36F382850.quest_desc: [
		"Зачем: турель стреляет, пока на складе есть патроны, — без рук."
		"&6Автоподача&r ставится вплотную к собранному лафету автопушки и кормит его. ПКМ — 64 основных + 64 трассера и через сколько выстрелов трассер."
		"Принимает воронки, желоба и механическую руку: конвейер от патронной линии — прямо в турель."
		"{@pagebreak}"
		"&6Большой ящик патронов&r — 64 + 64, при поломке патроны и настройки сохраняются."
		"&6Умный стеллаж&r — 40 готовых выстрелов, сам выбирает следующий тип и кормит соседний лафет; &6карусель&r 3×3 — 24 комплекта, крутится валом снизу."
		"&6Сборщик гильз&r — подбирает стреляные гильзы в 6 блоках вокруг; &6автоконтроллер&r — превращает обычный редстоун в очередь или залп."
		"&7&o— Служба доставки: «Посылка для орды. Оплата при получении».&r"
	]
	quest.4B15D3F36F382850.title: "Автоподача патронов"
	quest.4BDCC99B7C9A545A.quest_desc: [
		"&6Богатая почва&r: растения на ней растут быстрее. Вспаши мотыгой — выйдет богатая пашня."
		"Начало — &6органический компост&r, миксер: земля, 2 гнилой плоти (или 4 коры от окорки брёвен), 2 соломы, 4 костной муки."
		"{@pagebreak}"
		"Блок компоста на земле сам со временем становится богатой почвой."
		"Быстро: компост + 250 мБ воды в миксере → жидкое удобрение (Slice & Dice). Дозатор льёт 500 мБ удобрения на компост — сразу богатая почва."
	]
	quest.4BDCC99B7C9A545A.title: "Богатая почва"
	quest.4BE51863FE0E8FAE.quest_desc: [
		"Зачем: в каждом свитке — одно заклинание с уровнем. Это и есть то, что вписывают в книгу."
		"Где взять: &6редкая добыча набегов&r (с 27-й волны свитки сильнее), сундуки магических построек, странствующий торговец. Свои — в кузнице свитков."
		"ПКМ свитком — колдует один раз без маны и перезарядки, но свиток сгорает. Хорошее — лучше вписать в книгу."
	]
	quest.4BE51863FE0E8FAE.title: "Свитки"
	quest.4C3550A20ABDE71C.quest_desc: [
		"Зачем: без очков машина — чёрный ящик. В очках видно скорость, запас сети, жидкость в баках и стрелки сборщиков."
		"Очки выдают каждому при высадке. Надень на голову и наведи на блок."
		"Потерял — рецепт в JEI (&6R&r): золотой лист, стекло, нить."
	]
	quest.4C3550A20ABDE71C.title: "Инженерные очки"
	quest.4C8775EB335DCF89.quest_desc: [
		"Машина, которая сама копает тоннель и складывает добычу в сундук на борту."
		"&6Буровое колесо&r ломает блоки в радиусе вокруг себя. Крафтеры столбиком: дробильное колесо, промышленный железный блок, железный лист."
		"{@pagebreak}"
		"&6Буровой подшипник&r: плита, коробка передач, промышленный железный блок. Нужны хотя бы одно колесо и сундук в конструкции."
		"&cТонкость:&r крутится в 4 раза медленнее источника. Полный сундук — бур встаёт."
	]
	quest.4C8775EB335DCF89.title: "Бур-вездеход"
	quest.4CB4973DAB869AD0.quest_desc: [
		"Зачем: рюкзак сам кормит, когда проголодаешься, — выручает в долгих вылазках и набегах."
		"Основа улучшения + золотое яблоко, золотая морковь, сверкающий ломтик арбуза, жемчуг Эндера (R)."
		"&7&o— Столовая Axiomativ: «Обед по расписанию». Рюкзак: «Обед по голоду». Рюкзак победил.&r"
	]
	quest.4CB4973DAB869AD0.title: "Улучшение «Кормление»"
	quest.4D03C9F63A7D2222.quest_desc: [
		"Зачем: с 20-й волны без неё рискованно."
		"Защита &e20&r и вязкость &e8&r (вязкость снимает часть урона от сильных ударов)."
		"Алмазы — из шахты, с глубинных руд, из добычи набегов."
	]
	quest.4D03C9F63A7D2222.title: "Алмазная броня"
	quest.4D8732FCCCBD523B.quest_desc: [
		"Зачем: с 70-й волны орда несёт материалы на лучшее оружие."
		"Добыча боссов падает, даже если их добили турели. Всё — механическими крафтерами, рецепты в JEI (R):"
		"&eЧёрная сталь&r (драугры) — меч, топор, щит"
		"&eДревнее копьё&r — 9,5 (кобольды, Уаджет)"
		"&eИспепелитель&r — 14 (Игнис, 82+)"
		"&eРасплата душ&r — 15 (Маледиктус, 85+)"
		"{@pagebreak}"
		"&eВизеритовый гранатомёт&r — ракета 16 (Предвестник, 87+)"
		"&eКеравн&r — 16, молнии (Сцилла, 95+)"
		"Только с боссов: &6Перчатка защиты&r (Страж Края) и &6Незеритовый горн&r (Незеритовое чудовище)."
		"Отметь, когда в руках первый трофей."
		"&7&oБосс — это моб, который пришёл со своим лутом. Невежливо не взять.&r"
	]
	quest.4D8732FCCCBD523B.title: "Трофеи Cataclysm"
	quest.4D8D8F451184D8CF.quest_desc: [
		"Супы и рагу сытнее сырья в разы. &6Механические крафтеры 3×3&r: верх — кирпич, деревянная лопата, кирпич; середина — железо, ведро воды, железо; низ — 3 железных слитка."
		"Как варить: под кастрюлей огонь, продукты — в окно (ПКМ), в слот посуды — миски (&6миксер&r: 3 доски → 4 миски)."
		"Блюдо варится само и ждёт внутри."
	]
	quest.4D8D8F451184D8CF.title: "Кастрюля"
	quest.4DADC2F0709A2873.quest_desc: [
		"Вдали, в ~280 блоках, вырастает &2гнездо&r с маткой (~1 400 HP) и стражей, которая подтягивается каждые 30 с."
		"Долететь, пробиться и убить матку за 8 минут. Куда лететь — над хотбаром."
		"Повторы — 54 и 66."
		"Первое прохождение: &6Сердце матки&r."
	]
	quest.4DADC2F0709A2873.title: "Волна 36: Штурм гнезда"
	quest.4E5B7F2646C73C7C.quest_desc: [
		"Первые рецепты кастрюли, от простого:"
		"&6Костный бульон&r — кость + светящиеся ягоды, гриб, висячие корни или светящийся лишайник. Грядка не нужна: кости — со скелетов."
		"{@pagebreak}"
		"&6Овощной суп&r — морковь, картофель, свёкла, капуста."
		"&6Жареный рис&r — рис, яйцо, морковь, лук."
		"Каждому — миска. Остальное меню — JEI, U по кастрюле."
		"&7&o— Бухгалтерия: «Бульон из костей скелета — безотходное производство. Скелет не возражал».&r"
	]
	quest.4E5B7F2646C73C7C.title: "Суп дня"
	quest.4E80ABFD6CFAE6FF.quest_desc: [
		"В ~350 блоках от базы ждёт &6обоз&r — три вьючные ламы (~630 HP каждая). Идёт к алтарю, только пока рядом охрана (ближе 48 блоков); куда лететь — над хотбаром."
		"Каждые 15 с — &cзасада&r впереди обоза: пауки, сольпуги, стрекозы бьют лам. Довести до базы хоть одну за 6 минут. Своих лам вы не раните."
		"Застрявшую ламу обоз подталкивает сам. Повтор — 63: путь длиннее, засады злее."
		"Первое прохождение: &6Пломба конвоя&r."
	]
	quest.4E80ABFD6CFAE6FF.title: "Волна 43: Конвой"
	quest.4EEA6A53FCBBE2D0.quest_desc: [
		"Бродяги (4–7): скелеты, трясинные скелеты, пауки, слизни, кадавры и первые &cгромилы&r (60 HP)."
		"Каждая 5-я волна — с боссом. Здесь впервые &4Вожак орды&r: зомби в железе, 90 HP. Босс — два броска добычи."
		"Готовьтесь: железная броня, щит, лук, ловушка на подходе."
	]
	quest.4EEA6A53FCBBE2D0.title: "Волна 5: Вожак орды"
	quest.4F2010ED01E72F75.quest_desc: [
		"Зачем: ключ поворачивает блоки Create, разворачивает стрелки сборщиков и снимает детали без поломки."
		"&6ПКМ&r — повернуть. &6Shift+ПКМ&r — снять блок в инвентарь."
		"Выдают каждому при высадке. Держи в хотбаре: нужен на каждом шагу."
	]
	quest.4F2010ED01E72F75.title: "Гаечный ключ"
	quest.4F818187E549D44C.quest_desc: [
		"Пробуждённый артефакт — та же вещь, но сильнее: &a+50 % к числам&r, перезарядки щита и второго дыхания на треть короче, эффекты держатся дольше."
		"Как: &eсборка по шагам&r Create — артефакт на ленте проходит деплоер (эссенция), пресс и наполнитель (250 мБ лавы). Кругов — сколько эссенций: эпический 2, легендарный 3, мифический 4, божественный 5."
		"{@pagebreak}"
		"Пробуждаются эпические и выше — артефакты волн, арены и трофеи боссов, всего 37. Имя — со звёздочкой ✦."
		"Потолки суммы прежние: срез урона ≤35 %, вампиризм ≤20 %, уклонение ≤25 %; здоровье от артефактов — не больше +60. Обычный и пробуждённый одного вида вместе не наденутся. В переплавку пробуждённые не идут."
		"Пример: &cСердце орды ✦&r — +21 к здоровью (10,5 сердца); вампиризм 9 % нанесённого урона (до 4,5 HP за удар); вне боя +0,8 HP/с (5 с без урона). Пробуждённый: +50 % к числам, перезарядки на треть короче."
		"&7&o— ОТК: «Пробуждённый артефакт проверен прессом. Трижды. Претензии — к прессу».&r"
	]
	quest.4F818187E549D44C.title: "&6Пробуждение ✦&r"
	quest.4F84F2F6E6210ECF.quest_desc: [
		"Зачем: без стрелок сеть с развилками не построить."
		"Миксер: рычаг + андезитовый корпус + шестерня (мод Steam 'n' Rails)."
		"Переводит состав на другую ветку — вручную или редстоуном."
	]
	quest.4F84F2F6E6210ECF.title: "Стрелочный перевод"
	quest.502442B12090F06D.quest_desc: [
		"Магистраль без лимита по току."
		"&eВысоковольтный соединитель&r (большой) — миксер: золотой или электрумовый стержень + 2 андезитовых сплава + резина → &62&r."
		"&6Без лимита&r FE/т, &66&r проводов, пролёт &632&r блока."
		"Между двумя большими — только &eзолотая&r или &eэлектрумовая&r катушка, медная не встанет."
		"{@pagebreak}"
		"&eЗамена за клик:&r Shift+ПКМ большим соединителем по малому — блок меняется на месте, провода остаются, малый вернётся в инвентарь."
		"Сеть — общий котёл: лимит только у соединителей, где ток входит и выходит. Промежуточные опоры можно не менять."
		"&7&o— Служба доставки: «Толстый кабель везёт всё и сразу. Как мы, только без выходных».&r"
	]
	quest.502442B12090F06D.title: "Толстый кабель"
	quest.5050456F7CF14F06.quest_desc: [
		"Балласт держит глубину, водомёт или винт двигают вперёд, прочное стекло держит давление, электролизёр с диффузором дают дышать."
		"Первое полноценное погружение: корпус цел, экипаж дышит, лодка слушается."
	]
	quest.5050456F7CF14F06.title: "Подлодка на глубине!"
	quest.507306DCDCF2C239.quest_desc: [
		"Зачем: без контроллера станция не соберёт поезд."
		"Миксер: рычаг + железнодорожный корпус + механизм точности."
		"Хотя бы один контроллер смотрит вперёд; второй, назад, — отправление в обе стороны. ПКМ — сесть и ехать клавишами."
	]
	quest.507306DCDCF2C239.title: "Контроллер поезда"
	quest.5097DA3954C254B0.quest_desc: [
		"Башня делит нефть на фракции. Основа — стальные баки, рядом с ними — &6контроллер&r: в него заливают нефть."
		"Над баками — до 6 &6выходов&r, между ними промышленные трубы. Под баками — источник тепла: шкала на башне показывает мощность, без тепла башня стоит."
		"Контроллер: 2 свинцовые пластины, 2 лампы, компас, корпус тяжёлой машины, промышленная труба, 2 стальных механизма."
	]
	quest.5097DA3954C254B0.title: "Перегонная башня TFMG"
	quest.50B0F735AA99D36F.quest_desc: [
		"Зачем: вписать свиток в книгу — заклинание станет многоразовым."
		"Механические крафтеры 3×3: книга в правом верхнем углу, 3 деревянные плиты в среднем ряду, 2 забора по краям нижнего ряда; пустые клетки — крафтеры с крышкой слота."
		"ПКМ по столу: книга в левый слот, свиток — в свободную ячейку, «Начертать». Свиток можно вынуть обратно, но заклинание из книги уйдёт."
		"&7&o— Юротдел: всё, что вписано в книгу, может быть использовано против орды.&r"
	]
	quest.50B0F735AA99D36F.title: "Начертательный стол"
	quest.50FADB6F1F2FFCC9.quest_desc: [
		"Зачем: передать вращение вбок и под углом 90°."
		"Соседние шестерни крутятся &cв разные стороны&r, лента — в одну. Перепутал — пила кинет доски назад, колёса не будут дробить."
		"Рецепт: вал + доска (миксер или активатор)."
	]
	quest.50FADB6F1F2FFCC9.title: "Шестерня"
	quest.5132CCC7A875B401.quest_desc: [
		"С 16-й волны в ордах &cтолько мобы модов&r: пауки, сколопендры, скорпионы и летуны ArPhEx, глубинники и драугры Cataclysm, гости с планет, Пещерный житель."
		"У каждой волны свой &6праздник&r и &eпремьера&r — моб, которого ещё не было. На старте — титр и совет в чате: что он делает и чем его бить. Потом он входит в общий пул."
		"{@pagebreak}"
		"Примеры: 16 — Паук-шнырь, 18 — Подрывник, 22 — Стрекоза-дредноут (летает), 30 — Богомол-потрошитель (бьёт на 15), 37 — Пещерный житель, 50 — Краб-душитель."
		"С 58-й — особые варианты: Королева шнырей, Подрывник-тяжеловес, Невидимый жнец, Голиаф-титан. С 70-й у каждой волны — «звезда вечера»."
		"Удар у модовых мобов сильнее ванильного — держат &eброня с «Защитой»&r, &bэнергощит&r и &dартефакты смены&r."
		"&7&o— Пресс-служба: «Каждую ночь — премьера. Билеты бесплатные, выход — нет».&r"
	]
	quest.5132CCC7A875B401.title: "Премьеры: новая тварь каждую волну"
	quest.515EB053AE51DC78.quest_desc: [
		"&eПКМ по алтарю&r (или по блоку базы под ним) — окно &eПульт алтаря&r: всё про набеги в одном месте. Вкладки — мышью или клавишами &e1–6&r."
		"&eВолны&r — сетка по 20: &aзелёные ✔&r пройдены (фармите сколько угодно), &eжёлтая ▶&r — следующая, серые закрыты. В клетке — праздник волны и значки угроз. Листать — стрелками или колесом."
		"&eДосье&r — нажми на волну: каждая подволна, мобы с числом на всю команду и здоровьем с усилениями волны, значки угроз и «чем бить», босс, условия смены, тема арены, добыча и шансы артефактов. Кнопки &a[▶ Старт]&r и &b[→ Арена]&r."
		"{@pagebreak}"
		"Значки угроз: летают, невидимые, подрывники, лезут по стенам, плодят детёнышей, бронированные, быстрые, идут сквозь щит, ломают щит, выжигают щит, босс. Наведи на значок или моба — совет."
		"&eБестиарий&r — моб открывается после первой встречи в набеге: модель, здоровье, удар, особенности, совет, с какой волны. В досье закрытых волн ещё не встреченные — «???»."
		"&eУсловия&r, &eКонтракты&r и &eАртефакты&r (переплавка 3 → 1) — там же."
		"На старте каждой подволны в чате — строка досье: «Подволна 3: невидимые — нужен прожектор; летуны — ПВО». Наведи — состав."
		"{@pagebreak}"
		"Меню в чате осталось запасным: &e/nightshift menu&r в 64 блоках от алтаря. Досье любой волны текстом — &e/nightshift dossier N&r."
		"Волн &e100&r, сила растёт плавно; после сотой — &dБесконечность&r."
		"Волна — это несколько &eподволн&r подряд (3 в начале, 18 после 70-й), в конце босс: каждая &e5-я&r волна, с 70-й — каждая."
		"После старта — 15 секунд на подготовку (у малого набега — минута), ночь стоит до конца набега. Орда выходит кольцом в 30–45 блоках (за зоной) и идёт к алтарю. Моб у алтаря — &cпровал&r."
		"{@pagebreak}"
		"Обычные монстры у алтаря на время набега исчезают, мобы орды друг друга не трогают."
		"Никого ближе 160 блоков к алтарю — набег на паузе, орда ждёт. Кто далеко — получит кнопку &a[Телепорт к алтарю]&r; после набега вернёт, откуда забрала."
		"Мобов считают на всю команду онлайн: вдвоём — ×1,5, втроём — ×2. Начать может любой."
		"&7&o— Отдел по работе с ордой: «Досье выдаётся до боя. После боя оно называется некрологом».&r"
	]
	quest.515EB053AE51DC78.title: "Пульт алтаря"
	quest.51BC26FDB7EE8214.quest_desc: [
		"Чтобы летать, взрослому дракону нужно &6седло&r (ПКМ седлом по дракону или слот в его инвентаре)."
		"Рецепта у седла нет: сундуки подземелий и храмов, рыбалка, кожевник-мастер — или &6стол трансмутации&r за 192 EMC."
	]
	quest.51BC26FDB7EE8214.title: "Седло"
	quest.521CD648E130FD9F.quest_desc: [
		"Зачем: оружие и ближнего, и дальнего боя."
		"Не собирается. Бывает в редкой добыче набегов 35–42 волн и падает с утопленников в диком мире (утопленники набега трезубцы не роняют)."
		"Удар — 9, бросок — 8. С &aВерностью&r возвращается в руку."
	]
	quest.521CD648E130FD9F.title: "Трезубец"
	quest.5257CFCF4554E0AE.quest_desc: [
		"Где яйцо (шанс на сундук) и чем порода хороша:"
		"&cОгненный&r — пустынный храм 6,5 %; не горит"
		"&4Незерский&r — бастион 35 %, крепость незера 10 %; не горит, броня"
		"&9Водный&r — зарытый клад 17,5 %; плавает, не тонет"
		"&bЛедяной&r — иглу 15 %; мороз, не тонет"
		"{@pagebreak}"
		"&fНебесный&r — данж со спавнером 15 %; быстрый полёт"
		"&7Призрачный&r — заброшенная шахта 15 %; не тонет, иммун к иссушению"
		"&2Лесной&r — храм джунглей 20 %; маскировка"
		"&aПышный&r — особняк 20 %, клад и джунгли 10 %"
		"{@pagebreak}"
		"&dАметистовый&r — библиотека крепости 10 %"
		"&5Эндер&r — коридор крепости 10 %; здоровье 75 вместо 60"
		"&3Скалковый&r — древний город 10 %; эхо-чутьё"
		"Статы у каждого дракона свои (здоровье −5…+10, урон −2,5…+5) — смотри в его инвентаре."
	]
	quest.5257CFCF4554E0AE.title: "Справка: породы"
	quest.526F0A929AFCF674.quest_desc: [
		"Зачем: шесть точных выстрелов в одной руке."
		"Механические крафтеры: стальные пластины и слиток, латунные пластины, шестерня, андезитовый сплав, окорённые брёвна. Рецепт — в JEI (R)."
		"&e8 урона&r, 2 выстрела в секунду, барабан на 6. Бронебойный — &e12&r и пробивает 2 цели."
		"{@pagebreak}"
		"Патроны на конвейере: латунная пластина → деплойер с пресс-формой → деплойер с &eоружейным порохом&r → 8 пустых гильз; гильза + свинцовый самородок → патрон (стальной самородок + свинцовый → бронебойный)."
		"Пресс-форма — железный слиток на пиле с фильтром."
		"Насадки: длинный ствол, прицел, приклад, патронная лента, автоогонь."
	]
	quest.526F0A929AFCF674.title: "Револьвер"
	quest.529610133ACB2780.quest_desc: [
		"Вещи после смерти остаются при тебе, но смерть не бесплатна."
		"Каждая смерть — &cрана&r: −1 сердце максимума (до −5). Лечит только «Настойка жизни»."
		"Рассудок при возрождении &cне восстанавливается&r: каким был, таким и остался, но не ниже 40%."
		"Раны и проклятие алтаря вместе не опустят здоровье ниже 3 сердец."
		"&7&o— Юротдел Axiomativ: «Смерть на смене не освобождает от выхода на смену».&r"
	]
	quest.529610133ACB2780.title: "Цена смерти"
	quest.52B663403D95C5AC.quest_desc: [
		"Зонд = &eбесконечная жила&r своего типа в чанке: ПКМ по земле — и ставь буровую."
		"Цены, EMC: уголь, медь, цинк, сера — 128 000; железо, кварц — 256 000; свинец — 512 000; золото, литий — ~2 млн; платина — ~4 млн; торий — ~6 млн; алмаз — ~8 млн; титан, вольфрам, марсианское железо — ~10 млн."
		"{@pagebreak}"
		"Титан — на любой планете, вольфрам — только на Меркурии, марсианское железо — на Марсе."
		"Первые зонды дают и набеги: за первую волну каждого нового состава — один на команду."
		"&7&oЗонд втыкается в землю один раз. Земля потом долго не может прийти в себя.&r"
	]
	quest.52B663403D95C5AC.title: "Зонд жилы"
	quest.535A1AD00EFCD245.quest_desc: [
		"Ест топливо попроще: дизель, керосин, нафта или &6печной газ&r прямо из домны."
		"Нужен постоянный приток &eвоздуха&r и отвод CO₂ в выхлоп, иначе глохнет. Выход вращения — ПКМ валом."
		"Собирается только на &6механических крафтерах&r (сталь, алюминий, баки, механизмы и &eрадиатор с хладагентом&r — форпост «Ледник») — рецепт в JEI (R)."
	]
	quest.535A1AD00EFCD245.title: "Большой двигатель"
	quest.5374E61F4F20603E.quest_desc: [
		"Зачем: сердце камеры сгорания, Ракетной станции и навигационного компьютера."
		"Последовательная сборка из механизма точности Create, 5 кругов, деплоерами: титановый самородок → железная шестерня Northstar → большая железная шестерня. Выход 85%."
		"Железная шестерня — вал + блок промышленного железа (миксер). Большая — рецепт в JEI (R)."
	]
	quest.5374E61F4F20603E.title: "Закалённый механизм"
	quest.539485CE657AFD69.quest_desc: [
		"Зачем: основа Звёздного навигатора, Звёздной и Стабилитовой кирок и Генератора щита (глава алтаря)."
		"В точило: 2 титановых слитка + вольфрамовый слиток + полированный лунный сапфир → 1 сплав. Точило само находит рецепт — подавай воронками."
		"Три мира в одном слитке: Земля, Меркурий, Луна."
		"&7&o— Бухгалтерия: «Слиток, ради которого облетели три мира, списывать запрещено».&r"
	]
	quest.539485CE657AFD69.title: "&dМежпланетный сплав&r"
	quest.539FB1F056F8E82A.quest_desc: [
		"&eОбвесы&r (прицел, приклад-«ложа», стволы, магазины): оружие в руку → клавиша «Изменить обвесы». По умолчанию Z — она занята картой и зумом, переназначь в Управление → «NTGL Оружие»."
		"{@pagebreak}"
		"Урон за выстрел · выстрелов в секунду:"
		"&eСамопал&r — 10 · раз в 3,5 с"
		"&eРевольвер&r — 8 (12) · 2"
		"&eДробовик&r — 20–30 за залп · 2 залпа"
		"&eГвоздемёт&r — 5 (8) · 10"
		"&eГатлинг&r — 8 (12) · 4"
		"&eРакета&r — 5 + взрыв 20"
		"&eВсполохомёт&r — 2 + огонь · ~7"
		"В скобках — бронебойные и стальные."
		"{@pagebreak}"
		"Пуля снимает с моба неуязвимость после удара — очередь доходит вся."
		"В голову — ×1,25."
		"Выстрел без глушителя злит всех враждебных мобов в 20 блоках: они бросают коридор и идут на стрелка. Гвоздемёт бесшумный."
	]
	quest.539FB1F056F8E82A.title: "Справка: огнестрел"
	quest.53DF778E5B05A4F3.quest_desc: [
		"Чугун — металл, из которого TFMG строит трубы, баки и печи. Без него к стали не подступиться."
		"&6Пресс над бассейном&r с горелкой (обычный нагрев): железный слиток + уголь → &6чугунный слиток&r."
		"&7&o— ОТК: «Чугун не гнётся под критикой. Он сразу трескается».&r"
	]
	quest.53DF778E5B05A4F3.title: "Чугун"
	quest.5419BEC0D04A20F0.quest_desc: [
		"Зачем: с него пилот стартует и тормозит при посадке. Без контроллера станция ракету не соберёт."
		"Рецепт «Ночной смены» — механические крафтеры, 5 рядов: 2 рычага + &dядро навигации&r / 3 &eзвёздные карты&r (форпост «Обсерватория», глава «Сеть форпостов») / 3 титановые пластины / 3 схемы / 3 блока промышленного железа."
		"{@pagebreak}"
		"Как пользоваться: ПКМ по контроллеру собранной ракеты — берёшь управление, как у поезда Create."
		"&eПробел&r — отсчёт 10 секунд до старта. Ещё раз Пробел — отмена."
		"Управлять можно, стоя не дальше 8 блоков от контроллера."
	]
	quest.5419BEC0D04A20F0.title: "Контроллер ракеты"
	quest.54231138C74C436B.quest_desc: [
		"Зачем: сплав — основа машин: валы, шестерни, корпуса, стол трансмутации."
		"&6Миксер&r над &6чашей&r: андезит + железный (или цинковый) самородок = сплав. Нагрев не нужен."
		"Миксер замешивает всё бесформенное — вахта держится на нём."
		"32 сплава из ящика уйдут быстро: андезит — с шахты, самородки — с промывки."
	]
	quest.54231138C74C436B.title: "Андезитовый сплав — миксером"
	quest.54836B2556E2C657.quest_desc: [
		"Зачем: второй тир — обшивка (+8 теплозащиты), термостойкий скафандр, Электролизёр, Продвинутая схема."
		"Пресс над чашей с горелкой: титановый слиток + сырая марсианская железная руда + вулканический пепел → 2 слитка."
		"Руда (обычной киркой) и пепел есть только на Марсе."
		"{@pagebreak}"
		"&eСкафандр из марсианской стали&r — как железный, но из марсианской брони и листов. Держит и холод, и жару выше 300 °C."
		"&eЭлектролизёр&r: вода → кислород + водород. Работает без атмосферы: лёд с Луны — воздух для базы."
		"&eПродвинутая схема&r — для Терморегулятора и Звёздного навигатора."
	]
	quest.54836B2556E2C657.title: "Марсианская сталь"
	quest.54D2D1744EDB509D.quest_desc: [
		"Печь медленно — около минуты на штуку — превращает уголь в &6кокс&r, попутно давая &eкреозот&r и углекислый газ."
		"Рецепт: 4 чугунных слитка + блок промышленного железа → &a2 печи&r (миксер или крафтеры)."
		"Ставь печи рядами. Уголь сыпь с любой стороны, CO₂ откачивай сверху, креозот — с остальных сторон."
	]
	quest.54D2D1744EDB509D.title: "Коксовая печь"
	quest.556DE5924DA9D57F.quest_desc: [
		"Ход под водой. &6Водомёт&r толкает водой под давлением: нужен источник воды (цистерна) и вращение. Выше давление и обороты — быстрее."
		"Миксер: механическая помпа, пропеллер Create, 5 медных блоков."
		"&6Гребной винт&r проще: пропеллер, промышленный железный блок, вал столбиком, ставится на вал. Вне воды бесполезен."
	]
	quest.556DE5924DA9D57F.title: "Водомёт и винт"
	quest.557E6274128BBD2E.quest_desc: [
		"Выдаёт редстоун-сигнал по высоте штуковины, диапазон — в окне блока. С высотой воздух реже и тяга падает: датчик сбросит или прибавит газ за тебя."
		"Крафтеры столбиком: бумага, железный лист, андезитовый корпус."
	]
	quest.557E6274128BBD2E.title: "Датчик высоты"
	quest.55BEB26DF436B36E.quest_desc: [
		"Лучший голем пака — из &dмежпланетного сплава&r: атака 85, здоровье 1000, регенерация 8."
		"Не горит, не боится молний и магии, гасит взрывы, отбивает снаряды, пробивает броню, колется шипами."
		"{@pagebreak}"
		"Цена: 4 точных механизма на каждый цикл. Металлический голем — 36 сплава и 144 механизма, человекоподобный — 18 и 72, пёс — 9 и 36."
		"Сплав делает межпланетное точило (глава «Космос»)."
		"&7&o— Axiomativ: «Всегда есть решение». Иногда решение весит тонну и стоит у алтаря.&r"
	]
	quest.55BEB26DF436B36E.title: "Страж из сплава"
	quest.56635B3491872F7C.quest_desc: [
		"Разметчик отмечает &aзону базы&r: внутри неё монстры сами не появляются."
		"Рецепт: палка + кремень + уголь (подойдёт древесный) — миксер."
		"ПКМ по блоку — первый угол, по противоположному — второй. Зона — колонна на всю высоту мира; с Shift на первом клике — только между высотами кликов."
		"{@pagebreak}"
		"ПКМ в воздух — в какой ты зоне; Shift + ПКМ в воздух — удалить эту зону. С разметчиком в руке видны границы и точки спавна орды."
		"Зон сколько угодно и любого размера. Но набег приходит снаружи: чем больше база, тем длиннее периметр."
		"&7&o— Отдел землеустройства Axiomativ: «Всё, что внутри забора, — наше. Всё, что снаружи, — хочет внутрь».&r"
	]
	quest.56635B3491872F7C.title: "Разметчик базы"
	quest.56666CC5F6622986.quest_desc: [
		"Голем целиком из одного металла, атака / здоровье:"
		"&6Медь&r 10 / 50 — молния не страшна"
		"&7Железо&r 15 / 100"
		"&eЛатунь&r 15 / 150 — стойкость к магии"
		"&eЗолото&r 5 / 20 — регенерация"
		"&8Незерит&r 30 / 300 — огнеупорный"
		"&3Скалк&r 30 / 500 — звуковой удар"
		"&cCataclysm&r (игнитиум, витерит, курсиум) — 30–40 / ~400, свои приёмы боссов"
		"{@pagebreak}"
		"Космос (подробно — квест «Космические металлы»):"
		"&fТитан&r 40 / 400"
		"&9Лунный сапфир&r 35 / 480"
		"&cМарсианская сталь&r 50 / 550"
		"&8Вольфрам&r 65 / 750"
		"&dМежпланетный сплав&r 85 / 1000"
	]
	quest.56666CC5F6622986.title: "Справка: металлы"
	quest.5720C739A6A1590D.quest_desc: [
		"Зачем: отметить, что база кормит сама: руда, камень, металл."
		"Шахта теперь — ради редкостей, приключений и жил под буры (глава «Жилы и экономика»)."
		"Вниз — много и сразу, но рискованно. Линия на базе — медленно, но надёжно. Удачной смены, вахтовик."
		"&7&o— Отдел по работе с ордой: база готова. Орда тоже. Приятно, когда все готовы.&r"
	]
	quest.5720C739A6A1590D.title: "Фаза «База»"
	quest.5739B17782550F0D.quest_desc: [
		"Фильтр воздуха — &eскафандры&r Northstar (шлем и нагрудник с баллоном), &eзаправщик кислорода&r, &eкислородный диффузор подлодки&r и &eпротивогаз&r Create Big Cannons."
		"&eГде:&r болота и мангровые болота. Примета — тёмный тлеющий торфяник, над ним дым."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на торфяник, сбоку вода и грязь → &6торф&r (горит в печи, как уголь)."
		"Вентилятор через огонь (копчение) или коптильня → &6активированный уголь&r."
		"Пресс над бассейном: 2 угля + бумага + железный самородок → &6фильтр воздуха&r."
		"&7&oТорф горел тысячу лет. Теперь он чистит воздух. Отличная карьера, нам бы так.&r"
	]
	quest.5739B17782550F0D.title: "Торфяник"
	quest.575231C024676318.quest_desc: [
		"Дизельный двигатель CDG, полный газ:"
		"&eДизель&r — 6 144 SU, 96 об/мин"
		"&eБензин, биодизель&r — 4 096 SU"
		"&eЭтанол&r — 2 048 SU, 96 об/мин"
		"&eРаст. масло&r — 2 048 SU, 74 об/мин"
		"&eМодульный&r, на блок: дизель 8 192, бензин 6 144, этанол 3 072."
		"&eОгромный&r: дизель 16 384 SU на 224 об/мин, бензин 12 288, этанол 6 144 (192 об/мин)."
		"{@pagebreak}"
		"Турбокомпрессор — ×2 к оборотам и SU."
		"Двигатели TFMG: мощность зависит от топлива, цилиндров и газа — смотри очками."
		"Для сравнения: паровой двигатель Create на полном котле — 16 384 SU."
		"Двигатель — такой же источник вращения, как колесо или пар. Общая схема энергии — в главе «Энергия»."
	]
	quest.575231C024676318.title: "Сколько даёт двигатель"
	quest.577D5A25C2A53FC5.quest_desc: [
		"Зачем: наука открывает планеты в Атласе — без неё станции некуда лететь."
		"&eТелескоп&r — механические крафтеры: &eлинза&r (форпост «Кварцевый карьер») + 2 латунных слитка + 3 палки."
		"ПКМ по телескопу — карта неба. Выбери планету и зажми кнопку записи; нужен лист &eбумаги&r в инвентаре. Запись падает под ноги."
		"{@pagebreak}"
		"На Земле — только ночью. На Луне, Марсе и Меркурии — и днём."
		"Одна запись одной планеты за игровые сутки. За ночь снимай ВСЕ планеты сразу — по листу на каждую."
		"&7&o— Пресс-служба: «Мы не смотрим на звёзды. Мы проводим инвентаризацию».&r"
	]
	quest.577D5A25C2A53FC5.title: "Телескоп и записи"
	quest.579A3577016BCF77.quest_desc: [
		"Первая сила — без топлива и хлопот. Хватит на пресс, миксер и пилу, но не на завод."
		"&eВодяное колесо&r — &6256 SU&r"
		"&eБольшое колесо&r — &6512 SU&r"
		"&eВетряк&r — &6512–8 192 SU&r"
		"SU — сила вращения. Сколько её осталось — покажут инженерные очки."
		"&7&o— ОТК: «Колесо не ест уголь, не взрывается и не просит отпуск. Идеальный сотрудник».&r"
	]
	quest.579A3577016BCF77.title: "1 · Колёса"
	quest.57E36735D748B165.quest_desc: [
		"Зачем: турель из одного блока — автопушка или пушка сбоку, без громоздкого крепления."
		"&6Лафет автопушки&r и &6компактный лафет&r пушки: ствол ставится к левой грани с валом. Боковые валы — наклон, верх и низ — поворот."
		"Передняя грань — сигнал выстрела, задняя — сборка; ключом меняются местами. Собранный лафет сам передаёт патроны пушке — подавай воронкой."
		"Крафтеры или миксер: железные пластины, вал, шестерни, корпус, латунный лист, оружейный порох (JEI, R)."
		"{@pagebreak}"
		"Вертикальный лафет на вахте закрыт: в этой версии мода слезть с пушки на нём — уронить сервер."
		"&7&o— ОТК: «Лафет компактный. Отдача — нет».&r"
	]
	quest.57E36735D748B165.title: "Компактные лафеты"
	quest.582913C503B5526D.quest_desc: [
		"&eУсловия&r: вакуум, −183 °C, тяжесть 1,6 м/с², теплозащита 0. Железного скафандра хватает."
		"Телескоп работает и днём. Обычные факелы гаснут."
		"{@pagebreak}"
		"&eДобыча&r: &bлунный сапфир&r — в жеодах. Блоки лунного сапфира падают сами → дробилка → 3–4 осколка. Друзы и бутоны — только Шёлковым касанием."
		"Осколок → наждачка → полированный. Кристалл: 3 полированных + 2 железа + 2 редстоуна (миксер)."
		"{@pagebreak}"
		"Ещё: ледяные и светокаменные пещеры, лунные руды."
		"&eФауна&r: лунные угри, луноходки, лунные улитки."
		"&7&o— Техника безопасности: на Луне тебя никто не услышит. Особенно без шлема.&r"
	]
	quest.582913C503B5526D.title: "Справка: Луна"
	quest.58CBE83DFE54E852.quest_desc: [
		"Зачем: без жидкости рассадник стоит."
		"&6Случайная&r: огненный стержень + жемчуг Эндера + 250 мБ воды, миксер с нагревом. Или 500 мБ жидкого опыта + 500 мБ воды (нагрев)."
		"&6Видовая&r: случайная + ключ — кожа и пшеница → корова, паучий глаз → паук, порох → крипер, кость → скелет."
	]
	quest.58CBE83DFE54E852.title: "Жидкости призыва"
	quest.58CDE5A8D0227B98.quest_desc: [
		"Самый быстрый путь в небо — готовые самолёты Immersive Aircraft: без физики, клея и расчёта тяги. Начинаются с корпуса."
		"&6Механические крафтеры&r: брёвна сверху и снизу, в середине 3 &eалюминиевых листа&r (алюминий — форпост «Бокситовый карьер», глава «Сеть форпостов»)."
		"&7&o— Служба доставки: «Самолёт из брёвен — экологично. Горит тоже экологично».&r"
	]
	quest.58CDE5A8D0227B98.title: "Корпус самолёта"
	quest.590411A05AAAE42D.quest_desc: [
		"Зачем: блоки Незера без Незера."
		"Вентилятор сквозь &5огонь душ&r (огниво по песку душ): песок → песок душ, земля → почва душ, булыжник → черныт, обсидиан → 12,5 % плачущего."
		"Первый песок душ — из Незера."
	]
	quest.590411A05AAAE42D.title: "Призрачная обработка"
	quest.59635B6F608A15C5.quest_desc: [
		"Из одного куска — больше порций. &6Миксер&r: 4 доски + 2 палки."
		"Положи продукт на доску и ударь ножом: говядина → 2 фарша, курица → 2 куска и костная мука, капуста → 2 листа."
		"Без рук: &6механическая пила&r режет то же самое на ленте, &6деплоер&r с ножом — на доске (мод Central Kitchen)."
	]
	quest.59635B6F608A15C5.title: "Разделочная доска"
	quest.598870E2C08934FE.quest_desc: [
		"Зачем: копать быстро и без устали."
		"Латунь + 2 шестерни + паровой двигатель (Stuff'N Additions) + латунная головка дрели (сборщики)."
		"Чары — только «Копание»: область 3×3. Ест топливо и воду: из бака или ведро во второй руке."
	]
	quest.598870E2C08934FE.title: "Портативная дрель"
	quest.5988745A12ACBC81.quest_desc: [
		"Зачем: снимать чары с хлама и перемалывать опыт в жидкость."
		"8 андезитовых сплавов вокруг вала (сборщики)."
		"Под точило — &6осушитель точила&r: предметы с опытом сами уходят в жидкий опыт."
	]
	quest.5988745A12ACBC81.title: "Механическое точило"
	quest.59DE800C3269A551.quest_desc: [
		"Ищет нефть: сетка 5×5 сверху показывает чанки вокруг, чанки с залежью светятся (границы чанков — F3+G)."
		"Питание — вращение снизу через &6машинный ввод&r. Не засветилось за несколько секунд — рядом нефти нет."
		"Рецепт: 6 электронных ламп, корпус тяжёлой машины, 2 стальных механизма."
	]
	quest.59DE800C3269A551.title: "Сканер поверхности"
	quest.5A02A7B022B6C246.quest_desc: [
		"Зачем: стена покупает секунды для ловушек и турелей."
		"Моб, который 3 с не продвинулся к алтарю, грызёт блок перед собой (на уровне ног и головы). Время = прочность блока × 2 с:"
		"&eБулыжник&r — 4 с"
		"&eГлубинный сланец&r — 6 с"
		"&eКирпичи сланца&r — 7 с"
		"&eЖелезный блок&r — 10 с"
		"&eОбсидиан&r — 60 с (потолок)"
		"{@pagebreak}"
		"&aМеханизмы, сундуки и всё с блок-сущностью&r орда не грызёт вообще. Блоки турелей, пушек, радаров и автопушек — тоже."
		"Дешёвый камень на всю стену, железо и обсидиан — на ворота и узкие места."
		"&7&oЗомби не умеют открывать двери. Но они умеют ждать. И грызть. В основном грызть.&r"
	]
	quest.5A02A7B022B6C246.title: "Стена и сколько её грызут"
	quest.5A4B58E3D3636EAA.quest_desc: [
		"Волны 50–59: краб-душитель, оса-немезида, жнецы, заразители, глубинники и драугры Cataclysm и подволна &dпротив щита&r (стрекозы — сквозь щит, крабы — ×10 по щиту, осы выжигают запас). Боссы: 50 — &4Диаболос-истребитель&r, 55 — матриарх и артроплевра."
		"Мечом это уже не держится: нужна &6промышленная оборона&r — турели, пушки, големы."
		"{@pagebreak}"
		"&6Веха каждому&r: &dЯдро навигации&r — без него не собрать контроллер ракеты (глава «Космос»). И &5Сердце ночи&r."
	]
	quest.5A4B58E3D3636EAA.title: "Волна 50: ядро навигации"
	quest.5AF0534F6432C4D1.quest_desc: [
		"Стирает жилу в чанке — чтобы поставить туда нужный зонд."
		"Миксер: TNT, 2 пороха и андезитовый сплав. Тратится за раз."
		"&7&oГеология — наука точная: не понравилась жила — взорвали и поставили другую.&r"
	]
	quest.5AF0534F6432C4D1.title: "Очиститель жилы"
	quest.5B0D0D05577E8BCF.quest_desc: [
		"Зачем: ток из этой главы — в оборону. Башня сама бьёт монстров молнией и достаёт &eлетунов&r: фантомов, стрекоз и ос ArPhEx."
		"Сборка — механические крафтеры: &eлатунный корпус&r, &e2 конденсатора C&A&r, &eмедная катушка C&A&r, &eгромоотвод&r, &e2 электромеди&r. Рецепт — в JEI (R)."
		"{@pagebreak}"
		"&eПитание:&r ток к любой стороне основания, кроме верха. Генератор C&A вплотную отдаёт ток сам; провод — через соединитель на основании, режим «отдавать», как на моторе."
		"Запас &650 000 FE&r, приём до &62 000 FE/т&r (малый соединитель пропустит &61 000&r)."
		"&eСтрельба:&r раз в секунду — ближайший монстр в радиусе, мобы набега первыми. Молния перескакивает на соседа в &64&r блоках."
		"Выстрел — &62 000 FE&r, каждый перескок — ещё &6500 FE&r. В запасе меньше 2 000 — башня молчит, обмотка гаснет."
		"{@pagebreak}"
		"Нужна &eпрямая видимость&r от верхушки: сквозь блоки, даже стекло и листву, молния не бьёт. Ставь башню выше стен."
		"Игроков, питомцев, големов и мирных не трогает, блоки не ломает и не поджигает. Мобу — поджог на 2 с."
		"Наглядно — Ponder: наведи на башню в JEI и зажми &eW&r."
		"&7&o— Отдел по работе с ордой: «Переговоры с ордой зашли в тупик. Переходим к аргументам по 2 000 FE».&r"
	]
	quest.5B0D0D05577E8BCF.title: "Тесла-башня"
	quest.5B0EAEACFF067C03.quest_desc: [
		"Зачем: возить предметы между машинами без тебя."
		"&6Лента&r: ПКМ по одному валу, потом по другому — натянется конвейер. Валы на ленте крутятся в одну сторону. Лента — 6 сушёных ламинарий (миксер)."
		"&6Депо&r — «стоячий» кусок ленты: на нём прессуют и промывают, с него берёт рука."
		"{@pagebreak}"
		"&6Андезитовый шлюз&r на сундуке или машине забирает и кладёт предметы: на ленту, в чашу, из жернова."
		"Жернов и колёса берут только сверху — шлюз или лента над ними."
		"&7&oЛента везёт всё. Однажды привезла в цех крипера. Он тоже был на смене. Недолго.&r"
	]
	quest.5B0EAEACFF067C03.title: "Лента, депо и шлюзы"
	quest.5B2534CC31A2A47B.quest_desc: [
		"Свет — главная защита: в темноте тает рассудок и появляются монстры."
		"Факелы делает &6миксер&r: палка + уголь или древесный уголь → 4 факела. Древесный уголь — брёвна в печи."
		"Факел в левой руке светит на ходу (F — переложить). Ставь факелы по пути — по ним найдёшь дорогу назад."
		"&7&oФакел — лучший друг вахтовика. Второй лучший друг — второй факел.&r"
	]
	quest.5B2534CC31A2A47B.title: "Запас света"
	quest.5B383EC023412952.quest_desc: [
		"Электролит нужен каждому &eконденсатору C&A&r, а из конденсаторов собраны аккумуляторы, генератор энергощита, энергощиты, тесла-башня и электромотор C&A."
		"&eГде:&r пляжи. Примета — розово-белый соляной пласт у самой воды."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на пласт, вода с обеих сторон → &6каменная соль&r."
		"Миксер: каменная соль + 500 мБ воды → &6500 мБ электролита&r."
		"&eКонденсатор&r — миксер: медный лист + цинковый лист + факел из редстоуна + 100 мБ электролита."
		"Дробилка делает из каменной соли обычную соль — для Northstar и кухни."
	]
	quest.5B383EC023412952.title: "Солеварня"
	quest.5C6DE81149094BAE.quest_desc: [
		"1. Столб &6промышленных труб&r от залежи до поверхности (пила: стальной слиток → 8 труб)."
		"2. На верх трубы — &6основа качалки&r, позади — держатель молота."
		"3. Над ними — соединитель и головка, между ними — части молота. Всё склей &aсуперклеем&r."
		"4. &6Машинный ввод&r (вращение) — снизу, кривошип — над ним. Красная метка основы смотрит &7от&r держателя молота."
		"{@pagebreak}"
		"Очки покажут запас залежи: она не бесконечная, следующую ищи заранее."
		"&7&o— Техника безопасности: не стойте под молотом качалки. Он не видит разницы между нефтью и вами.&r"
	]
	quest.5C6DE81149094BAE.title: "Нефтяная качалка"
	quest.5CC2972B8E23DC31.quest_desc: [
		"Насос между морем и цистернами. Крафтеры шахматкой (или миксер): 5 медных самородков и 4 медных блока."
		"Условия: трубы Create к цистернам, вращение на клапан, хотя бы одна грань касается моря снаружи."
		"Направление вращения — режим: набор воды или откачка. Переключай реверсом."
	]
	quest.5CC2972B8E23DC31.title: "Балластный клапан"
	quest.5CD1EC681729A76D.quest_desc: [
		"Садись ПКМ по оседланному дракону. Прыжок — взлёт и набор высоты, &6«Снижаться»&r — вниз, летит куда смотришь."
		"&6«Слезть с дракона»&r — спешиться. &6«Атака дракона»&r — дыхание: огонь, лёд, у каждой породы своё."
		"Клавиши — Управление → «Драконы (Dragon Mounts)»."
		"&7&o— Отдел по работе с ордой: «Дракон — лучший аргумент в споре с зомби. Второй лучший — ядерный заряд».&r"
	]
	quest.5CD1EC681729A76D.title: "В небо!"
	quest.5D0BB0FB363BCF9C.quest_desc: [
		"Зачем: понять, где встречать волну."
		"Мобы выходят кольцом в &e30–45 блоках&r от алтаря, за зоной базы, и идут прямо к нему. Подошёл ближе &c2 блоков&r — набег провален."
		"Набег идёт, пока кто-то из команды в 64 блоках от алтаря. Живых мобов разом — до 120, остальные ждут и выходят по мере гибели."
		"{@pagebreak}"
		"Дальше по рядам: стены → ловушки → турели → большие пушки → автонаведение → поздняя оборона."
		"&7&o— Отдел по работе с ордой: «Мы не опаздываем. Мы окружаем».&r"
	]
	quest.5D0BB0FB363BCF9C.title: "Как ходит орда"
	quest.5D619F38B169BB70.quest_desc: [
		"Экструдер: лава с двух сторон, снизу почва душ — 2 удара на блок."
		"Или миксер с нагревом: булыжник + незераковая мука + 1 000 мБ лавы."
		"Незерак → колёса → мука → промывка: 25 % самородка золота."
	]
	quest.5D619F38B169BB70.title: "Незерак без Незера"
	quest.5E46C064FCD78091.quest_desc: [
		"Зачем: удар с высоты — самый сильный в игре."
		"Механические крафтеры: тяжёлое ядро + стержень вихря. Ядро — редкая добыча набегов 43–49 волн и зловещих хранилищ испытаний, стержни — с вихрей (в набегах с 14-й волны)."
		"{@pagebreak}"
		"Урон 6, удар раз в 1,7 с. С высоты: +4 за каждый из первых 3 блоков падения, +2 за следующие 5, +1 дальше. Удар гасит урон от падения."
		"Заряд ветра (стержень вихря → 4 заряда) подбрасывает вверх: прыжок, удар, повтор."
		"&7&o— Техника безопасности: промах булавой с 30 блоков — это не промах. Это падение.&r"
	]
	quest.5E46C064FCD78091.title: "Булава"
	quest.5E4F935500884B5E.quest_desc: [
		"Проверь сборщик на простом: платформа из пары блоков, &6суперклей&r Create по ним, сборщик рядом — рычаг вверх. Платформа стала физической."
		"По штуковине можно ходить, открывать сундуки и дёргать рычаги прямо на ходу."
		"{@pagebreak}"
		"Вместо суперклея — &6мёдоклей&r: дозатор Create наливает мёд на железный лист."
		"&cТонкость:&r блоки, касающиеся только ребром по диагонали, тоже считаются одной группой."
		"Отсюда четыре дороги: небо на пропеллерах, дирижабли, машины и подлодки."
	]
	quest.5E4F935500884B5E.title: "Первая штуковина"
	quest.5E512EAAD7AD8E46.quest_desc: [
		"Зачем: бьёт как игрок, пока крутится вал."
		"Дай деплойеру меч (ПКМ мечом по нему) и гаечным ключом переключи в режим удара. Он бьёт моба перед рукой уроном этого меча — Острота работает."
		"{@pagebreak}"
		"Мобы на деплойер не злятся. Добыча с убитых падает ему в руку — забирай воронкой. Для игры он игрок: «игроцкий» лут (конденсаторы стражей тоже) выпадает."
		"Сборка: андезитовый корпус, латунная рука, электронная лампа."
	]
	quest.5E512EAAD7AD8E46.title: "Деплойер с мечом"
	quest.5E7E779ADCC9DF09.quest_desc: [
		"Поставь яйцо блоком и нажми по нему &6ПКМ&r — пойдёт вылупление, &6~10 минут&r (подсказка на яйце покажет остаток)."
		"Рядом с яйцом не дерись и не ломай его. Из яйца выйдет дракончик той породы, что написана на яйце; взрослым станет ещё через ~10 минут."
		"&7&o— Столовая: «Это не омлет. Повторяем: это НЕ омлет».&r"
	]
	quest.5E7E779ADCC9DF09.title: "Вылупление"
	quest.5E9B9A280ABBD6B0.quest_desc: [
		"Зачем: снаряд летит на порохе."
		"Пресс: 3 &eоружейного пороха&r → спрессованный порох. Пустой заряд — нитки и шерсть. Вместе в миксере — пороховой заряд."
		"&eОружейный порох&r — миксер: серная пыль + обычный порох + древесный уголь → 3. Обычный порох в пушки больше не идёт: сера — форпост «Серный источник» (глава «Сеть форпостов»)."
		"Заряды кладут в блоки &eствола&r, не дула: в дуле 20 % на разрыв."
		"Больше, чем держит пушка, — разрыв с шансом 50 %. Мало пороха — снаряд застрянет (25 %). Чугуну нужен примерно 1 заряд на блок ствола."
		"&7&oПушка разорвалась? Это не авария. Это очень короткий выстрел во все стороны.&r"
	]
	quest.5E9B9A280ABBD6B0.title: "Пороховой заряд"
	quest.5E9F40AEAEB40403.quest_desc: [
		"Зачем: броня как у лучшего голема — на себя. Защита &e24&r (незерит 20), вязкость &e4&r, отбрасывает на 15 % слабее, &aне горит в лаве&r."
		"Улучшение незеритовой: механические крафтеры в ряд — &eсплав | незеритовая вещь | сплав&r. Чары сохраняются. На комплект — 8 сплавов."
		"Сплав — межпланетное точило (глава «Космос»)."
		"&7&o— ОТК: «Голем носит такую же. Голему не жаловались».&r"
	]
	quest.5E9F40AEAEB40403.title: "&dБроня из межпланетного сплава&r"
	quest.5F03E560473FFEB2.quest_desc: [
		"Зачем: нужен контроллеру поезда, руке, загрузчикам чанков, реактивному ранцу."
		"&6Последовательная сборка&r: золотой лист на ленте проходит 3 активатора — шестерня, большая шестерня, самородок железа — и так &e5 кругов&r."
		"Выход ≈80 %, остальное — лом (листы, сплав, шестерни). Схема — R в JEI."
	]
	quest.5F03E560473FFEB2.title: "Механизм точности"
	quest.5F66150BE3C4D321.quest_desc: [
		"Съешь — &d+1 сердце максимума навсегда&r, до +5. Шестое не приживётся — вернётся в инвентарь, отдай другу."
		"Только из набегов: изредка в добыче и наверняка за первое прохождение 50-й, 60-й и каждой 10-й с 70-й; в Бесконечности — каждой 5-й. За сотую — сразу три."
		"Ни купить, ни продать: EMC у него нет."
		"&7&oСердце ночи ещё тёплое. Не спрашивай, чьё.&r"
	]
	quest.5F66150BE3C4D321.title: "Сердце ночи"
	quest.5F6E91CF98C1DAB5.quest_desc: [
		"Зачем: видеть цели и связать блоки в сеть."
		"&6Монитор&r (3 лампы, латунный корпус, точный механизм → 3 штуки): поставь рядом — сложатся в большой экран."
		"&6Передатчик радиолокационных данных&r (Data Link: редстоун-факел, латунный корпус, передатчик) связывает блоки на расстоянии до 128."
	]
	quest.5F6E91CF98C1DAB5.title: "Монитор и связь"
	quest.60055E81B084F741.quest_desc: [
		"Зачем: первая машина нашего аддона &dAxiomativ Industries&r — сплавляет металлы с разных планет."
		"Механические крафтеры: жернов + 3 титановых листа + вольфрамовый лист + 2 механизма точности."
		"{@pagebreak}"
		"Крутить &6от 100 об/мин&r (вал снизу или шестерни сбоку), нагрузка 32 SU на 1 об/мин."
		"Класть — воронкой, желобом, конвейером или ПКМ предметом. Забирать — ПКМ пустой рукой или воронкой снизу."
	]
	quest.60055E81B084F741.title: "&dМежпланетное точило&r"
	quest.60435D2A4499BA6F.quest_desc: [
		"Вся орда &7невидима&r. Видно только в луче &eпрожектора&r (аддон Axiomativ): в луче моб теряет невидимость и светится ещё 5 с после."
		"Ставьте прожекторы на подходах к стене, на ток. Турели и тесла тоже бьют только тех, кого видно."
		"&8Блэкаут&r (56) — то же, но у защитников весь набег «Тьма»: свет и цель даёт только прожектор."
		"Первое прохождение: &6Призменная линза&r."
	]
	quest.60435D2A4499BA6F.title: "Волна 34: Невидимки"
	quest.6068DECB682A4365.quest_desc: [
		"Зачем: бесплатный урон каждому, кто идёт по коридору."
		"Утопи пилу в пол коридора лезвием вверх и дай ей вращение. Урон за удар зависит от оборотов:"
		"&e32 об/мин&r — 3,5"
		"&e64&r — 5"
		"&e128&r — 8"
		"&e256&r — 10"
		"{@pagebreak}"
		"Моб после удара полсекунды неуязвим, так что на 256 об/мин это ~20 урона в секунду. Механический бур бьёт так же."
		"Сборка: андезитовый корпус, железный слиток и 3 железные пластины — миксер или крафтеры."
	]
	quest.6068DECB682A4365.title: "Пила в полу"
	quest.6093A92FF80FA235.quest_desc: [
		"Драконья броня (кожа, железо, золото, изумруд, алмаз) — из сундуков построек. Надевается в инвентаре дракона (Shift + ПКМ)."
		"ПКМ сундуком по дракону — он понесёт сундук: кладовая в дорогу, которая сама летает за тобой."
	]
	quest.6093A92FF80FA235.title: "Броня и сундук"
	quest.6098697A991695C9.quest_desc: [
		"Генератор, который растёт вместе с магнитами: от &622&r до &6540 FE/т&r на катушку при 64 об/мин."
		"&eКатушка динамо-машины&r — миксер: &68&r электромеди + блок андезитового сплава."
		"{@pagebreak}"
		"&eСборка:&r"
		"1) катушки на валу, до &68&r в ряд;"
		"2) вокруг каждой &612&r магнитов рамкой 5×5 без углов — по 3 с каждой стороны, через клетку от катушки;"
		"3) на конце ряда — &eуглеродный накопитель&r (щётки; миксер: вал + 2 угля + 6 андезитовых сплавов), он снимает ток."
		"{@pagebreak}"
		"Формула: FE/т = сумма сил магнитов × об/мин × &60,0293&r."
		"Нагрузка: (24 + сумма сил) × об/мин SU. Ставь все 12 магнитов: свои 24 SU/об катушка берёт всегда."
		"Какой магнит сколько даёт — справка «Магниты»."
		"&7&o— ОТК: «Двенадцать магнитов вокруг катушки — не суеверие, а КПД».&r"
	]
	quest.6098697A991695C9.title: "Катушка динамо и магниты"
	quest.614B14F253B142DB.quest_desc: [
		"Укрепления вокруг печи &eвдвое ускоряют&r плавку. Без них домна тоже работает, просто медленнее."
		"Рецепт: 3 стальных слитка, 3 тяжёлые пластины, 3 огнеупорных кирпича → &a4 укрепления&r. Тяжёлая пластина — стальной слиток через пресс на сборочной линии."
	]
	quest.614B14F253B142DB.title: "Укрепления домны"
	quest.6198B25FE394E4CE.quest_desc: [
		"Набор фракций зависит от числа выходов. 6 выходов: 340 мБ нефти → 120 тяжёлой нефти, 60 дизеля, 60 бензина, 60 сжиженного газа, 30 керосина, 10 нафты."
		"Тяжёлую нефть гони ещё раз: 200 мБ → 100 обратно, 50 дизеля, 20 керосина, 25 смазки и капля нафты."
		"Полный бак на выходе останавливает башню — включи на выходах «уничтожать излишек»."
	]
	quest.6198B25FE394E4CE.title: "Бензин, дизель, керосин"
	quest.61FD7D8079AA53C1.quest_desc: [
		"Сердце домны — &6выход домны&r (блок чугуна, 4 чугунные трубы, 4 огнеупорных кирпича). Обстрой его цилиндром из огнеупорного кирпича, в стену вставь &6люк домны&r — вход горячего воздуха."
		"Всё засыпается в отверстие сверху. Второй люк на верхнем отверстии собирает печной газ и пропускает предметы вниз."
		"Очки покажут топливо, высоту и таймер плавки."
	]
	quest.61FD7D8079AA53C1.title: "Доменная печь"
	quest.625E481953585276.quest_desc: [
		"Зачем: поезд ездит по маршруту сам, без тебя за рычагами."
		"Миксер: прочный лист + бумага → &e4 шт.&r"
		"Составь маршрут и отдай машинисту: горелка всполоха или любое существо перед контроллером."
	]
	quest.625E481953585276.title: "Расписание поезда"
	quest.629E15D96732EB91.quest_desc: [
		"Аксиоматив хочет от смены порядка, Инь-Янь учит равновесию. Слиток аксиомита и слиток стабилита — доказательство, что смена дошла до края карты компании."
		"Отметь квест, когда оба металла будут на руках. Бухгалтерия EMC оценивает каждый в 40 960."
		"&7&o— Штаб: «Отчёт принят. Свобода от рутины — со следующей смены».&r"
	]
	quest.629E15D96732EB91.title: "&6Отчёт в штаб&r"
	quest.62D949F92F5E380D.quest_desc: [
		"Стол переводит вещи в &eEMC&r и обратно: сжёг вещь — получил EMC и знание о ней, знание покупается за EMC. Покупка и продажа — &6по одной цене&r."
		"Философского камня нет: стол собирает миксер — 4 андезитовых сплава, андезитовый корпус, 2 редстоуна, 2 камня."
		"{@pagebreak}"
		"Торгуются ресурсы (руда, слитки, самоцветы), ванильная еда, инструменты, броня и стройблоки. Руда и сырьё — за полцены слитка."
		"&cТехника Create и сплавы&r (латунь, андезитовый сплав, сталь, дроблёная руда) — ни купить, ни продать: их делает только завод."
		"EMC и знания &aобщие на команду&r."
		"{@pagebreak}"
		"&eЛимит покупок&r: не больше &e64 штук каждого предмета за 5 минут&r — один счёт на весь сервер. Купил стак железа — следующий через 5 минут. Руду и слитки пачками делает завод, стол только докупает."
		"&aВыкуп&r: что продал в стол за последние &a10 минут&r, покупается обратно без лимита. Сдал 10 стаков железа — 10 минут можешь забрать те же 10 стаков."
		"Сколько осталось и когда сброс — строка над хотбаром при покупке. Тот же лимит у планшетов, сетки арканного планшета, звена EMC, камня вечной плотности и ртутного глаза."
		"&cКонденсаторов нет&r: убраны из сборки. Поставленные стоят без дела — забери из них вещи."
		"&7&o— Бухгалтерия EMC: «Деньги — это заводы. Всё остальное — сдача».&r"
	]
	quest.62D949F92F5E380D.title: "Стол трансмутации"
	quest.63884CBF99FC1C65.quest_desc: [
		"&eНе взлетает&r — тяги меньше массы. Очки на пропеллер: добавь винт, собери пропеллер на подшипнике или облегчи раму."
		"&eТолкает не туда&r — ключ по пропеллеру (реверс) или проверь, куда смотрит блок."
		"&eНе разбирается&r — встань ровно (крен до 4°), почти без скорости и у земли: в воздухе разборка запрещена."
		"{@pagebreak}"
		"&eСдуло с палубы&r — &6скобы&r (самородок железа над андезитовым сплавом): держись за них на кренах."
		"Неудачную штуковину разбери любым сборщиком и собери снова — блоки не теряются."
	]
	quest.63884CBF99FC1C65.title: "Советы пилоту"
	quest.6396C3E683386BB8.quest_desc: [
		"Орду берёт &bтолько ток&r: тесла-башня (аддон Axiomativ), молния — посох молний, заряд. Пули, мечи и турели — мимо."
		"Строй тесла-башни заранее и держи сеть: залпы едят энергию. Повторы — 44 и 64."
		"Первое прохождение: &6Сердечник катушки&r."
	]
	quest.6396C3E683386BB8.title: "Волна 22: Механоиды"
	quest.63D73C7D0A577B48.quest_desc: [
		"Зачем: собирает ракету из блоков, выбирает курс и показывает, всего ли хватает. Станция — часть ракеты и летит с ней."
		"Механические крафтеры: 9 титановых пластин + 5 титановых слитков + 4 закалённых механизма + 2 схемы + 2 железные шестерни + навигационный компьютер."
		"{@pagebreak}"
		"Окно станции (ПКМ):"
		"&eFuel&r — топливо есть / нужно (наведи — взлёт, перелёт, посадка)."
		"&eThrusters&r — ускорители есть / нужно."
		"&eHeat Shielding&r — теплозащита."
		"&eNavigator&r — нужен ли Межпланетный навигатор."
		"&eComputers&r — экономия от стоек."
		"{@pagebreak}"
		"Слот — для Атласа (Space Atlas) или Обратного билета. Кнопки — «Собрать Ракету» и «Disassemble Rocket»."
		"Пондер: наведи на станцию в JEI и зажми &eW&r — сцена «Building a rocket» показывает всю компоновку."
	]
	quest.63D73C7D0A577B48.title: "Ракетная станция"
	quest.63F586606A40A32E.quest_desc: [
		"Флюс для домны — только &6известняковый песок&r."
		"Найди &eизвестняк&r Create (прослойки среди других пород Create) и раздроби жерновами или дробильными колёсами."
	]
	quest.63F586606A40A32E.title: "Флюс: известняковый песок"
	quest.642C38A2F7823EF0.quest_desc: [
		"Зачем: и лечит, и бьёт — волна равновесия радиусом 12."
		"Своим (игроки, големы, приручённые): +4 сердца, регенерация II на 5 с, тушит огонь. Врагам: 16 урона магией и слабость II на 5 с."
		"Мана 50, перезарядка 10 с, прочность 500."
		"Механические крафтеры: «стабилит | божественная жемчужина | стабилит», «эссенция | золотой стержень | эссенция», внизу по центру золотой стержень. Стабилит — с наших планет (Звёздная кирка, 70-я волна)."
		"&7&o— ОТК: «Равновесие — это когда у орды минус, а у бригады плюс».&r"
	]
	quest.642C38A2F7823EF0.title: "Посох равновесия"
	quest.6436250ACE0D60A8.quest_desc: [
		"Первый инструмент кухни: режет мясо на доске, собирает дикие овощи и &eсолому&r (сломай ножом траву или пшеницу)."
		"&6Миксер&r: кремень + палка. Кремень — из гравия. Железный нож — железный слиток + палка, быстрее."
		"&7&o— Техника безопасности: нож — кухонный инструмент. Зомби об этом не знают, не говори им.&r"
	]
	quest.6436250ACE0D60A8.title: "Нож"
	quest.648B4A2170FD0077.quest_desc: [
		"Зачем: лучшая броня, которую можно собрать. Полный комплект — &aСила II&r и &aСопротивление II&r навсегда."
		"Механические крафтеры в ряд: шаблон эха | незеритовая вещь | слиток эха. Защита 20, вязкость 12, отбрасывает на 80 % слабее."
		"{@pagebreak}"
		"&eСлиток эха&r — незеритовый слиток на конвейере, 5 кругов: лава 250 мБ → пресс → плавленое эхо 50 мБ → огненный порошок → пресс."
		"&eПлавленое эхо&r — миксер на сверхнагреве: 2 осколка эха → 100 мБ."
		"&eШаблон&r — пресс с нагревом: осколок эха, глубинный сланец, огненный порошок."
		"Осколки эха — в сундуках древних городов."
	]
	quest.648B4A2170FD0077.title: "Броня эха"
	quest.64B2071B71444A15.quest_desc: [
		"Рама, 3–4 крепления по углам, шины, двигатель на борту — и вращение на валы креплений. Поехали."
		"Руль — сигнал сбоку крепления: тяговый рычаг или пульт. Тормоз — сигнал сверху."
		"&7&o— Техника безопасности: ремень безопасности в моде не предусмотрен. Предусмотрена скоба.&r"
	]
	quest.64B2071B71444A15.title: "Первая машина"
	quest.64CD01588A6A664E.quest_desc: [
		"Показывают то, чего не видно глазом: у пропеллера — тягу и поток, у механизмов — нагрузку и запас сети. Хватит ли тяги на взлёт, видно ещё на земле."
		"Миксер или крафтер: кожа + инженерные очки Create."
		"&7&o— Отдел кадров: очки выдаются бесплатно. Бесплатно и падать без них.&r"
	]
	quest.64CD01588A6A664E.title: "Авиаторские очки"
	quest.6503EB1CA12CEEC8.quest_desc: [
		"Зачем: без конденсатора лазерную турель не собрать."
		"&6Конденсатор луча стража&r падает со стража с шансом 25 % (Добыча III — 55 %), &6конденсатор древнего стража&r — с древнего стража, 15 % (Добыча III — 45 %)."
		"{@pagebreak}"
		"Убить должен игрок или деплойер Create. Стражи живут у океанских монументов и там же появляются снова, древних — по трое на монумент, навсегда."
		"На столе трансмутации конденсаторы не продаются и не покупаются."
		"&7&o— Отдел снабжения: «Рыбалка — это не отпуск. Это закупка»&r"
	]
	quest.6503EB1CA12CEEC8.title: "Охота на стражей"
	quest.652D8C7BE73B6E6F.quest_desc: [
		"Зачем: латунный корпус — основа точных машин: сборщиков, баков, станций, поездов."
		"Окорённое бревно поставь блоком и кликни по нему латунным слитком (или дай слиток активатору)."
		"Латунь — из главы «Вахта: инструктаж»."
	]
	quest.652D8C7BE73B6E6F.title: "Латунный корпус"
	quest.65323940C7E98B08.quest_desc: [
		"Зачем: книга — твой маршрут. Эта глава ведёт от ящика до завода, остальные — по темам."
		"Карточка = шаг: первая строка — «зачем», дальше — «как». Предмет-задача засчитается сам, когда окажется в инвентаре; галочку жми сам."
		"Золотые шестиугольники — вехи. Кружки — справки: их читают, а не выполняют."
		"{@pagebreak}"
		"Главное испытание — &5набеги на алтарь&r: волну (их сто) выбираешь сам, чем дальше — тем богаче добыча. Глава «Алтарь и набеги»."
		"Застрял — перечитай «как» в карточке, потом &6R&r в JEI и &6W&r (Ponder)."
		"&7&o— Отдел кадров Axiomativ: «Инструктаж считается пройденным, если вы его открыли». Юротдел: «…и не закрыли сразу».&r"
	]
	quest.65323940C7E98B08.title: "Как читать эту книгу"
	quest.65643FB540C724EF.quest_desc: ["Звёздные карты — путь в космос, целебные споры — спокойные ночи."]
	quest.65643FB540C724EF.title: "Звёзды и рассудок"
	quest.65BDB0A73D405268.quest_desc: [
		"Зачем: калибр крупнее обычной автопушки — свои бронебойные и фугасные выстрелы."
		"В моде рецептов нет — на вахте части собирают механические крафтеры из стальных частей автопушки CBC:"
		"&6казённик&r — 2 стальных казённика, 2 возвратные пружины, 4 стали, точный механизм; &6ствол&r — 2 стальных ствола, 4 стали. Толстый ствол, дульный тормоз и спаренные части — из них же (JEI, R)."
		"{@pagebreak}"
		"Выстрелы: бронебойный (или зенитный + порох) автопушечный снаряд + снаряжённая гильза + любая сталь → 2 крупнокалиберных."
		"&7&o— Отдел по работе с ордой: «Калибр — тоже аргумент».&r"
	]
	quest.65BDB0A73D405268.title: "Крупнокалиберная автопушка"
	quest.65CB6AE9800DF7D3.quest_desc: [
		"Риск за добычу: в меню алтаря строка &eУсловия смены&r — включай перед набегом, орда станет злее, а добычи больше."
		"Бросков обычной добычи ×(1 + бонус/2), артефакт смены — лишние броски: целая часть бонуса наверняка, дробная — шансом. Условия общие на команду и держатся, пока не выключишь; малые набеги их не берут."
		"{@pagebreak}"
		"&cДвойная смена&r — мобов вдвое больше (+50 %)."
		"&cСтеклянная пушка&r — бьют вдвое, здоровья −40 % (+25 %)."
		"&cНочь боссов&r — босс в каждой волне, на кратных 5 — два (+40 %)."
		"&cЯрость&r — орда со «Скоростью II» (+30 %)."
		"{@pagebreak}"
		"&cПодрывной день&r — подрывников втрое (+20 %)."
		"&cБез света&r — у вас «Тьма» весь набег (+20 %)."
		"&cЖелезная воля&r — смерть любого защитника = провал (+60 %)."
		"Всё сразу — добыча +225 %, два-три лишних броска артефакта. Удачи."
		"&7&o— Бухгалтерия: «Премия за вредность начисляется посмертно. Шутка. Или нет».&r"
	]
	quest.65CB6AE9800DF7D3.title: "Условия смены"
	quest.65EBFC16CC926C3D.quest_desc: [
		"Зачем: сама находит моба и жжёт его, пока крутится вал."
		"Механические крафтеры (5×3): стекло, призмариновые кирпичи, кристаллы призмарина, вал, цинковые самородки и конденсатор стража. Рецепт — в JEI (R)."
		"Бьёт &e1 цель&r в радиусе &e17 блоков&r: 6 урона (+3 магией, но после удара моб неуязвим, так что по факту ~6)."
		"{@pagebreak}"
		"Нужна скорость не ниже средней (от 30 об/мин). Заряд луча:"
		"&e32 об/мин&r — 4,5 с"
		"&e64&r — 3,5 с"
		"&e128&r — 2,5 с"
		"&e256&r — 1,5 с (быстрее нельзя)"
		"Кого бить, настраивается на самой турели: только враждебных, всех, кроме владельца, и т. д. Гаечным ключом её крутит только владелец."
	]
	quest.65EBFC16CC926C3D.title: "Лазерная турель"
	quest.663530EB05D899C2.quest_desc: [
		"Тепло без топлива. &eСолнечный теплогенератор&r:"
		"&eОбыкновенный&r — до &620&r тепла/с"
		"&eПродвинутый&r — до &660&r тепла/с"
		"Греет днём под открытым небом, в дождь слабее, ночью — ноль."
		"&eТруба&r берёт тепло снизу:"
		"лава, огонь, магма — &66/с&r"
		"горелка на топливе — &624/с&r"
		"горелка на торте — &642/с&r"
		"Каждая труба теряет &61&r тепла/с."
		"{@pagebreak}"
		"Рецепты:"
		"трубы — миксер: 3 терракоты + медный лист + 2 цинковых самородка → &64&r;"
		"обыкновенный теплогенератор — механические крафтеры: 3 &eкварцевых стекла&r (форпост «Кварцевый карьер») + 4 железных слитка + 2 трубы;"
		"продвинутому нужно 4 заряженного железа (справка «Зарядка»)."
		"&7&oСолнце светит всем бесплатно. Поэтому бухгалтерия его и недолюбливает.&r"
	]
	quest.663530EB05D899C2.title: "Солнечные теплогенераторы и трубы"
	quest.664ED02D22778AFB.quest_desc: [
		"Кабина вместо россыпи рычагов: на &6пульт&r Aeroworks ставятся модули — штурвал, рычаг, джойстик, педаль, кнопки. Каждый шлёт сигнал на свою частоту передатчиков Create."
		"Миксер: латунный корпус, электронная лампа, точный механизм, передатчик, редстоун-связь."
		"{@pagebreak}"
		"Сигнал в угол превращает &6сервопривод&r Aeroworks (на руль, подшипник) или &6адаптер наклона&r Create Propulsion (разница двух сигналов — наклон двигателя)."
		"Пульты вплотную объединяются, но рулит один игрок."
		"&7&o— Юротдел: «Кто за штурвалом — тот и виноват».&r"
	]
	quest.664ED02D22778AFB.title: "Пульт управления"
	quest.676D2249E255B12B.quest_desc: [
		"Зачем: хранить опыт жидкостью в баке, а не на себе."
		"Блок опыта нанеси на жидкостный люк (ПКМ) — выйдет люк опыта. Ставь на бак."
		"&6ПКМ&r — сдать опыт, &6Shift+ПКМ&r — забрать. Прокруткой — сколько за раз."
	]
	quest.676D2249E255B12B.title: "Люк опыта"
	quest.6830526159D51413.quest_desc: [
		"&fИнь-Янь&r идёт по орбите Земли, на 60° позади неё — там, где тяготение Солнца и Земли уравновешено."
		"Планета расколота надвое: чёрные земли &8Инь&r и белые &fЯн&r чередуются квадратами по 8192 блока; у X = 0, Z = 0 сходятся все четыре."
		"{@pagebreak}"
		"Долететь: наука &67&r, Межпланетный навигатор на борту, Звёздный навигатор у каждого. До неё всегда около 1 а.е."
		"+20 °C и земная тяжесть, но воздух — разреженный водород: без скафандра не выйти. Теплозащита 60 + 0,1 за блок."
		"Садишься в те же X/Z — стартуй ближе к 0, 0, если нужен стык света и тьмы."
	]
	quest.6830526159D51413.title: "&6Инь-Янь: планета равновесия&r"
	quest.686F94EE226A9895.quest_desc: [
		"Зачем: сталь держит 8 зарядов, незер-сталь — 10."
		"Сталь CBC — миксер с нагревом: 2 железных слитка + уголь → 2 слитка."
		"Стальной ствол не льют целиком: 5 слоёв разного размера отливают и сверлят, &6наращиватель слоёв&r собирает их в блок."
		"Потом блок &eнагревают&r: вентилятор дует на него сквозь лаву, 5 минут."
		"Чугун — 2 заряда, бронза — 4, сталь — 8. Сварной шов у стали отнимает 2."
	]
	quest.686F94EE226A9895.title: "Стальные стволы"
	quest.6880D921FDA3F837.quest_desc: [
		"Зачем: шахта кормит, пока ты в неё спускаешься. Пора строить линию, которой не нужен ты с киркой."
		"Дальше: экструдер → рудная порода → катализатор. Медленнее шахты, зато без тебя и без потери рассудка."
		"Отметь, когда будешь готов."
	]
	quest.6880D921FDA3F837.title: "Фаза «Завод»"
	quest.689528CB26C0E3A3.quest_desc: [
		"Зачем: поднимать уровень заклинаний и усиливать снаряжение."
		"Механические крафтеры: 3 аметистовых блока сверху, алмаз в центре, снизу полированный глубинный сланец | наковальня | полированный глубинный сланец."
		"Что умеет: &eсвиток + чернила следующей редкости&r → заклинание на уровень выше; &eоружие + свиток&r → меч колдует это заклинание; &eброня или книга + сфера улучшения&r → постоянный бонус (до 3 на вещь)."
		"&7&o— Служебная записка: «Наковальня волшебная, но на ногу падает как обычная».&r"
	]
	quest.689528CB26C0E3A3.title: "Волшебная наковальня"
	quest.69B53E0B6FA14ADE.quest_desc: [
		"Ток для машин TFMG — у них своя сеть с вольтами и ваттами (видно в очках)."
		"Сборочная линия на валу, 3 круга: конденсатор → стальной лист → намотка медной катушки TFMG (намоточный станок) → электромедь → стальной механизм → отвёртка."
		"Сталь — глава «Сталь и нефть»."
		"{@pagebreak}"
		"Работает от &640 об/мин&r: быстрее — больше вольт."
		"В FE-машины (C&A, New Age) ток отдаёт кабельный узел TFMG вплотную. Провода TFMG и C&A друг к другу не тянутся."
		"Нужен просто ток для зарядки — проще генератор C&A."
		"&7&oTFMG — «The Factory Must Grow». Бухгалтерия расшифровывает иначе, но вслух не говорит.&r"
	]
	quest.69B53E0B6FA14ADE.title: "Генератор TFMG"
	quest.69C0C60E738BFA33.quest_desc: [
		"Зачем: пропуск на наши планеты — Аксиоматив и Инь-Янь. Без него ракета туда не полетит, а прибывшего другим путём вернёт на Землю."
		"Механические крафтеры: 2 межпланетных сплава + продвинутая схема / 2 механизма точности + &dядро навигации&r / схема и 2 &eзвёздные карты&r (форпост «Обсерватория»)."
		"{@pagebreak}"
		"Носи в инвентаре — не тратится. Нужен &eкаждому&r пассажиру: нет хоть у одного — полёт отменён для всех."
		"Второе ядро навигации — со стола трансмутации за 65 536 EMC."
		"Межпланетный навигатор-блок на борту тоже нужен."
		"&7&o— Пропускной режим штаба: «Без пропуска — только в виде метеорита».&r"
	]
	quest.69C0C60E738BFA33.title: "&dЗвёздный навигатор&r"
	quest.6A226AA9E85F7950.quest_desc: [
		"Зачем: пули и дробь всех ружей — из свинца."
		"Свинцовая руда Gunsmithing лежит в обычном камне и сланце. На вахте печь руду не плавит: дробилка → промывка → плавка вентилятором через лаву."
		"Годится любой свинец, и TFMG тоже: рецепты патронов берут «любые свинцовые самородки»."
		"Картечь — свинцовые самородки на пиле с фильтром."
	]
	quest.6A226AA9E85F7950.title: "Свинец"
	quest.6A24AF99B3061795.quest_desc: [
		"Катает стержни и провода — без него ни соединителей, ни генератора C&A."
		"Слиток → &62&r стержня, лист → &62&r провода. Провод — только из &eлиста&r: сначала пресс, потом стан."
		"Кидай сверху или подавай воронкой и лентой."
		"{@pagebreak}"
		"&eКатушка провода&r — механические крафтеры: пустая катушка, 4 провода и 4 резины по углам (изоляция; резина — форпост «Каучуковая плантация»). Пустые — миксер: 2 железных листа + железный стержень → &624&r."
		"&7&oСтан не спрашивает, что ты в него кладёшь. Главное — не руку.&r"
	]
	quest.6A24AF99B3061795.title: "Прокатный стан"
	quest.6A79D752E0C6BF84.quest_desc: [
		"&6Легендарные&r артефакты волн (3) — основа позднего билда: много здоровья, большой срез урона, второе дыхание."
		""
		"&6Кровь титана&r — +12 к здоровью (6 сердец); вне боя +0,5 HP/с (5 с без урона). Основа танка."
		"&6Щиток бригадира&r — +3 брони; +20 % сопротивления отбрасыванию; −12 % входящего урона. Самый большой срез урона среди артефактов волн."
		"&6Жетон второго дыхания&r — +4 к здоровью (2 сердца); второе дыхание: смертельный удар оставляет 1 HP, 2 с неуязвимости; раз в 5 мин. Срабатывает раньше тотема бессмертия — тотем остаётся целым."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 3 — с волны 27: ≈0,14 % на 27-й, ≈0,97 % на 50-й, ≈3,8 % на 100-й за победу (без первого прохождения)."
	]
	quest.6A79D752E0C6BF84.title: "&6Легендарные&r артефакты"
	quest.6A850784B9615901.quest_desc: [
		"Зачем: руду пока не переработать — первый металл даёт порода."
		"&6Жернов&r на валу: брось сверху булыжник — выйдет гравий; гранит → красный песок. Забирай ПКМ или шлюзом."
		"&6Вентилятор&r дует сквозь воду (ведро из ящика) на депо: что лежит на депо — промывается."
		"{@pagebreak}"
		"Гравий → &e25 %&r самородок железа + кремень."
		"Красный песок → &e25 %&r самородок меди + редстоун (он нужен столу трансмутации)."
		"Мало? Два жернова и лента вместо депо. Бесконечный камень даст экструдер (фаза «Завод»)."
		"&7&o— Бухгалтерия Axiomativ: «Четыре гравия на самородок — не потери, а инвестиции в терпение».&r"
	]
	quest.6A850784B9615901.title: "Первый металл: жернов и промывка"
	quest.6AF7098360A5E993.quest_desc: [
		"Зачем: удар незерита плюс немощь врагу."
		"Урон 8, при ударе — &cСлабость II&r и &cТьма II&r на 5 с: громила под слабостью почти не ранит. Прочность 2 124."
		"Механические крафтеры в ряд: шаблон эха | незеритовый меч | слиток эха. Где брать слиток и шаблон — в квесте «Броня эха»."
	]
	quest.6AF7098360A5E993.title: "Меч эха"
	quest.6B33460399FB68BA.quest_desc: [
		"Замкнутая оболочка, горелка под ней, всё проклеено и собрано сборщиком. Подай сигнал и жди: всплывёт, когда подъёмная сила перевесит вес."
		"Высоту держит сам: наверху воздух реже. Вниз — ослабь сигнал горелки."
		"Вперёд — пропеллер с двигателем, как у самолёта."
		"&7&o— Пресс-служба: «Мы не летаем медленно. Мы летаем вдумчиво».&r"
	]
	quest.6B33460399FB68BA.title: "Дирижабль поднялся"
	quest.6B4A80C8D04DFF1C.quest_desc: [
		"&eНизковольтный соединитель&r (малый) — вход в сеть C&A: ставится на генератор, мотор, аккумулятор."
		"Миксер: медный стержень + андезитовый сплав + слизь → &63&r."
		"Малый: до &61 000 FE/т&r, &64&r провода, пролёт &616&r блоков."
		"{@pagebreak}"
		"&eПровод:&r с катушкой в руке ПКМ по одному соединителю, потом по другому. Одна катушка — один пролёт, пустая вернётся. Снять — ПКМ пустой катушкой."
		"Соединитель на генераторе должен &eзабирать&r ток, на моторе — &eотдавать&r. Режим ставится сам; поправить — гаечным ключом."
		"&7&oСлизь в рецепте — для изоляции. По крайней мере, так говорят в снабжении.&r"
	]
	quest.6B4A80C8D04DFF1C.title: "Соединитель и медный провод"
	quest.6BE2AB1CA7A7B150.quest_desc: [
		"&6Ботинки&r"
		"&eПружинные ботинки&r — урон от падения 0."
		"&eШаговый подъёмник&r — шаг на целый блок без прыжка (0,6 → 1,1). Сборка по шагам: железный лист → шестерня → андезитовый сплав → пресс, два круга."
		"&6Поножи&r"
		"&eУскоритель бега&r — скорость +30 %. Крафтеры: 4 латунных листа, 2 сахара, 2 электронные лампы, точный механизм."
		"&eПрыжковые пружины&r — прыжок ~2,2 блока вместо 1,25. Крафтеры: 4 блока слизи, 2 кроличьи лапки, 2 латунных листа, точный механизм."
		"{@pagebreak}"
		"&6Нагрудник&r"
		"&eБронепластина&r — защита +4, вязкость +2, отбрасывание −10 %. Крафтеры: 8 прочных листов вокруг незеритового слитка. Сплавная броня (24) + пластина = 28 из 30 возможных."
		"&eЭнергощит&r — своя ветка справа."
		"&6Шлем&r"
		"&eПрибор ночного видения&r — квест ниже."
	]
	quest.6BE2AB1CA7A7B150.title: "Справка: модули"
	quest.6C0ECF8DB46B242F.quest_desc: [
		"Сырьё эндгейма: завод делает из осколков эссенцию, а она &eпробуждает артефакты&r."
		"Падают с мобов набега — не на землю, а в &eкопилку набега&r: что выбили вы и ваши турели, после победы получает каждый защитник вместе с добычей. Провал — копилка сгорает."
		"Шанс с моба: волны 1–15 — 0,5–1,5 %, 16–70 — 1,5–6 %, дальше до 8 %; ванильные мобы — вдвое реже. Босс — 4–8 осколков наверняка."
		"Сколько в копилке прямо сейчас — команда /nsart."
		"&7&o— Отдел снабжения: «Орда не знает, что её разбирают на запчасти. Не говорите ей».&r"
	]
	quest.6C0ECF8DB46B242F.title: "&dОсколок орды&r"
	quest.6C1319E4F7619FC0.quest_desc: [
		"Дождись рассвета живым и отметь галочку, когда взойдёт солнце."
		"Что помогает: свет вокруг базы, стены с дверью, костёр рядом и таблетки в кармане."
		"Дальше — глава «Алтарь и набеги»: разметить базу и поставить алтарь."
		"&7&o— Пресс-служба Axiomativ: «Смена прошла штатно. Потерь нет. Тех, кого нет, — тоже нет».&r"
	]
	quest.6C1319E4F7619FC0.title: "Пережить первую ночь"
	quest.6C3AD885DB6C2F69.quest_desc: [
		"В глубоких тёмных пещерах водится &cПещерный житель&r."
		"Драться бесполезно: он очень живучий. Услышал его — уходи к свету и наверх, не оборачивайся."
		"&7&o— Отдел по работе с ордой: «С Пещерным жителем мы не работаем. Он работает с нами».&r"
	]
	quest.6C3AD885DB6C2F69.title: "Пещерный житель"
	quest.6C614AF71546A618.quest_desc: [
		"&cМифические&r артефакты волн (2) — то, ради чего гриндят 50+: секунда полной неуязвимости после удара и сердце орды."
		""
		"&cПесочные часы смены&r — +2 брони; после удара моба — 1 с полной неуязвимости, перезарядка 6 с. Щит включает удар моба или снаряда; огонь и яд его не тратят. Ни урона, ни отбрасывания."
		"&cСердце орды&r — +14 к здоровью (7 сердец); вампиризм 6 % нанесённого урона (до 3 HP за удар); вне боя +0,5 HP/с (5 с без урона). Здоровье, вампиризм и лечение вне боя в одном слоте."
		"{@pagebreak}"
		"Слот: &eРеликвия&r. Выпадает каждый из 2 — с волны 43: ≈0,3 % на 43-й, ≈0,62 % на 50-й, ≈4,8 % на 100-й, ≈7,2 % в Бесконечности (∞20) за победу (без первого прохождения)."
		"&7&oПесочные часы смены: одна секунда бессмертия, потом шесть секунд объяснительной.&r"
	]
	quest.6C614AF71546A618.title: "&cМифические&r артефакты"
	quest.6C6C1196E042B5E3.quest_desc: [
		"Зачем: только она (и Стабилитовая) добывает руды наших планет — аксиомит и стабилит. Обычная кирка руду не сломает, бур сломает — но без добычи."
		"Алтарь за первое прохождение &e70-й волны&r даёт каждому защитнику &dЗвёздный осколок&r — сердцевину кирки. Без него кирку не собрать."
		"Механические крафтеры: &e3 межпланетных сплава&r сверху, &eнезеритовая кирка&r, под ней &dосколок&r."
		"{@pagebreak}"
		"Прочность &e2 500&r, скорость копания &e10&r (незеритовая — 2 031 и 9). Сколько прочности осталось — в подсказке кирки."
		"Ещё осколки — редкая добыча Кошмара (волны 70+) и стол трансмутации, когда осколок изучен."
		"&7&o— Отдел кадров: «Кирку выдают за выслугу. Выслуга — 70 волн. Кирку, правда, ещё собрать надо».&r"
	]
	quest.6C6C1196E042B5E3.title: "Звёздная кирка — осколок 70-й волны"
	quest.6C7048DAF23AD178.quest_desc: [
		"Зачем: книга хранит заклинания и колдует их сколько угодно — за ману, а не за свитки."
		"&6Хлипкий журнал&r: 2 медных слитка + нить + 6 бумаги — механические крафтеры 3×3. Дальше: железный фолиант (цепи, кожа, бумага), книга ученика (золото, эссенция, кожа хоглина), зачарованная и древний трактат."
		"Чем дороже книга, тем больше ячеек — видно в подсказке."
		"ПКМ книгой — она встаёт в свой слот (Curios). Колдовать — клавиша &eV&r, выбрать заклинание — &eR&r (см. справку о мане)."
		"&7&oКнига без заклинаний — это просто тетрадь. Дорогая тетрадь.&r"
	]
	quest.6C7048DAF23AD178.title: "Книга заклинаний"
	quest.6C9D773A2FC527F8.quest_desc: [
		"Волны 60–69: особые варианты — &8Невидимый жнец&r, Голиаф-титан, Бешеный богомол, Краб-владыка, подрывники-тяжеловесы. Боссы парами: 60 — Трисектор и Скорпиоид, 65 — Диаболос и Драконохвост."
		"Оборона должна работать без вас: турели, ремонт, патроны на потоке. Людей — не меньше двух."
		"&6Первое прохождение&r: &5Сердце ночи&r и сильный артефакт каждому."
	]
	quest.6C9D773A2FC527F8.title: "Волна 60: Ночь невидимок"
	quest.6CA219A30AA20749.quest_desc: [
		"Зачем: Атлас (Space Atlas) — «ключ зажигания». В станции он показывает открытые планеты."
		"&eАтлас&r: книга + титановый слиток (миксер)."
		"&eАстрономический стол&r: обтёсанное бревно + 4 деревянные плиты + железный слиток + бумага (миксер)."
		"Кладёшь в стол Атлас и записи — наука идёт в Атлас."
		"{@pagebreak}"
		"Нужно науки: Земля 1, Луна 2, Марс 5, Венера и Меркурий 6, Инь-Янь 7, Аксиоматив 8."
		"Запись = 1, но каждая следующая с той же планеты-наблюдателя весит ×0,9. С одной Земли: Луна — 3 ночи, Марс — 7, Венера и Меркурий — 9."
		"{@pagebreak}"
		"Быстрее: долети до Луны и снимай оттуда — счёт там свой, и можно днём."
		"Землю открой 1 записью с Луны — или возвращайся по Обратному билету."
		"&7&o— Юротдел: «Планета не в атласе юридически не существует. Падать на неё всё равно больно».&r"
	]
	quest.6CA219A30AA20749.title: "Атлас и наука"
	quest.6DB17E94A8B8DC7D.quest_desc: [
		"Зачем: броня одной школы магии усиливает её заклинания (огонь, лёд, молния и т. д.)."
		"Вещь робы волшебника + руна школы + эссенция → миксер. Кузнечного стола на вахте нет — этот путь единственный."
		"&6Пустая руна&r: деплоер кладёт эссенцию на полированный глубинный сланец. &6Руна школы&r: пустая руна в центре + 8 фокусов школы вокруг (крафтеры 3×3)."
		"{@pagebreak}"
		"Фокусы: огонь — стержень блейза, лёд — замороженная кость (роняют зимогоры, в набегах их много), молния — молния в бутылке, свет — божественная жемчужина (золото + аметист, миксер), Энд — жемчуг Края, кровь — флакон с кровью, заклятие — изумруд, природа — ядовитый картофель."
		"&6Незеритовая мантия мага&r: ряд механических крафтеров — шаблон незеритового улучшения | вещь робы | незеритовый слиток (чары и вписанные заклинания сохраняются)."
	]
	quest.6DB17E94A8B8DC7D.title: "Броня школы"
	quest.6E1ED7079EA38D72.quest_desc: [
		"Зачем: закрыться от стрел скелетов и разбойников."
		"Механические крафтеры: доски и железный слиток, раскладка как на верстаке."
		"ПКМ — блок: удары и стрелы спереди не проходят. Топор выбивает щит на 5 с."
		"Позже — щиты Cataclysm из чёрной стали и лазурный."
	]
	quest.6E1ED7079EA38D72.title: "Щит"
	quest.6ED17F493EBED118.quest_desc: [
		"Зачем: добыча без моба — ни драки, ни лагов, ни криперов."
		"Сборка 5×5, как у рассадника, но в центре деревянная бочка и без вала."
		"Поставь в точку появления: вместо моба в сборщик падает его добыча. Выводи шлюзом."
	]
	quest.6ED17F493EBED118.title: "Сборщик добычи"
	quest.6ED7257BB0C28FE8.quest_desc: [
		"Create: Ender Transmission — передатчики между измерениями: предметы, жидкости и энергия."
		"Буровая на Марсе → передатчик → склад на Земле. Ток на арену — тем же путём."
		"Передатчик предметов — механические крафтеры 5×5: обсидиан, эндер-жемчуг, око Края, механизмы точности, желоб."
	]
	quest.6ED7257BB0C28FE8.title: "Доставка с планет"
	quest.6F0ED9E8085BFCE5.quest_desc: [
		"ПКМ шиной по &6передней грани&r крепления — насадить (с других сторон не встанет)."
		"Размеры: &eмаленькая&r — деплоер кладёт резину на вал; &eобычная&r — вал в кольце из 4 резины; &eбольшая&r — вал, 2 ремня и 2 резины; &eгигантская&r — вал в кольце из 8 резины. Резина — форпост «Каучуковая плантация» (глава «Сеть форпостов»)."
		"Крупнее шина — проходимее машина."
	]
	quest.6F0ED9E8085BFCE5.title: "Шины"
	quest.6F174BDE59A5B3BF.quest_desc: [
		"Какой уровень даст котёл — по основанию бака."
		"&eОснование — горелок — уровень:&r"
		"&e1×1&r — 1: уголь &61&r, торт &62&r"
		"&e2×2&r — 4: уголь &64&r, торт &68&r"
		"&e3×3&r — 9: уголь &69&r, торт &618&r"
		"Высота бака: 4 блока под уголь, 8 — под торт. Выше бак ничего не добавляет."
		"{@pagebreak}"
		"&eSU на тортах:&r"
		"1×1×8 — &632 768 SU&r"
		"2×2×8 — &6131 072 SU&r"
		"3×3×8 — &6294 912 SU&r (максимум)"
		"Вода: котёл 18 пьёт &6180 мБ/т&r — две помпы на 256 об/мин."
		"Торты: 9 горелок съедают ~&63,4&r торта в минуту."
		"&7&oКотёл 18 — это когда соседи думают, что у тебя поезд. Всегда.&r"
	]
	quest.6F174BDE59A5B3BF.title: "Справка: уровни котла"
	quest.6F3FDF1B1C44B4CF.quest_desc: [
		"Зачем: летучий помощник — копает, носит вещи или возит существ, смотря какой модуль."
		"Сборка 3×3: 2 пропеллера, редстоун-связь, сплав, механизм точности."
		"Пульт дрона (латунь + пульт Create) включает модули и меняет дистанцию."
	]
	quest.6F3FDF1B1C44B4CF.title: "Латунный дрон"
	quest.6FBB17163563987D.quest_desc: [
		"Большая машина на механических крафтерах: много латуни, механизмы точности, лампы, механический бур — рецепт в JEI (R)."
		"Поставь над жилой, вставь сменный бур, подведи вращение — установка сама качает руду, пока жила не иссякнет (или вечно, если она бесконечная)."
		"Жилам незерита и закалённого алмаза подай лаву трубой."
		"{@pagebreak}"
		"&7&o— Геологоразведка Axiomativ: «Мы не копаем. Мы вежливо просим землю отдать своё».&r"
	]
	quest.6FBB17163563987D.title: "Буровая установка"
	quest.6FD1D61B190A391F.quest_desc: [
		"Греет воздух в оболочке НАД собой. &aТоплива не ест&r — работает от редстоун-сигнала: сильнее сигнал — полнее шар."
		"Крафтеры: железные листы по бокам, блок угля в центре, снизу андезитовый сплав и редстоун."
		"{@pagebreak}"
		"Одна горелка — до 500 м³, в панели сбоку лимит меньше. Несколько горелок на один шар складываются."
		"Есть &6паровое сопло&r (золотой лист над медным блоком): ставится на котёл Create и занимает 1 его уровень. Пассивный котёл тянет плохо — горелка проще."
	]
	quest.6FD1D61B190A391F.title: "Горелка аэростата"
	quest.6FE93BB8113FA436.quest_desc: [
		"Боссы L_Ender's Cataclysm — с 70-й волны: мини-боссы до 92-й, настоящие — с 80-й. Их трофеи — самые сильные в паке."
		"Трофей падает за победу на волне, где был босс: легендарный — 15 %, мифический — 10 % каждому защитнику; при &eпервом прохождении&r волны с боссом — наверняка одному из вас. Трофей занимает слот «Реликвия» — это и есть выбор."
		"{@pagebreak}"
		"&6Аметистовый панцирь&r — +4 брони; отражает 20 % урона ближнего боя обратно; иммунитет: хватка краба. Колется в ответ, а краб-душитель его не сожмёт. &7Боссы: Аметистовый краб (волны 70–84), Клаудиан (волны 78–92).&r"
		"&6Медальон гладиатора&r — +2 урона в ближнем бою; за убийство: Сила I на 6 с, Скорость I на 6 с. Арена любит тех, кто добивает. &7Боссы: Кобольдиатор (волны 70–84), Аптргангр (волны 75–89), Уаджет (волны 72–86, 90).&r"
		"&6Ядро голема&r — +3 брони; +2 прочности брони; отбрасывания нет вовсе; иммунитет: паралич. Ни босс, ни взрыв не сдвинут с места. &7Боссы: Голем Края (волны 76–90), Рыскун (волны 74–88).&r"
		"{@pagebreak}"
		"&cОко Стража Края&r — +6 к здоровью (3 сердца); второе дыхание: смертельный удар оставляет 1 HP, 2 с неуязвимости и телепорт на несколько блоков в сторону; раз в 3 мин. Смертельный удар — и ты уже в нескольких блоках отсюда. &7Босс: Страж Края (с 80-й).&r"
		"&cЯдро Игниса&r — постоянно: огнестойкость; огненная аура: монстры в 4 блоках горят и получают 2 урона в секунду. Чем гуще толпа у алтаря, тем лучше. &7Босс: Игнис (с 82-й).&r"
		"&cВенец Маледиктуса&r — +3 урона в ближнем бою; иммунитет: иссушение; твои удары: Иссушение II на 3 с, Слабость I на 3 с. Ослабленный моб бьёт слабее — меньше урона по тебе. &7Боссы: Маледиктус (с 85-й), Предвестник (с 87-й).&r"
		"{@pagebreak}"
		"&cОжерелье реликта&r — −12 % входящего урона; постоянно: подводное дыхание; иммунитет: замедление, слепота. Древняя защита и дыхание под водой. &7Боссы: Древний реликт (с 90-й), Сцилла (с 95-й).&r"
		"&cНезеритовое сердце&r — +12 к здоровью (6 сердец); +4 брони; +2 прочности брони; −5 % скорости. Тяжёлое, как само чудовище. &7Босс: Незеритовое чудовище (с 92-й).&r"
		"&7&o— Отдел трофеев: «Голову Игниса на стену не вешать. Она до сих пор горячая».&r"
	]
	quest.6FE93BB8113FA436.title: "&cТрофеи боссов Cataclysm&r"
	quest.7036B8873470BA20.quest_desc: [
		"Зачем: зачарование жидким опытом, без стола и без раскладов."
		"Кузня на вахте мертва: 3 сборщика в ряд — &eкузнечный шаблон | горелка всполоха | стол зачарования&r."
		"Подай жидкий опыт из бака, выставь уровень на панели (потолок — 30)."
		"Инфузора в сборке нет: его рецепт требует мод, которого в паке нет."
		"&7&oВсполох-чародей зачаровывает всё. Кроме бухгалтерии: её не берёт даже огонь.&r"
	]
	quest.7036B8873470BA20.title: "Всполох-чародей"
	quest.705095DD857BF7D7.quest_desc: [
		"Резина — изоляция: без неё нет катушек провода C&A, проводов New Age, толстого кабеля, шин Offroad, шасси самолёта и уплотнителя кислорода Northstar. Синтетической резины из нефти больше нет."
		"&eГде:&r джунгли. Примета — пятно красной латеритной почвы, на нём серые деревья-гевеи."
		"{@pagebreak}"
		"&eПодсочка:&r нож для подсочки (деплоер кладёт железный лист на палку) → ПКМ по стволу гевеи → &6латекс&r."
		"Ствол даёт латекс, только если стоит на латеритной почве (до 6 стволов в высоту). Ствол можно срубить и поставить заново — на той же почве."
		"Один ствол — раз в &63 с&r."
		"{@pagebreak}"
		"&eАвтоматизация:&r деплоер с ножом через клетку от ствола (деплоер бьёт на 2 блока вперёд), латекс складывается в сам деплоер."
		"Забирай воронкой с &eфильтром «латекс»&r — без фильтра она вытащит и нож."
		"&eВулканизация:&r миксер с нагревом — 2 латекса + серная пыль → &63&r резины."
		"&7&oГевея плачет латексом. Бухгалтерия плачет от счёта за серу. Все при деле.&r"
	]
	quest.705095DD857BF7D7.title: "Каучуковая плантация"
	quest.7074755FA491960A.quest_desc: [
		"Проще всего: &6миксер&r, 3 пшеницы → хлеб."
		"Выгоднее — линия: пшеница в &6жернов&r → мука; мука + вода в миксере или вентилятор через воду → &6тесто&r; тесто через вентилятор с огнём (или печь, коптильня) → хлеб."
		"Тесто Farmer's Delight — миксер: 3 пшеницы + яйцо."
		"&7&o— Пресс-служба: «Хлеб из вентилятора — это не магия, это логистика».&r"
	]
	quest.7074755FA491960A.title: "Хлеб на потоке"
	quest.707C719598FB65D9.quest_desc: [
		"Зачем: посох мода усиливает заклинания и колдует выбранное заклинание книги по ПКМ."
		"&6Посох старца&r: деревянная лопата + железный слиток + эссенция — по диагонали, крафтеры с крышками слота на пустых клетках."
		"&6Трость изобретателя&r — багровые доски, золото и аметист. Ледяной и пириевый посохи — из редкой добычи и незерита."
		"Наши посохи — ниже: они не колдуют книгу, у каждого своё заклинание."
	]
	quest.707C719598FB65D9.title: "Посохи мода"
	quest.70AA6E20E81CFD85.quest_desc: [
		"Настоящий самолёт планирует: &6крыло&r Create Propulsion даёт подъёмную силу на скорости, винту остаётся тянуть вперёд."
		"Крафтеры 3×3 (или миксер): железные листы по углам, железные самородки по бокам, андезитовый сплав в центре → 4 крыла."
		"Закалённое крыло — крыло в печи. Крыло-копикат — крыло под пилой."
	]
	quest.70AA6E20E81CFD85.title: "Крылья"
	quest.70D7CC025ABCB528.quest_desc: [
		"Зачем: без ядра не собрать Контроллер ракеты. Его выдаёт алтарь за первое прохождение &e50-й волны&r — каждому защитнику по одному."
		"Совет: сначала &eвыучи ядро на столе трансмутации&r (положи и выкупи). Дальше докупай за 65 536 EMC — второе нужно для Звёздного навигатора."
		"&7&o— Отдел по работе с ордой: «Сначала оборона, потом звёзды. Звёзды подождут, орда — нет».&r"
	]
	quest.70D7CC025ABCB528.title: "Ядро навигации — 50-я волна"
	quest.710081270063F8BA.quest_desc: [
		"Зачем: револьвер, дробовик и гатлинг собираются из стальных пластин."
		"Подходит любая сталь: рецепты берут «любой стальной слиток» и «любую стальную пластину»."
		"Своя сталь Gunsmithing: миксер на &cсверхнагреве&r (горелка ифрита на пироге) — железный слиток + угольная пыль (древесный уголь в дробилке). Пресс делает из слитка пластину."
		"{@pagebreak}"
		"Пластина из стали TFMG — «тяжёлая пластина» — тоже годится. Отметь, когда пластины пошли."
		"&7&o— ОТК: «Сталь закаляется. Вахтовик — тоже. Но сталь быстрее».&r"
	]
	quest.710081270063F8BA.title: "Сталь для ружей"
	quest.7171E67739DF54DC.quest_desc: [
		"Зачем: сырую руду дробят только колёса — жернов руду не берёт никакую."
		"Рецепт — сборка 5×5: &e21 сборщик&r. В ящике 9, нужно ещё 12."
		"&6Сборщик&r: электронная лампа, латунный корпус, мёртвый верстак — столбиком, выходит 3. Верстак — 4 доски прессом над чашей. Лампа и корпус — глава «Латунь, склад и поезда»."
		"{@pagebreak}"
		"Поставь пару колёс рядом: крутиться они должны &cнавстречу&r друг другу, иначе не дробят."
		"Сыпь сверху (шлюз, лента). Колёса умеют и всё, что умеет жернов, — только быстрее."
		"&7&o— Техника безопасности: руки между колёс не суют. Ещё раз: руки. Между колёс. Не суют.&r"
	]
	quest.7171E67739DF54DC.title: "Дробильные колёса"
	quest.721226B028FF97C7.quest_desc: [
		"Зачем: пара мобов опаснее сотни зомби."
		"&eВедьма&r — бросает зелья и лечится; бей издалека, первой."
		"&eЗаклинатель&r — призывает вексов, они летают сквозь стены."
		"&eВизер-скелет&r — удар накладывает иссушение; не подпускай."
		"&eОпустошитель&r — 100 HP и таран; держи его под пилами."
		"{@pagebreak}"
		"С 50-й волны отдельная подволна против щита: &dпронзатели&r (вексы, сквозь купол), &cразрушители&r (опустошители, ×10 по щиту), &5разрядники&r (ведьмы, выжигают запас)."
		"&7&o— Отдел кадров: «Ведьму не переубедить. Её можно только уволить. Из лука».&r"
	]
	quest.721226B028FF97C7.title: "Кого снимать первым"
	quest.722333FEE3F97701.quest_desc: [
		"Зачем: следующая ступень брони — маны больше, и она основа для брони школ."
		"&6Магическая ткань&r: шерсть в центре, 8 эссенций вокруг — механические крафтеры 3×3."
		"Из ткани на крафтерах — шляпа или капюшон, роба, поножи, сапоги (раскладка как у брони; пустые клетки — крафтеры с крышкой слота)."
		"&7&o— Отдел кадров: роба волшебника — не дресс-код. Но коллеги оценят.&r"
	]
	quest.722333FEE3F97701.title: "Роба волшебника"
	quest.724C7100B630DF65.quest_desc: [
		"Моб дошёл до алтаря — провал: добычи нет, у всей команды &cминус сердца&r максимума: волны 1–7 — 2, 8–26 — 3, дальше — 5."
		"Проклятие копится до −5 сердец. Пока оно висит, алтарь &cне начнёт&r новый набег."
		"&aИскупление&r: стопка ресурса за сердце — ПКМ стопкой по алтарю или воронкой в алтарь. Что и сколько, алтарь напишет сам: от 64 брёвен до 32 тория."
		"{@pagebreak}"
		"Всё лишнее, что заехало в алтарь конвейером, сгорает."
		"Раны от смертей и проклятие вместе не опустят здоровье ниже 3 сердец."
		"Провал на арене — такое же проклятие: прогресс и алтарные долги общие."
		"&7&o— Бухгалтерия Axiomativ: «Проклятие гасится стопками. Сердца к оплате не принимаются».&r"
	]
	quest.724C7100B630DF65.title: "Провал и проклятие"
	quest.72B123024288763B.quest_desc: [
		"&eУсловия&r: вакуум; днём до +434 °C, ночью до −200 °C; тяжесть 3,7 м/с²."
		"Теплозащита &c100 + 2 за блок&r: промышленное железо не вытянет — обшивка из марсианской стали или вольфрама."
		"Днём без скафандра из марсианской стали горишь. Садись ночью или приходи в термостойком."
		"{@pagebreak}"
		"&eДобыча&r: &bвольфрам&r (только здесь; руда и сырой — в дробилку), светокаменная руда, обычные руды."
		"&eФауна&r: рапторы, тараканы, черепахи."
		"&7&o— Столовая: «Обед на Меркурии готовится сам. Вместе с поваром».&r"
	]
	quest.72B123024288763B.title: "Справка: Меркурий"
	quest.73412CDE10A401D6.quest_desc: [
		"Зачем: позвать свой поезд к себе, где бы он ни был."
		"Миксер: медный слиток + латунный самородок (Steam 'n' Rails)."
		"ПКМ свистком по машинисту едущего поезда — привязка. Потом свисток на рельсах или у станции зовёт этот поезд."
	]
	quest.73412CDE10A401D6.title: "Свисток вызова поезда"
	quest.7348F756244BA78A.quest_desc: [
		"Зачем: делать свитки самому, а не ждать добычи."
		"Механические крафтеры: 3 полированного глубинного сланца сверху, плачущий обсидиан в центре и 3 внизу (пустые клетки — крышки слота)."
		"В кузницу: &eчернила&r (редкость — от неё уровень заклинания) + &eбумага&r + &eфокус школы&r (какие — в квесте «Броня школы»). Выбери заклинание из списка — готово."
		"Обычные чернила дают заклинания низкого уровня; сильные — от редких чернил и выше."
	]
	quest.7348F756244BA78A.title: "Кузница свитков"
	quest.737798268A331D1C.quest_desc: [
		"&eУсловия&r: +464 °C всегда, углекислота ~91 атм, тяжесть 8,87 м/с², теплозащита &c250 + 5 за блок&r."
		"Нужны скафандр из марсианской стали и вольфрамовый корпус: лист даёт +20 при норме +5 за блок. Марсианской стали понадобится больше сотни листов."
		"{@pagebreak}"
		"&eДобыча&r: венерианский гравий — дробилка даёт концентрат рутила щедрее песка. Угольная руда, грибные леса."
		"&cСерная кислота&r — в озёра не лезть."
		"&eФауна&r: мимики, скорпионы, каменные быки, грифы."
		"&7&o— Турагентство Axiomativ: «Венера — для тех, кому на Меркурии было прохладно».&r"
	]
	quest.737798268A331D1C.title: "Справка: Венера"
	quest.73867618D704282A.quest_desc: [
		"Зачем: запас в 2,5 раза больше — 500 единиц поглощённого урона (500 000 FE). Под куполом — полный за 12,5 с."
		"Крафтеры: 4 межпланетных сплава, 2 перезаряженных алмаза, 2 конденсатора, модульный аккумулятор."
		"Ставится и поверх Mk1 — модуль + нагрудник + электрическая медь, заряд сохраняется. Доля та же — 50 %."
	]
	quest.73867618D704282A.title: "Энергощит Mk2"
	quest.741AD72C451408C4.quest_desc: [
		"Лишние артефакты волн не пропадают: &e3 одного уровня → 1 случайный следующего&r."
		"Как: команда &e/nsart reforge&r или кнопка «[Переплавить 3 → 1]» в меню алтаря. Берутся артефакты из инвентаря (не из слотов) — самого низкого уровня, где их набралось три; сначала повторы."
		"Потолок — &cмифический&r: три легендарных дают мифический, божественные только из волн. Трофеи боссов и артефакты арены в переплавку не идут."
		"&7&o— Бухгалтерия: «Три старых в одно новое — это не потеря, это оптимизация склада».&r"
	]
	quest.741AD72C451408C4.title: "Переплавка 3 → 1"
	quest.742E217E8017112E.quest_desc: [
		"Зачем: синий лёд нужен экструдерам базальта и эндерняка."
		"Снег: экструдер между двумя водами на высоте &eот 150&r. 9 снежных блоков — пресс над чашей → лёд."
		"Промывка: лёд → плотный лёд → синий лёд."
	]
	quest.742E217E8017112E.title: "Синий лёд"
	quest.756309A2E9194896.quest_desc: [
		"Раскрути качалку — нефть пойдёт в подключённый бак."
		"Храни в &6стальных баках&r (бочка + 2 тяжёлые пластины → 2 бака; соседние сливаются в один). Они же — основа перегонной башни."
		"&7&oНефть — это динозавры, которые наконец-то пригодились на смене.&r"
	]
	quest.756309A2E9194896.title: "Нефть"
	quest.75D4EA183A7216E8.quest_desc: [
		"Тяга. Смотрит вверх — поднимает, вбок — толкает. Готовый винт, ставится прямо на вал."
		"&6Крафтеры&r столбиком: пропеллер Create, деревянная плита, вал."
		"&cТонкость:&r куда толкает — зависит от того, куда смотрит блок и куда крутится вал. Развернуть тягу — ключом."
	]
	quest.75D4EA183A7216E8.title: "Пропеллер"
	quest.75E4613658460314.quest_desc: [
		"Кварцевое стекло — &eкабины самолётов&r (биплан, гиродин, квадрокоптер, приборная панель), &eсолнечные теплогенераторы&r New Age, солнечная панель Northstar. Линзы — подзорная труба, телескоп Northstar, бинокль радара."
		"&eГде:&r пустыни. Примета — белая блестящая жила среди песка."
		"{@pagebreak}"
		"&eЦепочка:&r экструдер на жилу, сбоку песчаник и вода → &6кварцевый песок&r."
		"Вентилятор через лаву (обдув) → &6кварцевое стекло&r."
		"Деплоер с наждачной бумагой над конвейером (шлифовка) → &6линза&r."
		"&7&oВ пустыне ничего нет, кроме песка. Теперь там есть ещё и наш экструдер. Пустыня возмущена.&r"
	]
	quest.75E4613658460314.title: "Кварцевый карьер"
	quest.75F82658768FAA4D.quest_desc: ["Экструдер: синий лёд и лава по бокам, снизу &6почва душ&r (земля через призрачную обработку)."]
	quest.75F82658768FAA4D.title: "Базальт"
	quest.773E1E8AE9F7B7CF.quest_desc: [
		"Зачем: из титана вся ракета — пластины, станция, ускорители, атлас. Всё сырьё — в Верхнем мире."
		"&cВажно&r: на Земле титановой руды нет — первый титан делают химией (ниже). С планет руда пойдёт по пути «Вахты»: дробилка → дроблёная → промывка или печь."
		"{@pagebreak}"
		"&e1. Концентрат рутила&r — дробилка: известняк (50% на 2 шт.) или песок (25%)."
		"&e2. Соль&r — дробилкой из базальта. Базальт — в биоме «Базальтовые скалы» (Terralith), в Нижний мир не нужно."
		"&e3. Натриевый катализатор&r — соль под дозатором с 500 мБ лавы."
		"{@pagebreak}"
		"&e4. Газообразный углерод&r — пресс над чашей с горелкой: 3 угля → 1000 мБ."
		"&e5. Тетрахлорид титана&r — миксер над ПЕРЕГРЕТОЙ чашей (горелка + торт всполоха): 3 концентрата + катализатор + цинковый слиток + 500 мБ углерода → 500 мБ."
		"{@pagebreak}"
		"&e6. Слиток&r — последовательная сборка из Прочного листа Create: 500 мБ лавы → пресс → 500 мБ тетрахлорида → пресс → 1000 мБ воды."
		"500 мБ тетрахлорида = 1 слиток. Пластины — прессом."
		"&7&o— Отдел снабжения: «Титан не копают. Титан варят. Вопросы — в письменном виде».&r"
	]
	quest.773E1E8AE9F7B7CF.title: "&6Титан: варим на Земле&r"
	quest.773E29288CF753D6.quest_desc: [
		"Зачем: латунь открывает вторую половину Create: латунные корпуса, лампы, новые сборщики, поезда."
		"Миксер над чашей, под чашей &6горящая горелка&r: медь + цинк = &e2 латуни&r. Холодная чаша — ничего не выйдет."
		"Латунь не купить на столе — только завод."
		"&7&o— ОТК: «Холодная латунь — это медь и цинк, которые лежат рядом и молчат».&r"
	]
	quest.773E29288CF753D6.title: "Латунь"
	quest.7740332F1426A7C8.quest_desc: [
		"Стабилит — руда абсолютной стабильности, и она честно расколота надвое. Копается &eтолько Звёздной киркой&r."
		"&fСветлая&r руда — только в белых землях Ян (в кальците), &8тёмная&r — только в чёрных землях Инь (в чернокамне). Обе — y от −8 до 72, примерно как алмазы."
		"{@pagebreak}"
		"Квест засчитает светлую половинку, но домой вези &eобе&r. Проще всего у точки 0, 0: там все четыре квадрата рядом."
		"Половинку не возьмут ни печь, ни дробилка, ни вентилятор."
	]
	quest.7740332F1426A7C8.title: "Стабилит: две половинки"
	quest.784C7BEA8FE085AA.quest_desc: [
		"Зачем: летуны не идут по коридору и не грызут стены — их надо сбивать."
		"&eФантомы&r (с 14-й волны) кружат в ~16 блоках над алтарём, &eвексы&r заклинателей (с 20-й) — в ~8 блоках и проходят сквозь стены."
		"Лазерная турель бьёт на 17 блоков — поставь пару прямо у алтаря, и небо над ним прикрыто."
		"{@pagebreak}"
		"Радар видит цели только в ±20 блоках по высоте — держи его на уровне алтаря."
		"С 85-й волны летают и боссы Cataclysm: Маледиктус, потом Предвестник."
		"Ещё ПВО на токе — &eтесла-башня&r (глава «Энергия»): бьёт летунов цепной молнией сама, без радара."
	]
	quest.784C7BEA8FE085AA.title: "ПВО"
	quest.78A694FC4AC929DC.quest_desc: [
		"Зачем: большая часть волны гибнет, не дойдя до стрелков."
		"Собери всё в конце коридора: вентилятор сдувает и жжёт, пилы в полу режут, деплойеры с мечами добивают. Орда приходит туда сама."
		"Пока крутится вал, мясорубка работает без тебя. Можно спать. Нельзя — набег."
		"&7&o— Столовая: «Фарш сегодня не подаём. По техническим причинам».&r"
	]
	quest.78A694FC4AC929DC.title: "Мясорубка"
	quest.79049C351BB0ADD1.quest_desc: [
		"Зачем: 11 урона по шести мобам, 17 — пневмоударом."
		"Кузнечного стола на вахте нет: механические крафтеры в ряд — шаблон незеритового улучшения | алмазная головка | незеритовый слиток. Чары и прочность переносятся."
		"Незерит — из древних обломков Нижнего мира и из добычи набегов."
	]
	quest.79049C351BB0ADD1.title: "Незеритовая головка"
	quest.79713E00CE3F45AC.quest_desc: [
		"Тепло → вращение: без угля и воды, круглые сутки (если греть трубами)."
		"Тепло принимает только &eсверху&r."
		"&6от 50&r тепла/с — &6512 SU&r (16 об/мин)"
		"&6от 100&r тепла/с — &61 024 SU&r (32 об/мин)"
		"Полный Стирлинг = 2 продвинутых теплогенератора (днём) или ~20 труб над лавой (всегда)."
		"Рецепт — в JEI (R)."
		"&7&oСила — 1/16 парового двигателя. Зато не ест и не взрывается. Стажёр мечты.&r"
	]
	quest.79713E00CE3F45AC.title: "Двигатель Стирлинга"
	quest.798AC21976DE3822.quest_desc: [
		"&bАксиомит&r — металл, ради которого компания строила заводы. Добывается &eтолько Звёздной киркой&r."
		"Руда — в сером туфе (y до ~160) и в глубинном сланце ниже 0; глубоко внизу — крупные жилы."
		"{@pagebreak}"
		"Печь сырьё не плавит. Дробилка → &6Дроблёный рудный аксиомит&r (с сырья 1 + 50%, с блока руды 2 + 50%) → вентилятор над лавой или огнём → &6Аксиомитовый слиток&r."
		"Попутно — железная руда и блоки сырого железа в глубинах."
	]
	quest.798AC21976DE3822.title: "Аксиомит: руда → слиток"
	quest.798ACE3CE5DB69E8.quest_desc: [
		"Кровавая луна (14–15): &cфантомы&r в небе, невидимые &8тени&r-пауки, вихри, пещерные пауки. Босс — &4Голиаф&r: паук ArPhEx, быстрый, ~560 HP."
		"Готовьтесь: алмазная броня и оружие с чарами, вдвоём-втроём; стрелки или турели, которые бьют вверх."
		"&6Веха каждому&r: &dЗаряд молнии&r — в деплоер Create, бить по медному слитку: выйдет &eэлектрическая медь&r. Без неё не собрать ни один генератор тока (глава «Энергия»)."
		"{@pagebreak}"
		"Дальше — &cтолько мобы модов&r и премьера каждую волну (квест «Премьеры»)."
	]
	quest.798ACE3CE5DB69E8.title: "Волна 15: заряд молнии"
	quest.799CA552C9730DC4.quest_desc: [
		"&eУсловия&r: углекислый воздух 0,006 атм — дышать нельзя; −100 °C (железный скафандр держит); тяжесть 3,71 м/с²; теплозащита 50 + 0,05 за блок."
		"Телескоп работает и днём. Концентратор собирает тут углерод."
		"{@pagebreak}"
		"&eДобыча&r: марсианская железная руда (киркой — сырая руда для стали), вулканический пепел, марсианский гравий (дробилка → соль), марсианская клубника."
		"&eФауна&r: кобры, дьявольская моль, корневые жабы, эхо-черви."
		"&7&o— Пресс-служба: «Жизни на Марсе нет. Есть кобры. Это разные вещи».&r"
	]
	quest.799CA552C9730DC4.title: "Справка: Марс"
	quest.7A0F0FB1F4DD3514.quest_desc: [
		"С 22-й волны часть стадий — &dособые&r: они заставляют строить новое, а не стоять за той же стеной."
		"&eНеуязвимость&r — обычная орда, но берёт урон только от одного: тока, машин или магии. Бьёшь «не тем» — урон гаснет, над хотбаром подсказка."
		"&eНевидимки&r — орда невидима, видно только в луче прожектора."
		"&eОсада форпоста&r — орда идёт на ваш форпост, а не на базу. &eКонвой&r — довести обоз до базы через засады."
		"&eСценарий&r — вместо подволн задача на время: воздушный бой, побег, штурм гнезда. Сценарии идут только у &6алтаря базы под открытым небом&r, на арене их не начать."
		"{@pagebreak}"
		"Номера: 22, 24, 26, 28, 32, 34, 36, 38, 43, дальше повторы и «Блэкаут» — 42–68 (крепче, дальше, злее). Кратные 5 остаются за боссами."
		"За первое прохождение каждой особой стадии — &6ключевой предмет&r (нужен для техники следующей ступени) и &dартефакт смены наверняка&r."
		"Прогноз у алтаря заранее пишет, какая стадия ждёт и что понадобится."
		"&7&o— Бригадир: «Кто думал, что смена — это стоять у стены, тот её ещё не видел».&r"
	]
	quest.7A0F0FB1F4DD3514.title: "Особые стадии"
	quest.7A39018E4BE93584.quest_desc: [
		"Сердце любой физической штуковины: превращает постройку в отдельный объект с массой и инерцией. Самолёт, дирижабль, машина, подлодка — все начинаются с него."
		"&6Механические крафтеры&r: рычаг сверху, под ним андезитовый корпус, по бокам от корпуса андезитовый сплав."
		"{@pagebreak}"
		"Сборщик берёт себя, блок под собой и всё приклеенное к ним. Зажми ПКМ по сборщику: рычаг вверх — собрать, вниз — разобрать."
		"Разобрать можно любым сборщиком, но штуковина должна стоять почти ровно, почти неподвижно и у земли: в воздухе не разбирается."
		"{\"text\":\"▶ Вики: физический сборщик (открыть)\",\"color\":\"aqua\",\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://createaeronautics.miraheze.org/wiki/Physics_Assembler\"}}"
	]
	quest.7A39018E4BE93584.title: "Физический сборщик"
	quest.7A54A188DFC80DA9.quest_desc: [
		"Арена меняет облик по номеру волны — и у каждой темы свои &dартефакты арены&r. Падают &eтолько за победу на арене&r в этой теме: так у арены появляется смысл фарма."
		"Шанс — отдельный бросок каждому защитнику сверх обычного артефакта; первое прохождение волны — ×2. Внутри темы эпический выпадает чаще мифического."
		"{@pagebreak}"
		"&eШахта&r (волны 1–15, 12 % за победу):"
		"&5Каска проходчика&r — +3 брони; +30 % скорости копания; иммунитет: усталость. Копать и строить оборону между волнами — быстрее."
		"&5Шахтёрский обушок&r — +2 урона в ближнем бою; +10 % скорости атаки. Тяжёлый, но послушный в руке."
		"&eКаньон пауков&r (волны 16–29, 12 % за победу):"
		"&5Паучий шёлк&r — +10 % скорости; иммунитет: паутина пауков, замедление, яд. Паутина пауков ArPhEx больше не держит."
		"&6Ядовитая железа&r — +2 урона в ближнем бою; твои удары: Иссушение I на 4 с. Иссушение берёт и пауков, которым яд нипочём."
		"{@pagebreak}"
		"&eВечная мерзлота&r (волны 30–44, 12 % за победу):"
		"&5Осколок вечной мерзлоты&r — +2 брони; ударившему тебя вплотную: Замедление III на 3 с. Сильнее всего против тех, кто бьёт часто: богомолов и скорпионов."
		"&6Сердце метели&r — +10 к здоровью (5 сердец); иммунитет: замедление; нет урона: мороз и рыхлый снег. Мороз не берёт, а холодное сердце бьётся ровно."
		"&eПекло&r (волны 45–59, 12 % за победу):"
		"&6Пепельное сердце&r — +6 к здоровью (3 сердца); постоянно: огнестойкость; ударившего тебя вплотную поджигает на 5 с. В Пекле — спасение: лава и огонь больше не страшны."
		"&cКорона пекла&r — +3 урона в ближнем бою; постоянно: огнестойкость; твои удары поджигают на 4 с. Огнестойких не берёт: визер-скелеты и пылающие и так горят."
		"{@pagebreak}"
		"&eКрай&r (волны 60–69, 12 % за победу):"
		"&6Перо Края&r — +10 % скорости; нет урона: падение; медленное падение, пока зажат Shift. С крыши арены — вниз без последствий."
		"&cОсколок пустоты&r — +8 к здоровью (4 сердца); уклонение 15 %: удар моба проходит мимо. Примерно каждый седьмой удар моба уходит в пустоту."
		"&eКошмар&r (волны 70–99, 12 % за победу):"
		"&cФонарь кошмара&r — +8 к здоровью (4 сердца); постоянно: ночное зрение; иммунитет: Тьма, слепота, ужас моли, расколотый рассудок; во тьме рассудок не падает, урона тьмы нет. Тьма больше не съедает рассудок."
		"&6Коготь кошмара&r — +4 урона в ближнем бою; вампиризм 6 % нанесённого урона (до 3 HP за удар). Бьёт глубоко и пьёт понемногу."
		"{@pagebreak}"
		"&eЗвёздная бездна&r (волны 100+ и Бесконечность, 4 % за победу):"
		"&bОсколок звезды&r — +12 к здоровью (6 сердец); +10 % скорости; −8 % входящего урона; после удара моба — 1 с полной неуязвимости, перезарядка 5 с. Из Звёздной бездны — только с сотой и дальше."
		"&7&o— Турбюро Axiomativ: «Мерзлота, Пекло, Край. Всё включено, кроме возвращения».&r"
	]
	quest.7A54A188DFC80DA9.title: "&dАртефакты арены&r"
	quest.7A5BB064B668F255.quest_desc: [
		"Дракон — верховой зверь с дыханием, бронёй и своим сундуком. Летает быстрее самолёта на старте и зовётся свистком через миры."
		"Путь: найти яйцо → вылупить → приручить рыбой → седло → в небо. Мод — Dragon Mounts Remastered."
		"&7&o— Служба доставки: «Доставим куда угодно. Дракон тоже доставит, но может съесть посылку».&r"
	]
	quest.7A5BB064B668F255.title: "Драконья ферма"
	quest.7A9E4A6FA2EA52AF.quest_desc: [
		"Зачем: вал несёт вращение от источника к машинам — это «провод» Create."
		"Вращение — это &eскорость&r (об/мин) и &eнагрузка&r (SU). Машина ест SU, источник даёт запас. Съели больше запаса — встаёт вся сеть."
		"Наведи очки на вал — видно скорость и запас. Источники — колёса, ветряк, пар (глава про энергию)."
		"Вал: сплав на пилу — 6 шт."
		"&7&o— ОТК: «Вал крутится — цех работает. Вал стоит — цех пишет объяснительную».&r"
	]
	quest.7A9E4A6FA2EA52AF.title: "Вал и вращение"
	quest.7AA1D2EC840C70E1.quest_desc: [
		"Зачем: верстака нет — механические сборщики заменят его на всю игру."
		"Поставь 9 сборщиков стеной 3×3, все лицом в одну сторону. В очках видны стрелки: ключом сведи их к одному сборщику-выходу."
		"Вращение: рукоятка (держи ПКМ) или водяное колесо → вал → шестерня рядом со сборщиком."
		"{@pagebreak}"
		"Детали клади ПКМ в лицевые стороны, как на верстаке. Сборка стартует, когда заполнены &eвсе&r сборщики группы."
		"Рецепт меньше 3×3 — сними лишние ключом (Shift+ПКМ) или дай редстоун-импульс."
		"У выхода поставь сундук или депо — готовое ляжет туда. Не понятно — наведи на сборщик и держи &6W&r."
	]
	quest.7AA1D2EC840C70E1.title: "Сборочный пост"
	quest.7B2C996C9330FAFF.quest_desc: [
		"Зачем: лампа — «мозг» точных машин: сборщики, активаторы, стрелки, буровые."
		"&6Розовый кварц&r: кварц + 8 редстоуна (миксер). Отполируй &6наждачкой&r (песок + бумага, миксер): кварц во второй руке, держи ПКМ."
		"Лампа: полированный кварц + железный лист (миксер)."
		"&7&o— ОТК: «Лампа не светит. Лампа думает». Мы тоже пробовали. Не у всех получилось.&r"
	]
	quest.7B2C996C9330FAFF.title: "Электронная лампа"
	quest.7B5A4EFA0A80ED25.quest_desc: [
		"Зачем: руками бревно не разобрать — пила из ящика первый станок вахты."
		"Посади саженцы. Пилу поставь зубьями вверх, дай вращение и брось бревно сверху: &e6 досок&r."
		"Фильтр пилы (ПКМ предметом) — то, что хочешь &eполучить&r. Без фильтра пила перебирает все варианты по кругу."
		"Доска → 2 палки. Ступеньки, плиты, заборы, двери — тоже пилой."
		"&7&o— Техника безопасности: пила не отличает бревно от вахтовика. Проверено не на нас.&r"
	]
	quest.7B5A4EFA0A80ED25.title: "Пила: доски и палки"
	quest.7C1F5670809C5930.quest_desc: [
		"Вся глава в одном блюде. &6Миксер&r: хлеб, говяжья котлета, капуста, томат, лук."
		"Котлета: говядина → доска или пила → фарш → печь, коптильня, костёр или вентилятор с огнём."
		"Поставь бургеры на стол перед набегом: сытый вахтовик и рассудок держит дольше."
		"&7&o— Отдел по работе с ордой: «Орда ест вахтовиков. Вахтовики едят бургеры. Круговорот еды в природе».&r"
	]
	quest.7C1F5670809C5930.title: "Праздничный бургер"
	quest.7D067AFBD3DC3961.quest_desc: ["Электролит — в конденсаторы, магнетит — в магниты и моторы. Без этих двух форпостов ток на базе не заведёшь дальше генератора."]
	quest.7D067AFBD3DC3961.title: "Ток и магниты"
	quest.7D06BCB9E657D0AA.quest_desc: [
		"Зачем: автопосадка тормозит у грунта сама — Пробел держать не нужно, взрыва не будет."
		"&eАвтоматическая посадочная станция&r — механические крафтеры: 9 титановых пластин + 4 титановых слитка + 4 полированных лунных сапфира + кристалл лунного сапфира + 4 схемы + ещё одна Ракетная станция."
		"Блок ставится в корпус и приклеивается."
		"{@pagebreak}"
		"&eМаяк (Rocket Waypoint)&r — точка посадки. Механические крафтеры: 7 титановых пластин + 6 титановых и 5 вольфрамовых слитков + 2 навигационных компьютера + закалённый механизм + полированный алмаз + лампа из редстоуна."
		"{@pagebreak}"
		"ПКМ по маяку с Атласом — точка попадёт в список станции."
		"Маяк сломан — полёт отменится («Missing Rocket Waypoint»)."
		"&7&o— Служба доставки: «Садимся точно в точку. Иногда даже в нужную».&r"
	]
	quest.7D06BCB9E657D0AA.title: "Автопосадка и Маяк"
	quest.7D1C2E958E9CA27B.quest_desc: [
		"Домна горит не на угле и даже не на коксе, а на &6коксовой пыли&r: раздроби кокс жерновами или дробильными колёсами."
		"Пыль сыплется в домну сверху вместе с рудой и флюсом. Очки покажут, сколько топлива внутри."
		"&7&oКокс — это уголь, который прошёл курсы повышения квалификации.&r"
	]
	quest.7D1C2E958E9CA27B.title: "Коксовая пыль — топливо домны"
	quest.7D71F73C8A9DE129.quest_desc: [
		"ПКМ зарядом: всё враждебное в радиусе &e48 блоков&r — насмерть; у кого 150 HP и больше (боссы) — &c−35%&r здоровья. Блоки целы, игроки и големы — тоже."
		"Заряд тратится, перезарядка 60 с. С 80-й даже рядовой моб набега толще 150 HP — ему тоже только −35%."
		"{@pagebreak}"
		"Механические крафтеры: 4 слитка стабилита, 3 слитка аксиомита (руды наших планет, нужна звёздная кирка), TNT и радиоактивный торий."
		"&7&o— Техника безопасности: перед подрывом крикните «Ложись!». Орде всё равно, а вам спокойнее.&r"
	]
	quest.7D71F73C8A9DE129.title: "&eТактический ядерный заряд&r"
	quest.7EBEF8695B8AB4C0.quest_desc: [
		"Зачем: из корпуса — депо, жернов, миксер, экструдер, стол трансмутации и почти все машины."
		"Окорённое бревно (пила с фильтром «окорённое» или топор) поставь блоком и кликни по нему сплавом (ПКМ) — это «собрать руками», вахта разрешает."
		"Позже то же самое сделает автономный активатор."
	]
	quest.7EBEF8695B8AB4C0.title: "Андезитовый корпус"
	quest.7EC630A4A315D46F.quest_desc: [
		"Узнаёт, что и сколько в жиле, и записывает это в атлас."
		"Механические крафтеры: латунный корпус, 3 латунных листа, электронная лампа, механизм точности, 2 прочных листа и механический бур Create."
		"Поставь на жилу, &eсверху — медный баллон&r с воздухом (без него не запустится), ПКМ — старт. Закончил — ПКМ атласом, сведения уйдут в атлас."
	]
	quest.7EC630A4A315D46F.title: "Пробоотборник"
	quest.7F274304A2B7CC90.quest_desc: [
		"Эссенция — то, чем пробуждают артефакт: одна эссенция на круг сборки."
		"&eМиксер с супернагревом&r (горелка всполоха на торте всполоха): 16 пыли орды + звёздный осколок + 1000 мБ лавы."
		"&dРычаг магии&r: 8 пыли + 8 арканной эссенции (Iron's Spells, добыча набегов) + звёздный осколок + лава — пыли вдвое меньше."
		"Звёздный осколок — веха 70-й волны и добыча Кошмара, покупается за EMC (131 072). Итого ~15 осколков орды на эссенцию."
		"&7&o— Столовая: «Эссенция пробуждения — не кофе. Пить её запрещено. Особенно вам».&r"
	]
	quest.7F274304A2B7CC90.title: "&6Эссенция пробуждения&r"
	quest.7F5182591CB8A08F.quest_desc: [
		"То, что горит в реакторе. Без него стержень — просто красивая труба."
		"Сборочная линия из радиоактивного тория: пресс → деплоер с железным листом → пресс."
		"&61&r топливо = &624 мин&r работы одного стержня. В стержень влезает до &612&r штук (4,8 ч)."
		"&7&oСклад: «Топливо хранить подальше от столовой». Столовая: «Взаимно».&r"
	]
	quest.7F5182591CB8A08F.title: "Ядерное топливо"
	quest.7F8A5BCF1F2BC876.quest_desc: [
		"Металлы с других планет в разы крепче незерита. Линия та же, в цикле: слиток, пресс, точные механизмы, ключ."
		"&fТитан&r — огнеупорный, гасит взрывы. 1 механизм на цикл."
		"&9Лунный сапфир&r (полированный) — лекарь: регенерация, не боится магии и молний, плавает. 1 механизм."
		"{@pagebreak}"
		"&cМарсианская сталь&r — держит молнии, отбивает снаряды. 2 механизма."
		"&8Вольфрам&r — пробивает броню, глушит взрывы и магию, режет урон по себе. 3 механизма."
		"Металлы и сапфир — глава «Космос»."
	]
	quest.7F8A5BCF1F2BC876.title: "Космические металлы"
	quest.7FDAFA4F8A44DEA3.quest_desc: [
		"Зачем: решать, кому сколько тепла. Нагреватель жадный — берёт самую дорогую ступень, на какую хватает. Без вентилей ближний к котельной уйдёт в суперогонь и съест всё."
		"Ставь в разрыв трубы перед нагревателем. Тепло идёт только по &eстрелкам&r: вентиль ставится «от себя», с Shift — к себе, ключ поворачивает."
		"Окошко на боку (ПКМ и тяни, как скорость у мотора): строка &6Обычный&r или &bСуперогонь&r, число — сколько нагревателей за вентилем (до 4, 0 — закрыт)."
		"{@pagebreak}"
		"&6Обычный&r — 200 ˚T/с на нагреватель: бассейн «нагрет»."
		"&bСуперогонь&r — 550 ˚T/с: бассейн «перегрет», котлу — ровно 3 уровня с нагревателя. Котлу ставь суперогонь: на обычном уровень скачет 1–2."
		"&eРедстоун&r прикрывает по силе сигнала: &615&r — закрыт, 7 — половина. Рычаг — и ветка остыла."
		"Лампа на боку: зелёная — пропускает, красная — закрыт. Сколько идёт — в очках инженера."
		"Больше 4 нагревателей за одним вентилем дальние недополучат — лучше свой вентиль на каждый."
		"Сборка — механические крафтеры: жидкостный вентиль Create, 2 тепловые трубы, электронная лампа, электрическая медь."
	]
	quest.7FDAFA4F8A44DEA3.title: "Тепловой вентиль: обычный или суперогонь"
	quest.7FE6CF4D0290C173.quest_desc: [
		"Веха: &4Страж Края&r и два &5Голема Края&r. Страж стягивает гравитацией с укрытий."
		"Дальше по кругу настоящие боссы: Игнис (с 82-й), Маледиктус (85-й), Предвестник (87-й), Древний реликт (90-й), Незеритовое чудовище (92-й), Сцилла (95-й). Мини-боссы — парами."
		"&6Первое прохождение&r: сильный артефакт и &5Сердце ночи&r."
	]
	quest.7FE6CF4D0290C173.title: "Волна 80: две тени"
	quest.7FE7DE0EC8DCE5AE.quest_desc: [
		"&eНе зовётся.&r Над хотбаром пишется причина. Нужно: свисток в инвентаре, ты не верхом, вокруг ~3×4×3 без блоков (выйди из-под крыши), 5 с между вызовами. Погиб — жди 60 с."
		"&eСвисток «не работает».&r ПКМ не щёлкают, а ЗАЖИМАЮТ: меню → «Свистнуть». Клавиша V занята ещё шестью модами — переназначь «Позвать дракона»."
		"{@pagebreak}"
		"&eНевидим у тебя, а другие его видят, сесть нельзя.&r Клиент потерял дракона после резкого полёта или телепорта. Лечится перезаходом: Esc → Отключиться → зайти."
		"Не помогло — зови админа: он перенесёт дракона командой."
		"&7&o— Служба поддержки Axiomativ: «Вы пробовали выключить и включить мир?»&r"
	]
	quest.7FE7DE0EC8DCE5AE.title: "Дракон пропал?"
	quest.7FFAED499CB00CC3.quest_desc: [
		"Купол радиусом 24 блока вокруг генератора: монстры не проходят внутрь, их удары и снаряды гаснут. Над головой — видимая сфера, сверху — полоска «Щит»."
		"Питание — током: толстый кабель от аккумуляторов. Прочность растёт с запасом энергии, но &6вдвое больше энергии — только в 1,5 раза прочнее&r; каждый удар списывает энергию. Упал — 10 с перезагрузки."
		"{@pagebreak}"
		"Против щита в волнах 50+ есть своя подволна: &dпронзатели&r (вексы) проходят сквозь купол, &cразрушители&r (опустошители) бьют по нему в 10 раз сильнее, &5разрядники&r (ведьмы) выжигают запас."
		"Сигнал редстоуна гасит купол — между набегами выключайте: он тратит 1% запаса в минуту."
		"{@pagebreak}"
		"Сборка — механические крафтеры: 4 межпланетных сплава, 4 электрические меди, маяк и модульный аккумулятор."
		"&7&o— ОТК: «Купол защищает от зомби, скелетов и плохого настроения. От вексов — нет».&r"
	]
	quest.7FFAED499CB00CC3.title: "&aГенератор щита&r"
}
