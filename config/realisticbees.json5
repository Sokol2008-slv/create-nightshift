{
	// Ночная смена: пчёлы обычного размера (у мода по умолчанию 0.25 — крошечные)
	// min: 0.01, max: 5.0
	"beeSizeModifier": 1.0,
	// Сколько лишних пчёл появляется вместе с каждой естественной (пчёл было слишком мало)
	// min: 0, max: 50
	"extraBeeSpawnsPerBee": 4,
	// Сколько пчёл помещается в улей (в ванилле 3)
	// min: 0, max: 50
	"beeHiveBeeSpace": 10,
	"preventBeeSuffocationDamage": true
}
